# Local runtime state — never shared
/data/
dist/

# Secrets and personal configuration
config/control.token
config/jobs.json
config/jobs.json.bak*
config/*.bak*
config/projects.json
config/models.json

# Personal precheck scripts (keep only the shipped examples)
config/prechecks/*.sh
!config/prechecks/example-*.sh

# Personal worktree provisioning hooks (keep only the shipped examples)
config/provision/*.sh
!config/provision/example-*.sh

# Personal helper libraries sourced by prechecks and prompts
config/lib/

# Logs and OS cruft
*.log
.DS_Store
__pycache__/
*.pyc

# Node is a developer dependency: the UI bundle in bin/static/ is COMMITTED,
# so installing claude-cron never needs npm. These are the build inputs only.
node_modules/
