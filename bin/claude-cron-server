const STATUS_ICON={success:I.check, warning:I.alert, error:I.xcircle, idle:I.clock, running:I.timer};

/* ---------------------------------------------------------------- theme */
function themePref(){ return localStorage.ccTheme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"); }
function applyTheme(t){ document.documentElement.dataset.theme=t; $("themebtn").innerHTML = t==="dark" ? I.sun : I.moon; }
applyTheme(themePref());

/* ---------------------------------------------------------------- utils */
let DATA={jobs:[],state:{},runs:[],launchd_loaded:false};
let editingId=null, creating=false;
const esc=(s)=>String(s ?? "").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const fmtAgo=(s)=>{ if(!s) return "never"; const d=Math.floor(Date.now()/1000)-s;
  if(d<60)return d+"s ago"; if(d<3600)return Math.floor(d/60)+"m ago";
  if(d<86400)return Math.floor(d/3600)+"h ago"; return Math.floor(d/86400)+"d ago"; };
const fmtDur=(s)=>s<60 ? s+"s" : Math.floor(s/60)+"m "+(s%60)+"s";
// Explicit parts rather than dateStyle:"short" — that renders a 2-digit year.
const fmtWhen=(s)=>new Date(s*1000).toLocaleString(undefined,{year:"numeric",month:"numeric",
  day:"numeric",hour:"numeric",minute:"2-digit",second:"2-digit"});
// Canonical USD mask: $150.00, $1,234.56 — 2 decimals + thousands separator;
// tiny agent costs keep up to 4 decimals so a $0.004 run isn't shown as $0.00.
const money=(n)=>new Intl.NumberFormat("en-US",{style:"currency",currency:"USD",
  minimumFractionDigits:2, maximumFractionDigits:(Math.abs(n||0)<0.1?4:2)}).format(n||0);
const normStatus=(s)=>s==="ok"?"success":(s||"—");
// effort level → human label (empty = the flag is omitted and the CLI decides)
const EFFORT_LABELS={"":"default","low":"Low","medium":"Medium","high":"High","xhigh":"Extra high","max":"Max"};
const effortLabel=(v)=>EFFORT_LABELS[v||""]||v;
const fmtBytes=(b)=>{ if(!b) return "0 B"; const u=["B","KB","MB","GB"]; let i=0;
  while(b>=1024 && i<u.length-1){ b/=1024; i++; } return (i?b.toFixed(1):b)+" "+u[i]; };
const DOW=["","Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
function fmtDays(arr){
  const a=[...new Set((arr||[]).map(Number))].filter(n=>n>=1&&n<=7).sort((x,y)=>x-y);
  if(!a.length) return "—";
  const s=a.join(",");
  if(s==="1,2,3,4,5,6,7") return "Every day";
  if(s==="1,2,3,4,5") return "Mon–Fri";
  if(s==="6,7") return "Sat–Sun";
  return a.map(n=>DOW[n]).join(", ");
}
// The precheck's first output line as a bulleted key:value list on its own row,
// so it never wraps against the "nothing to do" text.
function checkList(output){
  const raw=String(output||"").split("\n")[0];
  if(!raw) return "";
  const pairs=[...raw.matchAll(/([A-Za-z_]+)=(\S+)/g)];
  const rest=raw.replace(/[A-Za-z_]+=\S+/g,"").replace(/->/g,"→").replace(/\s+/g," ").trim();
  const items=pairs.map(m=>'<li>'+esc(m[1].replace(/_/g," "))+': <span class="ck-v">'+esc(m[2])+'</span></li>');
  if(rest) items.push('<li>'+esc(rest)+'</li>');
  return items.length ? '<ul class="checklist">'+items.join("")+'</ul>' : '';
}

function toast(msg,isErr,iconName){
  const t=$("toast");
  t.innerHTML=(I[iconName||((isErr)?"xcircle":"check")]||"")+"<span>"+esc(msg)+"</span>";
  t.className=isErr?"show err":"show";
  clearTimeout(t._h); t._h=setTimeout(()=>t.className="",2600);
}

async function api(op, extra){
  const r = await fetch("/api/action", {method:"POST",
    headers:{"Content-Type":"text/plain","X-CC-Token":TOKEN},
    body: JSON.stringify(Object.assign({op}, extra))});
  const j = await r.json().catch(()=>({}));
  if(!r.ok || j.ok===false){ toast((j.output||j.error||("HTTP "+r.status)), true); return false; }
  return true;
}

/* ------------------------------------------------------------ confirm modal */
let _cfResolve=null;
function showConfirm(o){
  $("cf-halo").className="halo "+(o.tone==="danger"?"b-err":"b-warn");
  $("cf-halo").innerHTML=I[o.icon||"alert"]||I.alert;
  $("cf-title").textContent=o.title||"Are you sure?";
  $("cf-msg").textContent=o.message||"";
  const mono=$("cf-mono");
  if(o.mono){ mono.textContent=o.mono; mono.hidden=false; } else { mono.hidden=true; }
  const ok=$("cf-ok");
  ok.textContent=o.confirmLabel||"Confirm";
  ok.className="btn "+(o.tone==="danger"?"danger":"primary");
  $("confirm").showModal();
  return new Promise(res=>{ _cfResolve=res; });
}
$("cf-ok").addEventListener("click",()=>{ $("confirm").close(); if(_cfResolve){_cfResolve(true);_cfResolve=null;} });
$("cf-cancel").addEventListener("click",()=>{ $("confirm").close(); if(_cfResolve){_cfResolve(false);_cfResolve=null;} });
$("confirm").addEventListener("cancel",()=>{ if(_cfResolve){_cfResolve(false);_cfResolve=null;} });

/* ---------------------------------------------------------------- refresh */
async function refresh(){
  try{
    const r = await fetch("/api/data", {headers:{"X-CC-Token":TOKEN}});
    if(!r.ok) throw new Error("HTTP "+r.status);
    DATA = await r.json();
    // Server upgraded since this page loaded → reload once to pick up new UI.
    if(DATA.build && DATA.build!==BUILD && sessionStorage.ccReloadedFor!==DATA.build){
      sessionStorage.ccReloadedFor=DATA.build; location.reload(); return;
    }
    render();
  }catch(e){ $("updated").textContent = "server unreachable — "+e.message; }
}

let jobProjectFilter="";  // "" = all, "__none__" = standalone, else a project name
let collapsedGroups=new Set(JSON.parse(localStorage.ccCollapsed||"[]"));

function projById(name){ return (DATA.projects||[]).find(p=>p.name===name)||null; }
// effective value with project inheritance: job's own, else project's, else default
function eff(j, field, def){
  if(j[field]!=null && j[field]!=="") return j[field];
  const p=j.project?projById(j.project):null;
  if(p && p[field]!=null && p[field]!=="") return p[field];
  return def;
}

// Mirrors in_window() in the bash engine: is NOW inside the job's active window?
// Same rules — active_days is 1=Mon..7=Sun, active_hours is "HH:MM-HH:MM" and
// may cross midnight; an empty/absent value means "no restriction".
function inWindow(j, when){
  const now=when||new Date();
  const days=j.active_days;
  if(Array.isArray(days) && days.length){
    const dow=now.getDay()===0?7:now.getDay();   // JS 0=Sun → 7
    if(!days.map(Number).includes(dow)) return false;
  }
  const hours=j.active_hours;
  if(hours && /^\d{1,2}:\d{2}-\d{1,2}:\d{2}$/.test(hours)){
    const [a,b]=hours.split("-");
    const toMin=(s)=>{ const [h,m]=s.split(":").map(Number); return h*60+m; };
    const s=toMin(a), e=toMin(b), nowMin=now.getHours()*60+now.getMinutes();
    if(s<=e){ if(!(nowMin>=s && nowMin<e)) return false; }
    else { if(!(nowMin>=s || nowMin<e)) return false; }   // window crosses midnight
  }
  return true;
}

// When the next precheck will actually happen. The tick skips any job outside
// its window (in_window is checked BEFORE the precheck), so "last + interval" is
// wrong once that lands outside the schedule — the real answer is when the
// window next opens. Returns epoch seconds, or null if nothing fits in 8 days.
function nextCheckAt(j, fromEpoch){
  const from=new Date(fromEpoch*1000);
  if(inWindow(j, from)) return fromEpoch;
  const days=(Array.isArray(j.active_days)&&j.active_days.length)?j.active_days.map(Number):null;
  const hours=(j.active_hours && /^\d{1,2}:\d{2}-\d{1,2}:\d{2}$/.test(j.active_hours))?j.active_hours:null;
  const [oh,om]=(hours?hours.split("-")[0]:"00:00").split(":").map(Number);
  for(let i=0;i<=8;i++){
    const c=new Date(from); c.setDate(c.getDate()+i); c.setHours(oh,om,0,0);
    if(c.getTime()<from.getTime()) continue;      // that day's opening already passed
    const dow=c.getDay()===0?7:c.getDay();
    if(days && !days.includes(dow)) continue;
    return Math.floor(c.getTime()/1000);
  }
  return null;
}

function jobCard(j){
  const t0=Math.floor(new Date().setHours(0,0,0,0)/1000);
  const st=DATA.state[j.id]||{}, disabled=j.enabled===false;
  const chk=(DATA.checks||{})[j.id]||{checks:0,runs:0};
  const spentToday=DATA.runs.filter(r=>r.id===j.id && r.start>=t0).reduce((a,r)=>a+(r.cost||0),0);
  const cap=(j.daily_budget_usd!=null?+j.daily_budget_usd:null);
  const capped=(cap!=null && spentToday>=cap);
  // Due time by interval, then pushed to the next window opening if that falls
  // outside the schedule — so the card never promises a check that cannot run.
  const dueAt=st.last_start?(st.last_start+(j.interval_seconds||300)):Math.floor(Date.now()/1000);
  const nextAt=nextCheckAt(j, dueAt);
  const next = j.enabled===false ? '<span class="muted">disabled</span>'
    : (nextAt==null ? '<span class="muted">no matching window</span>'
    : esc(fmtWhen(nextAt))+(nextAt>dueAt+30?' <span class="muted">· when the window reopens</span>':''));
  const pc=st.last_precheck||null;
  let checkStr=fmtAgo(st.last_start);
  if(pc && typeof pc==="object"){ checkStr+=" — "+(pc.exit===0?"work found":"nothing to do")+checkList(pc.output); }
  // A job may have SEVERAL runs going at once, so say how many rather than one
  // "running now". The per-run outcome is no longer summarised on the card: each
  // run is individual and carries its own status in the Runs table.
  const nLive = activeRunsOf(j.id).length;
  const runStr = (nLive
      ? '<span class="runningbadge"><span class="pulse"></span>'
        +nLive+' running now'+(nLive===1?'':'')+'…</span>'
      : "")
    + (st.last_run_start
        ? (nLive?' <span class="muted">· last ':'<span class="muted">last ')+esc(fmtAgo(st.last_run_start))+'</span>'
        : (nLive?"":"never"));
  const model=eff(j,"model","opus"), perm=eff(j,"permission_mode","dontAsk"), budg=eff(j,"max_budget_usd",2);
  const kv='<dl class="kv">'
    +'<dt>'+I.clock+'Every</dt><dd>'+fmtDur(j.interval_seconds||300)+'</dd>'
    +'<dt>'+I.calendar+'Window</dt><dd>'+esc(j.active_hours||"24h")+' · '+esc(fmtDays(j.active_days||[1,2,3,4,5,6,7]))+'</dd>'
    +'<dt>'+I.play+'Last run</dt><dd>'+runStr+'</dd>'
    +'<dt>'+I.radar+'Last check</dt><dd>'+checkStr+'</dd>'
    +'<dt>'+I.cright+'Next check</dt><dd>'+next+'</dd>'   /* already escaped above */
    +'<dt>'+I.dollar+'Today</dt><dd>'+money(spentToday)
      +(cap!=null ? ' / '+money(cap)+(capped?' <span class="s-error">· capped</span>':'') : ' <span class="muted">· no cap</span>')+'</dd>'
    +'<dt>'+I.cpu+'Model</dt><dd>'+esc(model)+' · cap '+money(budg)+'/run · '+esc(perm)+'</dd>'
    +'<dt>'+I.activity+'Effort</dt><dd>'+esc(effortLabel(eff(j,"effort","")))+'</dd>'
    +'<dt>'+I.activity+'Checks (24h)</dt><dd>'+chk.checks+' automatic check'+(chk.checks===1?"":"s")+' · '+chk.runs+' run'+(chk.runs===1?"":"s")+' woken</dd>'
    +'</dl>';
  // Badge has three states: disabled (red), idle (amber — enabled but outside
  // its active window and not currently running), enabled (green).
  const running=nLive>0;
  const idle=!disabled && !running && !inWindow(j);
  const pillCls=disabled?"off":(idle?"idle":"on");
  const pillTxt=disabled?"disabled":(idle?"idle":"enabled");
  const pillTip=idle?' title="Outside its active window — no runs until the window reopens"':"";
  // Cards are draggable so a group can be put in the order the work runs in.
  // The drag handle is the whole card; buttons and inputs still work normally.
  return '<div class="card" draggable="true" data-job-id="'+esc(j.id)+'">'
    +'<h2><span class="jobname" title="Drag to reorder within the project">'+I.bot+esc(j.id)+'</span>'
    +'<span class="pill '+pillCls+'"'+pillTip+'>'+pillTxt+'</span></h2>'
    // Disabling stops FUTURE runs; one already in flight keeps going. Say so,
    // instead of letting "disabled" sit beside a spinning "running now…".
    +(disabled&&nLive?'<div class="warnline">'+I.alert+'Disabled — '+nLive+' run'+(nLive===1?'':'s')+' started earlier '+(nLive===1?'is':'are')+' still going. Stop '+(nLive===1?'it':'them')+' from the Runs table.</div>':"")
    +'<div class="desc">'+esc(j.description||"")+'</div>'
    +kv
    +'<div class="actions">'
    // Run now always available: several runs of a job may go at once (up to
    // max_parallel), so a live run no longer replaces this with a stop. Stopping
    // is per-run, from the Runs table — a job-wide stop would kill them all.
    +'<button class="btn primary" data-op="run" data-id="'+esc(j.id)+'">'+I.play+'Run now'
      +(nLive?' <span class="muted">('+nLive+' going)</span>':'')+'</button>'
    +'<button class="btn" data-op="'+(disabled?"enable":"disable")+'" data-id="'+esc(j.id)+'">'+I.power+(disabled?"Enable":"Disable")+'</button>'
    +'<button class="btn" data-op="edit" data-id="'+esc(j.id)+'">'+I.pencil+'Edit</button>'
    +'<button class="btn danger" data-op="delete" data-id="'+esc(j.id)+'">'+I.trash+'Delete</button>'
    +'</div></div>';
}

/* ---- drag to reorder job cards within their group ---- */
// Order lives in jobs.json (the engine rewrites only the dragged group's slots),
// so it survives reloads and is the order the tick walks the jobs in.
let _dragId=null;
function initJobDrag(){
  const host=$("jobs"); if(!host) return;
  host.addEventListener("dragstart",(e)=>{
    const c=e.target.closest(".card[data-job-id]"); if(!c) return;
    _dragId=c.dataset.jobId; c.classList.add("dragging");
    e.dataTransfer.effectAllowed="move";
    try{ e.dataTransfer.setData("text/plain", _dragId); }catch(_){}
  });
  host.addEventListener("dragend",()=>{
    _dragId=null;
    host.querySelectorAll(".dragging,.dragover").forEach(x=>x.classList.remove("dragging","dragover"));
  });
  host.addEventListener("dragover",(e)=>{
    if(!_dragId) return;
    const over=e.target.closest(".card[data-job-id]");
    const from=host.querySelector('.card[data-job-id="'+CSS.escape(_dragId)+'"]');
    // Only within the same group: reordering is per project, never across.
    if(!over || !from || over===from || over.closest(".grid")!==from.closest(".grid")) return;
    e.preventDefault(); e.dataTransfer.dropEffect="move";
    host.querySelectorAll(".dragover").forEach(x=>x.classList.remove("dragover"));
    over.classList.add("dragover");
  });
  host.addEventListener("drop",async(e)=>{
    const over=e.target.closest(".card[data-job-id]");
    const from=_dragId && host.querySelector('.card[data-job-id="'+CSS.escape(_dragId)+'"]');
    if(!over || !from || over===from || over.closest(".grid")!==from.closest(".grid")) return;
    e.preventDefault();
    const grid=over.closest(".grid");
    // Insert before or after, depending on which way the card was dragged.
    const cards=[...grid.querySelectorAll(".card[data-job-id]")];
    grid.insertBefore(from, cards.indexOf(from)<cards.indexOf(over) ? over.nextSibling : over);
    over.classList.remove("dragover");
    const order=[...grid.querySelectorAll(".card[data-job-id]")].map(c=>c.dataset.jobId);
    _dragId=null;
    const r=await fetch("/api/action",{method:"POST",
      headers:{"Content-Type":"text/plain","X-CC-Token":TOKEN},
      body:JSON.stringify({op:"reorder",order})});
    if(!r.ok){ const j=await r.json().catch(()=>({})); toast("Could not save the order — "+(j.error||("HTTP "+r.status)), true); }
    else toast("Order saved", false, "check");
    refresh();
  });
}

function collapsibleGroup(key, headerInner, cards){
  const collapsed=collapsedGroups.has(key);
  return '<div class="projgroup'+(collapsed?" collapsed":"")+'" data-group="'+esc(key)+'">'
    +'<div class="projgroup-h" data-toggle="'+esc(key)+'">'+headerInner
      +'<span class="pgh-chevron">'+I.cdown+'</span></div>'
    +'<div class="projgroup-body"><div class="pgb-inner"><div class="grid">'+cards+'</div></div></div>'
  +'</div>';
}

function renderJobs(){
  const jobs=DATA.jobs||[];
  const projects=[...new Set(jobs.map(j=>j.project||"").filter(Boolean))].sort();
  const nStandalone=jobs.filter(j=>!j.project).length;
  if(jobProjectFilter && jobProjectFilter!=="__none__" && !projects.includes(jobProjectFilter)) jobProjectFilter="";

  // chips (shown only when at least one project exists)
  if(projects.length){
    const chips=[["","All"]].concat(projects.map(p=>[p,p]));
    if(nStandalone) chips.push(["__none__","Standalone"]);
    $("projchips").innerHTML=chips.map(([v,l])=>{
      const cnt = v===""?jobs.length : v==="__none__"?nStandalone : jobs.filter(j=>j.project===v).length;
      return '<button class="projchip'+(jobProjectFilter===v?" active":"")+'" data-proj="'+esc(v)+'">'
        +(v&&v!=="__none__"?I.folder:"")+esc(l)+' <span class="chipn">'+cnt+'</span></button>';
    }).join("");
  } else { $("projchips").innerHTML=""; }

  // no projects at all → flat grid, no group chrome
  if(!projects.length){
    $("jobs").innerHTML = jobs.length ? '<div class="grid">'+jobs.map(jobCard).join("")+'</div>'
      : '<div class="card empty">'+I.inbox+'No jobs yet — create one.</div>';
    return;
  }

  const names = jobProjectFilter==="" ? projects : (jobProjectFilter==="__none__" ? [] : [jobProjectFilter]);
  const showStandalone = (jobProjectFilter===""||jobProjectFilter==="__none__") && nStandalone>0;
  let html="";
  for(const name of names){
    const js=jobs.filter(j=>j.project===name); if(!js.length) continue;
    const p=projById(name);
    const head='<span class="pgh-ic">'+I.folder+'</span><span class="pgh-name">'+esc(name)+'</span>'
      +'<span class="pgh-count">'+js.length+' job'+(js.length===1?"":"s")+'</span>'
      +(p&&p.description?'<span class="pgh-desc">'+esc(p.description)+'</span>':'')
      +'<span class="spacer"></span>'
      +'<button class="pgh-edit" data-editproj="'+esc(name)+'" title="Edit project">'+I.pencil+'</button>';
    html+=collapsibleGroup(name, head, js.map(jobCard).join(""));
  }
  if(showStandalone){
    const js=jobs.filter(j=>!j.project);
    const head='<span class="pgh-ic">'+I.folder+'</span><span class="pgh-name standalone">Standalone jobs</span>'
      +'<span class="pgh-count">'+js.length+' job'+(js.length===1?"":"s")+'</span>'
      +'<span class="spacer"></span>';
    html+=collapsibleGroup("__standalone__", head, js.map(jobCard).join(""));
  }
  $("jobs").innerHTML = html || '<div class="card empty">'+I.inbox+'No jobs in this view.</div>';
}

/* ---- projects modal ---- */
let editingProject=null;
function openProjectEditor(name){
  editingProject=name||null;
  const p=name?projById(name):null;
  $("pj-halo").innerHTML=name?I.pencil:I.plus;
  $("pj-title").textContent=name?("Edit project — "+name):"New project";
  // The name is editable when editing too: renaming carries the project's jobs
  // with it (the engine refuses a name already in use).
  $("pj-name").value=p?p.name:""; $("pj-name").disabled=false;
  $("pj-desc").value=(p&&p.description)||"";
  $("pj-cwd").value=(p&&p.cwd)||"";
  $("pj-delete").style.display=name?"":"none";
  $("projmodal").showModal();
}
async function projApi(op, extra){
  const r=await fetch("/api/action",{method:"POST",headers:{"Content-Type":"text/plain","X-CC-Token":TOKEN},
    body:JSON.stringify(Object.assign({op}, extra))});
  const j=await r.json().catch(()=>({}));
  if(!r.ok||j.ok===false){ toast(j.output||j.error||("HTTP "+r.status),true); return false; }
  return true;
}
async function saveProject(){
  const btn=$("pj-save"); btn.disabled=true;
  try{
    const name=$("pj-name").value.trim();
    if(!name){ toast("Project name is required",true); return; }
    // Rename FIRST when the name changed: the project is keyed by name, and its
    // jobs point at it by name, so both must move before anything else is saved.
    if(editingProject && name!==editingProject){
      const r=await fetch("/api/action",{method:"POST",
        headers:{"Content-Type":"text/plain","X-CC-Token":TOKEN},
        body:JSON.stringify({op:"project_rename",name:editingProject,new_name:name})});
      if(!r.ok){ const e=await r.json().catch(()=>({})); toast("Rename failed — "+(e.error||("HTTP "+r.status)), true); return; }
      editingProject=name;
      toast("Renamed project to "+name, false, "check");
    }
    const proj={name};
    const d=$("pj-desc").value.trim(); if(d) proj.description=d;
    const c=$("pj-cwd").value.trim(); if(c) proj.cwd=c;
    if(!await projApi("project_set",{project:proj})) return;
    $("projmodal").close(); toast("Saved project "+name); refresh();
  } finally { btn.disabled=false; }
}
async function deleteProjectFromModal(){
  if(!editingProject) return;
  const yes=await showConfirm({tone:"danger",icon:"trash",title:"Delete project "+editingProject+"?",
    message:"The project is removed. Its jobs keep their project label but stop inheriting its cwd/description; their runs are untouched.",
    confirmLabel:"Delete project"});
  if(!yes) return;
  if(!await projApi("project_delete",{name:editingProject})) return;
  $("projmodal").close(); toast("Deleted project "+editingProject); refresh();
}

function render(){
  const _g=DATA.generated?new Date(DATA.generated):null;
  $("updated").textContent=(_g&&!isNaN(_g))?_g.toLocaleString(undefined,{dateStyle:"medium",timeStyle:"medium"}):"";
  $("pill-launchd").innerHTML='<span class="pill '+(DATA.launchd_loaded?"on":"off")+'">'
    +(DATA.launchd_loaded?I.check+"launchd":I.xcircle+"launchd off")+'</span>';

  const today=new Date(); today.setHours(0,0,0,0);
  const t0=Math.floor(today.getTime()/1000), wk=Math.floor(Date.now()/1000)-7*86400;
  const sum=(rs,f)=>rs.reduce((a,r)=>a+(f(r)||0),0);
  const rt=DATA.runs.filter(r=>r.start>=t0), rw=DATA.runs.filter(r=>r.start>=wk);
  const nWarn=rw.filter(r=>normStatus(r.status)==="warning").length;
  const nErr =rw.filter(r=>normStatus(r.status)==="error").length;
  // The last two tiles are the ones you act on, so they filter the Runs table:
  // click to see exactly those runs, click again to clear.
  const tiles=[
    [I.activity,"b-accent",rt.length,"Runs today",""],
    [I.dollar,"b-accent",money(sum(rt,r=>r.cost)),"Spent today",""],
    [I.calendar,"b-accent",rw.length,"Runs (7d)",""],
    [I.dollar,"b-accent",money(sum(rw,r=>r.cost)),"Spent (7d)",""],
    [I.alert,"b-warn",nWarn,"Warnings (7d)","warning"],
    [I.xcircle,"b-err",nErr,"Errors (7d)","error"],
  ];
  $("stats").innerHTML=tiles.map(([icn,tone,n,l,filter])=>{
    const on=filter && RF.status===filter;
    const tip=filter
      ? (filter==="warning"
          ? "Runs that finished without failing but did not do the work — click to see them"
          : "Runs that failed — click to see them")
      : "";
    return '<div class="stat'+(filter?" clickable":"")+(on?" active":"")+'"'
      +(filter?' data-statfilter="'+filter+'" title="'+esc(tip)+'"':"")+'>'
      +'<div class="stat-top"><div class="bubble '+tone+'">'+icn+'</div><div class="n">'+esc(n)+'</div></div>'
      +'<div class="l">'+esc(l)+'</div></div>';
  }).join("");

  paintViewTabs();
  renderJobs();
  renderRuns();
  $("foot").textContent="claude-cron · control server on 127.0.0.1 · SQLite index.db ("
    +fmtBytes(DATA.db_bytes)+") holds run history & search · runs.ndjson is the append journal";
}

/* ------------------------------------------- runs: search + filters + pages */
const RF={project:"",job:"",status:"",from:"",to:""};
let pageSize=parseInt(localStorage.ccPageSize||"25",10)||25, page=1;
let searchKeys=null, snippets={}, searchSeq=0;

function activeFilterCount(){ return ["project","job","status","from","to"].filter(k=>RF[k]).length; }

// Runs happening right now. They are not in the journal yet (a record is only
// written when a run ends), so synthesize rows from the live state — that is what
// puts an in-flight run in the table, where its log can be followed live.
function liveRuns(){
  const now=Math.floor(Date.now()/1000), out=[];
  for(const [id,st] of Object.entries(DATA.state||{})){
    if(st && st.last_status==="running" && st.last_start){
      const j=(DATA.jobs||[]).find(x=>x.id===id)||{};
      out.push({id, start:st.last_start, status:"running", duration:Math.max(0,now-st.last_start),
                cost:null, session:"", project:j.project||"", live:true});
    }
  }
  return out.sort((a,b)=>b.start-a.start);
}

function filteredRuns(){
  const fromT=RF.from?Date.parse(RF.from):null, toT=RF.to?Date.parse(RF.to):null;
  // live rows first — a search narrows to indexed runs, so they drop out there
  const live=searchKeys?[]:liveRuns();
  return live.concat(DATA.runs).filter(r=>{
    if(r.live){
      if(RF.project){ const rp=r.project||""; if(RF.project==="__none__" ? rp!=="" : rp!==RF.project) return false; }
      if(RF.job && r.id!==RF.job) return false;
      if(RF.status && RF.status!=="running") return false;
      return true;
    }
    if(searchKeys && !searchKeys.has(r.id+"|"+r.start)) return false;
    if(RF.project){ const rp=r.project||""; if(RF.project==="__none__" ? rp!=="" : rp!==RF.project) return false; }
    if(RF.job && r.id!==RF.job) return false;
    if(RF.status && normStatus(r.status)!==RF.status) return false;
    const t=r.start*1000;
    if(fromT && t<fromT) return false;
    if(toT && t>toT) return false;
    return true;
  });
}

/* ---- hover tooltip (fixed bubble on <body>, so no container can clip it) ---- */
let _tipEl=null;
function tipShow(anchor, html){
  if(!_tipEl){ _tipEl=document.createElement("div"); _tipEl.id="tipbubble"; document.body.appendChild(_tipEl); }
  _tipEl.innerHTML=html; _tipEl.style.visibility="hidden"; _tipEl.classList.remove("show");
  // measure, then place above the anchor (flipping below when there's no room)
  const a=anchor.getBoundingClientRect(), b=_tipEl.getBoundingClientRect();
  let left=Math.min(Math.max(8, a.left+a.width/2-b.width/2), window.innerWidth-b.width-8);
  const above=a.top-b.height-9;
  _tipEl.style.left=left+"px";
  _tipEl.style.top=(above>8 ? above : a.bottom+9)+"px";
  _tipEl.style.visibility="visible";
  requestAnimationFrame(()=>_tipEl&&_tipEl.classList.add("show"));
}
function tipHide(){ if(_tipEl){ _tipEl.classList.remove("show"); _tipEl.style.visibility="hidden"; } }
function initTooltips(){
  document.addEventListener("mouseover",(e)=>{ const t=e.target.closest("[data-tip]"); if(t) tipShow(t, decodeURIComponent(t.dataset.tip)); });
  document.addEventListener("mouseout",(e)=>{ if(e.target.closest("[data-tip]")) tipHide(); });
  document.addEventListener("scroll",tipHide,true);
}

// "Succeeded, but nothing actually ran" — the engine puts the agent's own
// `NOTHING TO DO: <reason>` in the run's note. Returns the reason, or "".
function nothingNote(r){
  const n=(r&&r.note)||"";
  const i=n.indexOf("NOTHING TO DO:");
  return i<0 ? "" : n.slice(i+"NOTHING TO DO:".length).trim();
}

/* ---- live runs: a job may now have SEVERAL at once (one slot each) ---- */
const activeRunsOf = id => (DATA.active_runs||{})[id] || [];
// Which live slot to stop from a runs-table row. With one live run it is that
// run; with several, the row cannot tell them apart, so fall back to the first
// and let the engine's per-pid stop do the precise work.
function livePidFor(id){ const a=activeRunsOf(id); return a.length ? a[0].pid : ""; }

/* ---- resume bookkeeping: which failed run was already resumed, and into what ---- */
let resumedRuns={};
try{ resumedRuns=JSON.parse(localStorage.ccResumed||"{}"); }catch(e){ resumedRuns={}; }
const runKey=(id,start)=>id+"|"+start;
function markResumed(id,start){
  resumedRuns[runKey(id,start)]=Math.floor(Date.now()/1000);
  localStorage.ccResumed=JSON.stringify(resumedRuns);
}
// Has THIS failed run's own task already been picked back up? Resume now means
// `claude --resume <session>` — it continues that one conversation, so a later
// run of the same job is NOT a follow-up: it was a different ticket, in its own
// worktree, and this session is still sitting there unfinished. Only a run that
// actually resumed THIS session counts, which the journal records by carrying
// the same session id forward.
// Every run that CONTINUED the session `sid`, oldest first. Two signals, and
// both are needed: `--resume` makes the new run report the SAME session id (so
// a later run carrying it is a continuation — true even for runs from before
// this was tracked), and `resumed_from` records the parent explicitly, which is
// what identifies a continuation whose own session id came out different.
function continuationsOf(sid, after){
  if(!sid) return [];
  return (DATA.runs||[])
    .filter(r=>r.resumed_from===sid || (r.session===sid && r.start>after))
    .sort((a,b)=>a.start-b.start);
}
// The run this one continued, if any — the other side of the same link. The
// parent is always EARLIER: a resumed run reports the very session it resumed,
// so matching on the session alone would find the run itself.
function continuedRun(r){
  if(!r || !r.start) return null;
  const sid=r.resumed_from || r.session;
  if(!sid) return null;
  const earlier=(DATA.runs||[])
    .filter(x=>x.start<r.start && (x.session===sid || x.resumed_from===sid))
    .sort((a,b)=>b.start-a.start);
  return earlier[0]||null;
}
function resumeTarget(id, after){
  const src=(DATA.runs||[]).find(r=>r.id===id && r.start===after);
  const sid=src&&src.session;
  if(!sid) return null;
  const done=continuationsOf(sid, after);
  if(done.length) return {run:done[0], running:false};
  // A resume still in flight is not in the journal yet (a record is written
  // when a run ENDS), so ask the live slots as well.
  if(activeRunsOf(id).some(a=>a.resume_of===sid)) return {run:{id, start:after}, running:true};
  return null;
}
function resumeTip(id, start){
  const t=resumeTarget(id, start);
  if(!t) return "";
  const clickedAt=resumedRuns[runKey(id,start)];   // set only if resumed from this browser
  // Only a run that continued THIS session lands here (see resumeTarget).
  const head=clickedAt ? "Resumed into a new run" : "This task was already resumed";
  let rows=clickedAt ? '<div class="tt-row"><span class="tt-k">Resumed at</span><span class="tt-v">'+esc(fmtWhen(clickedAt))+'</span></div>' : "";
  rows+='<div class="tt-row"><span class="tt-k">New run</span><span class="tt-v">'+esc(fmtWhen(t.run.start))+'</span></div>';
  if(t.running){
    rows+='<div class="tt-row"><span class="tt-k">Session</span><span class="tt-v"><span class="runningbadge"><span class="pulse"></span>running now…</span></span></div>'
      +'<div class="tt-foot">Its session id is recorded when the run finishes.</div>';
  } else {
    const s=normStatus(t.run.status||"");
    rows+='<div class="tt-row"><span class="tt-k">Session</span><span class="tt-v"><code>'+esc((t.run.session||"—").slice(0,8))+'</code></span></div>'
      +'<div class="tt-row"><span class="tt-k">Outcome</span><span class="tt-v stat-cell s-'+esc(s)+'">'+(STATUS_ICON[s]||"")+esc(s)+'</span></div>'
      +'<div class="tt-foot">Open that row&rsquo;s log to see what it did.</div>';
  }
  return '<div class="tt-h">'+I.play+esc(head)+'</div>'+rows;
}

function renderRuns(){
  const all=filteredRuns();
  const pages=Math.max(1,Math.ceil(all.length/pageSize));
  if(page>pages) page=pages;
  const slice=all.slice((page-1)*pageSize, page*pageSize);
  $("runs").innerHTML = slice.map(r=>{
    const s=normStatus(r.status);
    const snip=searchKeys?(snippets[r.id+"|"+r.start]||""):"";
    // For a failed run: has the job run again since? (drives the disabled Resume
    // button and the "?" badge, and is true regardless of which browser resumed it)
    const followUp = s==="error" ? resumeTarget(r.id, r.start) : null;
    // A run that continued an earlier one says so, and points at it: without
    // this the two rows look unrelated, and the pair is the whole story.
    const parent = continuedRun(r);
    const resumedBadge = parent
      ? '<span class="trigger-badge resumed" data-tip="'
        +encodeURIComponent('<div class="tt-h">'+I.play+'Resumed run</div>'
          +'<div class="tt-row"><span class="tt-k">Continues</span><span class="tt-v">'+esc(fmtWhen(parent.start))+'</span></div>'
          +'<div class="tt-row"><span class="tt-k">That run</span><span class="tt-v stat-cell s-'+esc(normStatus(parent.status))+'">'
            +(STATUS_ICON[normStatus(parent.status)]||"")+esc(normStatus(parent.status))+'</span></div>'
          +'<div class="tt-row"><span class="tt-k">Session</span><span class="tt-v"><code>'+esc((parent.session||"—").slice(0,8))+'</code></span></div>'
          +'<div class="tt-foot">Same conversation, picked up where it stopped.</div>').replace(/"/g,"%22")
        +'">resumed</span>'
      : '';
    return "<tr><td class=num>"+esc(fmtWhen(r.start))
      +(r.forced?'<span class="trigger-badge">forced</span>':'')
      +resumedBadge
      +(snip?'<div class="snip" title="'+esc(snip)+'">'+esc(snip)+'</div>':'')+"</td>"
      +"<td><code>"+esc(r.id)+"</code></td>"
      +'<td>'+(r.project?'<span class="projtag">'+I.folder+esc(r.project)+'</span>':'<span class="muted">—</span>')+'</td>'
      +'<td>'+(r.live
          ? '<span class="runningbadge"><span class="pulse"></span>running…</span>'
          : '<span class="stat-cell s-'+esc(s)+'">'+(STATUS_ICON[s]||"")+esc(s)+"</span>"
            +((s==="error" && followUp)
               ? '<span class="tipbadge" data-tip="'+encodeURIComponent(resumeTip(r.id,r.start)).replace(/"/g,"%22")+'">?</span>'
               // A run can end fine having done nothing at all — a resumed task
               // already finished, or its ticket is gone. That is recorded as a
               // WARNING, and the reason is shown here, so a clean-looking run is
               // never mistaken for work that happened.
               : (nothingNote(r)
                  ? '<span class="tipbadge" data-tip="'+encodeURIComponent("Nothing was done in this run — "+nothingNote(r)).replace(/"/g,"%22")+'">?</span>'
                  : "")))
      +"</td>"
      +"<td class=num>"+esc(fmtDur(r.duration))+(r.live?' <span class="muted">so far</span>':"")+"</td>"
      +"<td class=num>"+(r.live?'<span class="muted">—</span>':esc(money(r.cost)))+"</td>"
      +"<td><code>"+esc((r.session||"").slice(0,8)||"—")+"</code></td>"
      +'<td class="rowacts">'
        +'<button class="iconbtn'+(r.live?' live':'')+'" title="'+(r.live?"Follow this run live":"View log")+'"'
          +' data-log-id="'+esc(r.id)+'" data-log-start="'+esc(r.start)+'">'+I.eye+'</button>'
        // A failed run is worth retrying — offer it right where the failure shows.
        // Reuses the Run-now op, so it inherits the precheck guard and toasts.
        // Always rendered (disabled when not applicable) so every row's icons
        // line up in the same columns.
        // Disabled once the job has run again (resumed here or anywhere) — a
        // second resume would just duplicate work. The "?" says where it went.
        // STOP and RESUME are BOTH always rendered, each enabled only when it
        // applies, so every row's icons line up in the same columns and the
        // controls are findable even on rows where they are not usable.
        // Stop ends THIS run (by its pid); resume continues THIS run's own
        // session — the same task, picked back up, exactly like
        // `claude --resume <session>` — never a fresh run of the job.
        +(r.live
           ? '<button class="iconbtn danger" title="Stop this run"'
             +' data-op="stop" data-id="'+esc(r.id)+'" data-run-pid="'+esc(livePidFor(r.id))+'">'+I.power+'</button>'
           : '<button class="iconbtn" disabled title="This run has already finished — only a running run can be stopped">'+I.power+'</button>')
        +(r.live
           ? '<button class="iconbtn retry" disabled title="This run is still going">'+I.play+'</button>'
           : s==="error"
             ? (!r.session
                ? '<button class="iconbtn retry" disabled title="This run recorded no session id, so it cannot be resumed">'+I.play+'</button>'
                : followUp
                  ? '<button class="iconbtn retry" disabled title="'
                    +(followUp.running?"A newer run is in progress":"This task was already resumed")
                    +' — see the ? beside the status">'+I.play+'</button>'
                  : '<button class="iconbtn retry" title="Resume this task — continue session '
                    +esc((r.session||"").slice(0,8))+' where it stopped"'
                    +' data-op="resume" data-id="'+esc(r.id)+'" data-session="'+esc(r.session||"")+'"'
                    +' data-resume-key="'+esc(runKey(r.id,r.start))+'">'+I.play+'</button>')
             : '<button class="iconbtn retry" disabled title="Only failed runs can be resumed">'+I.play+'</button>')
        // Erase this run for good: its log files, its journal line and its rows
        // in the search database. Never offered while it is still running.
        +(r.live
           ? '<button class="iconbtn" disabled title="A running run cannot be deleted — stop it first">'+I.trash+'</button>'
           : '<button class="iconbtn danger" title="Delete this run and everything it left behind"'
             +' data-del-id="'+esc(r.id)+'" data-del-start="'+esc(r.start)+'">'+I.trash+'</button>')
      +'</td></tr>';
  }).join("") || '<tr><td colspan=8 class="empty">'+I.inbox
      +(DATA.runs.length?(searchKeys?"No runs match this search.":"No runs match the filters."):"No runs recorded yet.")+'</td></tr>';
  $("pg-info").textContent="Page "+page+" / "+pages+" · "+all.length+" run"+(all.length===1?"":"s")
    +(searchKeys?" · searching logs":"");
  $("pg-prev").disabled = page<=1;
  $("pg-next").disabled = page>=pages;
  const n=activeFilterCount();
  $("f-toggle").innerHTML=I.filter+"Filters "+(n?'<span class="fbadge">'+n+"</span>":"")+I.cdown;
  const ids=[...new Set(DATA.runs.map(r=>r.id))].sort(), sig=ids.join("|"), sel=$("f-job");
  if(sel.dataset.sig!==sig){
    const cur=sel.value;
    sel.innerHTML='<option value="">All jobs</option>'+ids.map(i=>'<option>'+esc(i)+'</option>').join("");
    sel.value=cur; sel.dataset.sig=sig;
  }
  const projs=[...new Set(DATA.runs.map(r=>r.project||"").filter(Boolean))].sort();
  const psig=projs.join("|"), psel=$("f-project");
  if(psel.dataset.sig!==psig){
    const cur=psel.value;
    psel.innerHTML='<option value="">All projects</option>'+projs.map(p=>'<option>'+esc(p)+'</option>').join("")
      +(DATA.runs.some(r=>!r.project)?'<option value="__none__">No project</option>':"");
    psel.value=cur; psel.dataset.sig=psig;
  }
}

async function runSearch(q){
  const seq=++searchSeq;
  if(!q || q.trim().length<2){ searchKeys=null; snippets={}; renderRuns(); return; }
  try{
    const r=await fetch("/api/search?q="+encodeURIComponent(q.trim()), {headers:{"X-CC-Token":TOKEN}});
    if(!r.ok) throw new Error("HTTP "+r.status);
    const j=await r.json();
    if(seq!==searchSeq) return;            // a newer query superseded this one
    searchKeys=new Set(); snippets={};
    (j.results||[]).forEach(x=>{ const k=x.id+"|"+x.start; searchKeys.add(k); if(x.snippet) snippets[k]=x.snippet; });
    page=1; renderRuns();
  }catch(e){ if(seq===searchSeq) toast("Search failed — "+e.message, true); }
}

/* ---------------------------------------------------------------- editor */
const DEFAULT_PRECHECK="#!/bin/bash\n# Exit 0 to wake a Claude run; exit 1 to stay idle (a skipped tick costs nothing).\n# Put a cheap check here — curl an API, grep a log, test a file.\nexit 0\n";

function getDays(){
  return [...document.querySelectorAll("#ed-days-pick .day-btn.on")].map(b=>+b.dataset.day);
}
function setDays(arr){
  const on=new Set((arr&&arr.length?arr:[]).map(Number));
  document.querySelectorAll("#ed-days-pick .day-btn").forEach(b=>b.classList.toggle("on", on.has(+b.dataset.day)));
}
function fmtBudget(){ const el=$("ed-budget"), v=parseFloat(el.value.replace(/[^0-9.]/g,""));
  el.value=isNaN(v)?"":v.toFixed(2); }


/* Markdown highlighting for the prompt editor.
   Every character of the source is preserved — marks are only wrapped in spans,
   never removed or rewritten — so the highlight layer lines up character for
   character with the textarea above it and the saved prompt is byte-identical
   to what was typed. */
function mdHighlight(src){
  const out=[]; let fenced=false;
  for(const line of String(src).replace(/\r/g,"").split("\n")){
    if(/^\s*```/.test(line)){ fenced=!fenced; out.push('<span class="fence">'+esc(line)+'</span>'); continue; }
    if(fenced){ out.push('<span class="c">'+esc(line)+'</span>'); continue; }
    if(/^\s*#{1,6}\s/.test(line)){ out.push('<span class="h">'+esc(line)+'</span>'); continue; }
    let html=esc(line);
    // inline code first, so ** inside backticks is not treated as bold
    html=html.replace(/(`[^`]+`)/g, '<span class="c">$1</span>');
    html=html.replace(/(\*\*[^*]+\*\*)/g, '<span class="b">$1</span>');
    html=html.replace(/(^\s*)([-*])(\s)/, '$1<span class="bullet">$2</span>$3');
    html=html.replace(/(^\s*)(\d+\.)(\s)/, '$1<span class="mark">$2</span>$3');
    out.push(html);
  }
  return out.join("\n");
}

function paintPromptHighlight(){
  const ta=$("ed-prompt"), hl=$("ed-prompt-hl");
  if(!ta||!hl) return;
  hl.innerHTML=mdHighlight(ta.value||"");
  hl.scrollTop=ta.scrollTop; hl.scrollLeft=ta.scrollLeft;
}

/* A job in a project INHERITS that project's working directory — it must not be
   editable there, or the two would silently disagree. With no project the job
   owns its own cwd and the picker is available. */
function syncCwdField(projectName){
  const inp=$("ed-cwd"), btn=document.querySelector('.cwd-browse'), note=$("ed-cwd-note");
  if(!inp||!note) return;
  const p = projectName ? projById(projectName) : null;
  const inherited = p && p.cwd ? p.cwd : "";
  if(inherited){
    inp.value = inherited;
    inp.disabled = true;
    inp.removeAttribute("data-cwd-target");     // clicking must not open the picker
    if(btn) btn.disabled = true;
    note.textContent = "Inherited from the project “" + projectName + "”. Change it there, "
      + "or clear the project above to give this job its own directory.";
    note.hidden = false;
  }else{
    inp.disabled = false;
    inp.setAttribute("data-cwd-target","ed-cwd");
    if(btn) btn.disabled = false;
    note.hidden = true; note.textContent = "";
  }
}

function initPromptEditor(){
  const ta=$("ed-prompt"), hl=$("ed-prompt-hl");
  if(!ta||!hl) return;                        // never let this take the page down
  const sync=()=>{ hl.scrollTop=ta.scrollTop; hl.scrollLeft=ta.scrollLeft; };
  ta.addEventListener("input", paintPromptHighlight);
  ta.addEventListener("scroll", sync);
  // typing near the bottom scrolls the textarea without firing "scroll" first
  ta.addEventListener("keyup", sync);
  ta.addEventListener("click", sync);
}

/* ---- reusable searchable combobox (project select, model select) ---- */
function createCombo(cfg){
  // cfg: {id, allowNone, noneLabel, def, withIcon, onPick}
  // DOM: <id>-combo wrapper, -trigger, -val, -pop, -search, -opts; hidden input #<id>.
  const st={opts:[], val:"", active:0};
  const g=(s)=>$(cfg.id+"-"+s), hid=()=>$(cfg.id);
  const norm=(o)=>(typeof o==="string")?{v:o,label:o}:o;
  function items(q){
    const raw=(q||"").trim();
    q=raw.toLowerCase();
    const out=[];
    if(cfg.allowNone) out.push({v:"",label:cfg.noneLabel||"— None —",none:true});
    for(const o of st.opts){ if(!q||o.label.toLowerCase().includes(q)||o.v.toLowerCase().includes(q)) out.push(o); }
    // Let an id the list doesn't know be entered by hand — a model can exist in
    // the API before the installed CLI lists it (claude-opus-5 did exactly that).
    if(cfg.allowCustom && raw && !st.opts.some(o=>o.v.toLowerCase()===q)){
      out.push({v:raw, label:'Use "'+raw+'"', custom:true});
    }
    return out;
  }
  function labelFor(v){ const o=st.opts.find(x=>x.v===v); return o?o.label:v; }
  function renderTrigger(){
    const e=g("val");
    if(st.val){ e.textContent=labelFor(st.val); e.classList.remove("none"); }
    else { e.textContent=cfg.noneLabel||"— None —"; e.classList.add("none"); }
  }
  function renderList(q){
    const its=items(q), ul=g("opts");
    if(!its.length){ ul.innerHTML='<div class="combo-empty">No match</div>'; return; }
    if(st.active>its.length-1) st.active=its.length-1;
    if(st.active<0) st.active=0;
    ul.innerHTML=its.map((it,i)=>'<li role="option" data-v="'+esc(it.v)+'" class="'
      +(it.none?"none ":"")+(it.v===st.val?"sel ":"")+(i===st.active?"active":"")+'">'
      +((cfg.withIcon&&!it.none)?I.folder:"")+esc(it.label)+'</li>').join("");
    const a=ul.querySelector("li.active"); if(a) a.scrollIntoView({block:"nearest"});
  }
  function positionPop(){
    // fixed positioning so the popover escapes the dialog body's overflow clip
    // (an absolute popover near the bottom gets cut off). Anchor to the trigger
    // WITHOUT measuring the popover height (that was unreliable after the width
    // change): drop down from the trigger bottom, or — when there's more room
    // above — anchor the popover's bottom just above the trigger via `bottom`.
    const pop=g("pop"), t=g("trigger").getBoundingClientRect(), vh=window.innerHeight;
    pop.style.position="fixed"; pop.style.left=t.left+"px"; pop.style.width=t.width+"px"; pop.style.right="auto";
    if((vh-t.bottom)>=t.top){ pop.style.top=(t.bottom+4)+"px"; pop.style.bottom="auto"; }
    else { pop.style.bottom=(vh-t.top+4)+"px"; pop.style.top="auto"; }
  }
  function reposition(){ if(g("combo").classList.contains("open")) positionPop(); }
  function open(){
    g("combo").classList.add("open"); g("pop").hidden=false;
    g("trigger").setAttribute("aria-expanded","true"); g("search").value="";
    const its=items(""); st.active=Math.max(0, its.findIndex(it=>it.v===st.val));
    renderList(""); positionPop(); g("search").focus({preventScroll:true});
    // Re-anchor the fixed popover on any scroll or viewport change while open
    // (scroll/resize fire even in a background tab, unlike rAF); the timeouts
    // catch the layout settling right after open.
    setTimeout(reposition,0); setTimeout(reposition,120);
    window.addEventListener("scroll", reposition, true);
    window.addEventListener("resize", reposition);
  }
  function close(){ const c=g("combo"); if(!c) return; c.classList.remove("open");
    window.removeEventListener("scroll", reposition, true);
    window.removeEventListener("resize", reposition);
    const pop=g("pop"); pop.hidden=true;
    pop.style.position=""; pop.style.left=""; pop.style.top=""; pop.style.bottom=""; pop.style.width=""; pop.style.right="";
    g("trigger").setAttribute("aria-expanded","false"); }
  function pick(v){ st.val=v||""; hid().value=st.val; renderTrigger(); close(); if(cfg.onPick) cfg.onPick(st.val); }
  function set(val, options){
    if(options) st.opts=options.map(norm);
    let v=val||"";
    if(!v && cfg.allowNone===false) v=cfg.def||(st.opts[0]&&st.opts[0].v)||"";
    st.val=v; hid().value=v; renderTrigger(); close();
  }
  const caret=g("combo").querySelector(".combo-caret"); if(caret) caret.innerHTML=I.cdown;
  g("trigger").addEventListener("click",()=>{ g("combo").classList.contains("open")?close():open(); });
  g("search").addEventListener("input",()=>{ st.active=0; renderList(g("search").value); });
  g("search").addEventListener("keydown",(e)=>{
    const its=items(g("search").value);
    if(e.key==="ArrowDown"){ e.preventDefault(); st.active=Math.min(st.active+1,its.length-1); renderList(g("search").value); }
    else if(e.key==="ArrowUp"){ e.preventDefault(); st.active=Math.max(st.active-1,0); renderList(g("search").value); }
    else if(e.key==="Enter"){ e.preventDefault(); const it=its[st.active]; if(it) pick(it.v); }
    else if(e.key==="Escape"){ e.preventDefault(); close(); g("trigger").focus(); }
  });
  g("opts").addEventListener("click",(e)=>{ const li=e.target.closest("li[data-v]"); if(li) pick(li.dataset.v); });
  document.addEventListener("click",(e)=>{ if(g("combo").classList.contains("open") && !e.target.closest("#"+cfg.id+"-combo")) close(); });
  return {set, get:()=>st.val};
}

// You pick a FAMILY, never a version: the engine resolves it to that family's
// newest model at run time (config/models.json, refreshed by `resolve-models`).
// The label shows what it currently resolves to, so the choice stays honest.
// Exact model ids only — each job states precisely which model it runs.
let MODELS=[];
async function loadModels(){
  try{
    const r=await fetch("/api/models",{headers:{"X-CC-Token":TOKEN}});
    if(!r.ok) return;
    const d=await r.json();
    if(!d.models||!d.models.length) return;
    MODELS=d.models.map(m=>({v:m, label:m}));
    if(modelCombo) modelCombo.set(modelCombo.get(), MODELS);
  }catch(e){ /* keep the built-in fallback list */ }
}

// Effort: slider position ↔ CLI value. 0 leaves it unset (the CLI decides).
// slider stops, in order; labels come from the shared EFFORT_LABELS map
const EFFORTS=["","low","medium","high","xhigh","max"];
function setEffort(v){
  const i=Math.max(0, EFFORTS.indexOf(v||""));
  $("ed-effort").value=String(i);
  $("ed-effort-label").textContent=(EFFORTS[i]===""?"Default (CLI decides)":effortLabel(EFFORTS[i]));
}
function getEffort(){ return EFFORTS[+$("ed-effort").value||0]; }
const PERMS=[
  {v:"dontAsk",label:"dontAsk — run tools without prompting"},
  {v:"bypassPermissions",label:"bypassPermissions — full autonomy (headless default)"},
  {v:"acceptEdits",label:"acceptEdits"},
  {v:"auto",label:"auto"},
  {v:"plan",label:"plan"},
  {v:"manual",label:"manual"},
];
let projectCombo=null, modelCombo=null, permCombo=null;
function initCombos(){
  projectCombo=createCombo({id:"ed-project", allowNone:true, noneLabel:"— None —", withIcon:true,
    onPick:(v)=>syncCwdField(v)});
  modelCombo=createCombo({id:"ed-model", allowNone:false, def:"opus"});
  modelCombo.set("opus", MODELS);
  loadModels();
  permCombo=createCombo({id:"ed-perm", allowNone:false, def:"dontAsk"});
  permCombo.set("dontAsk", PERMS);
}

/* ---- system folder picker (backend lists dirs; browser can't expose abs paths) ---- */
let _fsTarget=null, _fsPath="";
async function fsLoad(path){
  try{
    const r=await fetch("/api/fs"+(path?("?path="+encodeURIComponent(path)):""),{headers:{"X-CC-Token":TOKEN}});
    if(!r.ok){ toast("Cannot read that folder"); return; }
    const d=await r.json();
    _fsPath=d.path; $("fs-path").textContent=d.path;
    let html="";
    if(d.parent) html+='<li class="fs-up" data-path="'+esc(d.parent)+'">'+I.folder+'‹ parent folder</li>';
    for(const dir of d.dirs) html+='<li data-path="'+esc(dir.path)+'">'+I.folder+esc(dir.name)+'</li>';
    if(!d.dirs.length) html+='<li class="fs-empty">No sub-folders here</li>';
    $("fs-list").innerHTML=html; $("fs-list").scrollTop=0;
  }catch(e){ toast("Folder picker error"); }
}
async function fsOpen(targetId){
  _fsTarget=targetId;
  const cur=($(targetId).value||"").trim();
  await fsLoad(cur||null);
  $("fsmodal").showModal();
}
function initFolderPicker(){
  $("fs-halo").innerHTML=I.folder;
  $("fs-list").addEventListener("click",(e)=>{ const li=e.target.closest("li[data-path]"); if(li) fsLoad(li.dataset.path); });
  $("fs-cancel").addEventListener("click",()=>$("fsmodal").close());
  $("fs-use").addEventListener("click",()=>{ if(_fsTarget) $(_fsTarget).value=_fsPath; $("fsmodal").close(); });
  document.addEventListener("click",(e)=>{ const b=e.target.closest("[data-cwd-target]"); if(b) fsOpen(b.dataset.cwdTarget); });
}

function fill(j){
  // project combobox (searchable select of existing projects, or None)
  const projs=[...new Set((DATA.projects||[]).map(p=>p.name).concat((DATA.jobs||[]).map(x=>x.project||"")).filter(Boolean))].sort();
  projectCombo.set(j.project||"", projs);
  $("ed-desc").value=j.description||"";
  $("ed-cwd").value=j.cwd||"";
  syncCwdField(j.project||"");
  $("ed-prompt").value=j.prompt||"";
  paintPromptHighlight();
  $("ed-precheck").value=j._precheck||"";
  $("ed-interval").value=Math.round((j.interval_seconds||300)/60);
  modelCombo.set(j.model||"opus");
  setEffort(j.effort||"");
  $("ed-interactive").checked = j.interactive===true;
  const hp=String(j.active_hours||"").split("-");
  $("ed-hours-start").value=hp[0]||""; $("ed-hours-end").value=hp[1]||"";
  setDays(j.active_days||[]);
  $("ed-budget").value=(j.max_budget_usd!=null?j.max_budget_usd:2).toFixed(2);
  $("ed-daily").value=(j.daily_budget_usd!=null?Number(j.daily_budget_usd).toFixed(2):"");
  // Both optional: empty means "no hard limit" / "no stall guard".
  $("ed-timeout").value=j.timeout_seconds?Math.max(1,Math.round(j.timeout_seconds/60)):"";
  $("ed-stall").value=j.stall_timeout_seconds?Math.max(1,Math.round(j.stall_timeout_seconds/60)):"";
  permCombo.set(j.permission_mode||"dontAsk");
}

function openEditor(id){
  const j=(DATA.jobs||[]).find(x=>x.id===id); if(!j) return;
  editingId=id; creating=false;
  $("ed-halo").innerHTML=I.pencil;
  $("ed-title").textContent="Edit — "+id;
  // The id is editable here too: renaming carries the job's state, logs and
  // history with it (the engine refuses a bad or taken id, and refuses while a
  // run is live).
  $("ed-id-row").style.display="";
  $("ed-id").value=id;
  fill(j);
  $("ed-save").textContent="Save changes";
  $("editor").showModal();
}

function openCreator(){
  editingId=null; creating=true;
  $("ed-halo").innerHTML=I.plus;
  $("ed-title").textContent="New job";
  $("ed-id-row").style.display="";
  $("ed-id").value="";
  fill({_precheck:DEFAULT_PRECHECK, interval_seconds:300, model:"opus",
        active_hours:"08:00-20:00", active_days:[1,2,3,4,5],
        max_budget_usd:2, stall_timeout_seconds:1200, permission_mode:"dontAsk"});
  $("ed-save").textContent="Create job";
  $("editor").showModal();
}

function readForm(){
  const hs=$("ed-hours-start").value, he=$("ed-hours-end").value;
  if((hs && !he) || (!hs && he)){ toast("Active hours: fill both times, or neither for 24h", true); return null; }
  const days=getDays();
  if(!days.length){ toast("Pick at least one active day", true); return null; }
  const dailyRaw=$("ed-daily").value.trim().replace(/[^0-9.]/g,"");
  return {
    secs: Math.max(60,(parseInt($("ed-interval").value,10)||5)*60),
    model: $("ed-model").value||"opus",
    effort: getEffort(),
    interactive: $("ed-interactive").checked,
    hours: hs && he ? hs+"-"+he : "",
    days,
    budget: (parseFloat($("ed-budget").value.replace(/[^0-9.]/g,""))||2),
    daily: dailyRaw==="" ? null : parseFloat(dailyRaw),   // null = no cap
    // Both optional; null = leave unset (no hard limit / no stall guard).
    timeoutSecs: $("ed-timeout").value.trim()==="" ? null : Math.max(60,(parseInt($("ed-timeout").value,10)||30)*60),
    stallSecs: $("ed-stall").value.trim()==="" ? null : Math.max(60,(parseInt($("ed-stall").value,10)||20)*60),
  };
}

async function saveEditor(){
  const btn=$("ed-save"); btn.disabled=true;
  try{
    const f=readForm(); if(!f) return;
    if(creating){
      const id=$("ed-id").value.trim();
      if(!/^[A-Za-z0-9_-]+$/.test(id)){ toast("id: only letters, digits, - and _",true); return; }
      const prompt=$("ed-prompt").value.trim();
      if(!prompt){ toast("prompt is required",true); return; }
      const job={id, description:$("ed-desc").value.trim(), prompt, interval_seconds:f.secs,
        model:f.model, active_hours:f.hours, active_days:f.days, max_budget_usd:f.budget,
        permission_mode:$("ed-perm").value};
      if(f.effort) job.effort=f.effort;
      if(f.interactive) job.interactive=true;
      if(f.timeoutSecs!=null) job.timeout_seconds=f.timeoutSecs;
      if(f.stallSecs!=null) job.stall_timeout_seconds=f.stallSecs;
      if(f.daily!=null) job.daily_budget_usd=f.daily;
      const proj=$("ed-project").value.trim(); if(proj) job.project=proj;
      // an inherited directory belongs to the project, never to the job
      const cwd=$("ed-cwd").disabled ? "" : $("ed-cwd").value.trim();
      if(cwd) job.cwd=cwd;
      if(!await api("create",{id, job, precheck:$("ed-precheck").value})) return;
      $("editor").close(); toast("Created "+id); refresh(); return;
    }
    let id=editingId; const j=(DATA.jobs||[]).find(x=>x.id===id)||{};
    // Rename FIRST — every call below is keyed by the id, so they must target
    // the new one. The engine validates the id and moves state/logs/history.
    const wantId=$("ed-id").value.trim();
    if(wantId && wantId!==id){
      if(!/^[A-Za-z0-9_-]+$/.test(wantId)){ toast("id: only letters, digits, - and _",true); return; }
      const r=await fetch("/api/action",{method:"POST",
        headers:{"Content-Type":"text/plain","X-CC-Token":TOKEN},
        body:JSON.stringify({op:"rename",id,new_id:wantId})});
      if(!r.ok){ const e=await r.json().catch(()=>({})); toast("Rename failed — "+(e.error||("HTTP "+r.status)), true); return; }
      id=wantId; editingId=wantId;
      toast("Renamed to "+wantId, false, "check");
    }
    const setF=async(field,value,cur)=> String(value)===String(cur) ? true : api("set_field",{id,field,value:String(value)});
    const prompt=$("ed-prompt").value.trim();
    if(prompt && prompt!==(j.prompt||"")){ if(!await api("set_prompt",{id,prompt})) return; }
    const pc=$("ed-precheck").value;
    if(pc.trim() && pc!==(j._precheck||"")){ if(!await api("set_precheck",{id,script:pc})) return; }
    if(!await setF("interval_seconds",f.secs,j.interval_seconds||300)) return;
    if(!await setF("model",f.model,j.model||"opus")) return;
    if(!await setF("effort",f.effort,j.effort||"")) return;
    if(!await setF("interactive",String(f.interactive),String(j.interactive===true))) return;
    if(!await setF("active_hours",f.hours,j.active_hours||"")) return;
    if(!await setF("active_days",f.days.join(","),(j.active_days||[]).join(","))) return;
    if(!await setF("max_budget_usd",f.budget,(j.max_budget_usd!=null?j.max_budget_usd:2))) return;
    const curDaily=(j.daily_budget_usd!=null?+j.daily_budget_usd:null);
    if(f.daily!==curDaily){ if(!await api("set_field",{id,field:"daily_budget_usd",value:(f.daily==null?"":String(f.daily))})) return; }
    const curTo=(j.timeout_seconds!=null?+j.timeout_seconds:null);
    if(f.timeoutSecs!==curTo){ if(!await api("set_field",{id,field:"timeout_seconds",value:(f.timeoutSecs==null?"":String(f.timeoutSecs))})) return; }
    const curStall=(j.stall_timeout_seconds!=null?+j.stall_timeout_seconds:null);
    if(f.stallSecs!==curStall){ if(!await api("set_field",{id,field:"stall_timeout_seconds",value:(f.stallSecs==null?"":String(f.stallSecs))})) return; }
    if(!await setF("project",$("ed-project").value.trim(),j.project||"")) return;
    if(!await setF("description",$("ed-desc").value.trim(),j.description||"")) return;
    const cwdVal = $("ed-cwd").disabled ? "" : $("ed-cwd").value.trim();
    if(!await setF("cwd",cwdVal,j.cwd||"")) return;
    if(!await setF("permission_mode",$("ed-perm").value,j.permission_mode||"dontAsk")) return;
    $("editor").close(); toast("Saved "+id); refresh();
  } finally { btn.disabled=false; }
}

/* ---------------------------------------------------------------- log modal */
// Minimal, safe Markdown -> HTML. Input is HTML-escaped FIRST, then a small set
// of block/inline rules are applied, so nothing the agent wrote can inject HTML.
// Links are limited to http(s)/mailto.
function mdInline(s){
  const codes=[];
  s=s.replace(/`([^`]+)`/g,(m,c)=>{ codes.push(c); return "@@CC"+(codes.length-1)+"@@"; });
  s=s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g,(m,t,u)=>
    /^(https?:\/\/|mailto:)/i.test(u) ? '<a href="'+u+'" target="_blank" rel="noopener noreferrer">'+t+'</a>' : m);
  s=s.replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>').replace(/__([^_]+)__/g,'<strong>$1</strong>');
  s=s.replace(/(^|[^*])\*(?!\s)([^*\n]+?)\*/g,'$1<em>$2</em>');
  s=s.replace(/@@CC(\d+)@@/g,(m,i)=>'<code>'+codes[+i]+'</code>');
  return s;
}
function mdToHtml(src){
  const lines=esc(src).replace(/\r/g,"").split("\n");
  let html="", inCode=false, codeBuf=[], para=[], list=null;
  const flushPara=()=>{ if(para.length){ html+='<p>'+mdInline(para.join(" "))+'</p>'; para=[]; } };
  const flushList=()=>{ if(list){ html+='<ul>'+list.map(x=>'<li>'+mdInline(x)+'</li>').join("")+'</ul>'; list=null; } };
  for(const line of lines){
    if(/^\s*```/.test(line)){
      if(inCode){ html+='<pre class="log">'+codeBuf.join("\n")+'</pre>'; codeBuf=[]; inCode=false; }
      else { flushPara(); flushList(); inCode=true; }
      continue;
    }
    if(inCode){ codeBuf.push(line); continue; }
    const hd=line.match(/^(#{1,4})\s+(.*)$/);
    if(hd){ flushPara(); flushList(); html+='<div class="md-h">'+mdInline(hd[2])+'</div>'; continue; }
    const li=line.match(/^\s*[-*]\s+(.*)$/);
    if(li){ flushPara(); (list=list||[]).push(li[1]); continue; }
    if(line.trim()===""){ flushPara(); flushList(); continue; }
    flushList(); para.push(line.trim());
  }
  if(inCode) html+='<pre class="log">'+codeBuf.join("\n")+'</pre>';
  flushPara(); flushList();
  return html || '<span class="muted">—</span>';
}

function statusPill(s){ const n=normStatus(s); return '<span class="stat-cell s-'+esc(n)+'">'+(STATUS_ICON[n]||"")+esc(n)+'</span>'; }

function renderLog(d){
  const rec=d.record||{}, a=d.agent||{};
  const rows=[
    ["When", esc(fmtWhen(rec.start))],
    ["Status", statusPill(rec.status)],
    ["Trigger", rec.forced ? "Run now (forced)" : "scheduled — precheck passed"],
    ["Duration", esc(fmtDur(rec.duration||0))],
    ["Cost", esc(money(rec.cost))],
    // The job stores an alias ("opus"); model_id is what it actually resolved to
    // on the day of the run, so history stays truthful after a model ships.
    // Older runs predate the alias being recorded — then show the resolved id
    // alone (derived from the stored stream), which is the fact that matters.
    ["Model", (rec.model && rec.model_id) ? esc(rec.model)+' <span class="muted">→ '+esc(rec.model_id)+'</span>'
      : (rec.model_id ? esc(rec.model_id)
      : (rec.model ? esc(rec.model)+' <span class="muted">(resolved id not recorded)</span>' : "—"))],
    ["Session", esc(a.session||rec.session||"—")],
    ["Stop reason", esc(a.stop_reason||"—")],
  ];
  // While the run is live, say so and state the refresh cadence, so a still
  // screen reads as "nothing new yet" rather than "this page is stale".
  // It renders in the dialog header (right-aligned), not in the body.
  $("lg-live").innerHTML = d.live
    ? '<span class="livedot"></span><span class="livetxt">live</span>'
      +'<span class="muted">refreshing every '+Math.round(LOG_POLL_MS/1000)+'s</span>'
    : "";
  const meta='<dl class="kv loginfo">'+rows.map(x=>'<dt>'+x[0]+'</dt><dd>'+x[1]+'</dd>').join("")+'</dl>';

  const turns=d.turns||[];
  const timelinePane = turns.length
    ? '<ol class="timeline">'+turns.map(t=>{
        let line='<li><span class="tn">T'+t.n+'</span>';
        (t.tools||[]).forEach(x=>{ line+='<span class="tool">'+esc(x.tool)+'</span>';
          if(x.hint) line+='<span class="thint">'+esc(x.hint)+'</span> '; });
        if(t.text) line+='<span class="ttext">'+esc(t.text)+'</span>';
        return line+'</li>'; }).join("")+'</ol>'
    : '<div class="muted">No per-turn trace for this run (it pre-dates stream capture).</div>';

  const answerPane = a.result ? '<div class="md">'+mdToHtml(a.result)+'</div>'
                              : '<div class="muted">No agent output recorded.</div>';
  const precheckPane = d.precheck ? '<pre class="log">'+esc(d.precheck)+'</pre>'
                                  : '<div class="muted">No precheck output recorded.</div>';

  // tabs: Answer (default), Timeline, Precheck, and Blocked/stderr when present
  // Terminal: the run as a conversation, and — while it is live and the job is
  // interactive — a prompt box that delivers what you type into that same run.
  const convo = d.conversation||[];
  const termRows = convo.map(t=>{
    const you = t.role==="user";
    let line = "";
    // _tool_line yields {tool, hint} — stringifying it printed "[object Object]"
    (t.tools||[]).forEach(x=>{
      const nm = (x && x.tool) ? x.tool : String(x||"tool");
      const hint = (x && x.hint) ? x.hint : "";
      line += '<span class="t-tool">⏺ <b>'+esc(nm)+'</b>'+(hint?' '+esc(hint):'')+'</span>\n';
    });
    if(t.text) line += '<span class="t-'+(you?"you":"agent")+'">'
      + (you ? "&gt; " : "") + esc(t.text) + '</span>';
    return line ? '<div class="row">'+line+'</div>' : "";
  }).join("");
  const termPane = '<div class="termwrap">'
    + '<div class="term" id="term-body">'
    +   (termRows || '<span class="t-sys">Waiting for the first turn…</span>')
    +   (d.live?'<div class="row"><span class="t-sys">▍</span></div>':'')
    + '</div>'
    + (d.live && d.interactive
        ? '<div class="termbar"><span class="caret">&gt;</span>'
          + '<input id="term-input" placeholder="Say something to this run…" autocomplete="off">'
          + '<span class="hint">Enter</span>'
          + '<button type="button" class="btn primary" id="term-send">'+I.play+'Send</button></div>'
        : (d.live
            ? '<div class="termnote">This run is read-only — turn on <b>Interactive</b> on the job to talk to it while it works.</div>'
            : '<div class="termnote">This run has finished. Reopen it in the real CLI with <code>claude --resume '
              + esc(a.session||rec.session||"") + '</code></div>'))
    + '</div>';

  const tabs=[
    {id:"terminal", icon:I.terminal, label:"Terminal",            pane:termPane},
    {id:"answer",   icon:I.file,     label:"Answer",             pane:answerPane},
    {id:"timeline", icon:I.terminal, label:"Timeline ("+turns.length+")", pane:timelinePane},
    {id:"precheck", icon:I.radar,    label:"Precheck",           pane:precheckPane},
  ];
  const den=a.permission_denials;
  if(Array.isArray(den) && den.length){
    tabs.push({id:"blocked", icon:I.shield, label:"Blocked ("+den.length+")",
      pane:'<ul class="denials">'+den.map(x=>'<li><code>'+esc((x&&(x.tool_name||x.tool))||JSON.stringify(x))+'</code></li>').join("")+'</ul>'});
  }
  if(d.stderr && d.stderr.trim()){
    tabs.push({id:"stderr", icon:I.alert, label:"stderr", pane:'<pre class="log">'+esc(d.stderr)+'</pre>'});
  }
  if(d.error) tabs.push({id:"note", icon:I.alert, label:"Note", pane:'<div class="muted">'+esc(d.error)+'</div>'});

  const bar='<div class="tabs" role="tablist">'+tabs.map((t,i)=>
    '<button class="tab'+(i===0?" active":"")+'" data-tab="'+t.id+'">'+t.icon+t.label+'</button>').join("")+'</div>';
  const panes='<div class="tabpanes">'+tabs.map((t,i)=>
    '<div class="tabpane'+(i===0?" active":"")+'" data-pane="'+t.id+'">'+t.pane+'</div>').join("")+'</div>';

  return meta+bar+panes;
}

/* A live run's log keeps refreshing while the modal is open. Re-rendering must
   not fight the reader: the open tab is restored, and the pane only jumps to the
   newest line when the reader was already at the bottom (classic tail).       */
const LOG_POLL_MS=3000;
let logPoll=null, logCtx=null;
function stopLogPoll(){ if(logPoll){ clearInterval(logPoll); logPoll=null; } logCtx=null; }

async function sendToRun(){
  const inp=$("term-input"); if(!inp) return;
  const text=inp.value.trim(); if(!text || !logCtx) return;
  inp.value=""; inp.disabled=true;
  try{
    const r=await fetch("/api/action",{method:"POST",
      headers:{"Content-Type":"text/plain","X-CC-Token":TOKEN},
      body:JSON.stringify({op:"say", id:logCtx.id, text})});
    if(!r.ok){
      const j=await r.json().catch(()=>({}));
      toast("Not delivered — "+(j.error||("HTTP "+r.status)), true, "alert");
      inp.value=text;                       // give the message back, do not lose it
    }
  }catch(e){ toast("Not delivered — "+e.message, true); inp.value=text; }
  inp.disabled=false; inp.focus();
}

function paintLog(d){
  const body=$("lg-body");
  // Keep whatever is half-typed (and the caret) across the 3s live refresh.
  const oldInp=$("term-input");
  const draft = oldInp ? oldInp.value : null;
  const hadFocus = oldInp && document.activeElement===oldInp;
  const oldTerm=body.querySelector(".term");
  // Terminal scrolling, the way a terminal behaves: follow new output only while
  // the reader is already at the bottom. Scrolled up to read history? Then keep
  // exactly where they were — new lines are appended below, so the same
  // scrollTop shows the same text. (Restoring nothing is what made it jump to
  // the top on every 3s refresh.)
  const termAtBottom = oldTerm ? (oldTerm.scrollHeight-oldTerm.scrollTop-oldTerm.clientHeight < 40) : true;
  const termTop = oldTerm ? oldTerm.scrollTop : 0;
  const prevTab=body.querySelector(".tab.active")?.dataset.tab || null;
  const panes=body.querySelector(".tabpanes");
  const wasAtBottom = panes ? (panes.scrollHeight - panes.scrollTop - panes.clientHeight < 40) : true;
  const prevTop = panes ? panes.scrollTop : 0;
  body.innerHTML=renderLog(d);
  if(prevTab){
    const t=body.querySelector('.tab[data-tab="'+prevTab+'"]');
    if(t){
      body.querySelectorAll(".tab").forEach(x=>x.classList.toggle("active", x===t));
      body.querySelectorAll(".tabpane").forEach(p=>p.classList.toggle("active", p.dataset.pane===prevTab));
    }
  }
  const np=body.querySelector(".tabpanes");
  if(np) np.scrollTop = wasAtBottom ? np.scrollHeight : prevTop;
  syncTermMode(body);
  const inp=$("term-input");
  if(inp){
    if(draft!==null) inp.value=draft;
    if(hadFocus) inp.focus();
    inp.onkeydown=(e)=>{ if(e.key==="Enter"){ e.preventDefault(); sendToRun(); } };
    const sb=$("term-send"); if(sb) sb.onclick=()=>sendToRun();
  }
  const term=body.querySelector(".term");
  if(term) term.scrollTop = termAtBottom ? term.scrollHeight : termTop;
  // stop polling once the run is no longer live (this render is the final one)
  if(logPoll && !d.live) stopLogPoll();
}

async function fetchLog(id, start){
  const r=await fetch("/api/log?id="+encodeURIComponent(id)+"&start="+encodeURIComponent(start), {headers:{"X-CC-Token":TOKEN}});
  if(!r.ok) throw new Error("HTTP "+r.status);
  return r.json();
}

async function openLog(id, start){
  stopLogPoll();
  $("lg-halo").innerHTML=I.file;
  $("lg-title").textContent="Run — "+id;
  $("lg-body").innerHTML="<div class='empty'>Loading…</div>";
  $("logmodal").showModal();
  try{
    const d=await fetchLog(id, start);
    paintLog(d);
    if(d.live){
      logCtx={id, start};
      logPoll=setInterval(async ()=>{
        if(!$("logmodal").open){ stopLogPoll(); return; }
        try{ paintLog(await fetchLog(logCtx.id, logCtx.start)); }
        catch(e){ /* transient — keep polling */ }
      }, LOG_POLL_MS);
    }
  }catch(e){ $("lg-body").innerHTML="<div class='empty'>Could not load log — "+esc(e.message)+"</div>"; }
}

// The page must not scroll while a modal is open. Driven by observing the
// dialogs' `open` attribute rather than by patching every call site, so it holds
// no matter who opens or closes one (buttons, Esc, backdrop, code).
function syncModalScrollLock(){
  const anyOpen=[...document.querySelectorAll("dialog")].some(d=>d.open);
  document.documentElement.classList.toggle("modal-open", anyOpen);
}
function initModalScrollLock(){
  const obs=new MutationObserver(syncModalScrollLock);
  document.querySelectorAll("dialog").forEach(d=>{
    obs.observe(d,{attributes:true, attributeFilter:["open"]});
    d.addEventListener("close", syncModalScrollLock);
  });
  syncModalScrollLock();
}

/* Jobs / Runs as top-level views. The choice is remembered, and the counters are
   refreshed with the data so switching tabs is never needed just to see numbers. */
let currentView = localStorage.ccView === "runs" ? "runs" : "jobs";
function setView(v){
  currentView = (v === "runs") ? "runs" : "jobs";
  localStorage.ccView = currentView;
  $("view-jobs").hidden = currentView !== "jobs";
  $("view-runs").hidden = currentView !== "runs";
  document.querySelectorAll(".viewtab").forEach(b =>
    b.classList.toggle("active", b.dataset.view === currentView));
}
function paintViewTabs(){
  const jobs = (DATA.jobs || []).length;
  // Count what the table can actually show: the journal PLUS the runs in flight,
  // which are synthesized (a record is only journaled when a run ends). Using
  // DATA.runs alone made the tab read 43 while the pager said 45.
  const live = liveRuns().length;
  const runs = (DATA.runs || []).length + live;
  $("vt-jobs").innerHTML = I.zap + "Jobs" + '<span class="vcount">' + jobs + "</span>"
    + (live ? '<span class="runningbadge"><span class="pulse"></span>' + live + "</span>" : "");
  $("vt-runs").innerHTML = I.activity + "Runs" + '<span class="vcount">' + runs + "</span>";
}
function initViews(){
  document.querySelectorAll(".viewtab").forEach(b =>
    b.addEventListener("click", () => setView(b.dataset.view)));
  setView(currentView);
}
// The warning and error tiles are a way IN to the runs they count: click one to
// show exactly those runs, click it again to clear the filter.
function initStatFilters(){
  const host=$("stats"); if(!host) return;
  host.addEventListener("click",(e)=>{
    const t=e.target.closest("[data-statfilter]"); if(!t) return;
    const want=t.dataset.statfilter;
    RF.status = (RF.status===want) ? "" : want;
    const sel=$("f-status"); if(sel) sel.value=RF.status;
    page=1;
    setView("runs");
    render();          // redraws the tiles (so the active one is highlighted) and the table
  });
}

/* ---------------------------------------------------------------- events */
document.addEventListener("click", async (e)=>{
  const step=e.target.closest(".step-btn");
  if(step){
    const inp=$(step.dataset.for), min=parseInt(inp.min,10)||1;
    inp.value=Math.max(min,(parseInt(inp.value,10)||min)+parseInt(step.dataset.step,10));
    return;
  }
  const day=e.target.closest(".day-btn");
  if(day){ day.classList.toggle("on"); return; }
  const lg=e.target.closest("button[data-log-id]");
  if(lg){ openLog(lg.dataset.logId, lg.dataset.logStart); return; }
  // delete one run, for good — files, journal line and search index alike
  const del=e.target.closest("button[data-del-id]");
  if(del){
    const id=del.dataset.delId, start=+del.dataset.delStart;
    (async()=>{
      const yes=await showConfirm({tone:"danger", icon:"trash", title:"Delete this run?",
        message:"Everything this run left behind goes: its log and transcript files, its line in the journal, and its rows in the search database. This cannot be undone.",
        mono:id+" · "+fmtWhen(start), confirmLabel:"Delete run"});
      if(!yes) return;
      del.disabled=true;
      const r=await fetch("/api/action",{method:"POST",
        headers:{"Content-Type":"text/plain","X-CC-Token":TOKEN},
        body:JSON.stringify({op:"run_delete",id,start})});
      if(!r.ok){ const j=await r.json().catch(()=>({})); toast("Delete failed — "+(j.error||("HTTP "+r.status)), true); del.disabled=false; return; }
      toast("Run deleted", false, "trash");
      refresh();
    })();
    return;
  }
  // project editing (must run before the group toggle, since it's inside the header)
  const edp=e.target.closest("[data-editproj]");
  if(edp){ openProjectEditor(edp.dataset.editproj); return; }
  // collapse/expand a project group (animated via CSS; persisted in localStorage)
  const tog=e.target.closest("[data-toggle]");
  if(tog){
    const g=tog.closest(".projgroup"), key=tog.dataset.toggle;
    g.classList.toggle("collapsed");
    if(g.classList.contains("collapsed")) collapsedGroups.add(key); else collapsedGroups.delete(key);
    localStorage.ccCollapsed=JSON.stringify([...collapsedGroups]);
    return;
  }
  if(e.target.closest("#new-project")){ openProjectEditor(); return; }
  if(e.target.closest("#new-job")){ openCreator(); return; }
  const b=e.target.closest("button[data-op]"); if(!b) return;
  const op=b.dataset.op, id=b.dataset.id;
  if(op==="edit"){ openEditor(id); return; }
  if(op==="delete"){
    const yes=await showConfirm({tone:"danger", icon:"trash", title:"Delete job "+id+"?",
      message:"This removes the job from jobs.json. Its logs and precheck script are kept on disk.",
      confirmLabel:"Delete job"});
    if(!yes) return;
  }
  b.disabled=true;
  if(op==="run"){
    // Guard: forcing bypasses the precheck, so probe it first and warn when
    // it reports nothing to do — a forced idle run still costs a session.
    toast("Checking precheck…", false, "radar");
    try{
      const r=await fetch("/api/action",{method:"POST",
        headers:{"Content-Type":"text/plain","X-CC-Token":TOKEN},
        body:JSON.stringify({op:"precheck",id})});
      const j=await r.json().catch(()=>({}));
      if(r.ok && j.ok && j.work===false){
        const yes=await showConfirm({tone:"warn", icon:"alert", title:"Nothing to do right now",
          message:"The precheck reports no pending work. Run now bypasses the precheck — a forced run will still spend a full agent session.",
          mono:(j.output||""), confirmLabel:"Run anyway"});
        if(!yes){ b.disabled=false; return; }
      }
    }catch(err){ /* probe failed — fall through, the run itself will tell */ }
  }
  // "Run now" is refused with 409 while a run is in flight — report that plainly
  // instead of the old blanket "Started".
  if(op==="run"){
    const r=await fetch("/api/action",{method:"POST",
      headers:{"Content-Type":"text/plain","X-CC-Token":TOKEN},
      body:JSON.stringify({op:"run",id})});
    if(r.status===409){
      toast("Not started — a run is already in progress for "+id, true, "alert");
      b.disabled=false; refresh(); return;
    }
    if(!r.ok){ const j=await r.json().catch(()=>({})); toast("Failed — "+(j.error||("HTTP "+r.status)), true); b.disabled=false; return; }
    toast("Started "+id, false, "play");
    setTimeout(refresh, 1200); b.disabled=false; return;
  }
  // Resume continues THAT run's own session (the same task), so it carries the
  // session id. Stop from a runs row targets that one run by its pid — with
  // concurrent runs a job-wide stop would kill the others too.
  if(op==="resume"){
    const sid=b.dataset.session||"";
    b.disabled=true;   // stays down: one resume per session, and no double-click
    const r=await fetch("/api/action",{method:"POST",
      headers:{"Content-Type":"text/plain","X-CC-Token":TOKEN},
      body:JSON.stringify({op:"resume",id,session:sid})});
    if(r.status===409){
      toast("Not resumed — this job is already at its parallel-run limit", true, "alert");
      b.disabled=false; refresh(); return;
    }
    if(!r.ok){ const j=await r.json().catch(()=>({})); toast("Resume failed — "+(j.error||("HTTP "+r.status)), true); b.disabled=false; return; }
    if(b.dataset.resumeKey){ const [rid,rstart]=b.dataset.resumeKey.split("|"); markResumed(rid, +rstart); }
    toast("Resuming "+id+" — continuing session "+sid.slice(0,8), false, "play");
    setTimeout(refresh, 1200); b.disabled=true; return;
  }
  const extra={id};
  if(op==="stop" && b.dataset.runPid) extra.pid=b.dataset.runPid;
  const ok=await api(op,extra);
  if(ok) toast((op==="run"?"Started ":op+"d ")+id, false, op==="run"?"play":"check");
  setTimeout(refresh, op==="run"?1200:250);
  b.disabled=!!(ok && b.dataset.resumeKey);   // a used resume button stays disabled
});

$("pj-cancel").addEventListener("click", ()=>$("projmodal").close());
$("pj-save").addEventListener("click", saveProject);
$("pj-delete").addEventListener("click", deleteProjectFromModal);
initCombos();
initFolderPicker();
initTooltips();
initJobDrag();
initStatFilters();
initModalScrollLock();
initPromptEditor();
$("ed-cancel").addEventListener("click", ()=>$("editor").close());
$("ed-save").addEventListener("click", saveEditor);
$("ed-effort").addEventListener("input", ()=>setEffort(getEffort()));
$("ed-budget").addEventListener("blur", fmtBudget);
["ed-budget","ed-daily"].forEach(id=>$(id).addEventListener("input", ()=>{
  const el=$(id); el.value=el.value.replace(/[^0-9.]/g,"").replace(/(\..*)\./g,"$1");
}));
$("ed-daily").addEventListener("blur", ()=>{ const el=$("ed-daily"), v=el.value.trim();
  if(v!=="") el.value=(parseFloat(v.replace(/[^0-9.]/g,""))||0).toFixed(2); });
$("lg-close").addEventListener("click", ()=>$("logmodal").close());
// close covers Esc and the backdrop too, so stop the live tail from one place
$("logmodal").addEventListener("close", stopLogPoll);
// tab switching inside the log modal (delegated; #lg-body persists across opens)
$("lg-body").addEventListener("click",(e)=>{
  const t=e.target.closest(".tab"); if(!t) return;
  const id=t.dataset.tab, body=$("lg-body");
  body.querySelectorAll(".tab").forEach(x=>x.classList.toggle("active", x===t));
  body.querySelectorAll(".tabpane").forEach(p=>p.classList.toggle("active", p.dataset.pane===id));
  syncTermMode(body);
  const panes=body.querySelector(".tabpanes");
  if(id!=="terminal") panes.scrollTop=0;
  const term=body.querySelector(".term");
  if(term) term.scrollTop=term.scrollHeight;
  const inp=$("term-input"); if(inp && id==="terminal") inp.focus();
});

// The terminal owns its own scrolling: the transcript scrolls, the prompt bar
// does not. Any other tab keeps the normal single scroll area.
function syncTermMode(body){
  const panes=body.querySelector(".tabpanes"); if(!panes) return;
  const active=body.querySelector(".tabpane.active");
  panes.classList.toggle("termmode", !!active && active.dataset.pane==="terminal");
}
$("themebtn").addEventListener("click", ()=>{
  const t=(document.documentElement.dataset.theme==="dark")?"light":"dark";
  localStorage.ccTheme=t; applyTheme(t);
});
$("f-toggle").addEventListener("click", ()=>{ $("fpanel").hidden=!$("fpanel").hidden; });
["f-project","f-job","f-status","f-from","f-to"].forEach(id=>$(id).addEventListener("change",()=>{
  RF.project=$("f-project").value; RF.job=$("f-job").value; RF.status=$("f-status").value;
  RF.from=$("f-from").value; RF.to=$("f-to").value;
  page=1; renderRuns();
}));
$("f-size").addEventListener("change",()=>{
  pageSize=parseInt($("f-size").value,10)||25;
  localStorage.ccPageSize=pageSize; page=1; renderRuns();
});
$("f-clear").addEventListener("click",()=>{
  RF.project=RF.job=RF.status=RF.from=RF.to="";
  ["f-project","f-job","f-status","f-from","f-to"].forEach(i=>$(i).value="");
  page=1; renderRuns();
});
// project chips filter the Jobs section (grouping)
$("projchips").addEventListener("click",(e)=>{
  const c=e.target.closest(".projchip"); if(!c) return;
  jobProjectFilter=c.dataset.proj; renderJobs();
});
$("pg-prev").addEventListener("click",()=>{ page--; renderRuns(); });
$("pg-next").addEventListener("click",()=>{ page++; renderRuns(); });
let _qTimer=null;
$("q").addEventListener("input",()=>{
  const v=$("q").value;
  $("q-clear").hidden=!v;
  clearTimeout(_qTimer); _qTimer=setTimeout(()=>runSearch(v), 350);
});
$("q-clear").addEventListener("click",()=>{
  $("q").value=""; $("q-clear").hidden=true; runSearch("");
});

/* ---------------------------------------------------------------- boot */
$("brandmark").innerHTML=I.bot;
initViews();
$("h-jobs").innerHTML=I.zap+"Jobs";
$("h-runs").innerHTML=I.activity+"Recent runs";
$("new-job").innerHTML=I.plus+"New job";
$("new-project").innerHTML=I.folder+"New project";
$("f-toggle").innerHTML=I.filter+"Filters "+I.cdown;
$("f-clear").innerHTML=I.x+"Clear filters";
$("pg-prev").innerHTML=I.cleft+"Prev";
$("pg-next").innerHTML="Next"+I.cright;
$("q-clear").innerHTML=I.x;
$("searchbox").insertAdjacentHTML("afterbegin", I.search);
$("f-size").value=String(pageSize);

refresh();
setInterval(refresh, 5000);
</script>
</body></html>"""


def render_page() -> str:
    return (PAGE.replace("__TOKEN__", TOKEN)
                .replace("__BUILD__", BUILD)
                .replace("__FAVICON__", FAVICON))


def main():
    httpd = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    sys.stderr.write(f"claude-cron control server on http://127.0.0.1:{PORT}/\n")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
