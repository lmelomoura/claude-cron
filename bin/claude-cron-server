/* The prompt editor renders its own Markdown. A highlight layer sits exactly
   under a transparent textarea: you keep native editing, selection, caret and
   scrolling, and the bytes handed to the agent are still literally what you
   typed. Both layers MUST share font, size, line-height, padding and border —
   any difference and the text drifts out of register. Monospace makes bold safe
   (same advance width), which is why headings can be bold without shifting. */
.mdedit{position:relative;min-height:170px;height:230px;resize:vertical;overflow:hidden;
  border:1px solid var(--line);border-radius:8px;background:var(--panel2)}
.mdedit:focus-within{border-color:var(--accent)}
.mdedit > .mdedit-hl,
.mdedit > textarea{position:absolute;inset:0;margin:0;width:100%;height:100%;
  padding:9px 11px;border:0;border-radius:8px;background:transparent;
  font:13px/1.5 ui-monospace,"SF Mono",Menlo,monospace;
  /* a textarea wraps with overflow-wrap only; `word-break: break-word` makes a
     <pre> break in different places and the two layers drift apart mid-text */
  white-space:pre-wrap;overflow-wrap:break-word;word-break:normal;
  overflow-y:auto;overscroll-behavior:contain}
/* The textarea's scrollbar steals ~15px of text width, so it wraps earlier than
   the layer would. Reserving the same gutter here keeps both wrapping at the
   very same column — without it the two drift apart a few lines in. */
.mdedit > .mdedit-hl{pointer-events:none;overflow-y:hidden;scrollbar-gutter:stable;color:var(--ink)}
.mdedit > textarea{color:transparent;caret-color:var(--accent);resize:none;min-height:0}
.mdedit > textarea::selection{background:color-mix(in srgb,var(--accent) 30%,transparent)}
.mdedit > textarea:focus{outline:none}
