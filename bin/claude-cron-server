/* Tall modals: fixed header + footer, scrollable middle. The [open] guard is
   essential — a bare `display:flex` would override the UA's
   `dialog:not([open]){display:none}` and the modal would never hide (Close
   would appear to do nothing). The log modal takes a fixed default size and
   scrolls its content; the editor grows with its form up to the viewport. */
#editor[open],#logmodal[open]{display:flex;flex-direction:column}
#logmodal[open]{height:min(90vh,860px)}
#editor[open]{max-height:92vh}
#editor{max-width:min(880px,94vw);width:880px}
/* the <form> is the dialog's only flex child — it must itself be the scroll
   column, or the body never scrolls and the footer overflows below the modal */
#editor>form{display:flex;flex-direction:column;min-height:0;flex:1 1 auto;overflow:hidden}
#logmodal{max-width:min(1000px,95vw);width:1000px}
#confirm{max-width:min(460px,92vw);width:460px}
