#!/usr/bin/env python3
"""agentloop control server — authenticated, localhost-only UI in front of
the `agentloop` CLI. It never reimplements job logic: every mutation shells
out to `agentloop` so the bash engine stays the single source of truth.

Storage model:
  * files are the source of truth — the bash engine appends runs.ndjson and
    writes per-run logs under data/logs/<id>/;
  * data/index.db (SQLite, WAL) is a DERIVED search index the server keeps in
    sync incrementally; full-text search (FTS5, LIKE fallback) covers run
    results, per-turn streams and precheck output. Deleting the .db is safe —
    it rebuilds on the next search.

Security model (single-user machine):
  * binds 127.0.0.1 only — never reachable from the network;
  * every /api/* call requires the shared token in the X-CC-Token header;
  * cross-origin requests are rejected (Origin allowlist) and the custom
    header forces a CORS preflight we deliberately do not satisfy — so a
    malicious page in the browser cannot drive the agent (anti-CSRF);
  * the token lives in config/control.token (chmod 600) and is embedded only
    in the same-origin HTML the server itself serves.
"""

import base64
import calendar
import hashlib
import json
import os
import re
import secrets
import sqlite3
import subprocess
import sys
import threading
import time
from http.cookies import CookieError, SimpleCookie
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse, parse_qs

HOME = Path.home()
# Self-contained: config/ and data/ sit next to this file's bin/ directory
# (resolve() follows the ~/.local/bin symlink to the real project folder).
BASE_DIR = Path(__file__).resolve().parent.parent
BIN_DIR = Path(__file__).resolve().parent
CONFIG_DIR = Path(os.environ.get("CLAUDE_CRON_CONFIG", BASE_DIR / "config"))
DATA_DIR = Path(os.environ.get("CLAUDE_CRON_DATA", BASE_DIR / "data"))
JOBS_FILE = CONFIG_DIR / "jobs.json"
PROJECTS_FILE = CONFIG_DIR / "projects.json"
STATE_FILE = DATA_DIR / "state.json"
RUNS_FILE = DATA_DIR / "runs.ndjson"
TOKEN_FILE = CONFIG_DIR / "control.token"
DB_FILE = DATA_DIR / "index.db"
AGENTLOOP = str(BIN_DIR / "agentloop")
# Built from ui/ by build/build-ui.sh and COMMITTED. Installing agentloop
# needs jq, python3 and curl; Node is a developer dependency and never a
# runtime one, which only works if the output ships in git.
STATIC_DIR = BIN_DIR / "static"
STATIC_TYPES = {".js": "application/javascript; charset=utf-8",
                ".css": "text/css; charset=utf-8"}


def static_asset(name):
    """One flat directory, one segment, known extensions. No traversal, no
    subdirectories, nothing clever -- a static route is not the place to be
    clever.

    The name arrives exactly as it came off the wire, undecoded: decoding is
    what turns `..%2F` into a directory to climb, and there is nothing in this
    directory whose name needs it.

    Everything past the extension check runs inside the try, including
    `is_file()`: a pathologically long name makes stat() raise OSError
    (ENAMETOOLONG is not one of the errnos pathlib swallows on its own), and a
    file that is there but not valid UTF-8 makes `read_text()` raise
    UnicodeDecodeError -- a ValueError. Either one used to be a crash this
    route had no answer for instead of a plain miss.
    """
    if "/" in name or "\\" in name or name.startswith(".") or ".." in name:
        return None, None
    path = STATIC_DIR / name
    ctype = STATIC_TYPES.get(path.suffix)
    if not ctype:
        return None, None
    try:
        # Resolved and re-anchored under STATIC_DIR: a symlink sitting in the
        # directory (x.js -> /etc/passwd) would otherwise be followed and
        # handed back with whatever Content-Type its own extension claims.
        # Requiring the resolved parent to still be the resolved STATIC_DIR
        # keeps this route inside the one directory it was ever meant to read.
        if path.resolve().parent != STATIC_DIR.resolve() or not path.is_file():
            return None, None
        return path.read_text(), ctype
    except (OSError, ValueError):
        return None, None

PORT = int(os.environ.get("CLAUDE_CRON_PORT", "8787"))
PLIST_LABEL = "com.agentloop.tick"
SERVER_LABEL = "com.agentloop.server"
# WORKTREE_SESSION_TTL, not SESSION_TTL: this module already has a SESSION_TTL,
# and it is the HTTP sign-in idle timeout (12h). Two module-level assignments of
# one name do not collide loudly — the later one silently wins at import, and
# the dashboard would have counted every kept directory down against an auth
# constant that has nothing to do with the sweep. Kept in step with the engine's
# own default (bin/worktree-lib.sh, wt_prune_orphans): the dashboard must never
# promise a directory more time than the sweep will give it.
WORKTREE_SESSION_TTL = int(os.environ.get("CLAUDE_CRON_SESSION_TTL") or 86400)

CONFIG_DIR.mkdir(parents=True, exist_ok=True)
DATA_DIR.mkdir(parents=True, exist_ok=True)


def get_token() -> str:
    if TOKEN_FILE.exists():
        return TOKEN_FILE.read_text().strip()
    tok = secrets.token_urlsafe(32)
    TOKEN_FILE.write_text(tok)
    TOKEN_FILE.chmod(0o600)
    return tok


TOKEN = get_token()
ALLOWED_ORIGINS = {f"http://127.0.0.1:{PORT}", f"http://localhost:{PORT}"}
# Identifies the CODE a page is running, so an open tab can tell that the server
# has moved on and reload itself once — no manual refresh after an upgrade.
#
# Derived from the CONTENT of the files it serves, not from the start time. A
# timestamp answers "when did the server restart", which is the wrong question
# twice over: restarting without changing anything forced every open tab to
# reload, and — the case that actually bit — editing the page while a tab held
# the old JavaScript in memory looked identical to nothing having happened,
# because the 5s poll refreshes DATA and never the code.
#
# And RECOMPUTED lazily (current_build_id, below) rather than fixed at import:
# this id used to be assigned once, to a module-level BUILD, when the process
# first started, which answered "what does this SERVER know about" rather than
# "what is on DISK right now" -- two different things the moment `git pull`
# touches this tree under a server that is still running (a KeepAlive launchd
# agent restarts only on a crash). Every page load after that pull kept
# stamping `?v=` with the OLD id, so a browser kept serving the stale cached
# bundle against markup that had just changed underneath it — dead listeners,
# broken layout, fixed only by finding and restarting the process by hand.
# `current_build_id()` re-stats the identical set every request and only pays
# for a real re-hash when that stat has actually moved, so a plain reload is
# now enough: see that function's own comment.
def _build_sources():
    """Every file `_build_id` hashes, and the exact set `current_build_id`'s
    own cheap stat check has to watch -- one list, not two kept in step by
    hand, so a file added to either job is a file the other sees for free.

    Everything this directory is ALLOWED to serve, not a second list of
    extensions kept in step by hand. The page asks for each asset with
    `?v=<this id>`, so a servable file the id cannot see is a file an open
    tab keeps out of cache forever. This globbed "*.js" while the Security
    bundle was the only asset; the stylesheet that joined it in the same
    directory would have been invisible."""
    served = sorted(p for p in STATIC_DIR.iterdir()
                    if p.suffix in STATIC_TYPES) if STATIC_DIR.is_dir() else []
    # The bundles too, not just the page: the Security area's JavaScript moved
    # out of dashboard.html, and a build id derived from the page alone would
    # have stopped changing when that code changed -- which is the whole job of
    # this id. An open tab would keep last week's bundle and never learn, and
    # the `?v=` on the script tag would keep asking for the same cached URL.
    return (PAGE_FILE, Path(__file__), *served)


def _build_id() -> str:
    h = hashlib.sha256()
    for f in _build_sources():
        try:
            h.update(f.read_bytes())
        except OSError:
            # Unreadable is a state of its own: fall back to the mtime rather
            # than to a constant, so a page served from a broken read is never
            # mistaken for one that matches.
            h.update(str(getattr(f, "stat", lambda: None)).encode())
    return h.hexdigest()[:12]


def _build_stat():
    """A cheap fingerprint of `_build_sources()`: (path, mtime_ns, size) per
    file, stat()-only -- no content read, so this is a handful of syscalls
    even for a directory of bundles.

    NEVER the id itself, and never will be: mtime alone lies across a fresh
    clone (git does not record it, and a checkout writes every path in index
    order, so the sources are ALWAYS newer than a bundle built from them --
    this repository already learned that the hard way once, see build/
    ui-digest.sh's own comment on exactly this). It is only the trigger that
    decides whether `current_build_id` below is worth paying for a real
    content hash this request, never a substitute for one."""
    stat = []
    for f in _build_sources():
        try:
            st = f.stat()
            stat.append((str(f), st.st_mtime_ns, st.st_size))
        except OSError:
            stat.append((str(f), None, None))
    return tuple(stat)


_build_cache = {"stat": None, "id": None}


def current_build_id() -> str:
    """The id `render_page` and `/api/data` actually serve: `_build_id()`'s
    same content hash, but recomputed only when `_build_stat()` says
    something in `_build_sources()` moved since the last call -- see the
    comment above `_build_id` for the bug this replaces (an id fixed at
    import, oblivious to a `git pull` landing under a running server).

    A handful of stat() calls run on EVERY call, cheap enough to afford once
    per page load; the sha256 over full file contents -- the real work --
    only runs again once the stat map has actually changed, so an unpulled,
    unedited install pays for that hash exactly once, still, no matter how
    many pages it serves."""
    stat = _build_stat()
    if stat != _build_cache["stat"]:
        _build_cache["id"] = _build_id()
        _build_cache["stat"] = stat
    return _build_cache["id"]


# current_build_id's cache is primed once PAGE_FILE is known (see below), the
# same point the id used to be assigned to a module-level BUILD once and for
# all -- keeping that one eager call preserves the fail-fast property a
# broken read had before (the server refuses to start rather than serving a
# first page that discovers the problem), while every call after this one
# re-checks and re-hashes on its own, per current_build_id's own comment.

_SELF_FILE = Path(__file__).resolve()
_SELF_DIGEST = hashlib.sha256(_SELF_FILE.read_bytes()).hexdigest()


def code_is_stale() -> bool:
    """Has this file changed on disk since the running process loaded it?

    The page is re-read per request but the Python is not, so `git pull` leaves a
    new dashboard talking to old code — and the two then disagree about what the
    API offers. Not theoretical: the profile setup screen shipped, appeared
    immediately, and posted an op the running server had never heard of, which
    came back as `bad id`.
    """
    try:
        return hashlib.sha256(_SELF_FILE.read_bytes()).hexdigest() != _SELF_DIGEST
    except OSError:
        return False

