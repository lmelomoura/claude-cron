    '<rect x="7.5" y="13" width="17" height="12" rx="3"/>'
    '<circle cx="16" cy="7.5" r="1.7"/><path d="M16 9.2v3.8"/>'
    '<path d="M12 19h.01"/><path d="M20 19h.01"/></g></svg>'
)
FAVICON = "data:image/svg+xml;base64," + base64.b64encode(_FAVICON_SVG.encode()).decode()


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


# ------------------------------------------------------------- operator profile
# Who is running this install: one person, name, email, avatar and a password.
#
# It lives in its own SQLite file rather than in index.db, which the module
# docstring promises is derived and safe to delete — an account that a
# documented-harmless `rm index.db` would destroy is a trap. And not in config/
# either: that directory is hand-edited JSON, and a password hash is not
# something to leave lying in a file somebody opens to change a cron window.

APP_DB_FILE = DATA_DIR / "app.db"
PBKDF2_ROUNDS = 600_000          # OWASP's floor for PBKDF2-HMAC-SHA256
MIN_PASSWORD = 8
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")


def app_conn():
    conn = sqlite3.connect(str(APP_DB_FILE), timeout=5)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    # CHECK (id = 1) is the single-user rule, enforced by the schema instead of
    # by every caller remembering it. There is no user management to build.
    conn.execute("""CREATE TABLE IF NOT EXISTS operator (
        id INTEGER PRIMARY KEY CHECK (id = 1),
        name TEXT NOT NULL, email TEXT NOT NULL, avatar TEXT NOT NULL DEFAULT '',
        password TEXT NOT NULL, created INTEGER NOT NULL, updated INTEGER NOT NULL)""")
    # `expires` NULL is the whole "keep me logged in" feature: a session with no
    # expiry. The cookie holds the raw token, the table only its hash — reading
    # this file must not hand anyone a live session.
    conn.execute("""CREATE TABLE IF NOT EXISTS session (
        token_hash TEXT PRIMARY KEY, created INTEGER NOT NULL,
        seen INTEGER NOT NULL, expires INTEGER)""")
    # Operator preferences — which projects are starred, and whatever the UI
    # needs to remember next. Here rather than in localStorage because they
    # belong to the person, not to a browser profile: favourites that vanish in
    # a different browser read as data loss, not as a cache miss.
    conn.execute("""CREATE TABLE IF NOT EXISTS prefs (
        key TEXT PRIMARY KEY, value TEXT NOT NULL, updated INTEGER NOT NULL)""")
    return conn


def hash_password(pw: str) -> str:
    salt = secrets.token_bytes(16)
    dk = hashlib.pbkdf2_hmac("sha256", pw.encode("utf-8"), salt, PBKDF2_ROUNDS)
    return "pbkdf2_sha256${}${}${}".format(
        PBKDF2_ROUNDS, base64.b64encode(salt).decode(), base64.b64encode(dk).decode())


def verify_password(pw: str, stored: str) -> bool:
    try:
        algo, rounds, salt_b64, hash_b64 = stored.split("$", 3)
        if algo != "pbkdf2_sha256":
            return False
        dk = hashlib.pbkdf2_hmac("sha256", pw.encode("utf-8"),
                                 base64.b64decode(salt_b64), int(rounds))
    except Exception:  # noqa: BLE001 — a malformed row is a failed check, not a crash
        return False
    return secrets.compare_digest(dk, base64.b64decode(hash_b64))


def _operator_row():
    try:
        conn = app_conn()
    except sqlite3.Error:
        return None
    try:
        return conn.execute("SELECT * FROM operator WHERE id=1").fetchone()
    finally:
        conn.close()


def operator_stamp() -> str:
    """Fingerprint of everything /api/config carries out of app.db.

    The profile and the preferences both ride on that payload, and the page only
    re-fetches it when this moves — without them, starring a project would not
    reach the page until something unrelated edited jobs.json.

    Derived from the CONTENT, not from an `updated` second. Two preference
    writes inside the same second are ordinary — starring two projects in a row
    does it — and a second-resolution stamp does not move between them, so the
    page would keep serving the first state.
    """
    h = hashlib.md5()
    row = _operator_row()
    h.update(b"-" if row is None else
             json.dumps([row["name"], row["email"], row["avatar"], row["updated"]]).encode())
    try:
        conn = app_conn()
        try:
            for r in conn.execute("SELECT key, value FROM prefs ORDER BY key"):
                h.update(("\x00" + r["key"] + "\x00" + r["value"]).encode())
        finally:
            conn.close()
    except sqlite3.Error:
        h.update(b"?")
    return h.hexdigest()


PREF_KEYS = {"favorite_projects", "recent_projects"}


def load_prefs():
    """The UI preferences, defaulted so the page never has to test for absence."""
    out = {"favorite_projects": [], "recent_projects": []}
    try:
        conn = app_conn()
    except sqlite3.Error:
        return out
    try:
        for row in conn.execute("SELECT key, value FROM prefs"):
            if row["key"] not in PREF_KEYS:
                continue
            try:
                val = json.loads(row["value"])
            except ValueError:
                continue
            if isinstance(val, list):
                out[row["key"]] = [str(v) for v in val]
    finally:
        conn.close()
    return out


def set_pref(key, value):
    """Write one preference. Returns (http_status, payload)."""
    # An allowlist, not a free-form key/value store: this is reached from the
    # browser, and an endpoint that writes any key is a way to fill the operator's
    # disk one POST at a time.
    if key not in PREF_KEYS:
        return 400, {"error": "unknown preference"}
    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
        return 400, {"error": "that preference is a list of strings"}
    value = value[:200]        # a favourites list longer than this is a bug upstream
    conn = app_conn()
    try:
        conn.execute("INSERT OR REPLACE INTO prefs (key, value, updated) VALUES (?,?,?)",
                     (key, json.dumps(value), int(time.time())))
        conn.commit()
    finally:
        conn.close()
    return 200, {"ok": True, "prefs": load_prefs()}


def load_user():
    """The operator profile as the page is allowed to see it.

    Whitelisted field by field on purpose: the row also holds the password hash,
    and a `dict(row)` would put it on the wire on every config poll. An install
    that has not been set up says `configured: false` rather than inventing a
    name — a made-up "Admin / user@example.com" reads as a real account.
    """
    row = _operator_row()
    if row is None:
        return {"configured": False, "name": "", "email": "", "avatar": ""}
    return {"configured": True, "name": row["name"], "email": row["email"],
            "avatar": row["avatar"]}


# ------------------------------------------------------------------- sessions
# The control token in the page proves the request came from our own page (the
# anti-CSRF gate, unchanged). The session cookie proves somebody signed in. Both
# are required: without the session, anyone who opened the port would be handed
# a working dashboard, and "sign out" would mean nothing.

SESSION_COOKIE = "cc_session"
SESSION_TTL = 12 * 3600   # idle timeout; every authenticated call pushes it out


def _hash_token(raw: str) -> str:
    # High-entropy random token, so a plain digest is the right primitive here —
    # there is nothing to brute-force and no reason to make lookups slow.
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()


def create_session(keep: bool):
    """Mint a session. `keep` is "stay signed in": no expiry, ever."""
    raw = secrets.token_urlsafe(32)
    now = int(time.time())
    conn = app_conn()
    try:
        conn.execute("INSERT INTO session (token_hash, created, seen, expires) VALUES (?,?,?,?)",
                     (_hash_token(raw), now, now, None if keep else now + SESSION_TTL))
        # Cheap moment to take out the dead ones — there is no other sweeper.
        conn.execute("DELETE FROM session WHERE expires IS NOT NULL AND expires < ?", (now,))
        conn.commit()
    finally:
        conn.close()
    return raw


def touch_session(raw: str):
    """Return the live session for this cookie, sliding its expiry forward.

    Sliding rather than absolute on purpose: a dashboard is left open, and an
    absolute cap would sign the operator out mid-run for no security gain on a
    loopback-only port. A session dies from being unused, not from age.
    """
    if not raw:
        return None
    now = int(time.time())
    conn = app_conn()
    try:
        row = conn.execute("SELECT * FROM session WHERE token_hash=?",
                           (_hash_token(raw),)).fetchone()
        if row is None:
            return None
        if row["expires"] is not None and row["expires"] < now:
            conn.execute("DELETE FROM session WHERE token_hash=?", (row["token_hash"],))
            conn.commit()
            return None
        conn.execute("UPDATE session SET seen=?, expires=? WHERE token_hash=?",
                     (now, None if row["expires"] is None else now + SESSION_TTL,
                      row["token_hash"]))
        conn.commit()
        return {"created": row["created"], "keep": row["expires"] is None}
    finally:
        conn.close()


def destroy_session(raw: str):
    if not raw:
        return
    conn = app_conn()
    try:
        conn.execute("DELETE FROM session WHERE token_hash=?", (_hash_token(raw),))
        conn.commit()
    finally:
        conn.close()


def check_login(email, password):
    """Verify credentials. Returns (ok, error)."""
    row = _operator_row()
    if row is None:
        return False, "no profile on this install yet"
    email = str(email or "").strip()
    password = str(password or "")
    # One message for both halves: saying which of the two was wrong tells an
    # attacker which emails exist, and there is nothing here the operator does
    # not already know.
    ok = (email.lower() == row["email"].lower()) and verify_password(password, row["password"])
    return (True, "") if ok else (False, "that email and password do not match")


def create_operator(name, email, password, confirm):
    """Create the one profile. Returns (http_status, payload)."""
    name = str(name or "").strip()
    email = str(email or "").strip()
    password = str(password or "")
    confirm = str(confirm or "")
    if _operator_row() is not None:
        # Setup runs once. Without this the screen would be a password reset for
        # anyone who can reach the port, which is the opposite of its purpose.
        return 409, {"error": "a profile already exists"}
    if not name:
        return 400, {"error": "name is required"}
    if not EMAIL_RE.match(email):
        return 400, {"error": "that does not look like an email address"}
    if len(password) < MIN_PASSWORD:
        return 400, {"error": f"password must be at least {MIN_PASSWORD} characters"}
    # Checked here and not only in the page: a confirmation the server does not
    # verify is decoration, and this password cannot be recovered from anywhere.
    if password != confirm:
        return 400, {"error": "the two passwords do not match"}
    now = int(time.time())
    conn = app_conn()
    try:
        conn.execute("INSERT INTO operator (id, name, email, avatar, password, created, updated)"
                     " VALUES (1, ?, ?, '', ?, ?, ?)",
                     (name, email, hash_password(password), now, now))
        conn.commit()
    except sqlite3.IntegrityError:
        return 409, {"error": "a profile already exists"}
    finally:
        conn.close()
    return 200, {"ok": True, "user": load_user()}


# An avatar is stored inline, as a data: URI in the operator row, so that the
# page stays one self-contained file with nothing to serve and nothing to clean
# up when the photo is replaced. That only works while the photo is small: it
# rides along on /api/config and is hashed into operator_stamp(). The page
# downscales before uploading; this is the backstop, because a limit only the
# client enforces is not a limit.
AVATAR_MAX_BYTES = 512 * 1024
AVATAR_RE = re.compile(r"^data:image/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/=]+$")


def update_operator(name, email, avatar, current, password, confirm):
    """Edit the one profile. Returns (http_status, payload).

    `avatar` is tri-state on purpose: absent leaves the photo alone, "" clears
    it, and a data: URI replaces it — otherwise saving a name change would
    silently drop the photo the form did not happen to send.
    """
    row = _operator_row()
    if row is None:
        return 428, {"error": "set up the operator profile first"}
    name = str(name or "").strip()
    email = str(email or "").strip()
    if not name:
        return 400, {"error": "name is required"}
    if not EMAIL_RE.match(email):
        return 400, {"error": "that does not look like an email address"}

    if avatar is None:
        avatar = row["avatar"]
    else:
        avatar = str(avatar or "").strip()
        if avatar:
            if len(avatar.encode("utf-8")) > AVATAR_MAX_BYTES:
                return 400, {"error": "that photo is too large — pick a smaller one"}
            if not AVATAR_RE.match(avatar):
                return 400, {"error": "the photo must be an inline image"}

    stored = row["password"]
    password = str(password or "")
    if password:
        # The session alone is not enough to set a new password: it may be an
        # unattended tab. Knowing the old one is what proves it is the operator.
        if not verify_password(str(current or ""), stored):
            return 403, {"error": "that is not the current password"}
        if len(password) < MIN_PASSWORD:
            return 400, {"error": f"password must be at least {MIN_PASSWORD} characters"}
        if password != str(confirm or ""):
            return 400, {"error": "the two new passwords do not match"}
        stored = hash_password(password)

    conn = app_conn()
    try:
        conn.execute("UPDATE operator SET name=?, email=?, avatar=?, password=?, updated=?"
                     " WHERE id = 1",
                     (name, email, avatar, stored, int(time.time())))
        conn.commit()
    finally:
        conn.close()
    return 200, {"ok": True, "user": load_user()}


# ---------------------------------------------------------------- search index

def db_conn():
    conn = sqlite3.connect(str(DB_FILE), timeout=5)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    return conn


SCHEMA_VERSION = "5"   # bumped to backfill model_id from stored streams
STREAM_CAP = 2_000_000


def _log(msg):
    """One line to stderr — launchd captures it. Used where staying silent would
    hide the loss of something irreplaceable."""
    sys.stderr.write(f"agentloop-server: {msg}\n")
    sys.stderr.flush()


def db_init(conn):
    conn.execute("CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT)")
    conn.execute("""CREATE TABLE IF NOT EXISTS runs (
        key TEXT PRIMARY KEY, job TEXT, start INTEGER, status TEXT,
        duration INTEGER, cost REAL, session TEXT, log TEXT, forced INTEGER,
        precheck_note TEXT, result_json TEXT, stream TEXT, precheck_txt TEXT,
        stderr TEXT, doc TEXT, project TEXT, model TEXT, model_id TEXT,
        note TEXT, resumed_from TEXT, cause TEXT, pruned INTEGER DEFAULT 0)""")
    try:
        conn.execute("CREATE VIRTUAL TABLE IF NOT EXISTS runs_fts USING fts5(key UNINDEXED, content)")
        return True
    except sqlite3.OperationalError:
        return False


def _meta_get(conn, key, default=""):
    row = conn.execute("SELECT value FROM meta WHERE key=?", (key,)).fetchone()
    return row["value"] if row else default


def _meta_set(conn, key, value):
    conn.execute("INSERT OR REPLACE INTO meta (key, value) VALUES (?, ?)", (key, str(value)))


def _ndjson_sig():
    """Cheap fingerprint of the file head — detects rewrites (history edits)."""
    try:
        with open(RUNS_FILE, "rb") as f:
            return hashlib.md5(f.read(256)).hexdigest()
    except Exception:
        return ""


def _logs_root():
    return (DATA_DIR / "logs").resolve()


def _artifact_paths(rec):
    """The four on-disk artifacts of one run — confined to data/logs/."""
    try:
        logp = Path(rec.get("log", "")).resolve()
    except Exception:
        return None
    if not str(logp).startswith(str(_logs_root())):
        return None
    return {"json": logp,
            "stream": logp.with_name(logp.stem + ".stream.ndjson"),
            "precheck": logp.with_name(logp.stem + ".precheck.txt"),
            "err": Path(str(logp) + ".err")}


def _read_artifacts(rec):
    """Read a run's on-disk artifacts. Never raises, and never lies about it.

    `art["_read_failed"]` is the load-bearing part: whatever goes wrong here, the
    caller must know it read nothing, because the next step deletes these files.
    This used to be one try/except around all four reads with a bare `pass`, so a
    single undecodable byte in a 20 MB stream returned four empty strings — and
    ingestion then stored the emptiness and pruned the originals. A 37-minute,
    $7.27 run was erased that way, and reported success. Read as bytes and decode
    with errors="replace": a mangled character costs a character, not a run.
    """
    art = {"result_json": "", "stream": "", "precheck_txt": "", "stderr": "",
           "_read_failed": False}
    ap = _artifact_paths(rec)
    if not ap:
        return art

    def slurp(path, cap):
        # Per-file, so one bad artifact cannot take the others down with it.
        try:
            if not path.exists():
                return ""
            return path.read_bytes()[:cap].decode("utf-8", errors="replace")
        except Exception as exc:                       # noqa: BLE001 — reported, not swallowed
            art["_read_failed"] = True
            _log(f"ingest: could not read {path}: {exc!r}")
            return ""

    art["result_json"] = slurp(ap["json"], 200_000)
    art["stream"] = slurp(ap["stream"], STREAM_CAP)
    art["precheck_txt"] = slurp(ap["precheck"], 20_000)
    art["stderr"] = slurp(ap["err"], 20_000)
    return art


def _prune_artifacts(rec):
    """Delete a run's on-disk files once their content lives in the DB."""
    ap = _artifact_paths(rec)
    if not ap:
        return
    for p in ap.values():
        try:
            if p.exists():
                p.unlink()
        except Exception:
            pass


def _build_doc(rec, art):
    """Searchable text for one run."""
    parts = [rec.get("id", ""), rec.get("status", ""), rec.get("session", ""),
             rec.get("precheck", "") or "", art.get("precheck_txt", "")]
    try:
        data = json.loads(art.get("result_json") or "{}")
        parts.append(str(data.get("result", "")))
    except Exception:
        pass
    parts.append(art.get("stream", "")[:400_000])
    parts.append(art.get("stderr", ""))
    return "\n".join(p for p in parts if p)


def _rec_key(rec):
    return f"{rec.get('id','')}|{rec.get('start',0)}|{rec.get('log','')}"


def _model_id_from_stream(stream):
    """The resolved model id (e.g. claude-opus-4-8) from the stream's system/init
    event. The engine records it for new runs; deriving it here as a fallback
    also backfills every older run whose stream we still hold."""
    if not stream:
        return ""
    for line in stream.splitlines()[:40]:      # init is the first event
        line = line.strip()
        if not line or '"init"' not in line:
            continue
        try:
            ev = json.loads(line)
        except Exception:  # noqa: BLE001
            continue
        if ev.get("type") == "system" and ev.get("subtype") == "init":
            return ev.get("model") or ""
    return ""


def _api_retries(stream):
    """What the API is doing to this run, from the stream's `system/api_retry`
    events. The CLI retries a refused turn with backoff and says so on the
    stream; nothing downstream read it, so a run whose every turn was being
    bounced looked identical to one that was merely slow to start — an empty
    Terminal under the word "live", with the reason sitting unread in the file
    the panel was already tailing. Returns None when the run has never been
    refused, so callers can treat "no retries" as "nothing to say"."""
    if not stream or "api_retry" not in stream:
        return None
    seen, last = 0, None
    for line in stream.splitlines():
        line = line.strip()
        if not line or "api_retry" not in line:
            continue
        try:
            ev = json.loads(line)
        except Exception:  # noqa: BLE001
            continue
        if ev.get("type") == "system" and ev.get("subtype") == "api_retry":
            seen += 1
            last = ev
    if not last:
        return None
    return {"count": seen,
            "attempt": last.get("attempt"),
            "max_retries": last.get("max_retries"),
            "status": last.get("error_status"),
            "error": last.get("error") or "",
            "delay_ms": last.get("retry_delay_ms")}


def _salvage_from_stream(stream):
    """(last agent text, assistant turn count, session id) recovered from a run's
    stream. Used when a run was killed and left no final result event, so the log
    still shows what it did and how far it got. Malformed lines are skipped — a
    killed run is usually cut off mid-write."""
    last_text, turns, sess = "", 0, ""
    if not stream:
        return last_text, turns, sess
    for line in stream.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except Exception:  # noqa: BLE001
            continue        # truncated/garbled line — skip it, don't abandon the rest
        t = ev.get("type")
        if t == "system" and ev.get("subtype") == "init" and not sess:
            sess = ev.get("session_id") or ""
        elif t == "assistant":
            turns += 1
            for blk in (ev.get("message") or {}).get("content") or []:
                if blk.get("type") == "text" and (blk.get("text") or "").strip():
                    last_text = blk["text"]
    return last_text, turns, sess


def _upsert(conn, fts, rec, preserve=None):
    """Insert or refresh one journal record. `preserve` carries the existing
    row for already-pruned runs — their files are gone, so their stored
    content must survive a resync."""
    key = _rec_key(rec)
    if preserve is not None and preserve["pruned"]:
        art = {"result_json": preserve["result_json"], "stream": preserve["stream"],
               "precheck_txt": preserve["precheck_txt"], "stderr": preserve["stderr"]}
        doc, pruned = preserve["doc"], 1
    else:
        art = _read_artifacts(rec)
        doc = _build_doc(rec, art)
        pruned = 0
    conn.execute(
        "INSERT OR REPLACE INTO runs (key, job, start, status, duration, cost, session,"
        " log, forced, precheck_note, result_json, stream, precheck_txt, stderr, doc, project,"
        " model, model_id, note, resumed_from, cause, pruned)"
        # 22 columns, 22 placeholders. This line shipped with 21 once (the
        # `cause` column arrived without its `?`), and the failure mode was
        # vicious: nothing broke until the FIRST new journal line reached this
        # code, then every ingest raised, load_data's except swallowed it, and
        # the dashboard said "No runs recorded yet" over an intact journal.
        " VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
        (key, rec.get("id", ""), rec.get("start", 0), rec.get("status", ""),
         rec.get("duration", 0), rec.get("cost", 0), rec.get("session", ""),
         rec.get("log", ""), 1 if rec.get("forced") else 0,
         (rec.get("precheck") or "")[:500],
         art["result_json"], art["stream"], art["precheck_txt"], art["stderr"], doc,
         rec.get("project") or "", rec.get("model") or "",
         (rec.get("model_id") or _model_id_from_stream(art["stream"])),
         (rec.get("note") or "")[:500], rec.get("resumed_from") or "",
         (rec.get("cause") or "")[:40], pruned))
    if fts:
        conn.execute("DELETE FROM runs_fts WHERE key=?", (key,))
        conn.execute("INSERT INTO runs_fts (key, content) VALUES (?,?)", (key, doc))
    return key, pruned


def _finish_prune(conn, pending):
    """Delete a run's files only once its content is provably in the database.

    "Provably" is the whole point: pruning is irreversible, so an empty row is a
    reason to KEEP the files, not to trust that there was nothing to keep. A run
    that produced turns and cost but stored no stream did not have nothing to say
    — something went wrong reading it, and the file on disk is the only remaining
    copy.
    """
    for key, rec in pending:
        row = conn.execute(
            "SELECT length(coalesce(result_json,'')) + length(coalesce(stream,''))"
            " FROM runs WHERE key=?", (key,)).fetchone()
        stored = row[0] if row else 0
        if not stored:
            _log(f"ingest: keeping artifacts for {key} — nothing was stored for it")
            continue
        _prune_artifacts(rec)
        conn.execute("UPDATE runs SET pruned=1 WHERE key=?", (key,))


def ingest():
    """Absorb runs.ndjson into the DB. Incremental via byte offset; a rewritten
    journal (shrunk file, changed head, schema bump) triggers a full resync
    that preserves the stored content of already-pruned rows."""
    conn = db_conn()
    try:
        # Schema migration: ADDITIVE ONLY — never DROP the runs table. It stores
        # the content of already-pruned runs whose source files are deleted, so a
        # DROP destroys history that cannot be rebuilt (it once silently emptied
        # every run). Add any missing columns in place; the schema-bump resync
        # below then refreshes every row from the journal while _upsert preserves
        # each pruned row's stored content. A future NON-additive change (a
        # dropped or renamed column) must copy data into a new table first — never
        # a blind DROP.
        try:
            cols = [r[1] for r in conn.execute("PRAGMA table_info(runs)").fetchall()]
        except sqlite3.OperationalError:
            cols = []
        if cols:
            canon = [
                ("job", "TEXT"), ("start", "INTEGER"), ("status", "TEXT"),
                ("duration", "INTEGER"), ("cost", "REAL"), ("session", "TEXT"),
                ("log", "TEXT"), ("forced", "INTEGER"), ("precheck_note", "TEXT"),
                ("result_json", "TEXT"), ("stream", "TEXT"), ("precheck_txt", "TEXT"),
                ("stderr", "TEXT"), ("doc", "TEXT"), ("project", "TEXT"),
                ("model", "TEXT"), ("model_id", "TEXT"), ("note", "TEXT"),
                ("resumed_from", "TEXT"),
                # WHY a failed run failed. Empty for everything that did not.
                ("cause", "TEXT"),
                ("pruned", "INTEGER DEFAULT 0"),
            ]
            for name, decl in canon:
                if name not in cols:
                    conn.execute("ALTER TABLE runs ADD COLUMN " + name + " " + decl)
            conn.commit()
        fts = db_init(conn)
        size = RUNS_FILE.stat().st_size if RUNS_FILE.exists() else 0
        offset = int(_meta_get(conn, "offset", "0") or 0)
        sig = _ndjson_sig()
        # The engine drops this flag whenever it REWRITES history (a job or
        # project rename edits lines anywhere in the journal). The signature
        # below only hashes the head of the file, so an edit further down would
        # otherwise go unnoticed and this index would keep serving stale values.
        flag = DATA_DIR / ".reingest"
        forced = flag.exists()
        if forced:
            try:
                flag.unlink()
            except OSError:
                pass
        resync = (forced or size < offset or sig != _meta_get(conn, "sig", "")
                  or _meta_get(conn, "schema", "") != SCHEMA_VERSION)
        if resync:
            existing = {row["key"]: row for row in conn.execute("SELECT * FROM runs")}
            seen, pending = set(), []
            if RUNS_FILE.exists():
                for ln in RUNS_FILE.read_text().splitlines():
                    ln = ln.strip()
                    if not ln:
                        continue
                    try:
                        rec = json.loads(ln)
                    except Exception:
                        continue
                    key = _rec_key(rec)
                    seen.add(key)
                    k, pruned = _upsert(conn, fts, rec, preserve=existing.get(key))
                    if not pruned:
                        pending.append((k, rec))
            for key in set(existing) - seen:
                conn.execute("DELETE FROM runs WHERE key=?", (key,))
                if fts:
                    conn.execute("DELETE FROM runs_fts WHERE key=?", (key,))
            _finish_prune(conn, pending)
            offset = size
        elif size > offset:
            with open(RUNS_FILE, "r") as f:
                f.seek(offset)
                chunk = f.read()
            consumed = len(chunk) if chunk.endswith("\n") else chunk.rfind("\n") + 1
            pending = []
            for ln in chunk[:consumed].splitlines():
                ln = ln.strip()
                if not ln:
                    continue
                try:
                    rec = json.loads(ln)
                except Exception:
                    continue
                k, pruned = _upsert(conn, fts, rec)
                if not pruned:
                    pending.append((k, rec))
            _finish_prune(conn, pending)
            offset += consumed
        _meta_set(conn, "offset", offset)
        _meta_set(conn, "sig", sig)
        _meta_set(conn, "schema", SCHEMA_VERSION)
        _meta_set(conn, "fts", "1" if fts else "0")
        conn.commit()
        return fts
    finally:
        conn.close()


def search_runs(q):
    fts = ingest()
    tokens = [t for t in q.split() if t][:8]
    if not tokens:
        return {"results": [], "mode": "fts" if fts else "like"}
    conn = db_conn()
    try:
        results = []
        if fts:
            match = " ".join('"' + t.replace('"', '""') + '"' for t in tokens)
            rows = conn.execute(
                "SELECT r.job, r.start, r.key, snippet(runs_fts, 1, '', '', '…', 14) AS snip"
                " FROM runs_fts JOIN runs r ON r.key = runs_fts.key"
                " WHERE runs_fts MATCH ? ORDER BY r.start DESC LIMIT 300", (match,)).fetchall()
            for row in rows:
                results.append({"id": row["job"], "start": row["start"],
                                "snippet": (row["snip"] or "").replace("\n", " ")[:200]})
        else:
            cond = " AND ".join("doc LIKE ?" for _ in tokens)
            args = [f"%{t}%" for t in tokens]
            rows = conn.execute(
                f"SELECT job, start, doc FROM runs WHERE {cond}"
                f" ORDER BY start DESC LIMIT 300", args).fetchall()
            for row in rows:
                content = row["doc"] or ""
                pos = content.lower().find(tokens[0].lower())
                snip = content[max(0, pos - 60):pos + 80].replace("\n", " ") if pos >= 0 else ""
                results.append({"id": row["job"], "start": row["start"], "snippet": snip[:200]})
        return {"results": results, "mode": "fts" if fts else "like"}
    finally:
        conn.close()


# ------------------------------------------------------------------- app data

# How far back into tick.log the 24h counters look. A byte window, not a line
# count: the old `[-6000:]` slice was both too small (21 jobs on a 5-minute
# interval write past it in about a day, so a busy install silently
# under-reported) and too expensive (it read the WHOLE file first, on a poll
# that runs every 5s). The engine caps the file at 4 MiB; this window covers
# well over a day of entries at any realistic job count.
TICK_TAIL_BYTES = 1_500_000


def _tail_lines(path, max_bytes):
    """The last `max_bytes` of a text file, as whole lines.

    Seeking past the start lands mid-line, so the first fragment is dropped —
    it is not an entry and must not be parsed as one.
    """
    try:
        with open(path, "rb") as fh:
            fh.seek(0, os.SEEK_END)
            size = fh.tell()
            start = max(0, size - max_bytes)
            fh.seek(start)
            blob = fh.read()
    except OSError:
        return []
    text = blob.decode("utf-8", "replace")
    if start:
        _, sep, rest = text.partition("\n")
        text = rest if sep else ""
    return text.splitlines()


# The band at the top of the page and the sparkline on every card are drawn
# from these. Both want the same 24 hours of tick.log, so one pass produces
# both: 96 fifteen-minute buckets for the band, 24 hourly ones per job.
TICK_BUCKET_SECONDS = 900
TICK_BUCKETS = 86400 // TICK_BUCKET_SECONDS   # 96
JOB_BUCKETS = 24


def classify_tick(msg):
    """What one tick.log line says the scheduler decided.

    Only lines that represent a *decision about a job* count as a check. The
    engine also logs isolation, provisioning and sweep chatter against a job id;
    counting those would inflate the band with events the loop did not choose.

    Returns one of woke / idle / failed / capped / blocked, or None to ignore.
    """
    if msg.startswith("starting run"):
        return "woke"
    if "precheck found nothing" in msg:
        return "idle"
    if msg.startswith("PRECHECK FAILED"):
        return "failed"
    if "daily cap reached" in msg:          # covers the per-job and GLOBAL lines
        return "capped"
    # Held back by a usage window, not by money. Its own outcome because the
    # operator's next move differs: a dollar cap is a decision they made and can
    # raise, a spent window is a wait.
    if "usage limit reached" in msg:
        return "rate_limited"
    if "max_parallel" in msg:
        return "blocked"
    # A tick that could not even get as far as the probe: no prompt, a cwd that
    # has gone missing, a config dir that is not there, a worktree or a
    # provisioning step that failed. All of them mean the job did not run and
    # somebody has to look.
    if (msg.endswith(", skipped")
            or "isolation failed" in msg
            or msg.startswith("provisioning failed")):
        return "failed"
    return None


# Outcomes that mean "the loop looked at this job", in the order the band
# stacks them. `woke` is the signal; the rest are degrees of quiet.
TICK_OUTCOMES = ("woke", "idle", "capped", "rate_limited", "blocked", "failed")


def checks_24h(now=None):
    """The last 24h of scheduler activity, straight from tick.log — makes the
    autonomy visible even when every check stays idle.

    Returns (per-job counts, band). The counts keep the shape the card has
    always read (`checks`, `runs`) and add `failed` plus an hourly `series`;
    the band is the whole install bucketed at 15 minutes, oldest first, so the
    page can draw it without knowing anything about timestamps.
    """
    now = time.time() if now is None else now
    counts = {}
    # bucket 0 is the OLDEST: the band reads left to right as time does. Each
    # bucket is a list in TICK_OUTCOMES order rather than an object — this goes
    # out on every 5-second poll, and the keys would be 5× the numbers.
    band = [[0] * len(TICK_OUTCOMES) for _ in range(TICK_BUCKETS)]
    slot_of = {k: i for i, k in enumerate(TICK_OUTCOMES)}
    start = now - 86400
    try:
        lines = _tail_lines(DATA_DIR / "tick.log", TICK_TAIL_BYTES)
        for ln in lines:
            try:
                t = calendar.timegm(time.strptime(ln[:20], "%Y-%m-%dT%H:%M:%SZ"))
            except Exception:
                continue
            if t < start or t > now:
                continue
            job, _, msg = ln[21:].partition(": ")
            kind = classify_tick(msg)
            if kind is None:
                continue
            d = counts.get(job)
            if d is None:
                d = counts[job] = {"checks": 0, "runs": 0, "failed": 0,
                                   "series": [0] * JOB_BUCKETS,
                                   "woke": [0] * JOB_BUCKETS}
            d["checks"] += 1
            hour = min(JOB_BUCKETS - 1, int((t - start) // 3600))
            d["series"][hour] += 1
            if kind == "woke":
                d["runs"] += 1
                d["woke"][hour] += 1
            elif kind == "failed":
                d["failed"] += 1
            slot = min(TICK_BUCKETS - 1, int((t - start) // TICK_BUCKET_SECONDS))
            band[slot][slot_of[kind]] += 1
    except Exception:
        pass
    return counts, {"bucket_seconds": TICK_BUCKET_SECONDS, "start": int(start),
                    "outcomes": list(TICK_OUTCOMES), "buckets": band}


def compact_db():
    """Give the deleted pages back to the filesystem.

    SQLite keeps the pages a DELETE frees in its own freelist and reuses them
    later, so the file never shrinks on its own — after deleting runs the index
    can sit at twice the size of what it actually holds. VACUUM rewrites it at
    its true size; the FTS optimise first is what lets the index give up its
    own pages too. Returns (bytes_before, bytes_after).
    """
    def _size():
        n = 0
        for p in (DB_FILE, Path(str(DB_FILE) + "-wal"), Path(str(DB_FILE) + "-shm")):
            try:
                n += p.stat().st_size
            except OSError:
                pass
        return n

    before = _size()
    try:
        conn = db_conn()
        conn.isolation_level = None          # VACUUM cannot run inside a transaction
        try:
            conn.execute("INSERT INTO runs_fts(runs_fts) VALUES('optimize')")
        except sqlite3.OperationalError:
            pass                              # no FTS on this build; VACUUM still helps
        conn.execute("VACUUM")
        conn.execute("PRAGMA wal_checkpoint(TRUNCATE)")
        conn.close()
    except sqlite3.Error:
        return before, before                 # busy or locked: leave it for next time
    return before, _size()


class journal_lock:
    """Hold the journal still while it is rewritten.

    The engine appends a line when a run ends; deletes and renames rewrite the
    file whole. Without this, a rewrite built from a snapshot taken before an
    append silently overwrites it and that run's record is gone for good — which
    also strands its row in the index, where deleting it then fails with "no
    such run". Same mkdir lock the engine takes, by the same name — so the two
    sides must also agree on when a lock may be BROKEN.

    They now do: the holder writes its pid AND the boot it was taken in, and
    the lock is stolen only when that pid is gone OR belongs to an earlier
    boot. Breaking on elapsed time (what both sides used to do) robs the
    slowest legitimate holder first, and the slowest holder here is a rewrite
    of a long journal — precisely the case the lock exists for. Breaking on
    pid alone (what this class used to do after that) reopens the same defect
    Task 1 removed from the run slots: pids are reissued from 1 on every boot,
    so a `.journal.lock` left behind across a reboot can find its recorded pid
    reused by an unrelated live process, and a bare `os.kill` cannot tell the
    difference. `lock_take`, the engine's own mkdir lock, already checks
    `slot_alive` for exactly this reason; this is the same fix on the other
    side of the same lock, using the same `boot_id()`.

    A live holder is waited for, but NOT for ever: this runs inside an HTTP
    handler, so a wedged holder has to surface as a failed request rather than
    a hung thread. Hence TimeoutError in place of the old endless retry.
    """
    # Long enough that no honest rewrite loses its lock; short enough that an
    # owner killed between mkdir and writing its pid cannot wedge the journal.
    GRACE = 30.0

    def __init__(self, timeout=30.0):
        self.path = DATA_DIR / "locks" / ".journal.lock"
        self.timeout = timeout
        self.held = False

    def _owner(self):
        """The pid holding the lock: int, or None when it cannot be read."""
        try:
            return int((self.path / "pid").read_text().strip())
        except (OSError, ValueError):
            return None

    def _owner_boot(self):
        """The boot the current holder took the lock in: str, or "" when it
        cannot be read (predates this field, or races a concurrent _break)."""
        try:
            return (self.path / "boot").read_text().strip()
        except OSError:
            return ""

    @staticmethod
    def _alive(pid, boot):
        """Is the process this pid names still the one that took the lock?

        A boot that disagrees with the one this process is running in makes
        the lock dead however healthy its pid looks — the pid was reissued to
        someone else across the reboot. A lock with no boot file at all
        predates this field: fall back to the pid alone, so an upgrade does
        not treat every lock still held across it as stale.
        """
        now = boot_id()
        if boot and now and boot != now:
            return False
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True          # it exists, it is just not ours
        return True

    def _break(self):
        """Remove a lock we have decided is stale — pid file and all.

        rmdir() alone is not enough any more: the engine writes a pid into the
        directory, and a non-empty rmdir fails silently, which turned the old
        breaker into an infinite loop inside a request handler.
        """
        try:
            for child in self.path.iterdir():
                child.unlink()
            self.path.rmdir()
        except OSError:
            pass

    def __enter__(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        deadline = time.time() + self.timeout
        ownerless_since = None
        while True:
            try:
                self.path.mkdir()
            except FileExistsError:
                pass
            else:
                try:
                    (self.path / "pid").write_text(str(os.getpid()))
                    (self.path / "boot").write_text(boot_id())
                except OSError:
                    pass
                self.held = True
                return self

            owner = self._owner()
            if owner is not None and not self._alive(owner, self._owner_boot()):
                self._break()                 # the owner is gone, or from an earlier boot
                continue
            if owner is None:
                # The narrow race between mkdir and writing the pid. Only this
                # case gets a time-based escape.
                ownerless_since = ownerless_since or time.time()
                if time.time() - ownerless_since > self.GRACE:
                    self._break()
                    ownerless_since = None
                    continue
            else:
                ownerless_since = None
            if time.time() > deadline:
                raise TimeoutError(
                    f"the journal lock is held by live pid {owner} — try again in a moment")
            time.sleep(0.01)

    def __exit__(self, *exc):
        if self.held:
            self._break()
        return False


def delete_run(jid, start):
    """Erase one run completely: its files, its journal line and its DB rows.

    Irreversible on purpose — the user asked for the run to be gone, not hidden.
    Order matters: drop the journal line LAST-but-one and the DB rows last, so a
    crash midway leaves the journal as the source of truth and the next ingest
    reconciles rather than resurrecting half a run.
    """
    removed = {"files": 0, "journal": 0, "db": 0}
    # Read and rewrite under the lock: a run ending in between would append its
    # record to the file this rewrite is about to replace, and lose it.
    with journal_lock():
        kept, target = [], None
        if RUNS_FILE.exists():
            for ln in RUNS_FILE.read_text().splitlines():
                s = ln.strip()
                if not s:
                    continue
                try:
                    rec = json.loads(s)
                except Exception:  # noqa: BLE001
                    kept.append(ln)
                    continue
                if rec.get("id") == jid and int(rec.get("start") or 0) == start:
                    target = rec
                else:
                    kept.append(ln)
        if target is not None:
            RUNS_FILE.write_text("".join(ln + "\n" for ln in kept))
            removed["journal"] = 1

    if target is None:
        # Not in the journal, but the index may still carry it — a row stranded
        # by an earlier loss. Clear it rather than refusing forever with "no such
        # run": the journal is the source of truth, so anything the index holds
        # that the journal does not is exactly what should go.
        return _forget_stranded_row(jid, start, removed)

    # On-disk artifacts, plus the transient siblings a run can leave behind.
    ap = _artifact_paths(target) or {}
    extra = []
    try:
        logp = Path(target.get("log", ""))
        if str(logp.resolve()).startswith(str(_logs_root())):
            extra = [Path(str(logp) + ".watchdog"), Path(str(logp) + ".stdin"),
                     Path(str(logp) + ".turnend")]
    except Exception:  # noqa: BLE001
        extra = []
    for p in list(ap.values()) + extra:
        try:
            if p.exists():
                p.unlink()
                removed["files"] += 1
        except Exception:  # noqa: BLE001
            pass

    # Clear the DB rows now rather than waiting for the next ingest, and reset
    # the ingest offset so the shortened journal is re-read from the start
    # instead of being treated as appended-to.
    try:
        conn = db_conn()
        fts = db_init(conn)
        key = _rec_key(target)
        conn.execute("DELETE FROM runs WHERE key=?", (key,))
        removed["db"] = conn.total_changes
        if fts:
            conn.execute("DELETE FROM runs_fts WHERE key=?", (key,))
        _meta_set(conn, "offset", str(RUNS_FILE.stat().st_size if RUNS_FILE.exists() else 0))
        _meta_set(conn, "sig", _ndjson_sig())
        conn.commit()
        conn.close()
    except Exception:  # noqa: BLE001
        pass

    # Hand the freed pages back to the filesystem, so deleting a run actually
    # makes the index smaller instead of only marking space reusable.
    before, after = compact_db()
    removed["bytes"] = max(0, before - after)
    return removed


def _forget_stranded_row(jid, start, removed):
    """Delete an index row whose journal line is gone. Returns None if truly absent."""
    try:
        conn = db_conn()
        fts = db_init(conn)
        # Match on job+start, not on the row key: the key also carries the log
        # path, which a caller identifying a run by when it ran does not have.
        row = conn.execute("SELECT key, log FROM runs WHERE job=? AND start=?",
                           (jid, start)).fetchone()
        if row is None:
            conn.close()
            return None
        key = row["key"]
        # Its files, if any survived, then the row and its search entry.
        try:
            logp = Path(row["log"] or "")
            if str(logp) and str(logp.resolve()).startswith(str(_logs_root())):
                for p in (logp, logp.with_name(logp.stem + ".stream.ndjson"),
                          logp.with_name(logp.stem + ".precheck.txt"),
                          Path(str(logp) + ".err"), Path(str(logp) + ".watchdog")):
                    if p.exists():
                        p.unlink()
                        removed["files"] += 1
        except Exception:  # noqa: BLE001
            pass
        conn.execute("DELETE FROM runs WHERE key=?", (key,))
        removed["db"] = conn.total_changes
        if fts:
            conn.execute("DELETE FROM runs_fts WHERE key=?", (key,))
        conn.commit()
        conn.close()
    except sqlite3.Error:
        return None
    before, after = compact_db()
    removed["bytes"] = max(0, before - after)
    return removed


def active_runs_for(jid):
    """Live run slots for a job — read straight from data/locks/<jid>/<pid>/, so
    N CONCURRENT runs each show up (state only tracks the most recent). Each entry
    is {pid, child, log}; dead slots are skipped (the engine prunes them)."""
    out = []
    base = DATA_DIR / "locks" / str(jid)
    if not base.is_dir():
        return out
    for d in sorted(base.iterdir()):
        if not d.is_dir() or d.name.startswith("."):
            continue
        if not slot_alive(d):
            continue
        try:
            pid = int((d / "pid").read_text().strip())
        except (OSError, ValueError):
            continue
        def _read(name):
            try:
                return (d / name).read_text().strip()
            except Exception:  # noqa: BLE001
                return ""
        try:
            started = int(_read("start") or 0)
        except ValueError:
            started = 0
        if not started:
            # A run started before slots recorded their own start: fall back to
            # when the slot directory was created, which is that same moment.
            try:
                started = int(d.stat().st_mtime)
            except OSError:
                started = 0
        logf = _read("logfile")
        out.append({"pid": pid, "child": _read("child"), "log": logf,
                    # when THIS run began: the shared state holds one value per
                    # job, so concurrent runs are told apart by their slots
                    "start": started,
                    # The session is known from the transcript's first event, so
                    # a running row can show it instead of a dash — it is what
                    # you need to follow or resume the run.
                    "session": _session_from_log(logf),
                    # set when this run is continuing another run's session
                    "resume_of": _read("resume_of")})
    return out


def _session_from_log(logp):
    """The session id a live run reported in its transcript's init event.

    Read by LINES, not by a byte window. The init event carries the run's whole
    tool roster, and with a few MCP servers attached it passes 8 KB on its own —
    a byte cap then cuts it mid-object, json.loads raises on the fragment, and
    this returns "" having found nothing. The transcript is append-only, so
    those first bytes never change: the miss is permanent, not a transient the
    next poll recovers from. `session_from_stream` in bin/agentloop was fixed
    the same way and for the same reason, and the two sides must not disagree
    about what they are able to see.
    """
    if not logp or not logp.endswith(".json"):
        return ""
    sp = Path(logp[:-5] + ".stream.ndjson")
    try:
        if not sp.resolve().is_relative_to(_logs_root()):
            return ""
        head = []
        with open(sp, "r", errors="replace") as fh:
            for line in fh:
                head.append(line)
                if len(head) >= 5:    # the same five lines `head -n 5` reads
                    break
    except OSError:
        return ""
    for line in head:
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        sid = ev.get("session_id")
        if sid:
            return str(sid)
    return ""


_BOOT_ID = None


def boot_id():
    """The boot this machine is in, as the engine stamps it onto every slot.

    Reads `kern.bootsessionuuid`, not `kern.boottime`: XNU steps the calendar
    clock underlying `kern.boottime` on an NTP resync or a wake from sleep, so
    it can move within a boot that never rebooted. Comparing it exactly would
    then read a live slot as belonging to another boot. The session uuid is
    opaque and does not move, so there is nothing here to parse and no shape
    to get wrong.

    Slots live under data/ and survive a reboot; pids are reissued from 1 on the
    way up. Without the boot, a recycled pid makes a dead slot look live — and
    the dashboard then hides a run dir nobody owns from the only list that
    offers to discard it.
    """
    global _BOOT_ID
    if _BOOT_ID is None:
        try:
            out = subprocess.run(["sysctl", "-n", "kern.bootsessionuuid"],
                                 capture_output=True, text=True,
                                 timeout=5).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        _BOOT_ID = out.strip()
    return _BOOT_ID


def slot_alive(slot):
    """Is the process this slot names still the process that took it?"""
    try:
        pid = int((slot / "pid").read_text().strip())
    except (OSError, ValueError):
        return False
    try:
        boot = (slot / "boot").read_text().strip()
    except OSError:
        boot = ""       # predates the boot id: fall back to the pid alone
    now = boot_id()
    if boot and now and boot != now:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


# Throttle for _session_bound_to's own logging, keyed by run dir path (a
# string, so it survives independently of any Path object identity). Maps a
# path that currently has a bad condition to WHICH condition was last logged
# for it. retained_worktrees() runs on every /api/data poll -- every 5
# seconds -- and without this, one bad `.session` file would write a fresh
# log line every poll until the TTL reclaims its directory, up to 24h of
# identical lines for a condition already fully diagnosed the first time.
#
# In memory only, on purpose: the server is a long-lived process and this is
# exactly the kind of thing that does not need to survive a restart (a
# restart is itself a reasonable moment to re-report a standing condition).
# Entries are removed the instant the condition clears (the file reads fine,
# or is gone), so a LATER recurrence -- even the identical condition -- is
# reported again rather than staying silent forever because of what an
# earlier, since-resolved problem once logged. retained_worktrees() also
# prunes it for paths that drop out of the listing entirely (a torn-down run
# dir), so a path this function never sees again cannot sit here forever.
_session_bound_logged = {}


def _session_bound_to(run_dir):
    """The session id `.session` names for this run dir, or "" when there is
    none to resume with.

    Absent, empty and unreadable are not the same claim, and collapsing them
    into one silent "" would let a value that only exists on some paths be
    read by something that treats its default as an answer.

    - Absent is the ordinary case. bind_session (bin/agentloop) writes this
      file through mktemp + rename, and only once it already has a non-empty
      id -- so a run dir with no `.session` is one whose agent never got far
      enough to report one. There was never anything to resume; this is not a
      fault, and it is not logged.
    - Present but unreadable (permission denied, `.session` replaced by a
      directory, a mid-flight filesystem error, ...) is a different claim: a
      session may well be bound here and this simply could not read it.
      Logged, so staying silent does not hide it the way a swallowed
      exception would.
    - Present but empty is a contract violation: bind_session's own write
      goes through mktemp + rename and only after confirming the id is
      non-empty, so an empty file is not a state its writer can produce.
      Also logged, for the same reason as unreadable.

    All three leave the caller with no usable id -- this only decides what
    gets logged, never fabricates a placeholder the caller could mistake for
    a real one.

    The unreadable and empty cases are throttled through _session_bound_logged
    (see its own comment): logged the first time a directory shows one of
    them, silent on every repeat of the SAME condition, logged again the
    moment that directory's condition changes -- including clearing and then
    recurring.

    Reads bytes and decodes with errors="replace", not .read_text(): a
    session id is written by a single `printf` and should never be anything
    but plain ASCII, but .read_text() raises UnicodeDecodeError -- a
    ValueError, not an OSError -- on a byte that is not valid UTF-8, and that
    would have gone uncaught here, crashing retained_worktrees() and the
    /api/data poll it backs for every job's card, not just this one row's.
    Same fix _load_artifacts already needed for the same reason, elsewhere in
    this file.
    """
    p = run_dir / ".session"
    key = str(run_dir)
    try:
        raw = p.read_bytes()[:4096].decode("utf-8", errors="replace")
    except FileNotFoundError:
        _session_bound_logged.pop(key, None)
        return ""
    except OSError as exc:
        condition = f"unreadable: {exc!r}"
        if _session_bound_logged.get(key) != condition:
            _log(f"retained_worktrees: {p} exists but could not be read: {exc!r}")
            _session_bound_logged[key] = condition
        return ""
    sid = raw.strip()
    if not sid:
        if _session_bound_logged.get(key) != "empty":
            _log(f"retained_worktrees: {p} exists but is empty")
            _session_bound_logged[key] = "empty"
        return ""
    _session_bound_logged.pop(key, None)
    return sid


def retained_worktrees():
    """Run dirs sitting on disk that no live run is using.

    wt_teardown keeps a run dir whose session is marked `open` — cut short and
    waiting on a resume — or not marked at all, since a crash writes no marker
    either. Correct, but permanent on its own: the sweep re-reaches the same
    verdict every tick and nothing ever lets go without a resume or an explicit
    drop. They were also invisible, mentioned only in tick.log, so the first
    symptom was a full disk. Listing them is what makes the deliberate drop
    (worktree-drop) something a user can actually reach.

    Read straight from the directory tree, the same way active_runs_for reads
    the slots — no fork, cheap enough for the poll.
    """
    root = DATA_DIR / "worktrees"
    if not root.is_dir():
        return []
    claimed = set()
    locks = DATA_DIR / "locks"
    if locks.is_dir():
        for jobdir in locks.iterdir():
            if not jobdir.is_dir():
                continue
            for slot in jobdir.iterdir():
                if not slot.is_dir() or slot.name.startswith("."):
                    continue
                if not slot_alive(slot):
                    continue           # dead slot: whatever it named is nobody's
                try:
                    claimed.add((slot / "worktree").read_text().strip())
                except OSError:
                    pass
    out = []
    now = time.time()
    for jobdir in sorted(root.iterdir()):
        if not jobdir.is_dir():
            continue
        for d in sorted(jobdir.iterdir()):
            if not d.is_dir() or str(d) in claimed:
                continue
            try:
                age = max(0, int(now - d.stat().st_mtime))
            except OSError:
                age = 0
            repos, bytes_ = [], 0
            try:
                repos = sorted(c.name for c in d.iterdir() if c.is_dir())
            except OSError:
                pass
            for dirpath, _dirs, files in os.walk(d):
                for f in files:
                    try:
                        bytes_ += os.lstat(os.path.join(dirpath, f)).st_size
                    except OSError:
                        pass
            # An open session is kept for a resume, and the sweep reclaims it
            # once its TTL is up. Saying when turns a folder that looks abandoned
            # into a queue with an end.
            try:
                ended = (d / ".ended").read_text().strip()
            except OSError:
                ended = ""
            # Anything the engine has not marked `done` is on the expiry clock,
            # including a dir with no marker at all — a run killed with -9 never
            # wrote one, and it is exactly the kind that sits there longest. The
            # sweep uses the same `!= done` test; these two must not disagree,
            # or the dashboard promises a reclaim that never comes.
            expires_in = None if ended == "done" else max(0, WORKTREE_SESSION_TTL - age)
            # What a resume would need. "" means there is nothing to resume
            # WITH, for any of three different reasons -- see _session_bound_to.
            out.append({"job": jobdir.name, "stamp": d.name, "path": str(d),
                        "age": age, "repos": repos, "bytes": bytes_,
                        "ended": ended, "expires_in": expires_in,
                        "session": _session_bound_to(d)})
    # This is the one place that sees every path still on disk, so it is the
    # one place that can tell _session_bound_logged's throttle cache a path
    # is gone -- a torn-down run dir is never asked about again, and without
    # this its last bad condition would sit in memory for the rest of the
    # server process's life.
    #
    # dict(...) snapshots the cache before iterating it, and pop(stale, None)
    # tolerates a key that is already gone -- both load-bearing under the
    # ThreadingHTTPServer this backs: retained_worktrees() genuinely runs on
    # more than one thread at once (two tabs polling, or one poll outrunning
    # the next one's 5s interval), and _session_bound_to (called just above,
    # for every directory, by every one of those threads) adds and removes
    # keys in this SAME dict. Iterating the live dict directly and `del`ing a
    # key by name -- the previous shape -- raises `RuntimeError: dictionary
    # changed size during iteration` the moment another thread's write lands
    # mid-iteration, and `KeyError` the moment another thread has already
    # removed the exact key this thread is about to delete. Either kills the
    # request: the same failure _session_bound_to's own docstring says the
    # unreadable branch exists to prevent, reintroduced here.
    live_paths = {e["path"] for e in out}
    for stale in [k for k in dict(_session_bound_logged) if k not in live_paths]:
        _session_bound_logged.pop(stale, None)
    return out


def max_parallel_for(jid):
    """How many runs of this job may work at once — 0 means no ceiling.

    A JOB-level setting only, never inherited: missing or blank means 3. Kept in
    step with the engine so the dashboard never promises a run the engine would
    refuse, nor refuses one it would have allowed.
    """
    try:
        for j in json.loads(JOBS_FILE.read_text()).get("jobs", []):
            if j.get("id") == jid:
                try:
                    n = int(j.get("max_parallel"))
                except (TypeError, ValueError):
                    return 3
                return n if n >= 0 else 3
    except Exception:  # noqa: BLE001
        pass
    return 3


def at_capacity(jid):
    """(is_full, running, ceiling) — ceiling 0 means unlimited, so never full."""
    ceiling = max_parallel_for(jid)
    running = len(active_runs_for(jid))
    return (ceiling > 0 and running >= ceiling), running, ceiling


def resume_in_flight(jid, sid):
    """Is a run already resuming this session right now?"""
    return bool(sid) and any(r.get("resume_of") == sid for r in active_runs_for(jid))


def _resume_port_block(jid, sid):
    """The port block the retained run dir for <sid> would have to reclaim, or
    "" when there is none recorded — the engine then allocates a fresh one and
    nothing can be in the way."""
    root = DATA_DIR / "worktrees" / str(jid)
    if not root.is_dir():
        return ""
    for d in sorted(root.iterdir()):
        if not d.is_dir() or d.name.startswith("."):
            continue
        if _session_bound_to(d) != sid:
            continue
        try:
            base = json.loads((d / ".run.json").read_text()).get("port_base")
        except Exception:  # noqa: BLE001
            return ""
        return str(base or "")
    return ""


def resume_port_block_held_by(jid, sid):
    """(block, holder) — the port block this resume needs, and the LIVE run
    sitting on it, if any.

    A resume must have the EXACT block its services were bound to: a fresh one
    would point the resumed agent's config at ports nothing is listening on, so
    the engine refuses rather than substitute (see port_base_reclaim in
    bin/agentloop). That refusal happens after the run has detached, which is
    why it has to be asked here too — `cc(..., background=True)` returns before
    the engine has looked, so the dashboard said "Resuming…", disabled the
    button and left the operator watching nothing happen, with the reason
    written only to tick.log. Two sessions of one job cut short in a row share
    a block, so resuming either one makes the other unresumable until it ends —
    the exact case that produced two Resume buttons and one that could never
    work.

    Same scan as port_base_free: every live slot of every job, since the block
    can be held by a run of any of them. The resume's own slot does not exist
    yet at this point, so there is nothing to exclude.
    """
    want = _resume_port_block(jid, sid)
    if not want:
        return "", None
    locks = DATA_DIR / "locks"
    if not locks.is_dir():
        return want, None
    for jobdir in sorted(locks.iterdir()):
        if not jobdir.is_dir():
            continue
        for slot in sorted(jobdir.iterdir()):
            if not slot.is_dir() or slot.name.startswith("."):
                continue
            if not slot_alive(slot):
                continue
            try:
                base = (slot / "portbase").read_text().strip()
            except OSError:
                continue
            if base != want:
                continue
            try:
                pid = int((slot / "pid").read_text().strip())
            except (OSError, ValueError):
                pid = None
            return want, {"job": jobdir.name, "pid": pid}
    return want, None


_LAUNCHD_TTL = 60
_launchd_cache = {"at": 0.0, "loaded": False}


def launchd_loaded():
    """Is the tick agent loaded? Cached: this forks launchctl, and the poll it
    serves runs every 5s — roughly 17k forks a day to answer a question that
    changes when someone runs the installer."""
    now = time.time()
    if now - _launchd_cache["at"] < _LAUNCHD_TTL:
        return _launchd_cache["loaded"]
    loaded = _launchd_cache["loaded"]
    try:
        out = subprocess.run(["launchctl", "list"], capture_output=True, text=True, timeout=5)
        loaded = PLIST_LABEL in out.stdout
    except Exception:  # noqa: BLE001
        pass
    _launchd_cache.update(at=now, loaded=loaded)
    return loaded


_SUPERVISED = {"at": 0.0, "is": False}


def server_supervised():
    """Is THIS process the KeepAlive agent — i.e. would exiting mean restarting?

    A server started by hand must never take itself down: nothing would bring it
    back and the operator would just watch the dashboard die. Matching on the
    label alone was not enough — a hand-started server on a machine that also has
    the agent installed saw the label, believed it was supervised, and would have
    exited for good. So compare the pid launchd is actually holding.
    """
    now = time.time()
    if now - _SUPERVISED["at"] < _LAUNCHD_TTL:
        return _SUPERVISED["is"]
    supervised = False
    try:
        out = subprocess.run(["launchctl", "list", SERVER_LABEL],
                             capture_output=True, text=True, timeout=5)
        m = re.search(r'"PID"\s*=\s*(\d+)', out.stdout)
        supervised = bool(m) and int(m.group(1)) == os.getpid()
    except Exception:  # noqa: BLE001
        pass
    _SUPERVISED.update(at=now, **{"is": supervised})
    return supervised


def config_sig():
    """Fingerprint of the two config files, so the page can tell when the parts
    of the payload that almost never change actually did."""
    parts = []
    for p in (JOBS_FILE, PROJECTS_FILE):
        try:
            st = p.stat()
            parts.append(f"{st.st_mtime_ns}:{st.st_size}")
        except OSError:
            parts.append("-")
    # The operator profile rides on /api/config too, and it does not live in a
    # file — without its stamp here the page would keep showing the old name in
    # the sidebar until something unrelated edited jobs.json.
    parts.append(operator_stamp())
    return hashlib.md5("|".join(parts).encode()).hexdigest()


def load_config():
    """The static half of the page's data: the job definitions and projects.

    Split out of /api/data because it is both the bulk of the payload and the
    part that does not change — full prompts for every job plus a couple of
    kilobytes of project description each, re-sent every 5 seconds. The precheck
    SCRIPTS are deliberately not here: only the editor ever reads one, and
    shipping 21 shell scripts on every poll to service the occasional click is
    the same waste in miniature.
    """
    return {"sig": config_sig(),
            "jobs": read_json(JOBS_FILE, {}).get("jobs", []),
            "projects": read_json(PROJECTS_FILE, {}).get("projects", []),
            "user": load_user(),
            "prefs": load_prefs()}


def load_data():
    jobs = read_json(JOBS_FILE, {}).get("jobs", [])
    state = read_json(STATE_FILE, {})
    runs = []
    try:
        ingest()  # cheap when the journal has not grown
        conn = db_conn()
        db_init(conn)
        for row in conn.execute(
                "SELECT job, start, status, duration, cost, session, log, forced, precheck_note, project, note, resumed_from, cause"
                " FROM runs ORDER BY start DESC, rowid DESC LIMIT 1000"):
            runs.append({"id": row["job"], "start": row["start"], "status": row["status"],
                         "duration": row["duration"], "cost": row["cost"],
                         "session": row["session"], "log": row["log"],
                         "forced": bool(row["forced"]), "precheck": row["precheck_note"],
                         "project": row["project"] or "",
                         # Why a run ended as it did. Carries "NOTHING TO DO: …"
                         # for a run that succeeded without any work to do.
                         "note": row["note"] or "",
                         # the session this run continued, when it was a resume
                         "resumed_from": row["resumed_from"] or "",
                         "cause": row["cause"] or ""})
        conn.close()
    except Exception as exc:  # noqa: BLE001
        # Degrade to an empty list so the page still paints — but SAY SO.
        # This except once hid a broken INSERT for a whole morning: the page
        # showed "No runs recorded yet" over 223 intact journal lines and
        # nothing anywhere named the exception.
        print(f"agentloop-server: run listing failed, showing none: {exc!r}",
              flush=True)
        runs = []
    db_bytes = 0
    for p in (DB_FILE, Path(str(DB_FILE) + "-wal"), Path(str(DB_FILE) + "-shm")):
        try:
            if p.exists():
                db_bytes += p.stat().st_size
        except Exception:
            pass
    # strftime, not a `date` subprocess: same string, no fork, and this ran on
    # every one of those 5-second polls.
    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    checks, ticks = checks_24h()
    # current_build_id(), not a fixed BUILD: this is what an ALREADY-OPEN tab
    # polls every 5s to notice the server moved on and reload itself once
    # (bin/dashboard.html compares this against the id its own page was
    # rendered with) -- a static value here would never move, so a pull under
    # a running server would still need a manual refresh for any tab that was
    # already open, even though a brand new page load now gets the fresh id
    # from render_page() immediately. The handful of stat() calls this costs
    # is the same one render_page() already pays per load, just paid again
    # per poll tick -- see current_build_id's own comment on why that stays
    # cheap.
    return {"generated": now, "launchd_loaded": launchd_loaded(), "build": current_build_id(),
            "config_sig": config_sig(),
            "state": state, "runs": runs,
            # Job ids PLUS the derived security jobs. Those never appear in
            # jobs.json -- that is the isolation property doing its job -- but
            # their runs are as real as any other, and this map is the only way
            # the page sees a LIVE run: without the union, a running analysis
            # had no "Open the run" button and the Security page's dead-run
            # warning fired against every healthy run after three minutes.
            "active_runs": {i: active_runs_for(i) for i in
                            ([j.get("id") for j in jobs]
                             + sorted(d.name for d in (DATA_DIR / "locks").iterdir()
                                      if d.is_dir() and d.name.startswith("security-"))
                             if (DATA_DIR / "locks").is_dir()
                             else [j.get("id") for j in jobs])},
            "retained_worktrees": retained_worktrees(),
            "db_bytes": db_bytes, "checks": checks, "ticks": ticks}


def load_live_detail(jid, start_i):
    """Detail for a run that is STILL GOING. It has no journal record yet, so read
    the stream file the engine is writing (state.last_log) and build the same
    shape from it — this is what lets the dashboard tail a long run live."""
    try:
        state = json.loads(STATE_FILE.read_text())
    except Exception:  # noqa: BLE001
        state = {}
    st = (state or {}).get(jid) or {}

    # Find THIS run among the live ones by its start. The slots are the source:
    # the shared state keeps a single last_start/last_log per job, so with two
    # runs of one job it can only ever describe the newer — asking it made the
    # older run's log unopenable ("could not load log").
    slot = next((s for s in active_runs_for(jid) if s.get("start") == start_i), None)
    if slot is None and (st.get("last_status") != "running"
                         or int(st.get("last_start") or 0) != start_i):
        return None
    logp = (slot or {}).get("log") or (st.get("last_log") or "")
    sp = None
    if logp.endswith(".json"):
        sp = Path(logp[:-5] + ".stream.ndjson")
    else:
        # Runs started before the engine published last_log: the file is stamped
        # with the run's UTC start, so derive it from that.
        stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime(start_i))
        hits = sorted((DATA_DIR / "logs" / jid).glob(stamp + "*.stream.ndjson"))
        sp = hits[0] if hits else None
    stream = ""
    try:
        if sp and sp.resolve().is_relative_to(_logs_root()) and sp.exists():
            stream = sp.read_text(errors="replace")[-STREAM_CAP:]
            logp = logp or str(sp)
    except Exception:  # noqa: BLE001
        stream = ""
    last_text, turns, sess = _salvage_from_stream(stream)
    pc = st.get("last_precheck") or {}
    rec = {"id": jid, "start": start_i, "status": "running",
           "duration": max(0, int(time.time()) - start_i), "cost": None, "session": sess,
           "log": logp, "forced": False, "precheck": (pc.get("output") if isinstance(pc, dict) else "") or "",
           "project": "", "model": "", "model_id": _model_id_from_stream(stream), "live": True}
    interactive = False
    try:
        for j in json.loads(JOBS_FILE.read_text()).get("jobs", []):
            if j.get("id") == jid:
                interactive = bool(j.get("interactive"))
                break
    except Exception:  # noqa: BLE001
        pass
    return {"record": rec, "live": True, "interactive": interactive,
            "api_retries": _api_retries(stream),
            "agent": {"result": last_text, "num_turns": turns, "session": sess,
                      "stop_reason": "still running"},
            "precheck": (pc.get("output") if isinstance(pc, dict) else "") or "",
            "stderr": "", "turns": parse_turns_text(stream),
            "conversation": parse_conversation(stream)}


def load_run_detail(jid, start):
    """Full detail for one run, keyed by (id, start) — served from the DB,
    which canonically holds result, stream, precheck and stderr."""
    try:
        start_i = int(str(start))
    except Exception:
        return None
    live = load_live_detail(jid, start_i)
    if live is not None:
        return live
    try:
        ingest()
    except Exception:
        pass
    conn = db_conn()
    try:
        db_init(conn)
        row = conn.execute(
            "SELECT * FROM runs WHERE job=? AND start=? ORDER BY rowid DESC LIMIT 1",
            (jid, start_i)).fetchone()
    finally:
        conn.close()
    if not row:
        return None
    rec = {"id": row["job"], "start": row["start"], "status": row["status"],
           "duration": row["duration"], "cost": row["cost"], "session": row["session"],
           "log": row["log"], "forced": bool(row["forced"]), "precheck": row["precheck_note"],
           "project": row["project"] or "",
           # The note IS the reason for anything the scheduler decided — stopped
           # by the operator, budget-limited, nothing to do. Leaving it out of
           # this payload meant the run modal had nothing to fall back on when
           # the agent log carried no stop reason of its own, and showed a dash
           # for a run whose journal entry said exactly why it ended.
           "note": row["note"] or "",
           "cause": row["cause"] or "",
           "model": row["model"] or "", "model_id": row["model_id"] or ""}
    detail = {"record": rec, "agent": {}, "precheck": row["precheck_txt"] or "",
              "stderr": (row["stderr"] or "")[:8000], "turns": []}
    try:
        data = json.loads(row["result_json"] or "{}")
        if isinstance(data, dict) and data:
            detail["agent"] = {
                "result": data.get("result", ""),
                "is_error": data.get("is_error"),
                "subtype": data.get("subtype"),
                "num_turns": data.get("num_turns"),
                "cost": data.get("total_cost_usd"),
                "session": data.get("session_id"),
                "permission_denials": data.get("permission_denials"),
                "stop_reason": data.get("stop_reason") or data.get("terminal_reason"),
                # What the API answered, when it is the API that ended the run.
                # The CLI reports this alongside a stop_reason describing the
                # last GOOD turn, so without it the page can only read the
                # innocent field. See the run modal's own note.
                "api_error_status": data.get("api_error_status"),
                "usage": data.get("usage"),
            }
    except Exception as e:  # noqa: BLE001
        detail["error"] = str(e)
    stream = row["stream"] or ""
    # A killed/crashed run has no final result event, so its stored record can be
    # blank — but the stream still holds everything it did. Rebuild the missing
    # pieces from it rather than showing an empty log (this also repairs runs
    # recorded before the engine learned to do it).
    a = detail["agent"]
    if not a.get("result"):
        last_text, turns, sess = _salvage_from_stream(stream)
        if last_text or turns:
            reason = a.get("stop_reason") or "the run ended without a final result — it was killed or crashed"
            detail["agent"] = {
                **a,
                "result": ("**Run did not finish — " + reason + ".**\n\n"
                           "The agent's last message before it stopped:\n\n" + last_text) if last_text else a.get("result", ""),
                "num_turns": a.get("num_turns") or turns,
                "session": a.get("session") or sess,
                "stop_reason": reason,
                "salvaged": True,
            }
    detail["turns"] = parse_turns_text(stream)
    detail["conversation"] = parse_conversation(stream)
    # A finished run that was refused all the way to the retry ceiling needs this
    # just as much as a live one: it is the only record of WHY there is no
    # transcript under a run that cost $0.00 and lasted three minutes.
    detail["api_retries"] = _api_retries(stream)
    return detail


def _tool_line(block):
    """Compact one-line description of a tool_use block."""
    name = block.get("name", "tool")
    inp = block.get("input") or {}
    hint = ""
    for key in ("command", "prompt", "jql", "file_path", "url", "query", "description"):
        v = inp.get(key)
        if isinstance(v, str) and v.strip():
            hint = v.strip().replace("\n", " ")
            break
    if not hint and inp:
        try:
            hint = json.dumps(inp, ensure_ascii=False)
        except Exception:
            hint = ""
    if len(hint) > 160:
        hint = hint[:157] + "…"
    return {"tool": name, "hint": hint}


def parse_turns_text(text):
    """One entry per assistant turn from a stream-json transcript: what the
    agent said and which tools it called. Empty text → [] (older runs)."""
    if not text:
        return []
    turns = []
    try:
        for ln in text.splitlines():
            ln = ln.strip()
            if not ln:
                continue
            try:
                ev = json.loads(ln)
            except Exception:
                continue
            if ev.get("type") != "assistant":
                continue
            msg = ev.get("message") or {}
            texts, tools = [], []
            for block in msg.get("content") or []:
                btype = block.get("type")
                if btype == "text" and (block.get("text") or "").strip():
                    texts.append(block["text"].strip())
                elif btype == "tool_use":
                    tools.append(_tool_line(block))
            if not texts and not tools:
                continue  # pure-thinking event, nothing observable
            text = " ".join(texts)
            if len(text) > 300:
                text = text[:297] + "…"
            turns.append({"n": len(turns) + 1, "text": text, "tools": tools})
            if len(turns) >= 300:
                break
    except Exception:
        pass
    return turns


def parse_conversation(text, limit=400):
    """The run as a dialogue: the human's messages AND the agent's, in order.

    `parse_turns_text` deliberately keeps only assistant turns (that is what the
    Timeline shows). The terminal needs both sides — an interactive run echoes
    the human's messages back into the stream (`--replay-user-messages`), so
    they are here too."""
    out = []
    if not text:
        return out
    for ln in text.splitlines():
        ln = ln.strip()
        if not ln:
            continue
        try:
            ev = json.loads(ln)
        except Exception:  # noqa: BLE001
            continue
        kind = ev.get("type")
        if kind not in ("assistant", "user"):
            continue
        msg = ev.get("message") or {}
        content = msg.get("content")
        if isinstance(content, str):
            content = [{"type": "text", "text": content}]
        texts, tools = [], []
        for block in content or []:
            if not isinstance(block, dict):
                continue
            bt = block.get("type")
            if bt == "text" and (block.get("text") or "").strip():
                texts.append(block["text"].strip())
            elif bt == "tool_use":
                tools.append(_tool_line(block))
            # tool_result blocks are the machine's echo — noise in a terminal
        if not texts and not tools:
            continue
        body = " ".join(texts)
        if len(body) > 2000:
            body = body[:1997] + "…"
        out.append({"role": "user" if kind == "user" else "agent",
                    "text": body, "tools": tools})
        if len(out) >= limit:
            break
    return out


def cc(args, stdin=None, background=False):
    """Invoke the agentloop CLI. Returns (ok, output)."""
    cmd = ["/bin/bash", AGENTLOOP] + args
    if background:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return True, "started"
    try:
        p = subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=30)
        return p.returncode == 0, (p.stdout + p.stderr).strip()
    except Exception as e:  # noqa: BLE001
        return False, str(e)


MODEL_FAMILIES = [
    ("opus",   "the most capable"),
    ("sonnet", "balanced capability and speed"),
    ("haiku",  "the fastest and cheapest"),
    ("fable",  "the newest generation"),
]


def list_models():
    """Every concrete model id a job can be pinned to.

    Only exact ids are offered: the user removed the family entries
    (opus/sonnet/…) from the picker on 2026-07-24, wanting each job to say
    precisely which model it runs. Families are still resolved behind the scenes
    and their resolutions are folded in here, which is how an id the installed
    CLI has never heard of (claude-opus-5) still appears. The engine keeps
    honouring a family value if some job still carries one.
    """
    resolved = {}
    try:
        data = json.loads((CONFIG_DIR / "models.json").read_text())
        resolved = data.get("resolved") or {}
    except Exception:  # noqa: BLE001
        resolved = {}
    families = []
    for fam, desc in MODEL_FAMILIES:
        r = resolved.get(fam) or {}
        families.append({"v": fam, "desc": desc, "id": r.get("id") or "", "at": r.get("at") or 0})

    ids = set()
    # Scan the CLI binary ourselves rather than shelling out to `strings`:
    # /usr/bin/strings belongs to the Xcode Command Line Tools, so on a machine
    # that never installed them it fails and the picker would come up empty.
    # python3 is already a hard dependency of this tool, so this always works.
    claude = os.environ.get("CLAUDE_CRON_CLAUDE_BIN") or str(Path.home() / ".local/bin/claude")
    try:
        with open(os.path.realpath(claude), "rb") as fh:
            blob = fh.read()
        ids.update(m.decode() for m in
                   re.findall(rb"claude-(?:opus|sonnet|haiku|fable)-\d+(?:-\d+)*", blob))
    except Exception:  # noqa: BLE001
        pass
    for f in families:                      # whatever the families resolve to
        if f["id"]:
            ids.add(f["id"])
    try:
        for j in json.loads(JOBS_FILE.read_text()).get("jobs", []):
            if j.get("model"):
                ids.add(j["model"])
    except Exception:  # noqa: BLE001
        pass
    try:
        conn = db_conn()
        try:
            for row in conn.execute("SELECT DISTINCT model_id FROM runs WHERE coalesce(model_id,'')<>''"):
                ids.add(row["model_id"])
        finally:
            conn.close()
    except Exception:  # noqa: BLE001
        pass
    ids -= {f[0] for f in MODEL_FAMILIES}

    fam_order = [f[0] for f in MODEL_FAMILIES]

    def sort_key(v):
        f = next((i for i, x in enumerate(fam_order) if x in v), 9)
        return (f, [-int(n) for n in re.findall(r"\d+", v)])   # newest first
    return {"models": sorted(ids, key=sort_key),
            "efforts": ["low", "medium", "high", "xhigh", "max"]}


def list_dirs(path):
    """List the sub-directories of `path` (default: $HOME) for the folder picker.
    Local, single-user tool: the server already runs as the user, so browsing
    their own filesystem is the intended use. Returns absolute paths; hides
    dot-directories; degrades gracefully on a bad path or a permission error."""
    home = os.path.expanduser("~")
    base = os.path.expanduser(path) if path else home
    try:
        base = os.path.realpath(base)
    except Exception:  # noqa: BLE001
        base = home
    if not os.path.isdir(base):
        base = os.path.dirname(base)
        if not os.path.isdir(base):
            base = home
    dirs = []
    try:
        for name in sorted(os.listdir(base), key=lambda s: s.lower()):
            if name.startswith("."):
                continue
            full = os.path.join(base, name)
            if os.path.isdir(full):
                dirs.append({"name": name, "path": full})
    except (PermissionError, OSError):
        pass
    parent = os.path.dirname(base)
    return {"path": base, "parent": (None if parent == base else parent), "dirs": dirs}


# ---------------------------------------------------------------- security
# Module-level and testable without an HTTP round trip, like the rest of this
# file's business logic — see tests/test_security_api.py.
REPORT_FORMATS = {"json": "application/json", "md": "text/markdown",
                  "html": "text/html; charset=utf-8",
                  # The stored CycloneDX inventory, not a report over the
                  # checklist. It was write-only until now: `prepare` built one
                  # on every analysis and nothing could read it back, which for
                  # a document whose only job is to be handed to somebody else
                  # is the same as not having built it.
                  "sbom": "application/json"}
# Where the download's file extension differs from the format's own name.
# `.cdx.json` is the conventional CycloneDX suffix, and the tools that consume
# one recognise a file by it; `analysis-7.sbom` is a file nothing will open.
REPORT_EXTENSIONS = {"sbom": "cdx.json"}
# A branch name reaches git through `agentloop security analyze` (bin/agentloop).
# Anything outside this set is refused HERE, at the edge, rather than quoted
# somewhere downstream and hoped about. The charset alone is not enough: '-'
# and '.' are both in it, so a leading '-' (which sits in an option position
# next to plumbing) and '..' (path/ref traversal) are refused explicitly below
# even though both match it.
BRANCH_OK = re.compile(r"^[A-Za-z0-9._/-]{1,255}$")
PROFILES = ("quick", "standard", "deep")


def _branch_ok(branch):
    # `fullmatch`, not `match`: with `$`, `re.match` anchors only the start and
    # `$` itself matches just before a trailing "\n" (not only at the true end
    # of string), so "main\n" would pass a `.match` check here even though it
    # is not a valid branch name. `fullmatch` requires the whole string to be
    # consumed, trailing newline included.
    return bool(BRANCH_OK.fullmatch(branch)) and not branch.startswith("-") and ".." not in branch


def _analysis_id(raw):
    """The `analysis` query/body param as an int, or None when it is not one.

    Checked here so a non-numeric value is a 400 at this edge, not int()'s
    ValueError two calls downstream, and not an argparse failure inside the
    CLI that the caller would only ever see as an opaque 500.
    """
    try:
        return int(raw)
    except (TypeError, ValueError):
        return None


def security_report_guard(fmt):
    if fmt not in REPORT_FORMATS:
        return 400, {"error": f"format must be one of {sorted(REPORT_FORMATS)}"}
    return 200, None


def security_report(analysis_id, fmt):
    """The rendered report body and its download header for one analysis.

    Only ever called once the id is a real int and the format has already
    passed `security_report_guard` — this function trusts both. The filename
    is built from that validated int and that validated format alone; no
    string the caller typed reaches this header.
    """
    ok, out = cc(["security", "render", "--analysis", str(int(analysis_id)),
                  "--format", fmt])
    if not ok:
        raise RuntimeError(out)
    # From a literal dict keyed by the already-validated format, never from the
    # caller's string: the same rule the int id above follows.
    ext = REPORT_EXTENSIONS.get(fmt, fmt)
    # The route (see `/api/security/report`) only ever receives the id and the
    # format the page's own fetch call sends (dashboard.html's `secDownload`)
    # -- never the project name -- so the export event this download earns is
    # filed under a project read back out of the ledger. `analysis --id` is a
    # lightweight verb that prints only the row: `checklist` used to be asked
    # here for the same single string, and it pays for a full diff/classify
    # pass (two `findings_of` calls, a `latest_analysis` query, a history
    # query across every prior analysis, `decisions_for`) to answer it. Best
    # effort: a project the CLI could not name (a stray warning on stdout, a
    # row gone between the render above and this lookup) must not turn an
    # otherwise successful download into a 500 -- the file the caller asked
    # for has already been rendered by the time this runs.
    ok2, meta = cc(["security", "analysis", "--id", str(int(analysis_id))])
    project = None
    if ok2:
        try:
            project = json.loads(meta)["project"]
        except (ValueError, KeyError, TypeError):
            project = None
    if project:
        cc(["security", "event", "--project", project,
            "--kind", "report_exported",
            "--detail", f"{fmt} report for analysis {int(analysis_id)}",
            "--related", str(int(analysis_id))])
    return out, {"Content-Disposition":
                 f'attachment; filename="security-analysis-{int(analysis_id)}.{ext}"'}


def _json_or_500(ok, out, what):
    """`out` decoded as JSON, or a 500 that says which call and why.

    `cc()` merges the CLI's stdout and stderr (see `cc`), so a warning printed
    on an otherwise successful run (rc 0) lands in `out` right alongside the
    clean JSON the CLI intends as its actual payload. Left unguarded,
    `json.loads` on that turns into an uncaught `JSONDecodeError` -- a dropped
    connection instead of a 500, and (for the caller polling for a restart) a
    stale check that silently never completes. A non-zero exit is already a
    500 with the CLI's own message; this is the same verdict for the rc-0
    case where the message just never reaches the page.
    """
    if not ok:
        return 500, {"error": out}
    try:
        return 200, json.loads(out)
    except ValueError:
        return 500, {"error": f"{what} produced output that was not valid JSON: {out!r}"}


def security_list(project):
    project = str(project or "").strip()
    if not project:
        # Mirrors /api/search's own refusal of a blank `q`: a missing project
        # used to reach the CLI as `--project ''`, which matches no analysis
        # and comes back a silent `200 []` -- indistinguishable from "this
        # project genuinely has none" rather than "you forgot the parameter".
        return 400, {"error": "project required"}
    ok, out = cc(["security", "list", "--project", project])
    return _json_or_500(ok, out, "security list")


def security_checklist(analysis_raw):
    aid = _analysis_id(analysis_raw)
    if aid is None:
        return 400, {"error": "analysis must be an integer"}
    ok, out = cc(["security", "checklist", "--analysis", str(aid)])
    return _json_or_500(ok, out, "security checklist")


def security_branches(project, repo):
    ok, out = cc(["security-branches", str(project), str(repo)])
    if not ok:
        return 500, {"error": out}
    return 200, {"branches": [b for b in out.splitlines() if b.strip()]}


def _security_projects():
    """Every security-enabled project, as the three fields
    `queries.project_rows` needs -- read fresh from projects.json on every
    call, the same file `load_config` already serves to the page whole. The
    ledger has no notion of a project's configuration (name, base branch,
    description), only of what has been recorded under a project's name, so
    this is the one place that bridges the two before `index-data` ever runs.

    Filtered to `security.enabled` exactly as `secEnabled` filters the old
    per-project list client-side (see ui/security/vocabulary.js): a project
    that has never turned analysis on has no posture to show, only an "off"
    row nothing on this screen computes for it.
    """
    out = []
    for p in read_json(PROJECTS_FILE, {}).get("projects", []):
        sec = p.get("security")
        enabled = isinstance(sec, dict) and sec.get("enabled") in (True, "true")
        if not enabled:
            continue
        out.append({"name": p.get("name", ""), "base": p.get("base", ""),
                   "description": p.get("description", "")})
    return out


def _project_meta(name):
    """One project's own configuration the ledger does not know -- its
    declared base branch and default security profile -- read fresh from
    projects.json, the same file `_security_projects()` reads for the whole
    fleet. A name matching nothing (never configured, or renamed) gets the
    same empty defaults `_security_projects()`'s exclusion already implies:
    nothing declared, so the CLI falls back to its own defaults."""
    for p in read_json(PROJECTS_FILE, {}).get("projects", []):
        if p.get("name") == name:
            sec = p.get("security") if isinstance(p.get("security"), dict) else {}
            return {"base": p.get("base", "") or "",
                   "default_profile": sec.get("default_profile", "") or ""}
    return {"base": "", "default_profile": ""}


def security_project(project):
    project = str(project or "").strip()
    if not project:
        return 400, {"error": "project required"}
    meta = _project_meta(project)
    ok, out = cc(["security", "project-data", "--project", project,
                  "--base", meta["base"], "--default-profile", meta["default_profile"]])
    return _json_or_500(ok, out, "project data")


SECURITY_INDEX_DEFAULT_WINDOW_DAYS = 30  # the mockup's own "Last 30 days"


def security_index(params=None):
    """Every panel the Security index screen draws, in ONE call to the CLI.

    The old per-project list (ui/security/projects.js) cost two subprocesses
    PER PROJECT on every load and every Refresh: one `security list`, and —
    for whichever project had a finished analysis — one `security checklist`
    on top. `index-data` computes the same ground (and more: the fleet-wide
    summary, recent analyses, the severity donut and its categories) as a
    single subprocess, however many projects are configured.

    `_json_or_500` is the same guard `security_list`/`security_checklist`
    already use for a non-zero exit AND for rc-0 chatter that is not valid
    JSON (`cc()` merges stdout and stderr) -- this used to be a second copy
    of that exact try/except.

    `params` is optional (`None` reads as no query string at all, exactly
    the polling and test call sites that predate this parameter) and carries
    two independent knobs:

    `days` -- the Findings-overview card's own period, forwarded to
    `queries.severity_totals`/`top_categories` (see their own docstrings for
    what a real window means now). ABSENT defaults to
    `SECURITY_INDEX_DEFAULT_WINDOW_DAYS` rather than those functions' own
    all-time default, so a caller that never asks for a period still gets
    the mockup's own "Last 30 days"; EXPLICIT, including `0` ("All time",
    the period picker's own `ACT_PERIODS` vocabulary), is passed straight
    through. Collapsing "absent" and "explicit 0" into one case would make
    "All time" silently mean "30 days" instead -- the identical trap
    `security_activity`'s own `since` parameter already refuses.

    `recent_page` -- the Recent-analyses table's own page, forwarded as
    `index-data`'s `--recent-page` (`queries.recent_analyses` pages the SQL
    itself; see that function's own docstring for why). Absent or invalid
    reads as page 1, the same clamp-not-reject treatment `security_activity`
    gives its own `page`.
    """
    params = params or {}
    raw_days = _param(params, "days", None)
    if raw_days is None:
        days = SECURITY_INDEX_DEFAULT_WINDOW_DAYS
    else:
        try:
            days = int(raw_days or 0)
        except (TypeError, ValueError):
            return 400, {"error": "days must be an integer"}
        if days < 0:
            days = 0

    try:
        recent_page = int(_param(params, "recent_page", "1") or 1)
    except (TypeError, ValueError):
        return 400, {"error": "recent_page must be an integer"}
    recent_page = max(1, recent_page)

    ok, out = cc(["security", "index-data",
                 "--projects", json.dumps(_security_projects()),
                 "--days", str(days), "--recent-page", str(recent_page)])
    return _json_or_500(ok, out, "index data")


def security_analyze(body):
    project = str(body.get("project", "")).strip()
    repo = str(body.get("repo", "")).strip()
    branch = str(body.get("branch", "")).strip()
    profile = str(body.get("profile", "standard")).strip()
    if not project or not repo:
        return 400, {"error": "project and repo are required"}
    if not _branch_ok(branch):
        return 400, {"error": "branch name has characters that are not allowed"}
    if profile not in PROFILES:
        return 400, {"error": f"profile must be one of {PROFILES}"}
    # --detach, and NOT cc(..., background=True). An analysis is minutes of
    # work and cc() gives a command 30 seconds before subprocess.run SIGKILLs
    # it: run inline this route timed out, and the killed shell never reached
    # the close, so the analysis stayed `running` for ever, the page's Analyse
    # button stayed disabled for that project and the agent was orphaned.
    # Backgrounding the WHOLE call would fix the timeout and lose the point of
    # the route: every refusal the CLI makes — security not enabled, no such
    # branch, one already running — is a sentence this page shows, and a
    # fire-and-forget Popen can only ever answer "started". --detach keeps the
    # synchronous half (the refusals, the analysis row, the request file) and
    # detaches only the run, so `output` carries the id of a row that really
    # exists.
    ok, out = cc(["security", "analyze", "--detach", project, repo, branch, profile])
    return (200, {"ok": True, "output": out}) if ok else (500, {"error": out})


FINDINGS_SORT = ("severity", "title", "category", "branch", "first_seen", "state")
# Every value below mirrors a closed set defined in bin/security/ — duplicated
# here, not imported, for the same reason PROFILES/BRANCH_OK/the literal
# state list in security_decide already are: this file shells out to the CLI
# rather than importing security/queries.py, so a bad value is refused at
# this edge BEFORE a subprocess is ever spawned, independently of whatever the
# CLI would have done with it. See security.queries.SORTABLE,
# security.report.SEVERITIES, security.diff.DERIVED_STATES +
# security.ledger.DECISION_STATES, and security.diff.DETERMINISTIC_CATEGORIES
# + ("sast",) — the design spec's own finding shape names them all.
FINDING_SEVERITIES = ("critical", "high", "medium", "low", "info")
FINDING_STATES = ("new", "open", "partial", "pending", "fixed", "regressed",
                  "accepted", "false_positive")
FINDING_CATEGORIES = ("secret", "dependency", "sast", "hygiene", "iac")
MAX_FINDINGS_PER_PAGE = 100


def _param(params, key, default=""):
    """One value for `key`, whether `params` holds it as a bare string (every
    test in this file that calls a route function directly) or as a list
    (what `parse_qs()` on a real query string hands the route) -- the first
    element wins for a list, exactly like `(q.get(...) or [""])[0]` already
    does at every other GET route in this file."""
    raw = params.get(key, default)
    if isinstance(raw, list):
        return raw[0] if raw else default
    return raw


def _param_list(params, key):
    """Every value for `key`, comma-split and flattened. Covers three shapes
    with the one pass: a raw `parse_qs()` list from repeated query params
    (`?severity=critical&severity=high`), a single comma-joined value (this
    page's own checkbox filters, joined client-side before the request goes
    out), and a bare string a test hands in directly, skipping the query
    string layer entirely. An absent key is an empty list, not `[""]`."""
    raw = params.get(key)
    if raw is None:
        return []
    items = raw if isinstance(raw, list) else [raw]
    out = []
    for item in items:
        out.extend(v.strip() for v in str(item).split(",") if v.strip())
    return out


def _checked_list(params, key, known):
    """`_param_list`'s values, refused as a whole the moment one of them is
    not in `known` -- severity/state/category are closed vocabularies, and a
    value outside them is not a filter that matches nothing, it is a typo (or
    an injection attempt) that deserves a sentence, not a silently empty
    result."""
    values = _param_list(params, key)
    bad = [v for v in values if v not in known]
    if bad:
        return None, {"error": f"{key} must be one of {sorted(known)}, got {bad[0]!r}"}
    return values, None


def security_findings(params):
    """`GET /api/security/findings` — every row `queries.finding_rows` (Task
    6) draws for one project, plus that project's saved filters
    (`ledger.saved_filters`, Task 4) in the same payload; see
    `bin/security/cli.py`'s `findings-page`, which bundles both the same way
    `index-data`/`project-data` already bundle a whole screen's panels into
    one call.

    `sort`/`direction` are an allowlist refused here, at the edge, before a
    subprocess is ever spawned -- `sort` is interpolated by nature inside
    `queries.finding_rows`'s own ORDER-adjacent logic (see that function's
    docstring), the one thing a query parameter cannot protect on its own.
    `page`/`per_page` are shape-checked (a non-integer is a 400) and then
    CLAMPED, not refused for being out of range -- exactly the treatment
    `queries.finding_rows` itself gives them, so a value this route would
    clamp anyway never reaches argv, where it is one more thing visible to
    anyone reading the process list. `severity`/`state`/`category` are
    checked against their closed vocabularies; `branch`/`path`/`q` are free
    text and travel as a single argv element each, never as shell -- `cc()`
    always calls `subprocess.run` with a list, never a shell string, so
    nothing about their CONTENT needs escaping, only their shape (a list of
    strings) needs to stay a list.
    """
    project = str(_param(params, "project")).strip()
    if not project:
        return 400, {"error": "project required"}

    sort = str(_param(params, "sort", "severity") or "severity").strip()
    if sort not in FINDINGS_SORT:
        return 400, {"error": f"sort must be one of {FINDINGS_SORT}"}
    direction = str(_param(params, "dir", "desc") or "desc").strip()
    if direction not in ("asc", "desc"):
        return 400, {"error": "dir must be asc or desc"}

    try:
        page = int(_param(params, "page", "1") or 1)
    except (TypeError, ValueError):
        return 400, {"error": "page must be an integer"}
    page = max(1, page)
    try:
        per_page = int(_param(params, "per_page", "25") or 25)
    except (TypeError, ValueError):
        return 400, {"error": "per_page must be an integer"}
    per_page = max(1, min(per_page, MAX_FINDINGS_PER_PAGE))

    severity, err = _checked_list(params, "severity", FINDING_SEVERITIES)
    if err:
        return 400, err
    state, err = _checked_list(params, "state", FINDING_STATES)
    if err:
        return 400, err
    category, err = _checked_list(params, "category", FINDING_CATEGORIES)
    if err:
        return 400, err

    branch = str(_param(params, "branch")).strip()
    path = str(_param(params, "path")).strip()
    q = str(_param(params, "q")).strip()
    show_resolved = str(_param(params, "show_resolved")).strip().lower() in ("1", "true", "yes")

    # A PREFIX, not the full 64-character shape `security_report`-adjacent
    # code enforces on a written fingerprint -- this is Task 12's Activity
    # screen linking a decision's `related` (only ever 12 characters) into
    # this browser, "filtered to it". Shape-checked here, at the edge, the
    # same reasoning severity/state/category already get: a value that is
    # not lowercase hex is a typo, not a filter that legitimately matches
    # nothing.
    fingerprint = str(_param(params, "fingerprint")).strip().lower()
    if fingerprint and not re.fullmatch(r"[0-9a-f]{1,64}", fingerprint):
        return 400, {"error": "fingerprint must be lowercase hex"}

    analysis_ids = []
    for raw in _param_list(params, "analysis"):
        try:
            analysis_ids.append(int(raw))
        except ValueError:
            return 400, {"error": f"analysis must be a list of integers, got {raw!r}"}

    args = ["security", "findings-page", "--project", project,
           "--sort", sort, "--dir", direction,
           "--page", str(page), "--per-page", str(per_page)]
    for s in severity:
        args += ["--severity", s]
    for s in state:
        args += ["--state", s]
    for s in category:
        args += ["--category", s]
    if branch:
        args += ["--branch", branch]
    for a in analysis_ids:
        args += ["--analysis", str(a)]
    if path:
        args += ["--path", path]
    if q:
        args += ["--q", q]
    if show_resolved:
        args.append("--show-resolved")
    if fingerprint:
        args += ["--fingerprint", fingerprint]

    ok, out = cc(args)
    return _json_or_500(ok, out, "findings page")


# Duplicated from `security.ledger.EVENT_KINDS`, not imported -- same
# reasoning as FINDING_SEVERITIES/FINDING_STATES/FINDING_CATEGORIES above:
# this file shells out to the CLI rather than importing security/ledger.py,
# so a typo'd kind is refused at THIS edge, before a subprocess is ever
# spawned, independently of whatever the CLI's own `choices=` would have
# done with it.
ACTIVITY_KINDS = ("analysis_started", "analysis_finished", "decision_made",
                  "settings_changed", "report_exported")
ACTIVITY_MAX_PER_PAGE = 500  # mirrors ledger.events_for's own ceiling
ACTIVITY_DEFAULT_WINDOW_DAYS = 30


def security_activity(params):
    """`GET /api/security/activity` -- every event `ledger.events_for` (Task
    3) returns for the period and kind(s) asked, the per-kind counts
    `queries.activity_summary` (Task 5) gives the SAME period, and which
    projects were busiest in it. See `bin/security/cli.py`'s `activity-data`.

    `kind` is validated against the closed vocabulary above, the same
    treatment `security_findings` gives severity/state/category: a typo is
    not a filter that matches nothing, it is a mistake worth a sentence.

    `since` ABSENT (the key missing from `params` entirely) defaults to
    `ACTIVITY_DEFAULT_WINDOW_DAYS` ago rather than `ledger.events_for`'s own
    "no lower bound" -- so a caller that never asks for a period still gets a
    legible, bounded one, the same window `queries.activity_summary`'s own
    default describes, so the table and the sidebar's per-kind counts agree
    on what period they are both showing unless the caller deliberately
    widens it.

    `since` EXPLICIT, including `0` or any negative value, is passed straight
    through as "no lower bound" -- `ledger.events_for`'s own contract. This is
    the only way the client can ask for everything: the screen's "All time"
    period (`secActSince()`, ui/security/activity-screen.js) always sends a
    `since` parameter, and for "All time" that value is `0`, on purpose, to
    reach exactly this branch. Collapsing "absent" and "explicit 0" into one
    case (as this route used to) makes "All time" silently mean "30 days"
    instead -- the request is present on the wire, it is simply never told
    apart from a caller who asked for nothing. `page`/`per_page` are
    shape-checked then clamped, exactly like `security_findings`'s own.
    """
    project = str(_param(params, "project")).strip()

    kinds, err = _checked_list(params, "kind", ACTIVITY_KINDS)
    if err:
        return 400, err

    raw_since = _param(params, "since", None)
    if raw_since is None:
        since = int(time.time()) - ACTIVITY_DEFAULT_WINDOW_DAYS * 86400
    else:
        try:
            since = int(raw_since or 0)
        except (TypeError, ValueError):
            return 400, {"error": "since must be an integer"}
        if since < 0:
            since = 0

    try:
        page = int(_param(params, "page", "1") or 1)
    except (TypeError, ValueError):
        return 400, {"error": "page must be an integer"}
    page = max(1, page)
    try:
        per_page = int(_param(params, "per_page", "25") or 25)
    except (TypeError, ValueError):
        return 400, {"error": "per_page must be an integer"}
    per_page = max(1, min(per_page, ACTIVITY_MAX_PER_PAGE))

    args = ["security", "activity-data", "--since", str(since),
           "--page", str(page), "--per-page", str(per_page)]
    if project:
        args += ["--project", project]
    for k in kinds:
        args += ["--kind", k]

    ok, out = cc(args)
    return _json_or_500(ok, out, "activity data")


def security_filter_save(body):
    project = str(body.get("project", "")).strip()
    name = str(body.get("name", "")).strip()
    if not project:
        return 400, {"error": "project required"}
    if not name:
        # Mirrors ledger.save_filter's own refusal (bin/security/ledger.py),
        # checked here too so the page gets a usable message instead of a 500
        # from a CLI that exited non-zero.
        return 400, {"error": "a saved filter needs a name"}
    query = body.get("query")
    if not isinstance(query, dict):
        # Same shape check report-finding/filters-save already make on their
        # own JSON body: a caller that forgot the current filter set, or sent
        # something that is not an object, saves an empty query rather than
        # failing the whole request over one field.
        query = {}
    ok, out = cc(["security", "filters", "save", "--project", project, "--name", name],
                stdin=json.dumps(query))
    return (200, {"ok": True}) if ok else (500, {"error": out})


def security_filter_delete(body):
    project = str(body.get("project", "")).strip()
    name = str(body.get("name", "")).strip()
    if not project or not name:
        return 400, {"error": "project and name are required"}
    ok, out = cc(["security", "filters", "delete", "--project", project, "--name", name])
    return _json_or_500(ok, out, "filters delete")


def security_decide(body):
    project = str(body.get("project", "")).strip()
    fingerprint = str(body.get("fingerprint", "")).strip()
    state = body.get("state")
    reason = str(body.get("reason", ""))
    if not project or not fingerprint:
        return 400, {"error": "project and fingerprint are required"}
    # The identity shape `report-finding` already enforces on a written
    # fingerprint (bin/security/cli.py's FINGERPRINT_RE), applied at the route
    # too -- not merely non-empty. A malformed value used to write a decision
    # row AND a `decision_made` event, so the Activity screen told the
    # operator the risk had been accepted while the finding stayed open on
    # every other screen, since no finding can ever carry that identity. The
    # CLI refuses it as well; both doors, because neither is the only one.
    if not re.fullmatch(r"[0-9a-f]{64}", fingerprint):
        return 400, {"error": "fingerprint must be 64 lowercase hex characters"}
    if not reason.strip():
        # Mirrors the ledger's own refusal (bin/security/ledger.py:set_decision),
        # checked here too so the page gets a usable message instead of a 500
        # from a CLI that exited non-zero.
        return 400, {"error": "a decision needs a reason"}
    if state not in ("accepted", "false_positive"):
        return 400, {"error": "state must be accepted or false_positive"}
    ok, out = cc(["security", "decide",
                  "--project", project, "--fingerprint", fingerprint,
                  "--state", str(state), "--reason", reason,
                  # Never taken from the request body: the agent under review
                  # reaches this same door, and a name it supplied itself would
                  # let it sign its own suppression.
                  "--by", (load_user() or {}).get("name", "")])
    return (200, {"ok": True}) if ok else (500, {"error": out})


class Handler(BaseHTTPRequestHandler):
    server_version = "agentloop/3"

    def log_message(self, *a):  # silence stderr access log
        pass

    # ---- helpers -------------------------------------------------------
    def _send(self, code, body, ctype="application/json; charset=utf-8", cookie=None,
              extra_headers=None):
        if isinstance(body, (dict, list)):
            body = json.dumps(body)
        data = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        if cookie:
            self.send_header("Set-Cookie", cookie)
        if extra_headers:
            for k, v in extra_headers.items():
                self.send_header(k, v)
        self.end_headers()
        try:
            self.wfile.write(data)
        except BrokenPipeError:
            pass

    def _authed(self) -> bool:
        origin = self.headers.get("Origin")
        if origin is not None and origin not in ALLOWED_ORIGINS:
            return False
        return secrets.compare_digest(self.headers.get("X-CC-Token", ""), TOKEN)

    def _raw_session(self) -> str:
        jar = SimpleCookie()
        try:
            jar.load(self.headers.get("Cookie", ""))
        except CookieError:
            return ""
        morsel = jar.get(SESSION_COOKIE)
        return morsel.value if morsel else ""

    def _signed_in(self):
        return touch_session(self._raw_session())

    def _gate(self):
        """The two checks every real endpoint needs, as one answer.

        Returns None when the call may proceed, or the (code, payload) to send
        back. 401 and 428 are told apart deliberately: the page shows a login
        screen for one and a create-profile screen for the other, and it cannot
        guess which from a bare 403.
        """
        if not self._authed():
            return 403, {"error": "forbidden"}
        if _operator_row() is None:
            return 428, {"error": "set up the operator profile first"}
        if not self._signed_in():
            return 401, {"error": "sign in first"}
        return None

    @staticmethod
    def _cookie_header(raw, keep):
        """HttpOnly so page scripts cannot read it, SameSite=Strict so it is
        never sent from another site — the same anti-CSRF stance as the token.
        No Secure: this server is http on loopback by design."""
        base = f"{SESSION_COOKIE}={raw}; HttpOnly; SameSite=Strict; Path=/"
        # A session cookie (no Max-Age) dies with the browser; "keep me logged
        # in" is what makes it outlive the window, matching the row that has no
        # expiry either.
        return base + ("; Max-Age=34560000" if keep else "")

    def _body_json(self):
        try:
            n = int(self.headers.get("Content-Length", "0"))
            return json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            return {}

    def handle_one_request(self):
        """Answer the request, then check whether this process is still the code
        on disk.

        After the response, and after EVERY request rather than off one route.
        It used to hang off /api/data, which stopped working the moment that
        route went behind the session gate: a signed-out page polls nothing, so a
        stale server could never learn it was stale — and the deadlock was total,
        because the version it was stuck on had no /api/login to sign in with.
        Staleness is a property of the process, not of one endpoint.
        """
        super().handle_one_request()
        self._restart_if_stale()

    def _restart_if_stale(self):
        """Step aside so launchd starts the version that is actually on disk.

        An upgrade lands within one request without anyone remembering to kick
        the agent. Only under launchd: a server started by hand has nothing to
        bring it back. The response is already written; the delay lets it flush
        before the process goes.
        """
        if not code_is_stale() or not server_supervised():
            return
        print("agentloop-server: the server file changed on disk — exiting so "
              "launchd restarts it on the new code", flush=True)
        threading.Timer(0.4, lambda: os._exit(0)).start()

    # ---- routes --------------------------------------------------------
    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/health":
            return self._send(200, {"ok": True})
        # The one endpoint that answers before you are signed in — it is what
        # tells the page whether to draw the dashboard, the login screen or the
        # create-profile screen.
        if path == "/api/session":
            sess = self._signed_in()
            return self._send(200, {"configured": _operator_row() is not None,
                                    "authenticated": bool(sess),
                                    "keep": bool(sess and sess["keep"]),
                                    "user": load_user() if sess else None})
        # Before the gate on purpose. The bundle is not secret -- it ships in
        # git, in every install -- and the page that draws the LOGIN card is the
        # same page the dashboard is, so gating this would leave a signed-out
        # browser holding a page whose code it is not allowed to fetch.
        if path.startswith("/static/"):
            body, ctype = static_asset(path[len("/static/"):])
            if body is None:
                return self._send(404, {"error": "not found"})
            return self._send(200, body, ctype)
        # One gate for every remaining endpoint, rather than a check per route
        # that a new route can forget to copy.
        if path.startswith("/api/"):
            gate = self._gate()
            if gate:
                return self._send(*gate)
        if path == "/api/data":
            return self._send(200, load_data())
        if path == "/api/config":
            return self._send(200, load_config())
        if path == "/api/search":
            q = (parse_qs(urlparse(self.path).query).get("q") or [""])[0].strip()
            if not q:
                return self._send(400, {"error": "q required"})
            try:
                return self._send(200, search_runs(q))
            except Exception as e:  # noqa: BLE001
                return self._send(500, {"error": str(e)})
        if path == "/api/log":
            q = parse_qs(urlparse(self.path).query)
            jid = (q.get("id") or [""])[0]
            start = (q.get("start") or [""])[0]
            if not jid or not start:
                return self._send(400, {"error": "id and start required"})
            d = load_run_detail(jid, start)
            if d is None:
                return self._send(404, {"error": "run not found"})
            return self._send(200, d)
        if path == "/api/models":
            try:
                return self._send(200, list_models())
            except Exception as e:  # noqa: BLE001
                return self._send(500, {"error": str(e)})
        if path == "/api/security":
            q = parse_qs(urlparse(self.path).query)
            code, payload = security_list((q.get("project") or [""])[0])
            return self._send(code, payload)
        if path == "/api/security/index":
            q = parse_qs(urlparse(self.path).query)
            code, payload = security_index(q)
            return self._send(code, payload)
        if path == "/api/security/project":
            q = parse_qs(urlparse(self.path).query)
            code, payload = security_project((q.get("project") or [""])[0])
            return self._send(code, payload)
        if path == "/api/security/findings":
            q = parse_qs(urlparse(self.path).query)
            code, payload = security_findings(q)
            return self._send(code, payload)
        if path == "/api/security/activity":
            q = parse_qs(urlparse(self.path).query)
            code, payload = security_activity(q)
            return self._send(code, payload)
        if path == "/api/security/checklist":
            q = parse_qs(urlparse(self.path).query)
            code, payload = security_checklist((q.get("analysis") or [""])[0])
            return self._send(code, payload)
        if path == "/api/security/branches":
            q = parse_qs(urlparse(self.path).query)
            code, payload = security_branches((q.get("project") or [""])[0],
                                              (q.get("repo") or [""])[0])
            return self._send(code, payload)
        if path == "/api/security/report":
            q = parse_qs(urlparse(self.path).query)
            fmt = (q.get("format") or [""])[0]
            code, err = security_report_guard(fmt)
            if err:
                return self._send(code, err)
            aid = _analysis_id((q.get("analysis") or [""])[0])
            if aid is None:
                return self._send(400, {"error": "analysis must be an integer"})
            try:
                body, headers = security_report(aid, fmt)
            except RuntimeError as exc:
                return self._send(500, {"error": str(exc)})
            return self._send(200, body, REPORT_FORMATS[fmt], extra_headers=headers)
        if path == "/api/fs":
            p = (parse_qs(urlparse(self.path).query).get("path") or [""])[0]
            try:
                return self._send(200, list_dirs(p))
            except Exception as e:  # noqa: BLE001
                return self._send(500, {"error": str(e)})
        if path == "/":
            # Same three states applyGates() works from, answered here so the
            # page does not have to wait for /api/session to know which to show.
            boot = ("boot-setup" if _operator_row() is None
                    else "boot-authed" if self._signed_in() else "boot-login")
            return self._send(200, render_page(boot), "text/html; charset=utf-8")
        return self._send(404, {"error": "not found"})

    def do_OPTIONS(self):
        # Deliberately no Access-Control-Allow-* → browser blocks cross-origin
        # preflight for our custom-header requests. This is the anti-CSRF gate.
        self._send(403, {"error": "no cors"})

    def do_POST(self):
        path = self.path.split("?", 1)[0]
        if path not in ("/api/action", "/api/login", "/api/logout"):
            return self._send(404, {"error": "not found"})
        # Every POST still has to come from our own page; only the session
        # requirement differs between signing in and doing anything else.
        if not self._authed():
            return self._send(403, {"error": "forbidden"})
        body = self._body_json()

        if path == "/api/login":
            ok, err = check_login(body.get("email"), body.get("password"))
            if not ok:
                return self._send(401, {"error": err})
            keep = bool(body.get("keep"))
            raw = create_session(keep)
            return self._send(200, {"ok": True, "keep": keep, "user": load_user()},
                              cookie=self._cookie_header(raw, keep))
        if path == "/api/logout":
            destroy_session(self._raw_session())
            # Expire the cookie too — a row-only delete leaves the browser
            # presenting a dead token forever and the tab looking half signed in.
            return self._send(200, {"ok": True},
                              cookie=f"{SESSION_COOKIE}=; HttpOnly; SameSite=Strict; Path=/; Max-Age=0")

        op = body.get("op", "")
        # First-run setup, and the gate that makes it mandatory. It signs the
        # operator straight in: they just typed the password twice, and asking
        # for it a third time on the next screen is a form for its own sake.
        if op == "profile_create":
            code, payload = create_operator(body.get("name"), body.get("email"),
                                            body.get("password"), body.get("password2"))
            if code != 200:
                return self._send(code, payload)
            keep = bool(body.get("keep"))
            raw = create_session(keep)
            return self._send(200, dict(payload, keep=keep),
                              cookie=self._cookie_header(raw, keep))
        gate = self._gate()
        if gate:
            return self._send(*gate)

        if op == "prefs_set":
            code, payload = set_pref(str(body.get("key", "")), body.get("value"))
            return self._send(code, payload)

        # Behind the gate, unlike profile_create: this one edits a profile that
        # already exists, so it needs the session that create_operator issues.
        # `avatar` stays absent rather than empty when the form did not touch it.
        if op == "profile_update":
            code, payload = update_operator(
                body.get("name"), body.get("email"),
                body.get("avatar") if "avatar" in body else None,
                body.get("current"), body.get("password"), body.get("password2"))
            return self._send(code, payload)

        # Project ops are keyed by name, not by a job id — handle before the id check.
        if op == "project_set":
            proj = body.get("project")
            if not isinstance(proj, dict) or not str(proj.get("name", "")).strip():
                return self._send(400, {"error": "missing project name"})
            ok, out = cc(["project-set"], stdin=json.dumps(proj))
            return self._send(200 if ok else 500, {"ok": ok, "output": out})
        if op in ("provision_get", "provision_set"):
            name = str(body.get("name", "")).strip()
            phase = str(body.get("phase", "")).strip()
            if not name or phase not in ("up", "down"):
                return self._send(400, {"error": "need a project name and phase up|down"})
            if op == "provision_get":
                ok, out = cc(["provision-get", name, phase])
                return self._send(200 if ok else 500, {"ok": ok, "script": out})
            # An empty script is meaningful here, unlike a precheck: it clears
            # the hook, which is the only way to say "this project provisions
            # nothing" once it has said otherwise.
            script = body.get("script", "")
            if not isinstance(script, str):
                return self._send(400, {"error": "script must be a string"})
            ok, out = cc(["provision-set", name, phase], stdin=script)
            return self._send(200 if ok else 500, {"ok": ok, "output": out})
        if op == "project_rename":
            # A project's name IS its identity — jobs reference it by name, so
            # the engine renames both sides and refuses a name already in use.
            old = str(body.get("name", "")).strip()
            new = str(body.get("new_name", "")).strip()
            if not old or not new:
                return self._send(400, {"error": "missing project name"})
            ok, out = cc(["project-rename", old, new])
            return self._send(200 if ok else 409,
                              {"ok": True, "output": out} if ok else {"error": out or "rename refused"})
        if op == "run_delete":
            # Erase one run for good: files, journal line and DB rows.
            jid = str(body.get("id", ""))
            try:
                start = int(body.get("start") or 0)
            except (TypeError, ValueError):
                start = 0
            if not jid or not start:
                return self._send(400, {"error": "missing run id/start"})
            # A run still in flight has no journal line yet (it is written when
            # the run ends), so deleting it would silently do nothing. Say so.
            if active_runs_for(jid):
                try:
                    st = (json.loads(STATE_FILE.read_text()) or {}).get(jid) or {}
                except Exception:  # noqa: BLE001
                    st = {}
                if st.get("last_status") == "running" and int(st.get("last_start") or 0) == start:
                    return self._send(409, {"error": "this run is still going — stop it first"})
            try:
                res = delete_run(jid, start)
            except TimeoutError as e:
                # The engine is rewriting the journal right now. Refusing is the
                # honest answer — the alternative is stealing its lock and
                # losing whatever it was writing.
                return self._send(409, {"error": str(e)})
            if res is None:
                return self._send(404, {"error": "no such run"})
            return self._send(200, {"ok": True, "output": "deleted", "removed": res})
        if op == "worktree_drop":
            # Discarding a retained run dir throws away whatever it holds —
            # which is the point (it is kept because its SESSION is still
            # open: cut short, never declared an ending, or holding work on
            # no remote — not only for unpushed work specifically), so the
            # engine owns the refusal rules and this only forwards.
            wjid = str(body.get("id", ""))
            stamp = str(body.get("stamp", ""))
            if not wjid or not all(c.isalnum() or c in "-_" for c in wjid):
                return self._send(400, {"error": "bad id"})
            if not stamp or not all(c.isalnum() or c in "-_." for c in stamp) or ".." in stamp:
                return self._send(400, {"error": "bad stamp"})
            ok, out = cc(["worktree-drop", wjid, stamp])
            return self._send(200 if ok else 409,
                              {"ok": True, "output": out} if ok else {"error": out or "refused"})
        if op == "project_delete":
            name = str(body.get("name", "")).strip()
            if not name:
                return self._send(400, {"error": "missing project name"})
            ok, out = cc(["project-delete", name])
            return self._send(200 if ok else 500, {"ok": ok, "output": out})
        # Keyed by project (+fingerprint for a decision), not by a job id —
        # handled here, alongside the other project-keyed ops, before the id
        # check below would otherwise refuse them for having no "id".
        if op == "security_analyze":
            return self._send(*security_analyze(body))
        if op == "security_decide":
            return self._send(*security_decide(body))
        if op == "security_filter_save":
            return self._send(*security_filter_save(body))
        if op == "security_filter_delete":
            return self._send(*security_filter_delete(body))

        # Reorder carries a LIST of ids rather than one — handle it before the
        # single-id check below. Jobs outside the list keep their positions, so
        # reordering one project group never disturbs another.
        if op == "reorder":
            order = body.get("order")
            if not isinstance(order, list) or not order:
                return self._send(400, {"error": "no order given"})
            if not all(isinstance(x, str) and x and all(c.isalnum() or c in "-_" for c in x) for x in order):
                return self._send(400, {"error": "bad id in order"})
            ok, out = cc(["reorder"], stdin=json.dumps(order))
            return self._send(200 if ok else 409, {"ok": ok, "output": out} if ok
                              else {"error": out or "reorder refused"})

        # A bulk switch carries a LIST of ids and a flag rather than one id —
        # handle it before the single-id check below, like reorder above.
        if op == "toggle_many":
            ids = body.get("ids")
            val = body.get("enabled")
            if not isinstance(ids, list) or not ids:
                return self._send(400, {"error": "no ids given"})
            if not all(isinstance(x, str) and x and all(c.isalnum() or c in "-_" for c in x) for x in ids):
                return self._send(400, {"error": "bad id in list"})
            # A real boolean only: the string "false" is truthy on the other end
            # of the wire, so coercing it would turn "disable all" into its
            # opposite. isinstance(True, int) is also true, so check bool first.
            if not isinstance(val, bool):
                return self._send(400, {"error": "missing enabled flag"})
            ok, out = cc(["toggle-many", "true" if val else "false"], stdin=json.dumps(ids))
            return self._send(200 if ok else 409, {"ok": ok, "output": out} if ok
                              else {"error": out or "refused"})

        jid = str(body.get("id", ""))
        if not jid or not all(c.isalnum() or c in "-_" for c in jid):
            return self._send(400, {"error": "bad id"})

        if op == "create":
            job = body.get("job")
            if not isinstance(job, dict) or not job.get("id"):
                return self._send(400, {"error": "missing job object"})
            ok, out = cc(["create"], stdin=json.dumps(job))
            if ok:
                pc = body.get("precheck")
                if isinstance(pc, str) and pc.strip():
                    cc(["set-precheck", str(job["id"])], stdin=pc)
            return self._send(200 if ok else 500, {"ok": ok, "output": out})
        if op == "precheck_get":
            # Fetched when the editor opens, instead of riding along on every
            # 5-second poll for all 21 jobs. Same shape as provision_get.
            ok, out = cc(["get-precheck", jid])
            return self._send(200 if ok else 500, {"ok": ok, "script": out})
        if op == "set_precheck":
            script = body.get("script", "")
            if not isinstance(script, str) or not script.strip():
                return self._send(400, {"error": "empty script"})
            ok, out = cc(["set-precheck", jid], stdin=script)
            return self._send(200 if ok else 500, {"ok": ok, "output": out})
        if op == "precheck":
            # The Run now guard: does the precheck see work? It RECORDS what it
            # saw, so the card's "last check" reflects the probe the user just
            # triggered — reading a check and then showing an older one is how a
            # card ends up describing a board that has since moved on.
            ok, out = cc(["precheck", jid])
            # Exit 0 is the engine's own "there is work" signal; a job with no
            # precheck at all runs on every due tick, so it always has work.
            work = ("no precheck configured" in out) or ("(exit 0)" in out)
            # Same three-way contract as the engine (0 work / 1 idle / else
            # broken), so the Run-now guard can say "your probe is broken"
            # instead of the far more misleading "nothing to do".
            m = re.search(r"\(exit (\d+)\)\s*$", out.strip())
            broken = bool(m) and m.group(1) not in ("0", "1")
            return self._send(200 if ok else 500,
                              {"ok": ok, "work": work, "broken": broken, "output": out})

        if op == "run":
            # Multiple runs of one job may now run in parallel (each isolated in
            # its own worktree), capped by the job's max_parallel. The forced run
            # is detached, so check the ceiling first — otherwise the dashboard
            # would report "Started" when the engine silently skipped it at cap.
            full, n, ceiling = at_capacity(jid)
            if full:
                return self._send(409, {
                    "error": f"{jid} already has {n} run{'' if n == 1 else 's'} going and its limit "
                             f"is {ceiling} at a time, so nothing was started. Stop a run, wait for "
                             f"one to finish, or raise “Max simultaneous runs” on this job.",
                    "running": True, "at_capacity": True, "running_count": n, "max_parallel": ceiling})
            ok, out = cc(["run", jid], background=True)
        elif op == "stop":
            # With concurrent runs, a stop targets ONE run by its pid; no pid = all.
            pid = body.get("pid")
            ok, out = cc(["stop", jid, str(pid)] if pid else ["stop", jid])
        elif op == "resume":
            # Resume THE SAME TASK: continue that run's own session
            # (`claude --resume <sid>`), not a fresh run of the job.
            sid = (body.get("session") or "").strip()
            if not sid:
                return self._send(400, {"error": "this run has no session id to resume"})
            # One resume per session at a time: the same conversation continued
            # twice in parallel would have both runs doing the same work.
            if resume_in_flight(jid, sid):
                return self._send(409, {"error": "this task is already being resumed right now"})
            full, n, ceiling = at_capacity(jid)
            if full:
                return self._send(409, {
                    "error": f"{jid} already has {n} run{'' if n == 1 else 's'} going and its limit "
                             f"is {ceiling} at a time, so this task was not resumed. Stop a run, wait "
                             f"for one to finish, or raise “Max simultaneous runs” on this job.",
                    "running": True, "at_capacity": True, "running_count": n, "max_parallel": ceiling})
            # Asked BEFORE the launch for the same reason at_capacity is: the
            # engine's own refusal lands after `cc` has detached, so without
            # this the dashboard reports a resume that the engine then declines,
            # naming the reason only in tick.log.
            block, holder = resume_port_block_held_by(jid, sid)
            if holder:
                who = holder["job"] + (f" (pid {holder['pid']})" if holder["pid"] else "")
                return self._send(409, {
                    "error": f"this task's services are bound to port block {block}, and the run "
                             f"{who} is holding it right now, so it was not resumed. A resume has to "
                             f"have that exact block — a fresh one would point the resumed agent at "
                             f"ports nothing is listening on. Stop that run, or wait for it to finish "
                             f"and try again.",
                    "running": True, "port_block_held": True,
                    "port_block": block, "held_by": holder})
            ok, out = cc(["resume", jid, sid], background=True)
        elif op == "say":
            # Deliver a human message into the run that is happening right now.
            text = body.get("text", "")
            if not isinstance(text, str) or not text.strip():
                return self._send(400, {"error": "empty message"})
            ok, out = cc(["say", jid], stdin=text)
            if not ok:
                return self._send(409, {"error": out or "could not deliver"})
        elif op == "rename":
            # The engine owns every rule here (id syntax, collisions, refusing
            # while a run is live) and migrates state/logs/journal with the id.
            new = (body.get("new_id") or "").strip()
            if not new:
                return self._send(400, {"error": "no new id given"})
            ok, out = cc(["rename", jid, new])
            if not ok:
                return self._send(409, {"error": out or "rename refused"})
        elif op == "enable":
            ok, out = cc(["enable", jid])
        elif op == "disable":
            ok, out = cc(["disable", jid])
        elif op == "delete":
            ok, out = cc(["delete", jid])
        elif op == "set_prompt":
            prompt = body.get("prompt", "")
            if not isinstance(prompt, str) or not prompt.strip():
                return self._send(400, {"error": "empty prompt"})
            ok, out = cc(["set-prompt", jid], stdin=prompt)
        elif op == "set_field":
            field = str(body.get("field", ""))
            value = str(body.get("value", ""))
            if field not in ("interval_seconds", "active_hours", "active_days",
                             "max_budget_usd", "daily_budget_usd", "model", "timeout_seconds",
                             "stall_timeout_seconds", "effort", "interactive", "max_parallel",
                             "description", "cwd", "permission_mode", "project"):
                return self._send(400, {"error": "bad field"})
            ok, out = cc(["set-field", jid, field], stdin=value)
        else:
            return self._send(400, {"error": "unknown op"})
        return self._send(200 if ok else 500, {"ok": ok, "output": out})


# The dashboard page lives in bin/dashboard.html, next to this file.
#
# It used to be a 2,600-line raw string in the middle of this module, which
# meant ~100 KB of HTML, CSS and JavaScript that no editor would highlight, no
# linter would check and no diff would render usefully — a typo in it was
# invisible until the page came up blank in a browser. As a file it is still
# entirely self-contained (same package, no CDN, nothing fetched at runtime),
# and `node --check` can be pointed straight at its script block.
PAGE_FILE = BIN_DIR / "dashboard.html"
current_build_id()   # primes the cache now that PAGE_FILE is known -- see its own comment
_page_cache = {"mtime": None, "text": ""}


def _page_source() -> str:
    """The page template, re-read whenever the file on disk changes.

    Cached by mtime rather than read once at import: the server is a KeepAlive
    launchd agent that only restarts when it crashes, so reading once would mean
    editing the page had no effect until someone remembered to kick it.
    """
    try:
        mtime = PAGE_FILE.stat().st_mtime_ns
    except OSError:
        return _page_cache["text"] or "<h1>dashboard.html is missing</h1>"
    if _page_cache["mtime"] != mtime:
        _page_cache.update(mtime=mtime, text=PAGE_FILE.read_text())
    return _page_cache["text"]


def render_page(boot: str = "boot-authed") -> str:
    """`boot` is which screen the page should already be showing when it paints.

    The overlays are raised by JavaScript once /api/session answers, so without
    this the shell is on screen for a round-trip first — the dashboard flashing
    past before the login card lands. This server knows the answer while it is
    still writing the response, so it says so and the first frame is right.
    Answering wrongly is not a leak either way: every endpoint behind the gate
    still refuses, and the page corrects itself the moment the session lands.

    `current_build_id()`, not a fixed BUILD: this runs on every request, so a
    `git pull` landing under a running server is visible on the very next
    load -- see that function's own comment.
    """
    return (_page_source().replace("__TOKEN__", TOKEN)
                .replace("__BUILD__", current_build_id())
                .replace("__BOOT__", boot)
                .replace("__FAVICON__", FAVICON))


def main():
    httpd = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    sys.stderr.write(f"agentloop control server on http://127.0.0.1:{PORT}/\n")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
