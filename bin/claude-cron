#!/bin/bash
# claude-cron — durable local scheduler for headless Claude Code runs.
#
# Self-contained: config/ and data/ sit next to this script's bin/ directory.
# A single launchd agent calls `claude-cron tick` once a minute; the tick
# decides which jobs are due, runs an optional cheap precheck, and only then
# spends a Claude session.
#
# Targets bash 3.2 (macOS system bash): no associative arrays, no mapfile.

set -uo pipefail

# Resolve this script's real path (following symlinks) so the install is
# self-contained: config/ and data/ and the sibling server live next to bin/,
# wherever the folder lives. A symlink in ~/.local/bin keeps it on PATH.
_src="$0"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
SELF="$(cd -P "$(dirname "$_src")" && pwd)/$(basename "$_src")"
BIN_DIR="$(dirname "$SELF")"
BASE_DIR="$(cd "$BIN_DIR/.." && pwd)"

CONFIG_DIR="${CLAUDE_CRON_CONFIG:-$BASE_DIR/config}"
DATA_DIR="${CLAUDE_CRON_DATA:-$BASE_DIR/data}"
JOBS_FILE="$CONFIG_DIR/jobs.json"
PROJECTS_FILE="$CONFIG_DIR/projects.json"
MODELS_FILE="$CONFIG_DIR/models.json"
INTERACTIVE_GRACE=20        # seconds to wait for a human reply before ending
                            # an interactive run that has finished its turn
MODELS_TTL=86400            # 24h — how long a family→id resolution is trusted,
                            # and how often the tick refreshes it on its own
STATE_FILE="$DATA_DIR/state.json"
RUNS_FILE="$DATA_DIR/runs.ndjson"
LOG_DIR="$DATA_DIR/logs"
LOCK_DIR="$DATA_DIR/locks"
WORKTREES_DIR="$DATA_DIR/worktrees"   # one isolated git worktree per run lives here
TICK_LOG="$DATA_DIR/tick.log"

PLIST_LABEL="com.claude-cron.tick"
PLIST_PATH="$HOME/Library/LaunchAgents/$PLIST_LABEL.plist"
SERVER_LABEL="com.claude-cron.server"
SERVER_PLIST="$HOME/Library/LaunchAgents/$SERVER_LABEL.plist"
SERVER_BIN="$BIN_DIR/claude-cron-server"
PORT="${CLAUDE_CRON_PORT:-8787}"

CLAUDE_BIN="${CLAUDE_CRON_CLAUDE_BIN:-$HOME/.local/bin/claude}"
# Which Claude account every run signs in as. Claude Code keeps credentials,
# settings, plugins, MCP servers and past sessions per config directory — one
# signed-in account each — so this variable is the only thing that chooses
# between two accounts on the same Mac. Set here it is the default for
# everything, model probes included; a project may pin its own (see
# `claude_config_dir` in projects.json). Empty leaves the CLI's own default
# (~/.claude), which is what this tool used before the setting existed.
#
# Taken ONLY from the explicit variable — an ambient CLAUDE_CONFIG_DIR is
# deliberately not a fallback. cmd_install already refuses it, and the runtime
# has to agree: `claude-cron run <job>` and `check <job>` are typed inside a
# Claude Code session as a matter of course, and that session exports its own
# account. Honouring it would sign the run in as whoever happened to open the
# terminal — different billing, different plugins, different MCP servers — with
# nothing in the run record saying which. Unsetting instead is the safe answer:
# it lands on the CLI default, which is where a run with no setting belongs.
CLAUDE_CONFIG_DIR="${CLAUDE_CRON_CLAUDE_CONFIG_DIR:-}"
if [ -n "$CLAUDE_CONFIG_DIR" ]; then export CLAUDE_CONFIG_DIR; else unset CLAUDE_CONFIG_DIR; fi
PYTHON="${CLAUDE_CRON_PYTHON:-$(command -v python3 2>/dev/null || echo /usr/bin/python3)}"
# /usr/bin/jq is only guaranteed on macOS 15 and later; before that jq comes
# from Homebrew, at a path that differs between Apple Silicon and Intel. The
# installer checks `jq` on PATH, so hard-coding a different path here meant an
# install could pass every check and then have every single run fail. Resolve
# it the same way python3 is resolved, and let the environment override.
JQ="${CLAUDE_CRON_JQ:-$(command -v jq 2>/dev/null || echo /usr/bin/jq)}"

mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$LOG_DIR" "$LOCK_DIR" "$WORKTREES_DIR"
[ -f "$STATE_FILE" ] || echo '{}' > "$STATE_FILE"
[ -f "$RUNS_FILE" ] || : > "$RUNS_FILE"
[ -f "$PROJECTS_FILE" ] || echo '{"projects":[]}' > "$PROJECTS_FILE"

# Per-run git-worktree isolation. Generic and language-agnostic: every
# project-specific detail (whether to isolate, which venv/env) is declared in
# projects.json under `.worktree`, never hard-coded here. See the library header.
. "$BIN_DIR/worktree-lib.sh"

die() { printf '%s\n' "$*" >&2; exit 1; }
# Every number that comes from a command goes through this. The interactive
# supervisor once killed healthy agents because `grep -c` prints "0" AND exits 1,
# so `$(grep -c … || echo 0)` produced "0\n0" and the arithmetic test below it
# blew up instead of returning false. A validated integer makes that whole class
# of failure impossible, so use num() rather than trusting command output.
num() { # num <text> [fallback] -> a plain non-negative integer, always
  local v="${1:-}" d="${2:-0}"
  v="$(printf '%s' "$v" | tr -d '[:space:]')"
  case "$v" in ''|*[!0-9]*) printf '%s' "$d" ;; *) printf '%s' "$v" ;; esac
}


# A leading ~ is the shell's, not the filesystem's: a path that arrives from
# JSON has never been through word expansion, so "~/.claude-work" would be taken
# literally and land a directory called "~" next to the config file.
expand_home() { # expand_home <path>
  case "${1:-}" in
    '~')   printf '%s' "$HOME" ;;
    '~/'*) printf '%s/%s' "$HOME" "${1#\~/}" ;;
    *)     printf '%s' "${1:-}" ;;
  esac
}

now_epoch() { date +%s; }
iso_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
log_tick() { printf '%s %s\n' "$(iso_now)" "$*" >> "$TICK_LOG"; }

# Nothing ever trimmed tick.log or exec.log, so both grew for the life of the
# install — and the dashboard re-reads tick.log WHOLE every 5s to count the
# day's activity, so an old install pays for that growth on every poll. Keep one
# previous generation and start fresh: history far enough back to be useless for
# the 24h counters is not worth carrying for ever.
LOG_MAX_BYTES="${CLAUDE_CRON_LOG_MAX:-4194304}"   # 4 MiB per file
log_rotate() { # log_rotate <file> [max-bytes]
  local f="${1:-}" max; max="$(num "${2:-$LOG_MAX_BYTES}" "$LOG_MAX_BYTES")"
  [ -f "$f" ] || return 0
  [ "$(num "$(wc -c < "$f" 2>/dev/null)")" -ge "$max" ] || return 0
  # Exactly one generation: mv replaces any existing .1, so the chain never
  # grows. A run holding exec.log open keeps writing into the renamed file —
  # harmless, and it stops at the end of that run.
  mv -f "$f" "$f.1" 2>/dev/null || return 0
  : > "$f" 2>/dev/null || true
}

# ---------------------------------------------------------------- job helpers

jobs_json() {
  [ -f "$JOBS_FILE" ] || die "No jobs file at $JOBS_FILE — run ./install.sh (it seeds one from config/jobs.example.json)"
  "$JQ" -e . "$JOBS_FILE" >/dev/null 2>&1 || die "Malformed JSON in $JOBS_FILE"
  cat "$JOBS_FILE"
}

# NOTE: deliberately NOT jq's `//` operator. `//` treats **false** as absent, so
# `(.enabled) // "true"` returned "true" for a job with `enabled: false` — which
# meant Disable never disabled anything and the tick kept launching runs. Fall
# back only on null/missing.
job_get() { # job_get <id> <jq-path> [default]
  local id="$1" path="$2" def="${3:-}"
  jobs_json | "$JQ" -r --arg id "$id" --arg def "$def" \
    '[.jobs[] | select(.id == $id) | '"$path"'] | .[0] as $v
     | (if $v == null then $def else $v end)
     | if type == "array" then join(",") else tostring end'
}

# ---------------------------------------------------------------- projects

projects_json() {
  [ -f "$PROJECTS_FILE" ] && "$JQ" -e . "$PROJECTS_FILE" >/dev/null 2>&1 || echo '{"projects":[]}' > "$PROJECTS_FILE"
  cat "$PROJECTS_FILE"
}

project_get() { # project_get <name> <jq-path> [default]
  local name="$1" path="$2" def="${3:-}"
  projects_json | "$JQ" -r --arg n "$name" --arg def "$def" \
    '[.projects[] | select(.name == $n) | '"$path"'] | .[0] as $v
     | (if $v == null then $def else $v end)
     | if type == "array" then join(",") else tostring end'
}

write_projects() { # write_projects <jq-filter> [jq-args...]
  local tmp; tmp="$(mktemp "$CONFIG_DIR/.projects.XXXXXX")"
  "$JQ" "$@" "$PROJECTS_FILE" > "$tmp" && mv "$tmp" "$PROJECTS_FILE"
}

# Resolve a possibly-inherited field: the job's own value wins; else the job's
# project's value; else the default. Empty/absent counts as "not set".
resolve() { # resolve <id> <field> <default>
  local id="$1" field="$2" def="$3" v proj pv
  v="$(job_get "$id" ".$field" '')"
  if [ -n "$v" ] && [ "$v" != "null" ]; then echo "$v"; return; fi
  proj="$(job_get "$id" '.project' '')"
  if [ -n "$proj" ] && [ "$proj" != "null" ]; then
    pv="$(project_get "$proj" ".$field" '')"
    if [ -n "$pv" ] && [ "$pv" != "null" ]; then echo "$pv"; return; fi
  fi
  echo "$def"
}

state_get() { # state_get <id> <field> [default]
  "$JQ" -r --arg id "$1" --arg f "$2" --arg def "${3:-}" \
    '.[$id][$f] as $v | (if $v == null then $def else $v end) | tostring' "$STATE_FILE" 2>/dev/null
}

# ---- the one mkdir lock every serialized write uses ------------------------
# Every lock here used to break purely on ELAPSED TIME (~4s) without ever asking
# whether the holder was still alive. That inverts the point of a lock: the
# slowest legitimate holder is precisely the one most likely to be robbed, and
# the slowest holder here is a journal rewrite over a long history — so the
# record a run had just appended could be lost to the very mechanism meant to
# protect it. `acquire_lock` already knew the right answer (write your pid, and
# only break the lock when that pid is gone); this generalises it to the rest.
LOCK_GRACE_SECONDS="${CLAUDE_CRON_LOCK_GRACE:-30}"

lock_take() { # lock_take <lockdir> — blocks until held; always succeeds
  local d="${1:-}" hold i=0
  while ! mkdir "$d" 2>/dev/null; do
    hold="$(cat "$d/pid" 2>/dev/null || true)"
    if [ -n "$hold" ] && ! kill -0 "$hold" 2>/dev/null; then
      rm -rf "$d"; continue          # the owner is gone: genuinely stale
    fi
    # A live owner is WAITED for, however long it takes. An unreadable owner is
    # the narrow race between mkdir and writing the pid — give that, and only
    # that, a time-based escape.
    i=$(( i + 1 ))
    if [ -z "$hold" ] && [ "$i" -ge $(( LOCK_GRACE_SECONDS * 100 )) ]; then
      rm -rf "$d"; i=0; continue
    fi
    sleep 0.01
  done
  echo $$ > "$d/pid" 2>/dev/null || true
  return 0
}
lock_drop() { rm -rf "${1:-}"; }   # rm -rf, not rmdir: the dir holds a pid file

# A slot is a LEASE, and a pid alone cannot express one. $LOCK_DIR lives under
# data/, so every slot survives a reboot — and the kernel reissues pids from 1
# on the way up, so a recycled pid makes a dead slot answer `kill -0`. That one
# false positive leaked three ways at once: it counted a phantom against
# max_parallel (the job simply stopped running, with nothing saying why), it kept
# an orphaned worktree unreapable, and it held a port block for good. Pinning the
# lease to the boot it was taken in is what makes "this process" mean the same
# process. Managed Agents has no equivalent bug because its claims are
# server-side leases with an expiry; ours are directories, so they carry the
# boot themselves.
# `kern.bootsessionuuid`, NOT `kern.boottime`. The obvious identifier is the
# boot time, and it is wrong: XNU shifts `kern.boottime` whenever the calendar
# clock is stepped — NTP resync, wake from sleep — so that uptime stays
# monotonic. Comparing it exactly would then declare every slot taken before
# the step to be from another boot, and every consequence of that runs the
# WRONG WAY: a live run's slot deleted and its worktree swept out from under
# it, its port block handed to somebody else. Widening the compare to a
# tolerance would paper over it; the boot session UUID has no such behaviour to
# tolerate. It is opaque, so there is also no field to parse and no greedy
# pattern to get wrong.
CC_BOOT_ID=""
boot_id() {
  if [ -z "$CC_BOOT_ID" ]; then
    CC_BOOT_ID="$(sysctl -n kern.bootsessionuuid 2>/dev/null | tr -d '[:space:]')"
  fi
  printf '%s\n' "$CC_BOOT_ID"
}

# 0 = the process this slot names is still the process that took it.
slot_alive() { # slot_alive <slot-dir>
  local slot="${1:-}" pid boot now
  [ -d "$slot" ] || return 1
  pid="$(cat "$slot/pid" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  boot="$(cat "$slot/boot" 2>/dev/null || true)"
  now="$(boot_id)"
  # A slot from an earlier boot is dead however healthy its pid looks. One with
  # no boot file at all predates this change: fall back to the pid alone, so an
  # upgrade does not reap the runs it finds in flight.
  if [ -n "$boot" ] && [ -n "$now" ] && [ "$boot" != "$now" ]; then
    return 1
  fi
  kill -0 "$pid" 2>/dev/null
}

# Serialize state writes: detached runs execute in parallel, and state_set is a
# read-modify-write on one shared file, so two of them racing would drop a field.
_state_lock()   { lock_take "$LOCK_DIR/.state.lock"; }
_state_unlock() { lock_drop "$LOCK_DIR/.state.lock"; }

state_set() { # state_set <id> <field> <value-as-json>
  local id="$1" field="$2" value="$3" tmp
  _state_lock
  tmp="$(mktemp "$DATA_DIR/.state.XXXXXX")"
  "$JQ" --arg id "$id" --arg f "$field" --argjson v "$value" \
    '.[$id] = ((.[$id] // {}) | .[$f] = $v)' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
  _state_unlock
}

# Several fields in ONE locked read-modify-write. The end of a run set seven
# fields one at a time, so it took the state lock seven times and forked jq
# seven times to record a single event — and every other run on the machine
# queued behind each of them. Merges into whatever the job already has, so no
# field written elsewhere is lost.
state_set_many() { # state_set_many <id> <json-object>
  local id="$1" obj="$2" tmp
  _state_lock
  tmp="$(mktemp "$DATA_DIR/.state.XXXXXX")"
  "$JQ" --arg id "$id" --argjson o "$obj" \
    '.[$id] = ((.[$id] // {}) + $o)' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
  _state_unlock
}

# What a precheck's exit status MEANS. The engine used to read every non-zero
# status as "nothing to do", which made the two failures that matter look
# identical to the one healthy outcome: a probe that ran and found no work
# (exit 1) and a probe that could not run AT ALL (a missing credentials file,
# an unsourceable helper, a typo -> 2, 126, 127) both left the job sitting
# quietly "idle". A job could therefore stop working for good and the dashboard
# would keep reporting it as healthy and up to date. The contract is now
# explicit and narrow: 0 = work, 1 = idle, anything else = the probe is broken.
precheck_verdict() { # precheck_verdict <exit-code> -> work|idle|error
  case "$(num "${1:-}" 99)" in
    0) printf 'work'  ;;
    1) printf 'idle'  ;;
    *) printf 'error' ;;
  esac
}

# ------------------------------------------------------------- schedule gates

# Is a moment inside a job's active window? 0 = yes, 1 = no (reason on stdout).
# Takes VALUES rather than a job id: the tick reads every job's fields in one jq
# pass (see tick_plan), and passing the day/minute in makes the rule testable
# without waiting for a Tuesday.
in_window_vals() { # in_window_vals <days-csv> <hours> [dow] [minute-of-day]
  local days="${1:-}" hours="${2:-}" dow="${3:-}" nowmin="${4:-}" start end s e
  case "$days" in null) days="" ;; esac
  case "$hours" in null) hours="" ;; esac
  [ -n "$dow" ] || dow="$(date +%u)"                         # 1=Mon .. 7=Sun
  [ -n "$nowmin" ] || nowmin=$(( 10#$(date +%H) * 60 + 10#$(date +%M) ))

  if [ -n "$days" ]; then
    case ",$days," in
      *",$dow,"*) : ;;
      *) echo "outside active_days ($days)"; return 1 ;;
    esac
  fi

  if [ -n "$hours" ]; then
    start="${hours%%-*}"; end="${hours##*-}"
    # 10# throughout: "08" is octal to bash arithmetic otherwise, and 08/09 are
    # not even valid octal — the window would abort rather than merely misread.
    s=$(( 10#${start%%:*} * 60 + 10#${start##*:} ))
    e=$(( 10#${end%%:*} * 60 + 10#${end##*:} ))
    if [ "$s" -le "$e" ]; then
      [ "$nowmin" -ge "$s" ] && [ "$nowmin" -lt "$e" ] || { echo "outside active_hours ($hours)"; return 1; }
    else  # window crosses midnight
      [ "$nowmin" -ge "$s" ] || [ "$nowmin" -lt "$e" ] || { echo "outside active_hours ($hours)"; return 1; }
    fi
  fi
  return 0
}

# --- backoff on repeated failure -------------------------------------------
# A job that fails relaunched every interval at full budget, for as long as it
# kept failing — the loop had no notion of "this is not working". Two failures
# are noise (a flaky network, a busy remote); from the third the wait doubles
# each time, capped so a job that is fixed recovers within one capped interval
# rather than hours later. The streak resets on ANY run that is not an error,
# so one good run puts the job straight back on its normal cadence.
BACKOFF_AFTER=3        # failures before the wait starts growing
BACKOFF_MAX=16         # never wait more than 16x the configured interval

backoff_multiplier() { # backoff_multiplier <consecutive-failures> -> 1|2|4|8|16
  local s m=1; s="$(num "${1:-}" 0)"
  [ "$s" -lt "$BACKOFF_AFTER" ] && { printf '1'; return; }
  local steps=$(( s - BACKOFF_AFTER + 1 )) i=0
  while [ "$i" -lt "$steps" ] && [ "$m" -lt "$BACKOFF_MAX" ]; do
    m=$(( m * 2 )); i=$(( i + 1 ))
  done
  [ "$m" -gt "$BACKOFF_MAX" ] && m="$BACKOFF_MAX"
  printf '%s' "$m"
}

effective_interval() { # effective_interval <interval> <streak>
  local iv; iv="$(num "${1:-}" 300)"
  printf '%s' "$(( iv * $(backoff_multiplier "${2:-0}") ))"
}

is_due_vals() { # is_due_vals <interval> <last-start> <fail-streak> ; 0 = due
  local interval last
  interval="$(effective_interval "${1:-300}" "${3:-0}")"
  last="$(num "${2:-0}")"
  [ "$(( $(now_epoch) - last ))" -ge "$interval" ]
}

# The session a run reported in its transcript. The id is what binds a run dir
# to the conversation that owns it: a resume looks the directory up by this, so
# the agent continues in the tree it was working in rather than in a fresh
# checkout of the base. Only the head of the file is read — the id arrives in
# the first event and never changes.
session_from_stream() { # session_from_stream <streamfile>
  local f="${1:-}"
  [ -s "$f" ] || return 0
  # By LINES, not by a byte window. A fixed `head -c` looks safe and is not:
  # the init event carries the run's whole tool roster, and with a few MCP
  # servers attached it passes 8 KB on its own — jq then never finishes parsing
  # that first object and emits nothing at all. The transcript is append-only,
  # so those first bytes never change: the miss would be permanent, not a
  # transient the next poll recovers from.
  head -n 5 "$f" 2>/dev/null \
    | "$JQ" -r 'select(type=="object") | .session_id // empty' 2>/dev/null \
    | head -1
}

# Bind a run dir to its session, once. Idempotent, cheap, and safe to call from
# anywhere: it stops looking the moment the file exists.
#
# Written through a temp file and renamed, because a later task looks a run dir
# up BY this file while runs are live — and a reader that catches a plain
# `>` redirection between create and write sees a zero-byte file.
bind_session() { # bind_session <run_dir> <streamfile>
  local rd="${1:-}" sf="${2:-}" sid tmp
  [ -n "$rd" ] && [ -d "$rd" ] || return 0
  [ -f "$rd/.session" ] && return 0
  sid="$(session_from_stream "$sf")"
  [ -n "$sid" ] || return 0
  # `mktemp`, not `$$`. This is called from two places — the watchdog, which
  # runs inside a backgrounded `( … ) &` subshell, and the main body after
  # `wait` — and bash 3.2 does NOT reseed `$$` in a subshell: both would
  # compute the same path. It is harmless only for as long as both writers
  # happen to write the identical id, which is an invariant nobody stated and
  # the next change to this function is free to break.
  tmp="$(mktemp "$rd/.session.XXXXXX" 2>/dev/null)" || return 0
  printf '%s\n' "$sid" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  mv -f "$tmp" "$rd/.session" 2>/dev/null || rm -f "$tmp"
}

# Is the agent's turn finished? True only when the LAST decodable event in the
# transcript is a `result` — i.e. the agent has answered and is now waiting for
# input. Deliberately a positive assertion on the file's current state: the
# earlier counter-based version mis-fired and killed working agents. Isolated
# and side-effect free so `claude-cron selftest` can exercise it directly.
turn_is_over() { # turn_is_over <stream-file> ; 0 = the agent answered and is idle
  local f="${1:-}" last
  [ -s "$f" ] || return 1
  last="$("$JQ" -rn -R '[inputs | fromjson? | select(.type != null) | .type] | last // ""' "$f" 2>/dev/null)"
  [ "$last" = "result" ]
}

# CPU seconds burnt by a process and every descendant of it.
#
# The stream file is the agent's heartbeat, but it goes SILENT for exactly as
# long as one tool call takes: a 40-minute test suite emits no events at all
# between the `tool_use` and its result. Treating that silence as a hang is how
# a healthy run gets killed for the crime of running the tests — the failure
# this exists to prevent. Work the agent has delegated to a child process is the
# second, independent proof of life, and it is the one that covers long tools.
#
# One `ps` sweep, closed transitively in awk, so a deep tool tree (shell -> make
# -> pytest -> workers) counts in full. Isolated and side-effect free so
# `claude-cron selftest` can exercise the parsing directly.
tree_cpu_seconds() { # tree_cpu_seconds <pid> -> integer CPU seconds (0 when gone)
  local root="${1:-}"
  case "$root" in ''|*[!0-9]*) echo 0; return ;; esac
  ps -eo pid=,ppid=,time= 2>/dev/null | cpu_tree_sum "$root"
}

# Split out so the selftest can feed it a fixed process table. Reads `ps` lines
# (pid ppid TIME) on stdin and prints the CPU seconds of <root>'s whole tree.
cpu_tree_sum() { # cpu_tree_sum <root-pid>  < "pid ppid time" lines
  awk -v root="$1" '
    { n++; pid[n]=$1; ppid[n]=$2; t[n]=$3 }
    END {
      want[root]=1
      # Descendants can appear in any order, so close the set to a fixed point
      # rather than assuming a parent is listed before its child.
      changed=1
      while (changed) {
        changed=0
        for (i=1;i<=n;i++)
          if (!(pid[i] in want) && (ppid[i] in want)) { want[pid[i]]=1; changed=1 }
      }
      total=0
      for (i=1;i<=n;i++) if (pid[i] in want) {
        # TIME is [dd-]hh:mm:ss or mm:ss.cc. Peel the day field off FIRST — it is
        # 24 hours, not another base-60 place, and folding it sexagesimally
        # overstates a long-running child by a factor of 2.4.
        s=t[i]; days=0
        if (match(s, /^[0-9]+-/)) { days = substr(s, 1, RLENGTH-1)+0; s = substr(s, RLENGTH+1) }
        m=split(s, p, ":"); sec=0
        for (j=1;j<=m;j++) sec = sec*60 + (p[j]+0)
        total += sec + days*86400
      }
      printf "%d", total
    }'
}

# The run-ending contract, injected into every job's prompt at launch.
#
# It lives HERE, in the shipped script, and not in a job's prompt, because the
# half that ENFORCES it is here: the classifier treats an ending with no marker
# as a warning. Put the requirement in the product and the contract in one
# person's jobs.json -- which is gitignored, and rightly so, being their paths,
# repos and tracker ids -- and everyone else clones a scheduler that demands a
# marker no prompt of theirs ever writes, so every run they make is filed
# `warning`. A rule the code enforces has to travel with the code.
#
# Injection is idempotent: a prompt that already states the contract is left
# alone, so a job may still word it its own way.
RUN_ENDING_MARKER='Never end your turn with work still running'

run_ending_contract() {
  cat <<'CONTRACT'
## Never end your turn with work still running — there is no "wait and resume"

This run is HEADLESS. The moment you return text without a tool call, the session
process exits: anything you launched in the background is killed with it, your
worktree can be torn down, and nothing reinvokes you. There is no notification
coming, no next turn, no picking it up when the suite finishes. A message saying
you will wait IS the end of the run, and everything still in flight is lost.

So never park work:
- Make the WAIT ITSELF a tool call — a foreground command that blocks until the
  work is done, or a blocking `until` loop on a marker the work writes when it
  finishes. While a tool call is open the run is alive: the watchdog counts your
  process tree's CPU, not just your output, so a suite that runs for an hour is
  fine and will not be killed for taking its time.
- Backgrounding a long command is only safe if you block on its result in the
  SAME turn. Never background something and then end your message.
- Do not hand-poll a log every few seconds. It burns budget and decides nothing.
  Block once, on the thing you are actually waiting for.
- If you are genuinely out of work but a process is still running, you are not
  out of work: block on it.

## Declare how your run ended
Your FINAL message must start with exactly one of these markers. The harness
classifies the run by it, and an ending with no marker is recorded as a warning
("may have stopped mid-task") rather than a success:
- `RUN COMPLETE: <one line>` — the work is finished, pushed, and handed over.
- `NOTHING TO DO: <reason>` — there was genuinely nothing to pick up.
- `BLOCKED: <what blocks it>` — you escalated; it awaits a human.

The marker is a claim about the state of the repository and the tracker, never
about what you intend to do next. Never write one while work is still in flight.

## Blocking is for NEW blockers — a human's move is an answer, not an anomaly

`BLOCKED:` exists for something that genuinely stops you: an unanswered business
question, a broken assumption, a change that would exceed this ticket. It is not
for re-litigating a decision that has already been taken.

In particular, when a ticket reaches you from the READY queue — the column a
human drags cards into — **that move IS a human decision**, and it is very often
the answer to a question the harness itself raised: a retry limit reached, a
review loop parked, an escalation you or a peer filed earlier. You will sometimes
see the history behind it — rounds already spent, a cap already hit, a prior
verdict saying "parks for a human". Do not read that history and conclude the
board is glitched and you should put the card back. **The card is in front of you
because a human put it there, having seen exactly that history.**

A run that re-blocks a ticket over a limit a human has already answered leaves it
stuck forever: the human's only lever moves it forward, the agent's caution moves
it back, every single time. Being careful is right; being careful about a decision
that is not yours to revisit is how work stops moving altogether.

So do the work you were given, and block only on something NEW — naming what it is.

## Never trust a hard-coded workflow id — resolve it by name

Any transition id written in a prompt is a snapshot of a board that has since been
edited. Worse, ids are per SOURCE STATE: the same destination is reached by a
different id depending on where the card sits, so an id that was right when the
prompt was written becomes wrong the moment anything moves the card first — which
is exactly what a claim does.

So before every transition: list the legal ones and match on the destination NAME.

    GET  /rest/api/3/issue/<KEY>/transitions
    pick .transitions[] | select(.to.name == "<the status you want>") | .id

If no transition to that name exists from where the card is, that is information,
not an obstacle: say which transitions DO exist and which one is missing, and
leave the card in the status that is truthfully correct. Never route around it by
taking some other action that happens to reach the status you wanted.

Ids quoted anywhere in your instructions are a hint for recognising the right
transition, never a value to send unverified.
CONTRACT
}

# ------------------------------------------------------------------- locking

acquire_lock() { # 0 = acquired
  # Two statements on purpose: `local a="$1" b="…$a"` expands every word BEFORE
  # assigning any of them, so under `set -u` the second one sees $a unset. It
  # only ever worked because callers happened to have their own `id` in scope.
  local id="$1" pid
  local lock="$LOCK_DIR/$id"
  if mkdir "$lock" 2>/dev/null; then
    echo $$ > "$lock/pid"; boot_id > "$lock/boot"; return 0
  fi
  if slot_alive "$lock"; then
    return 1                      # a previous run is still going
  fi
  rm -rf "$lock"                  # stale lock from a killed run, or an old boot
  mkdir "$lock" 2>/dev/null && { echo $$ > "$lock/pid"; boot_id > "$lock/boot"; return 0; }
  return 1
}

release_lock() { rm -rf "$LOCK_DIR/$1"; }

# ---- concurrent run slots (per job) ---------------------------------------
# A job may now run several times in parallel — worktrees remove the working-tree
# contention that used to force one-at-a-time. Each run holds its OWN slot dir
# $LOCK_DIR/<id>/<pid>/ carrying its pid, child pid and worktree breadcrumb.
# `max_parallel` caps how many run at once. The default is 3 (see run_job and
# the tick), NOT the 1 this comment used to claim -- and the difference matters
# to anyone reading it before setting the field: a job whose agent only records
# its progress at the END of a run (moving a card, applying a label) will have a
# second run launched against the same work by the next tick. Such a job wants
# an explicit 1. This is separate from acquire_lock above, which remains a
# single mutex for internal locks (_models).

slots_dir() { echo "$LOCK_DIR/$1"; }     # base dir holding a job's run slots

slots_active() { # <id> -> prints count of live slots; prunes dead ones
  local id="$1"                           # separate stmt: $id must exist before...
  local base="$LOCK_DIR/$id" d n=0        # ...it is expanded here (set -u)
  [ -d "$base" ] || { echo 0; return 0; }
  for d in "$base"/*/; do                # glob skips the dotfile mutex (.acq)
    [ -d "$d" ] || continue
    if slot_alive "${d%/}"; then n=$((n + 1)); else rm -rf "$d"; fi
  done
  echo "$n"
}

acquire_slot() { # <id> <max> -> prints the slot dir; non-zero when at capacity
  # max 0 means no ceiling: run as many at once as are asked for.
  local id="$1" max="$2"
  local base="$LOCK_DIR/$id" slot n L="" i=0
  mkdir -p "$base"
  L="$base/.acq"                         # short mutex so the ceiling holds under a race
  lock_take "$L"
  n="$(slots_active "$id")"              # also prunes dead slots
  if [ "$max" -gt 0 ] && [ "$n" -ge "$max" ]; then lock_drop "$L"; return 1; fi
  slot="$base/$$"                        # unique per _exec process
  mkdir -p "$slot"; echo $$ > "$slot/pid"; boot_id > "$slot/boot"
  lock_drop "$L"
  printf '%s\n' "$slot"
}

release_slot() { rm -rf "$1"; }          # <slot-dir>

# --- a port block per run ----------------------------------------------------
# Isolation gives every run its own worktree, which fixes the filesystem. It does
# NOTHING about the ports the run's services bind: two runs of the same repo each
# do `docker compose up postgres`, both publish 5432, and the second dies on
# "address already in use". The worktree name makes the compose PROJECT unique;
# the published ports are still whatever the compose file says.
#
# So every run also gets a block of ports nobody else is using. It is handed to
# the run and to its provisioning hooks as CC_PORT_BASE, and provision-lib.sh
# turns it into concrete numbers. Generic on purpose: this is not a Docker
# feature or a Compose feature, it is "two copies of the same stack at once",
# which every project that isolates will meet.
CC_PORT_RANGE_START="${CLAUDE_CRON_PORT_RANGE_START:-21000}"
CC_PORT_SPAN="${CLAUDE_CRON_PORT_SPAN:-100}"        # ports per run
CC_PORT_BLOCKS="${CLAUDE_CRON_PORT_BLOCKS:-60}"     # how many runs can hold one at once

# Lowest block no LIVE run holds. Recorded in the slot, so it is released exactly
# when the slot is — no separate registry to leak. Allocated under a mutex:
# two runs launching in the same instant would otherwise read the same "free"
# block and both take it, which is the very collision this exists to prevent.
alloc_port_base() { # <slot-dir> -> prints the base port
  local slot="$1" L="$LOCK_DIR/.ports" taken="" d b i
  mkdir -p "$LOCK_DIR"
  lock_take "$L"
  for d in "$LOCK_DIR"/*/*/; do
    [ -d "$d" ] || continue
    [ "$d" = "$slot/" ] && continue
    # A slot whose pid is gone holds nothing: the sweep has not reached it yet,
    # and treating it as live would shrink the pool for no reason.
    slot_alive "${d%/}" || continue
    b="$(cat "$d/portbase" 2>/dev/null || true)"
    [ -n "$b" ] && taken="$taken $b"
  done
  i=0
  while [ "$i" -lt "$CC_PORT_BLOCKS" ]; do
    b=$(( CC_PORT_RANGE_START + i * CC_PORT_SPAN ))
    case " $taken " in *" $b "*) ;; *) break ;; esac
    i=$(( i + 1 ))
  done
  # Every block held. Rather than refuse the run, hand back the first one and say
  # so: a port clash is a failure the operator can see and read, and a run that
  # never started because 60 others were live is one they cannot.
  if [ "$i" -ge "$CC_PORT_BLOCKS" ]; then
    b="$CC_PORT_RANGE_START"
    log_tick "all $CC_PORT_BLOCKS port blocks are in use — reusing $b, services may collide"
  fi
  # Same redirection trap as in provision-lib: the shell raises it before echo
  # runs, so the group is what has to swallow it.
  { echo "$b" > "$slot/portbase"; } 2>/dev/null || true
  lock_drop "$L"
  printf '%s\n' "$b"
}

# Is this port block free for <slot> to take? Used by a resume, which must have
# the block its services were bound to or none at all.
port_base_free() { # port_base_free <slot-dir> <base>
  local slot="$1" want="$2" d b
  for d in "$LOCK_DIR"/*/*/; do
    [ -d "$d" ] || continue
    [ "$d" = "$slot/" ] && continue
    slot_alive "${d%/}" || continue
    b="$(cat "$d/portbase" 2>/dev/null || true)"
    [ "$b" = "$want" ] && return 1
  done
  return 0
}

# End-of-run cleanup, shared by the normal exit path and the EXIT trap (so a
# crashed or killed run cleans up too). Tears down the run's worktrees if that is
# safe (see wt_teardown), THEN releases its slot. Reads the run dir from the
# slot breadcrumb; the trap bakes in the slot path. Idempotent.
# A run the operator stopped BEFORE it had anything to report still has to leave
# a record. Without this the row simply vanished from the table: no run, no log,
# nothing saying it had ever been asked for — which reads as the dashboard losing
# work rather than as a stop that was obeyed.
#
# Only fires when the stop marker is there and the normal path has not already
# journaled (it drops `journaled` the moment it does), so a run that reached its
# own ending is never recorded twice.
run_record_stopped_early() { # <id> <slot-dir>
  local id="$1" slot="${2:-}" start end logf project note model model_family
  [ -n "$slot" ] || return 0
  [ -f "$slot/stopped" ] || return 0
  [ -f "$slot/journaled" ] && return 0
  start="$(cat "$slot/start" 2>/dev/null || true)"
  case "$start" in ''|*[!0-9]*) start="$(now_epoch)" ;; esac
  end="$(now_epoch)"
  project="$(job_get "$id" '.project' '')"
  # What it WOULD have run. The record said "—" for the model, which reads as
  # missing data rather than as a run that never got far enough to have one.
  model="$(resolve "$id" model 'opus')"
  model_family=""
  case "$model" in opus|sonnet|haiku|fable) model_family="$model"; model="" ;; esac
  # This function only ever runs when the run's OWN classifier never finished
  # (see the journaled guard above), so "no work was done" is a guess, not a
  # fact — and $slot/child, written the instant an agent is spawned and never
  # removed, is the one thing here that can tell a guess from a fact. A Stop
  # that lands while the wrapper is still classifying an agent that already
  # exited reaches this exact function with the agent's commits sitting on
  # disk, unclassified: claiming "nothing was spent" invited an operator to
  # Discard a tree that might hold real work, on the strength of a record that
  # was simply wrong about what happened.
  if [ -f "$slot/child" ]; then
    note="STOPPED: ended from the dashboard after its agent had already been at work; its outcome was never classified. The run directory is kept, not deleted, until you resume it or drop it by hand."
  else
    note="STOPPED: ended from the dashboard before its agent started, so no work was done and nothing was spent."
  fi
  # A log body, so opening the run explains itself instead of showing the blank
  # record of a run that seemingly never happened. The slot only grows its
  # `logfile` breadcrumb once the run is well underway, so when the stop lands
  # earlier than that there is nothing to write to — name the file the same way
  # the run itself would have, and write it.
  logf="$(cat "$slot/logfile" 2>/dev/null || true)"
  if [ -z "$logf" ]; then
    mkdir -p "$LOG_DIR/$id" 2>/dev/null || true
    logf="$LOG_DIR/$id/$(date -u -r "$start" +%Y%m%dT%H%M%SZ 2>/dev/null || date -u +%Y%m%dT%H%M%SZ)-$(basename "$slot").json"
  fi
  "$JQ" -nc --arg r "$note" '{is_error:false, subtype:"stopped_by_user", num_turns:0,
    session_id:"", stop_reason:"stopped_by_user",
    result:("**Stopped by you.**\n\n"+$r)}' > "$logf" 2>/dev/null || logf=""
  state_set_many "$id" "$("$JQ" -nc --argjson end "$end" --argjson start "$start" \
    '{last_end:$end, last_status:"stopped", last_run_start:$start, last_run_status:"stopped"}')"
  record_run "$id" "stopped" "$start" "$end" "0" "0" "" "${logf:-}" "$note" "false" "" "$project" \
             "${model_family:-$model}" "" ""
  if [ -f "$slot/child" ]; then
    log_tick "$id: stopped by the user after its agent had already run"
  else
    log_tick "$id: stopped by the user before the agent started"
  fi
}

run_cleanup() { # <id> <slot-dir>
  local id="$1" slot="${2:-}" wt project
  [ -n "$slot" ] || return 0
  run_record_stopped_early "$id" "$slot"
  wt="$(cat "$slot/worktree" 2>/dev/null || true)"
  if [ -n "$wt" ]; then
    project="$(job_get "$id" '.project' '')"
    # The job's cwd is not needed: teardown finds each repo's canonical checkout
    # through wt_main_of, which works even for a run dir built from repos the
    # job itself never names.
    #
    # A run that never reached its own classifier — killed, crashed, the machine
    # went down — left no marker. Default it to `open`: its session may still be
    # resumable, and Task 8's TTL is what ends it if nobody comes back.
    #
    # `done` needs BOTH a stop and proof that no agent ever ran. `$slot/stopped`
    # alone does not mean that, however much `_stop_slot`'s comment says it
    # does: that function TERMs the run wrapper whenever the agent's pid is not
    # ALIVE, which includes an agent that already finished. So a Stop clicked
    # while the run is in its post-agent bookkeeping — the classifier forks
    # `git status` and `git branch -r --contains` per repo, seconds on a big
    # checkout, with the dashboard still showing the run as active — would
    # otherwise land here with the agent's commits on disk and mark them
    # `done`. They would be deleted, and the only record left would be
    # run_record_stopped_early's, which states in as many words that no work
    # was done. `$slot/child` is written the moment an agent is spawned, so its
    # absence is the fact this branch actually needs.
    if [ ! -f "$wt/.ended" ]; then
      if [ -f "$slot/stopped" ] && [ ! -f "$slot/child" ]; then
        printf 'done\n' > "$wt/.ended" 2>/dev/null || true
      else
        printf 'open\n' > "$wt/.ended" 2>/dev/null || true
      fi
    fi
    wt_teardown "$id" "$project" "$wt"
  fi
  release_slot "$slot"
}

lock_active() { # 0 = a run is currently holding the lock for <id> (single mutex)
  slot_alive "$LOCK_DIR/$1"
}

# ------------------------------------------------------------------ run a job

# The journal is appended to by runs ending and REWRITTEN whole by deletes and
# renames. Without a shared lock a rewrite can be built from a snapshot taken
# before an append and then overwrite it — losing a finished run's record for
# good. Both sides take this lock; the dashboard takes the same one by name.
journal_lock()   { lock_take "$LOCK_DIR/.journal.lock"; }
journal_unlock() { lock_drop "$LOCK_DIR/.journal.lock"; }

record_run() { # <id> <status> <start> <end> <cost> <turns> <session> <logfile> <note> <forced> <precheck> <project> <model> <model_id> <resumed_from>
  "$JQ" -nc \
    --arg id "$1" --arg status "$2" --argjson start "$3" --argjson end "$4" \
    --arg cost "$5" --arg turns "$6" --arg session "$7" --arg logfile "$8" --arg note "$9" \
    --arg forced "${10:-false}" --arg precheck "${11:-}" --arg project "${12:-}" \
    --arg model "${13:-}" --arg model_id "${14:-}" --arg resumed_from "${15:-}" \
    '{id:$id, status:$status, start:$start, end:$end, duration:($end-$start),
      cost:($cost|tonumber? // 0), turns:($turns|tonumber? // 0),
      session:$session, log:$logfile, note:$note,
      forced:($forced=="true"), precheck:$precheck, project:$project,
      model:$model, model_id:$model_id,
      # The session this run continued, when it was a resume — this is what
      # makes a resumed task identifiable as already picked up.
      resumed_from:$resumed_from}' > "$LOCK_DIR/.rec.$$"
  # Append under the journal lock, so a concurrent rewrite cannot drop this
  # record on the floor (build the line first — the lock is held for the append
  # alone, never across the jq run).
  journal_lock
  cat "$LOCK_DIR/.rec.$$" >> "$RUNS_FILE"
  journal_unlock
  rm -f "$LOCK_DIR/.rec.$$"
}

# How much of the journal the daily-spend scan reads. Records are appended in
# time order, so today's are always at the END — reading the whole file to find
# them made every single run launch O(all history ever). 4 MiB is thousands of
# records: far more than any day, and bounded for ever. A partial first line is
# dropped by `fromjson?`, which is why the offset can be a plain byte count.
SPEND_SCAN_BYTES="${CLAUDE_CRON_SPEND_SCAN:-4194304}"

_spend_since_midnight() { # _spend_since_midnight [id] -> dollars (float)
  local id="${1:-}" midnight
  midnight="$(date -v0H -v0M -v0S +%s 2>/dev/null || echo 0)"
  [ -f "$RUNS_FILE" ] || { printf '0'; return; }
  tail -c "$SPEND_SCAN_BYTES" "$RUNS_FILE" 2>/dev/null \
    | "$JQ" -rR --arg id "$id" --argjson mid "$midnight" \
        'fromjson? | select(((.start//0)>=$mid) and ($id=="" or .id==$id)) | (.cost//0)' 2>/dev/null \
    | awk '{s+=$1} END{printf "%.6f", s+0}'
}

# Total cost of a job's runs since local midnight — powers the per-job daily cap.
spent_today() { _spend_since_midnight "$1"; }

# Total cost of EVERY job's runs since local midnight — powers the global cap.
spent_today_all() { _spend_since_midnight ""; }

# The daily ceiling that applies to a job: its own, else its project's, else
# none. It used to be read from the job ALONE, so a `daily_budget_usd` set on a
# project silently did nothing — which is the one place you would naturally put
# it when a project owns several jobs.
daily_cap_for() { # daily_cap_for <id> -> dollars, or empty for "no cap"
  local v; v="$(resolve "$1" daily_budget_usd '')"
  case "$v" in null) v="" ;; esac
  printf '%s' "$v"
}

# A ceiling on what EVERYTHING spends in a day, declared once at the top of
# projects.json. Per-job caps cannot express "the whole fleet has a budget":
# 21 jobs each correctly under their own limit still add up.
global_daily_cap() { # -> dollars, or empty for "no cap"
  local v
  v="$(projects_json | "$JQ" -r '.global_daily_budget_usd // "" | tostring' 2>/dev/null)"
  case "$v" in null) v="" ;; esac
  printf '%s' "$v"
}

# --- family → newest concrete model id -------------------------------------
# Picking a family must always mean "the newest one". The CLI alias does NOT do
# that: it resolves to the newest model the INSTALLED CLI knows, which lags the
# API after a release (2026-07-24: `opus` still meant claude-opus-4-8 while
# claude-opus-5 was live and absent from the CLI binary). So we discover it:
# the alias gives a free baseline (the init event needs no API call), then we
# probe the next versions up. An unknown id is rejected by the API with
# "issue with the selected model", which is how a probe fails. Results are
# cached in config/models.json for MODELS_TTL so this costs almost nothing.

model_probe_ok() { # model_probe_ok <id> -> 0 when the API accepts it
  local out
  out="$("$CLAUDE_BIN" -p --output-format json --model "$1" "ok" 2>&1)" || return 1
  printf '%s' "$out" | "$JQ" -e '
    (.is_error != true) and (((.result // "") | test("issue with the selected model"; "i")) | not)
  ' >/dev/null 2>&1
}

model_alias_baseline() { # what the CLI's own alias points at (no API call)
  "$CLAUDE_BIN" -p --output-format stream-json --verbose --model "$1" "hi" 2>/dev/null \
    | head -1 | "$JQ" -r '.model // empty' 2>/dev/null
}

resolve_family() { # resolve_family <family> -> newest id (prints, and caches)
  local fam="$1" base major minor cand best=""
  base="$(model_alias_baseline "$fam")"
  [ -n "$base" ] || { echo "$fam"; return; }
  major="$(printf '%s' "$base" | sed -E "s/^claude-${fam}-([0-9]+).*/\1/")"
  case "$major" in ''|*[!0-9]*) echo "$base"; return ;; esac

  # newer bare majors first (e.g. claude-opus-6, claude-opus-5)
  local m
  for m in $(( major + 2 )) $(( major + 1 )); do
    cand="claude-${fam}-${m}"
    if model_probe_ok "$cand"; then best="$cand"; major="$m"; break; fi
  done
  [ -n "$best" ] || best="$base"

  # then the newest minor of that major (claude-opus-5-2, -1 …)
  for minor in 3 2 1; do
    cand="claude-${fam}-${major}-${minor}"
    if model_probe_ok "$cand"; then best="$cand"; break; fi
  done
  echo "$best"
}

models_cache_get() { # models_cache_get <family> -> cached id if still fresh
  [ -f "$MODELS_FILE" ] || return 1
  "$JQ" -er --arg f "$1" --argjson now "$(now_epoch)" --argjson ttl "$MODELS_TTL" \
    '.resolved[$f] | select(.id != null and (($now - (.at // 0)) < $ttl)) | .id' \
    "$MODELS_FILE" 2>/dev/null
}

models_cache_set() { # models_cache_set <family> <id>
  local tmp; tmp="$(mktemp "$CONFIG_DIR/.models.XXXXXX")"
  [ -f "$MODELS_FILE" ] || echo '{"resolved":{}}' > "$MODELS_FILE"
  "$JQ" --arg f "$1" --arg id "$2" --argjson at "$(now_epoch)" \
    '.resolved[$f] = {id:$id, at:$at}' "$MODELS_FILE" > "$tmp" && mv "$tmp" "$MODELS_FILE"
}

effective_model() { # effective_model <model> -> concrete id (families resolved)
  local m="$1" hit
  case "$m" in
    opus|sonnet|haiku|fable) ;;
    *) echo "$m"; return ;;          # already an explicit id — use it verbatim
  esac
  if hit="$(models_cache_get "$m")"; then echo "$hit"; return; fi
  hit="$(resolve_family "$m")"
  [ -n "$hit" ] || hit="$m"
  models_cache_set "$m" "$hit"
  echo "$hit"
}

models_stale() { # 0 = the cache is missing or older than MODELS_TTL
  local oldest
  [ -f "$MODELS_FILE" ] || return 0
  oldest="$("$JQ" -r '[.resolved[]?.at // 0] | min // 0' "$MODELS_FILE" 2>/dev/null)"
  case "$oldest" in ''|null|*[!0-9]*) oldest=0 ;; esac
  [ "$(( $(now_epoch) - oldest ))" -ge "$MODELS_TTL" ]
}

cmd_say() { # cmd_say <id> — message on stdin, delivered to the live run
  local id="$1" fifo text w
  lock_active "$id" || die "no run in progress for $id"
  fifo="$(state_get "$id" last_fifo '')"
  [ -n "$fifo" ] && [ "$fifo" != "null" ] && [ -p "$fifo" ] \
    || die "this run is not interactive (enable 'interactive' on the job)"
  text="$(cat)"
  [ -n "$text" ] || die "empty message"
  # Non-blocking: if the agent died between the checks above, writing to the
  # FIFO would block forever, so give up after a few seconds.
  "$JQ" -nc --arg t "$text" \
    '{type:"user",message:{role:"user",content:[{type:"text",text:$t}]}}' > "$fifo" &
  w=$!
  ( sleep 5; kill "$w" 2>/dev/null ) >/dev/null 2>&1 &
  wait "$w" 2>/dev/null || die "could not deliver — the run may have just ended"
  echo "delivered to $id"
}

# ---------------------------------------------------------------------- skills

# The agent prompts make several skills MANDATORY ("invoke `using-superpowers`",
# "work each finding through `closing-review-findings`"). A prompt that names a
# skill the machine does not have is a prompt whose standards silently do not
# apply -- and the skills we maintain lived only in ~/.claude/skills, which is not
# version controlled anywhere. Same failure as putting a rule in a gitignored
# jobs.json: the half that demands it shipped, the half that supplies it did not.
#
# So the skills this loop depends on and WE maintain live in skills/ here, and are
# linked into ~/.claude/skills. A link rather than a copy, so editing either path
# edits the versioned file and there is never a stale second copy to diverge.
#
# Not everything is ours: most of these skills come from the `superpowers` vendor
# package and are left pointing at it. `test-driven-development` is the exception
# -- it carries our own addition (axis 9: fixtures for external things must come
# from a real sample), which a vendor update would otherwise overwrite, so it is
# forked here deliberately. That trade is stated in the README.
SKILLS_DIR="$BASE_DIR/skills"
USER_SKILLS="$HOME/.claude/skills"

cmd_skills() { # claude-cron skills [install]
  local action="${1:-status}" name target link
  local _skills_pending=0
  [ -d "$SKILLS_DIR" ] || die "no skills/ directory in $BASE_DIR"
  mkdir -p "$USER_SKILLS"
  for target in "$SKILLS_DIR"/*/; do
    [ -d "$target" ] || continue
    name="$(basename "$target")"
    link="$USER_SKILLS/$name"
    if [ -L "$link" ] && [ "$(readlink "$link")" = "${target%/}" ]; then
      printf '  linked   %s\n' "$name"; continue
    fi
    if [ "$action" != "install" ]; then
      _skills_pending=$(( _skills_pending + 1 ))
      if [ -e "$link" ]; then printf '  DIVERGED %s (a different copy is installed)\n' "$name"
      else                    printf '  MISSING  %s\n' "$name"; fi
      continue
    fi
    # Never destroy an unversioned edit without keeping it: a skill someone tuned
    # in place is exactly the thing worth reading before it disappears.
    if [ -e "$link" ] && [ ! -L "$link" ]; then
      mv "$link" "$link.before-claude-cron.$(date -u +%Y%m%dT%H%M%SZ)"
      printf '  kept old %s (renamed .before-claude-cron.*)\n' "$name"
    fi
    rm -f "$link"
    ln -s "${target%/}" "$link"
    printf '  linked   %s\n' "$name"
  done
  # Only nag when something is actually out of place; a clean status that still
  # tells you to run install is noise that trains you to ignore the output.
  if [ "$action" != "install" ] && [ "${_skills_pending:-0}" -gt 0 ]; then
    echo "  (run \`claude-cron skills install\` to link them)"
  fi
}

cmd_selftest() { # offline checks of the logic that can kill a run or lose money
  local pass=0 fail=0 tmp
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/ccselftest.XXXXXX")"
  ok()   { pass=$(( pass + 1 )); printf '  ok    %s\n' "$1"; }
  bad()  { fail=$(( fail + 1 )); printf '  FAIL  %s\n' "$1"; }
  want() { # want <label> <expected 0|1> <actual-rc>
    [ "$2" -eq "$3" ] && ok "$1" || bad "$1"
  }
  size_of() { num "$(wc -c < "${1:-/nonexistent}" 2>/dev/null)"; }

  # The suite exercises wt_setup/wt_teardown/wt_provision for real, and those
  # write through log_tick and the provisioning hooks. Pointed at the live data
  # dir they append fake jobs (j1..j9, "provision up failed for repoA") to the
  # very tick.log the dashboard parses for its 24h activity counts — the test
  # suite inventing jobs in production history. Shadow the whole data dir, at
  # FUNCTION scope so every helper these tests call sees it too (bash is
  # dynamically scoped), and prove at the end that nothing leaked.
  local _real_tick="$TICK_LOG" _real_exec="$DATA_DIR/exec.log"
  local _tick0 _exec0
  _tick0="$(size_of "$_real_tick")"; _exec0="$(size_of "$_real_exec")"
  local DATA_DIR="$tmp/data"
  local TICK_LOG="$DATA_DIR/tick.log"
  local LOG_DIR="$DATA_DIR/logs" LOCK_DIR="$DATA_DIR/locks"
  local WORKTREES_DIR="$DATA_DIR/worktrees" RUNS_FILE="$DATA_DIR/runs.ndjson"
  mkdir -p "$DATA_DIR" "$LOG_DIR" "$LOCK_DIR" "$WORKTREES_DIR"

  echo "num() — a number from a command is always an integer"
  # This is the exact shape that once produced "0\n0" and killed live agents.
  local n; n="$(num "$(grep -c 'nothing' /dev/null 2>/dev/null)")"
  [ "$n" = "0" ] && ok "grep -c with no match yields 0" || bad "grep -c with no match yielded '$n'"
  [ "$(num '')" = "0" ]        && ok "empty  -> 0"        || bad "empty"
  [ "$(num '  7 ')" = "7" ]    && ok "spaces trimmed"     || bad "spaces"
  [ "$(num 'x9')" = "0" ]      && ok "garbage -> 0"       || bad "garbage"
  [ "$(num '' 5)" = "5" ]      && ok "fallback honoured"  || bad "fallback"
  # and it must be usable in arithmetic without aborting
  ( [ "$(num 'x')" -lt 1 ] ) >/dev/null 2>&1 && ok "usable in [ -lt ]" || bad "not usable in [ -lt ]"

  echo "turn_is_over() — only a finished, quiet turn may end a run"
  printf '%s\n' '{"type":"system"}' '{"type":"assistant","message":{}}' > "$tmp/working.ndjson"
  printf '%s\n' '{"type":"system"}' '{"type":"result","subtype":"success"}' > "$tmp/done.ndjson"
  printf '%s\n' '{"type":"result"}' '{"type":"assistant","message":{}}' > "$tmp/resumed.ndjson"
  : > "$tmp/empty.ndjson"
  printf '%s\n' '{"type":"result"}' '{"trunca' > "$tmp/cut.ndjson"
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"the word result appears here"}]}}' > "$tmp/decoy.ndjson"
  turn_is_over "$tmp/working.ndjson"; want "mid-work run is NOT killable"        1 $?
  turn_is_over "$tmp/done.ndjson";    want "answered run is killable"            0 $?
  turn_is_over "$tmp/resumed.ndjson"; want "work after a result is NOT killable" 1 $?
  turn_is_over "$tmp/empty.ndjson";   want "empty transcript is NOT killable"    1 $?
  turn_is_over "$tmp/cut.ndjson";     want "truncated tail ignored"              0 $?
  turn_is_over "$tmp/decoy.ndjson";   want "the word 'result' in text is not an event" 1 $?
  turn_is_over "$tmp/missing.ndjson"; want "missing file is NOT killable"        1 $?

  echo "session_from_stream() — the session id is read from the transcript's first event"
  # Absence has to be caught explicitly: a missing function prints to stderr and
  # yields an EMPTY stdout, which is exactly what the negative assertions below
  # accept. Without this line, deleting the reader outright would leave two of
  # the three still reporting ok.
  type session_from_stream >/dev/null 2>&1 \
    && ok "the reader is defined" || bad "session_from_stream does not exist"
  printf '%s\n' \
    '{"type":"system","subtype":"init","session_id":"sess-abc123"}' \
    '{"type":"assistant","message":{}}' > "$tmp/s1.ndjson"
  got="$(session_from_stream "$tmp/s1.ndjson")"
  [ "$got" = "sess-abc123" ] && ok "the init event's session is found" \
    || bad "read '$got'"

  # A fixed byte window would silently lose this one for good: the transcript is
  # append-only, so a first event that does not fit never starts fitting.
  { printf '{"type":"system","subtype":"init","session_id":"sess-big","tools":['
    i=0; while [ "$i" -lt 900 ]; do printf '"a-tool-with-a-long-name-%s",' "$i"; i=$((i+1)); done
    printf '"last"]}\n'
    printf '%s\n' '{"type":"assistant","message":{}}'
  } > "$tmp/s4.ndjson"
  [ "$(wc -c < "$tmp/s4.ndjson" | tr -d ' ')" -gt 8192 ] \
    && ok "the fixture init event really is over 8 KB" || bad "the fixture is too small to prove anything"
  got="$(session_from_stream "$tmp/s4.ndjson")"
  [ "$got" = "sess-big" ] && ok "an init event bigger than 8 KB is still read" \
    || bad "read '$got' from a large init event"
  printf '%s\n' '{"type":"assistant","message":{}}' > "$tmp/s2.ndjson"
  got="$(session_from_stream "$tmp/s2.ndjson")"
  [ -z "$got" ] && ok "a transcript with no session yet reports nothing" \
    || bad "invented a session '$got'"
  : > "$tmp/s3.ndjson"
  got="$(session_from_stream "$tmp/s3.ndjson")"
  [ -z "$got" ] && ok "an empty transcript reports nothing" || bad "read '$got' from nothing"

  echo "bind_session() — one shot, atomic, and a no-op without a run dir"
  mkdir -p "$tmp/rd1"
  bind_session "$tmp/rd1" "$tmp/s1.ndjson"
  [ "$(cat "$tmp/rd1/.session" 2>/dev/null)" = "sess-abc123" ] \
    && ok "it writes the session it found" || bad "wrote '$(cat "$tmp/rd1/.session" 2>/dev/null)'"
  # A later transcript must not move a binding that already exists: the run dir
  # belongs to the session that claimed it.
  bind_session "$tmp/rd1" "$tmp/s4.ndjson"
  [ "$(cat "$tmp/rd1/.session" 2>/dev/null)" = "sess-abc123" ] \
    && ok "a second call never rebinds it" || bad "the binding moved"
  [ -z "$(ls "$tmp/rd1"/.session.* 2>/dev/null)" ] \
    && ok "and leaves no temp file behind" || bad "a .session.* temp survived"
  mkdir -p "$tmp/rd2"
  bind_session "$tmp/rd2" "$tmp/s3.ndjson"
  [ ! -f "$tmp/rd2/.session" ] \
    && ok "a transcript with no session writes no file at all" || bad "bound an empty session"
  bind_session "" "$tmp/s1.ndjson"
  want "an empty run dir is a no-op, not a write to /.session" 0 $?
  [ ! -f "/.session" ] && ok "and nothing landed at the filesystem root" || bad "wrote /.session"

  echo "run_job() — the session is bound from BOTH call sites, not just the loop"
  # A structural assertion, deliberately. The two calls look interchangeable to
  # anyone reading them without the timing context, so the realistic way this
  # regresses is somebody deleting the second as a duplicate — and every
  # behavioural test here would still pass, because bind_session itself is
  # fine. What breaks is only which runs reach it: the polling one alone loses
  # every run that dies inside the 30s window, and the post-wait one alone
  # loses every run killed with -9. Both, or the guarantee is gone.
  got="$(sed -n '/^run_job()/,/^}/p' "$BIN_DIR/claude-cron" | grep -c 'bind_session "\$run_dir"')"
  [ "${got:-0}" -ge 2 ] \
    && ok "both bind_session call sites are still there ($got)" \
    || bad "run_job has $got bind_session call sites, expected 2 — see the plan for why each is load-bearing"

  echo "run_job() — the undelivered-work rule runs LAST, and never on a stopped run"
  # A structural assertion, deliberately. run_job is never invoked directly
  # anywhere in this suite (it needs a mocked agent CLI, a real worktree, a
  # budget cap...), and wt_undelivered_work / undelivered_note are both already
  # exercised on their own, above, so a behavioural test of either would stay
  # green even after the regression this guards against. That regression is
  # precedence: every rule above this one guards on `status = success`, so a
  # future edit that moves it back above BUDGET LIMITED (to sit next to
  # UNDECLARED ENDING, which is where it lived before this was caught in
  # review) would silently disable both of them the moment it sets `warning` —
  # and a guard that let `stopped` through would overwrite an operator's
  # STOPPED record with a less informative one. Both are one-line edits that
  # look like harmless cleanup.
  local budget_at undelivered_at guard_line budget_n undelivered_n case_at
  got="$(sed -n '/^run_job()/,/^}/p' "$BIN_DIR/claude-cron")"
  # -c (a count), not just -n | head -1: a SECOND "BUDGET LIMITED:" or a
  # duplicated call site would make head -1 silently anchor on whichever
  # comes first, and the ordering compare below would pass or fail on the
  # wrong pair of lines without ever saying so.
  budget_n="$(printf '%s\n' "$got" | grep -c 'BUDGET LIMITED:')"
  undelivered_n="$(printf '%s\n' "$got" | grep -c 'wt_undelivered_work "\$run_dir"')"
  budget_at="$(printf '%s\n' "$got" | grep -n 'BUDGET LIMITED:' | head -1 | cut -d: -f1)"
  undelivered_at="$(printf '%s\n' "$got" | grep -n 'wt_undelivered_work "\$run_dir"' | head -1 | cut -d: -f1)"
  [ "${budget_n:-0}" -eq 1 ] && [ "${undelivered_n:-0}" -eq 1 ] && [ "$undelivered_at" -gt "$budget_at" ] \
    && ok "the rule sits after BUDGET LIMITED, not before it (line $undelivered_at vs $budget_at)" \
    || bad "undelivered-work rule x$undelivered_n at line ${undelivered_at:-?}, BUDGET LIMITED x$budget_n at ${budget_at:-?} — expected exactly one of each, with the rule after"
  # Trimmed and compared for EXACT equality, not globbed: a suffix pattern
  # like *'success|warning)' also matches `stopped|success|warning)` — `*`
  # absorbs the prepended "stopped|" just as happily as it absorbs nothing —
  # so a case that let `stopped` back in by being listed FIRST would still
  # read as `ok`. Only an exact compare catches every position it could be
  # inserted at, not just appended.
  #
  # Semantic anchor, not positional: find THIS rule's own case statement by
  # searching backwards from wt_undelivered_work's own call (undelivered_at,
  # already found above) rather than by counting `case "$status" in`
  # occurrences from the top of run_job. A positional count breaks the moment
  # a second one exists anywhere else in the function — already true today
  # (Task 6's done/open marker sits below this one) — and would break again,
  # silently, the day a third one lands ABOVE this rule instead. The nearest
  # `case "$status" in` before wt_undelivered_work's own call can only ever be
  # the statement that guards it, however many more exist elsewhere in either
  # direction.
  case_at="$(printf '%s\n' "$got" | head -n "$undelivered_at" \
               | grep -n 'case "\$status" in' | tail -1 | cut -d: -f1)"
  guard_line="$(printf '%s\n' "$got" | sed -n "$((case_at + 1))p" \
                  | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [ "$guard_line" = "success|warning)" ] \
    && ok "and its guard covers success/warning only, never a stopped run" \
    || bad "the line after the status case reads '$guard_line', not exactly 'success|warning)'"

  echo "cpu_tree_sum() — a busy tool tree is proof of life, not a stall"
  # A run whose agent is quiet because a test suite is grinding away in a child
  # (shell -> make -> pytest) must read as ALIVE. This is the case that got a
  # healthy run killed at the stall timeout for running the tests it was told to.
  printf '%s\n' '100 1 00:10' '200 100 05:00' '300 200 10:00' '999 1 99:00' > "$tmp/ps.txt"
  local cpu
  cpu="$(cpu_tree_sum 100 < "$tmp/ps.txt")"   # 10s + 300s + 600s
  [ "$cpu" = "910" ] && ok "whole descendant tree counted ($cpu s)" \
                     || bad "tree cpu wrong: got '$cpu', want 910"
  # An unrelated process's CPU must never keep a genuinely hung run alive.
  cpu="$(cpu_tree_sum 999 < "$tmp/ps.txt")"
  [ "$cpu" = "5940" ] && ok "an unrelated tree is not counted in" \
                      || bad "isolation broke: got '$cpu', want 5940"
  # Children are not guaranteed to be listed after their parents.
  printf '%s\n' '300 200 10:00' '200 100 05:00' '100 1 00:10' > "$tmp/ps2.txt"
  cpu="$(cpu_tree_sum 100 < "$tmp/ps2.txt")"
  [ "$cpu" = "910" ] && ok "descendants found regardless of ps order" \
                     || bad "ordering broke: got '$cpu', want 910"
  # [dd-]hh:mm:ss must not be read as mm:ss — a day of CPU is not 0 seconds.
  printf '%s\n' '100 1 1-02:03:04' > "$tmp/ps3.txt"
  cpu="$(cpu_tree_sum 100 < "$tmp/ps3.txt")"
  [ "$cpu" = "93784" ] && ok "dd-hh:mm:ss parsed ($cpu s)" \
                       || bad "day-form parse wrong: got '$cpu', want 93784"
  # A dead or absent pid burns nothing — it must never look busy.
  cpu="$(cpu_tree_sum 4242 < "$tmp/ps.txt")"
  [ "$cpu" = "0" ] && ok "an absent pid reports no CPU" || bad "absent pid: got '$cpu'"
  cpu="$(num "$(tree_cpu_seconds '')")"
  [ "$cpu" = "0" ] && ok "an empty pid reports no CPU" || bad "empty pid: got '$cpu'"

  echo "the run-ending contract ships with the CODE, not with a personal jobs.json"
  # The classifier demands a marker. If the contract that teaches it lives only in
  # one person's (gitignored) jobs.json, everyone else clones a scheduler that
  # files every run as a warning. So injection must reach a prompt that has never
  # heard of it, and must not double up on one that has.
  inject() { # inject <prompt> -> the prompt as the agent will receive it
    case "$1" in
      *"$RUN_ENDING_MARKER"*) printf '%s' "$1" ;;
      *) printf '%s\n\n%s' "$1" "$(run_ending_contract)" ;;
    esac
  }
  local plain injected twice
  plain="Do the thing."
  injected="$(inject "$plain")"
  case "$injected" in *"RUN COMPLETE:"*) ok "a bare prompt receives the contract" ;;
    *) bad "a bare prompt did NOT receive the contract" ;; esac
  case "$injected" in "$plain"*) ok "the job's own prompt is kept, not replaced" ;;
    *) bad "the job's prompt was lost" ;; esac
  twice="$(inject "$injected")"
  [ "$twice" = "$injected" ] && ok "injection is idempotent (no double contract)" \
                             || bad "injection duplicated the contract"
  # And the marker the classifier looks for must be the one the contract teaches:
  # if these two ever drift, every run is a warning and nothing says why.
  case "$(run_ending_contract)" in
    *"RUN COMPLETE:"*"NOTHING TO DO:"*"BLOCKED:"*) ok "contract names every marker the classifier accepts" ;;
    *) bad "contract and classifier disagree on the markers" ;;
  esac

  echo "workflow ids are resolved, never trusted"
  # The reviewer prompts carried ids that were correct FROM `Review - DEV` and
  # wrong from `In Review - DEV` -- and the precheck moves the card to the latter
  # before the session starts, so every closing transition used the wrong number.
  # The durable cure is in the contract every job receives: resolve by to.name.
  case "$(run_ending_contract)" in
    *"resolve it by name"*) ok "the contract tells every run to resolve ids by name" ;;
    *) bad "the contract never warns about hard-coded transition ids" ;;
  esac
  case "$(run_ending_contract)" in
    *"per SOURCE STATE"*) ok "and says WHY a correct id goes stale (source state)" ;;
    *) bad "the contract states the rule without the reason it exists" ;;
  esac

  echo "the changelog moves when main moves"
  # Other people run this scheduler on their own projects: a change they cannot
  # see the shape of is a change they cannot trust or adopt. Writing the entry
  # afterwards never happens, so the check is here -- if the code moved and
  # CHANGELOG.md did not, this fails while the reason is still known.
  if [ -d "$BASE_DIR/.git" ] && command -v git >/dev/null 2>&1; then
    local _code _log
    # --no-merges: a merge commit touches bin/ by definition, and is always newer
    # than the changelog entry that came in WITH the branch it merges. Counting it
    # made this fail after every single merge, with the entry correctly in place —
    # a check that cries wolf on a healthy repo is one people learn to ignore.
    _code="$(git -C "$BASE_DIR" log -1 --no-merges --format=%ct -- bin skills test 2>/dev/null)"
    _log="$(git -C "$BASE_DIR" log -1 --format=%ct -- CHANGELOG.md 2>/dev/null)"
    if [ -z "${_code:-}" ]; then
      ok "no committed code yet — nothing to describe"
    elif [ -z "${_log:-}" ]; then
      bad "CHANGELOG.md has never been committed, but bin/ has"
    elif [ "$_log" -ge "$_code" ]; then
      ok "CHANGELOG.md is at least as new as the last code commit"
    else
      bad "code moved after the last CHANGELOG.md entry — describe the change before pushing"
    fi
  else
    ok "not a git checkout — changelog freshness not checkable here"
  fi
  [ -f "$BASE_DIR/CHANGELOG.md" ] && ok "CHANGELOG.md exists" || bad "CHANGELOG.md is missing"

  echo "a human's board move is an answer, not an anomaly"
  # QG-15: the cap parked the ticket, the human moved it to the ready column, and
  # the next run read the spent rounds, decided the board was glitched, and put it
  # straight back in Blocked. The human's only lever moves it forward; the agent's
  # caution moved it back. Both halves of the cure must be present.
  case "$(run_ending_contract)" in
    *"a human's move is an answer"*|*"human decision"*) ok "the injected contract tells a run not to re-block a human's move" ;;
    *) bad "the contract never mentions the human-released case" ;;
  esac
  case "$(run_ending_contract)" in
    *"block only on something NEW"*) ok "and says what DOES still justify blocking" ;;
    *) bad "the contract removed blocking without saying when it is still right" ;;
  esac

  echo "a run that stops talking is not a run that finished"
  # The exact shape that filed an abandoned ticket as a clean success: a normal
  # result event whose text simply never claims the work is done.
  declared() { printf '%s' "$1" | grep -qE '(RUN COMPLETE|NOTHING TO DO|BLOCKED):'; }
  declared "I'll wait for the suite to finish and then commit."
  want "an agent promising to continue is NOT a finished run"        1 $?
  declared "RUN COMPLETE: QG-15 reworked, pushed, moved to Review - DEV."
  want "a declared completion is a finished run"                     0 $?
  declared "NOTHING TO DO: the board had no ready ticket."
  want "a declared no-op is accepted"                                0 $?
  declared "BLOCKED: QG-15 — needs a human decision on scope."
  want "a declared escalation is accepted"                           0 $?
  declared ""
  want "an empty final message is NOT a finished run"                1 $?

  echo "undelivered_note() — the note names what was left behind and how to continue"
  got="$(undelivered_note "unpushed commits in api")"
  case "$got" in
    "UNDELIVERED: unpushed commits in api."*)
      ok "it leads with the marker the dashboard matches on, then the finding" ;;
    *) bad "the note read '$got'" ;;
  esac
  case "$got" in
    *"resume this run"*) ok "and points at the one action that continues the work" ;;
    *) bad "the note never says how to continue: '$got'" ;;
  esac

  echo "killed runs report what they consumed"
  printf '%s\n' \
    '{"type":"system","subtype":"init","session_id":"s"}' \
    '{"type":"assistant","message":{"usage":{"input_tokens":10,"cache_read_input_tokens":100,"cache_creation_input_tokens":5,"output_tokens":2}}}' \
    > "$tmp/usage.ndjson"
  local got
  got="$("$JQ" -rn -R '[inputs | fromjson?] as $ev | [$ev[] | .message?.usage? // empty] as $u
    | "\([$u[].input_tokens // 0] | add // 0)/\([$u[].cache_read_input_tokens // 0] | add // 0)/\([$u[].output_tokens // 0] | add // 0)"' \
    "$tmp/usage.ndjson" 2>/dev/null)"
  [ "$got" = "10/100/2" ] && ok "token usage recovered from a stream ($got)" \
                          || bad "token usage wrong: got '$got', want 10/100/2"

  echo "a disabled job is never launched"
  [ "$(job_get __no_such_job__ '.enabled' 'true')" = "true" ] && ok "absent job defaults to enabled" || bad "default broke"
  printf '%s' '{"jobs":[{"id":"x","enabled":false}]}' > "$tmp/jobs.json"
  got="$("$JQ" -r '[.jobs[] | select(.id=="x") | .enabled] | .[0] as $v | (if $v == null then "true" else $v end) | tostring' "$tmp/jobs.json")"
  [ "$got" = "false" ] && ok "enabled:false reads as false (jq // would say true)" || bad "enabled:false read as '$got'"

  echo "wt_repos() — declared repos win, a bare cwd is the single-repo case"
  mkdir -p "$tmp/proj"
  printf '%s' '{"projects":[{"name":"multi","cwd":"/x/front","repos":[
      {"name":"front","path":"/x/front","base":"develop"},
      {"name":"back","path":"/x/back","base":"release"}]},
    {"name":"solo","cwd":"/x/solo"}]}' > "$tmp/proj/projects.json"
  got="$( PROJECTS_FILE="$tmp/proj/projects.json"; wt_repos multi /x/front | wc -l | tr -d ' ' )"
  [ "$got" = "2" ] && ok "a declared multi-repo project yields 2 rows" || bad "multi yielded '$got' rows"
  got="$( PROJECTS_FILE="$tmp/proj/projects.json"; wt_repos multi /x/front | sed -n '2p' )"
  [ "$got" = "$(printf 'back\t/x/back\trelease')" ] && ok "name/path/base survive the round trip" \
    || bad "second row was '$got'"
  got="$( PROJECTS_FILE="$tmp/proj/projects.json"; wt_repos solo /x/solo )"
  [ "$got" = "$(printf 'solo\t/x/solo\t')" ] && ok "no .repos[] synthesises one row from cwd" \
    || bad "solo row was '$got'"

  echo "wt_base_ref() — declared base wins, then local, then HEAD"
  local gitc="git -c user.name=cc -c user.email=cc@local -c commit.gpgsign=false"
  mkdir -p "$tmp/g"
  git init -q --bare "$tmp/g/origin.git"
  git -c init.defaultBranch=develop init -q "$tmp/g/repo"
  ( cd "$tmp/g/repo" && echo hi > f && git add f && $gitc commit -qm init \
      && git remote add origin "$tmp/g/origin.git" && git push -q -u origin develop ) >/dev/null 2>&1
  got="$(wt_base_ref "$tmp/g/repo" develop)"
  [ "$got" = "origin/develop" ] && ok "a pushed base resolves to origin/<base>" || bad "got '$got'"
  ( cd "$tmp/g/repo" && git branch local-only ) >/dev/null 2>&1
  got="$(wt_base_ref "$tmp/g/repo" local-only)"
  [ "$got" = "local-only" ] && ok "a local-only base resolves to the local branch" || bad "got '$got'"
  got="$(wt_base_ref "$tmp/g/repo" no-such-branch)"
  [ "$got" = "HEAD" ] && ok "an unresolvable base falls back to HEAD" || bad "got '$got'"
  got="$(wt_base_ref "$tmp/g/repo" "")"
  [ "$got" = "origin/develop" ] && ok "an empty base is inferred from the current branch" || bad "got '$got'"

  echo "wt_base_ref() — a base pattern tracks the release train by itself"
  # A literal `release/0.9.0` is correct until 0.9.0 stops being current, and
  # then keeps cutting worktrees from an abandoned train with no symptom but
  # agents working on the wrong baseline. A pattern is written once.
  # Pushed to the ORIGIN, not faked as local remote-refs: wt_base_ref fetches
  # with --prune first, so a remote-tracking ref with no branch behind it is
  # deleted before it can be resolved — which is correct, and is also exactly
  # how a retired release train disappears on its own.
  ( cd "$tmp/g/repo"
    for v in 0.8.0 0.9.0 0.10.0; do git push -q origin "HEAD:refs/heads/release/$v"; done ) >/dev/null 2>&1
  got="$(wt_base_ref "$tmp/g/repo" 'release/*')"
  [ "$got" = "origin/release/0.10.0" ] \
    && ok "a base pattern resolves to the highest VERSION (0.10.0 > 0.9.0)" \
    || bad "pattern resolved to '$got', want origin/release/0.10.0"
  # The whole point: sorted as text, 0.9.0 beats 0.10.0 and the project silently
  # pins itself to the train it just left. This case is why --sort=-v:refname.
  got="$(git -C "$tmp/g/repo" for-each-ref --sort=-refname --count=1 \
          --format='%(refname:short)' 'refs/remotes/origin/release/*')"
  [ "$got" = "origin/release/0.9.0" ] \
    && ok "and text ordering would have picked 0.9.0 — the bug this avoids" \
    || bad "the text-order control did not reproduce: got '$got'"
  # A pattern that matches nothing must REFUSE, not fall through to HEAD:
  # falling through is exactly the silent-wrong-baseline failure being prevented.
  got="$(wt_base_ref "$tmp/g/repo" 'nosuch/*' 2>/dev/null)"; rc=$?
  [ "$rc" -ne 0 ] && [ -z "$got" ] \
    && ok "a pattern matching nothing refuses instead of falling back to HEAD" \
    || bad "unmatched pattern returned '$got' (exit $rc) instead of refusing"
  # And a literal base must be unaffected by any of this.
  got="$(wt_base_ref "$tmp/g/repo" develop)"
  [ "$got" = "origin/develop" ] && ok "a literal base still resolves as before" || bad "got '$got'"

  echo "wt_base_ref() — a hung fetch cannot hold a run for ever"
  # The fetch runs inside wt_setup, i.e. AFTER the run has taken its slot and
  # BEFORE the watchdog exists — so a remote that accepts the connection and
  # then says nothing used to pin the slot indefinitely. With max_parallel=1
  # that is the job dead until a human notices.
  mkdir -p "$tmp/fakebin"
  printf '%s\n' '#!/bin/bash' \
    'for a in "$@"; do [ "$a" = fetch ] && { sleep 8; exit 0; }; done' \
    'exec /usr/bin/git "$@"' > "$tmp/fakebin/git"
  chmod +x "$tmp/fakebin/git"
  local t0 elapsed ref_got
  t0="$(now_epoch)"
  ref_got="$( PATH="$tmp/fakebin:$PATH"; wt_base_ref "$tmp/g/repo" develop 2 2>/dev/null )"
  elapsed=$(( $(now_epoch) - t0 ))
  [ "$elapsed" -lt 6 ] && ok "a stalled fetch is abandoned after the timeout (${elapsed}s)" \
    || bad "wt_base_ref waited ${elapsed}s for a hung fetch"
  [ "$ref_got" = "origin/develop" ] \
    && ok "the base still resolves from the refs already on disk" \
    || bad "after a timed-out fetch the base resolved to '$ref_got'"

  echo "wt_provision() — a missing hook is a no-op, a failing one is a failure"
  mkdir -p "$tmp/cfg/provision" "$tmp/run/repoA"
  ( CONFIG_DIR="$tmp/cfg"; PROJECTS_FILE="$tmp/proj/projects.json"
    wt_provision up nohooks j1 "$tmp/run" repoA /x/a "$tmp/run/repoA" develop ) >/dev/null 2>&1
  want "no script at all is a no-op" 0 $?
  printf '%s\n' '#!/usr/bin/env bash' 'printf "%s %s\n" "$CC_REPO_NAME" "$CC_BASE" > "$CC_WORKTREE/seen"' \
    > "$tmp/cfg/provision/hooked.up.sh"
  ( CONFIG_DIR="$tmp/cfg"; PROJECTS_FILE="$tmp/proj/projects.json"
    wt_provision up hooked j1 "$tmp/run" repoA /x/a "$tmp/run/repoA" develop ) >/dev/null 2>&1
  want "a passing hook returns 0" 0 $?
  got="$(cat "$tmp/run/repoA/seen" 2>/dev/null)"
  [ "$got" = "repoA develop" ] && ok "the hook sees CC_REPO_NAME and CC_BASE" || bad "hook saw '$got'"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 3' > "$tmp/cfg/provision/broken.up.sh"
  ( CONFIG_DIR="$tmp/cfg"; PROJECTS_FILE="$tmp/proj/projects.json"
    wt_provision up broken j1 "$tmp/run" repoA /x/a "$tmp/run/repoA" develop ) >/dev/null 2>&1
  [ $? -ne 0 ] && ok "a failing hook reports failure" || bad "a failing hook reported success"

  echo "wt_setup() — one worktree per repo, a manifest, and an untouched canonical"
  git -c init.defaultBranch=develop init -q "$tmp/g/repo2"
  ( cd "$tmp/g/repo2" && echo hi > f && git add f && $gitc commit -qm init ) >/dev/null 2>&1
  printf '%s' '{"projects":[{"name":"two","cwd":"'"$tmp"'/g/repo","repos":[
      {"name":"one","path":"'"$tmp"'/g/repo","base":"develop"},
      {"name":"two","path":"'"$tmp"'/g/repo2","base":"develop"}]}]}' > "$tmp/proj/two.json"
  local rd="$tmp/wtroot/j2/stampA" prim
  prim="$( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
           wt_setup j2 two "$tmp/g/repo" stampA )"
  [ "$prim" = "$rd/one" ] && ok "the primary worktree is the repo matching .cwd" || bad "primary was '$prim'"
  [ -d "$rd/one" ] && [ -d "$rd/two" ] && ok "one worktree per declared repo" || bad "missing worktrees"
  got="$("$JQ" -r '.repos | length' "$rd/.run.json" 2>/dev/null)"
  [ "$got" = "2" ] && ok "the manifest lists both repos" || bad "manifest listed '$got'"
  got="$("$JQ" -r '.repos[0].fork_sha' "$rd/.run.json" 2>/dev/null)"
  [ "$got" = "$(git -C "$rd/one" rev-parse HEAD)" ] && ok "fork_sha matches the worktree's HEAD" \
    || bad "fork_sha was '$got'"
  got="$(git -C "$tmp/g/repo" symbolic-ref --short --quiet HEAD 2>/dev/null)"
  [ "$got" = "develop" ] && ok "the canonical checkout keeps its branch" || bad "canonical is on '$got'"

  echo "wt_setup() — a project that declares no repos still gets its one worktree"
  printf '%s' '{"projects":[{"name":"solo1","cwd":"'"$tmp"'/g/repo2"}]}' > "$tmp/proj/solo.json"
  prim="$( PROJECTS_FILE="$tmp/proj/solo.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
           wt_setup j9 solo1 "$tmp/g/repo2" stampS )"
  [ "$prim" = "$tmp/wtroot/j9/stampS/repo2" ] && ok "the single-repo path needs no .repos[]" \
    || bad "single-repo primary was '$prim'"
  got="$(wt_run_worktrees "$tmp/wtroot/j9/stampS" | wc -l | tr -d ' ')"
  [ "$got" = "1" ] && ok "exactly one worktree, named after the cwd" || bad "got $got worktrees"

  echo "wt_repos() — a single-repo project pins its base without declaring a repo"
  # The row it used to need was a copy of .cwd carrying one new field. Reading
  # .base directly is what lets the form stop asking for the path twice, which
  # is where a trailing slash used to creep in and orphan the primary.
  printf '%s' '{"projects":[{"name":"solo2","cwd":"'"$tmp"'/g/repo2","base":"develop"}]}' \
    > "$tmp/proj/solobase.json"
  got="$( PROJECTS_FILE="$tmp/proj/solobase.json"; wt_repos solo2 "$tmp/g/repo2" | cut -f3 )"
  [ "$got" = "develop" ] && ok "the project's .base reaches the synthesised row" \
    || bad "base came out '$got'"
  got="$( PROJECTS_FILE="$tmp/proj/solo.json"; wt_repos solo1 "$tmp/g/repo2" | cut -f3 )"
  [ -z "$got" ] && ok "a project declaring neither still infers, exactly as before" \
    || bad "an undeclared base came out '$got'"
  # .repos[] is the more specific statement, so it must not be quietly overruled
  # by a .base left behind from before the project grew a second repository.
  printf '%s' '{"projects":[{"name":"solo3","cwd":"'"$tmp"'/g/repo2","base":"develop","repos":[
      {"name":"repo2","path":"'"$tmp"'/g/repo2","base":"main"}]}]}' > "$tmp/proj/both.json"
  got="$( PROJECTS_FILE="$tmp/proj/both.json"; wt_repos solo3 "$tmp/g/repo2" | cut -f3 )"
  [ "$got" = "main" ] && ok "a declared repo's base still wins over the project's" \
    || bad "with both declared the base came out '$got'"

  echo "wt_setup() — a failing hook aborts, takes down what it built, leaves nothing"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 1' > "$tmp/cfg/provision/two.up.sh"
  printf '%s\n' '#!/usr/bin/env bash' 'echo "$CC_REPO_NAME" >> "$tmp_down_log"' \
    > "$tmp/cfg/provision/two.down.sh"
  export tmp_down_log="$tmp/abort-down.log"; : > "$tmp_down_log"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j2 two "$tmp/g/repo" stampB ) >/dev/null 2>&1
  want "a failing up aborts the setup" 1 $?
  [ ! -d "$tmp/wtroot/j2/stampB" ] && ok "the run dir is gone after a rollback" || bad "run dir survived"
  got="$(sort -u "$tmp_down_log" 2>/dev/null | tr '\n' ' ')"
  [ "$got" = "one two " ] && ok "down ran for what had been built before the abort" \
    || bad "abort ran down for '$got'"
  unset tmp_down_log
  rm -f "$tmp/cfg/provision/two.up.sh" "$tmp/cfg/provision/two.down.sh"

  echo "wt_teardown() — a finished session's dir goes, whatever is in it"
  printf '%s\n' '#!/usr/bin/env bash' 'echo down >> "$CC_RUN_DIR/../down.count"' \
    > "$tmp/cfg/provision/two.down.sh"
  chmod +x "$tmp/cfg/provision/two.down.sh"
  rm -f "$tmp/wtroot/j2/down.count"
  local rd2="$tmp/wtroot/j2/stampC"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j2 two "$tmp/g/repo" stampC ) >/dev/null 2>&1
  echo "work nobody else has" > "$rd2/one/agent.txt"
  echo done > "$rd2/.ended"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_teardown j2 two "$rd2" ) >/dev/null 2>&1
  [ ! -d "$rd2" ] \
    && ok "a done session is removed even holding work on no remote" \
    || bad "a done session's dir survived"
  got="$(wc -l < "$tmp/wtroot/j2/down.count" 2>/dev/null | tr -d ' ')"
  [ "${got:-0}" -eq 2 ] && ok "down ran once per repo" || bad "down ran $got times for 2 repos"

  echo "wt_teardown() — an open session is kept, and its down is NOT run"
  rm -f "$tmp/wtroot/j2/down.count"
  local rd5="$tmp/wtroot/j2/stampO"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j2 two "$tmp/g/repo" stampO ) >/dev/null 2>&1
  echo open > "$rd5/.ended"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_teardown j2 two "$rd5" ) >/dev/null 2>&1
  [ -d "$rd5" ] && ok "an open session keeps its tree" || bad "an open session was removed"
  [ ! -f "$tmp/wtroot/j2/down.count" ] \
    && ok "and its services are left up for the resume" \
    || bad "down tore down a session that is still open"

  echo "wt_teardown() — a dir with no marker is KEPT, because a crash writes none"
  # The discriminating half of this task, and the one that can destroy work if
  # it is wrong. A SIGKILL or a reboot runs no EXIT trap: no marker is written,
  # AND the classifier never fires, so the UNDELIVERED report that justifies
  # deleting a tree never happens either. The fixture therefore carries real
  # work — an empty dir would be reclaimed by any implementation and would
  # prove nothing.
  local rd6="$tmp/wtroot/j2/stampN"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j2 two "$tmp/g/repo" stampN ) >/dev/null 2>&1
  echo "work only this tree has" > "$rd6/one/agent.txt"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_teardown j2 two "$rd6" ) >/dev/null 2>&1
  [ -d "$rd6" ] && ok "a run killed before it could mark anything keeps its work" \
    || bad "an unmarked dir was deleted — a reboot would take every in-flight run with it"
  # And once it IS marked done, the same work is no obstacle: it was reported.
  echo done > "$rd6/.ended"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_teardown j2 two "$rd6" ) >/dev/null 2>&1
  [ ! -d "$rd6" ] && ok "and a done session goes even holding work on no remote" \
    || bad "a done session was kept"
  rm -f "$tmp/cfg/provision/two.down.sh" "$tmp/wtroot/j2/down.count"

  echo "wt_find_by_session() — a session's directory is found again by its id"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup jR two "$tmp/g/repo" stampS1 ) >/dev/null 2>&1
  echo "sess-xyz" > "$tmp/wtroot/jR/stampS1/.session"
  echo open       > "$tmp/wtroot/jR/stampS1/.ended"
  got="$( WORKTREES_DIR="$tmp/wtroot"; wt_find_by_session jR sess-xyz )"
  [ "$got" = "$tmp/wtroot/jR/stampS1" ] && ok "the open session's dir is found" \
    || bad "found '$got'"
  got="$( WORKTREES_DIR="$tmp/wtroot"; wt_find_by_session jR sess-nope )"
  [ -z "$got" ] && ok "an unknown session finds nothing" || bad "found '$got'"
  # Two things have to be true for this to test anything.
  #
  # Asked BEFORE jR closes its session, while stampS1 is still open and would
  # be a real match for jR. Asked afterwards, a lookup that ignored the job id
  # and searched every job's directory would ALSO find nothing here -- by then
  # nothing open exists anywhere for it to wrongly return -- and this assertion
  # would pass whether or not job scoping was implemented at all.
  #
  # And jOther's directory has to EXIST. If it does not, `wt_find_by_session`'s
  # own `[ -d "$WORKTREES_DIR/$id" ]` early return is what answers empty, and a
  # DIFFERENT bug -- a scoping check that lets the id through but then globs
  # every job's directory instead of just this one's -- would never even be
  # reached, let alone caught.
  mkdir -p "$tmp/wtroot/jOther"
  got="$( WORKTREES_DIR="$tmp/wtroot"; wt_find_by_session jOther sess-xyz )"
  [ -z "$got" ] && ok "another job's session is never returned" || bad "found '$got'"
  echo done > "$tmp/wtroot/jR/stampS1/.ended"
  got="$( WORKTREES_DIR="$tmp/wtroot"; wt_find_by_session jR sess-xyz )"
  [ -z "$got" ] && ok "a session already closed is not offered back" || bad "found '$got'"
  rm -rf "$tmp/wtroot/jR" "$tmp/wtroot/jOther"

  echo "run_job() — a reattach claims its tree under a lock, check before write"
  # Structural, deliberately, like the bind_session call-site count above:
  # run_job cannot be exercised end-to-end without mocking the agent CLI, so
  # neither of these has a behavioural test in this file. What actually proves
  # two concurrent resumes cannot both proceed is the real two-process race
  # below, against the live lock_take/wt_is_claimed; this only guards against
  # run_job's own inline code silently reordering the three away from each
  # other, or the primary-name guard regressing to a bare directory check.
  body="$(sed -n '/^run_job()/,/^}/p' "$BIN_DIR/claude-cron")"
  lt_line="$(printf '%s\n' "$body" | grep -n 'lock_take "\$rlock"'                  | head -1 | cut -d: -f1)"
  wc_line="$(printf '%s\n' "$body" | grep -n 'wt_is_claimed "\$id" "\$run_dir"'     | head -1 | cut -d: -f1)"
  wr_line="$(printf '%s\n' "$body" | grep -n 'echo "\$run_dir" > "\$slot/worktree"' | head -1 | cut -d: -f1)"
  # Both exits from the locked region have to drop it: the refusal path drops
  # BETWEEN the check and the write (it never reaches the write at all), and
  # the fall-through path drops AFTER it. Missing either leaks $LOCK_DIR/.resume
  # -- bounded (lock_take's own stale-owner recovery frees it once the holding
  # pid exits) but every OTHER resume serialises behind this one in the
  # meantime, which the line-order check above cannot see: deleting a
  # lock_drop leaves lt_line/wc_line/wr_line untouched and passes it clean.
  ld_lines="$(printf '%s\n' "$body" | grep -n 'lock_drop "\$rlock"' | cut -d: -f1)"
  ld1_line="$(printf '%s\n' "$ld_lines" | sed -n '1p')"
  ld2_line="$(printf '%s\n' "$ld_lines" | sed -n '2p')"
  if [ -n "${lt_line:-}" ] && [ -n "${wc_line:-}" ] && [ -n "${wr_line:-}" ] \
       && [ -n "${ld1_line:-}" ] && [ -n "${ld2_line:-}" ] \
       && [ "$lt_line" -lt "$wc_line" ] && [ "$wc_line" -lt "$wr_line" ] \
       && [ "$wc_line" -lt "$ld1_line" ] && [ "$ld1_line" -lt "$wr_line" ] \
       && [ "$wr_line" -lt "$ld2_line" ]; then
    ok "the lock is taken, the claim checked, and dropped on both exits -- the refusal and the claim -- in order"
  else
    bad "reattach claim ordering broken (lock=${lt_line:-?} check=${wc_line:-?} drop1=${ld1_line:-?} write=${wr_line:-?} drop2=${ld2_line:-?})"
  fi
  got="$(printf '%s\n' "$body" | grep -c '\[ -z "\$primary_name" \] ||')"
  [ "${got:-0}" -eq 1 ] \
    && ok "an empty manifest primary refuses the resume, not just a missing directory" \
    || bad "the primary-name emptiness guard is missing or duplicated (found $got)"

  echo "run_job() — two concurrent reattaches to the same tree: exactly one wins"
  # Not structural: this drives the real lock_take/lock_drop/wt_is_claimed/
  # slot_alive under genuine concurrency, to prove the mechanism the ordering
  # check above just confirmed run_job's code follows actually holds. Two
  # background attempts race for the SAME run_dir; each performs precisely the
  # sequence the reattach branch does -- lock, check wt_is_claimed, write the
  # breadcrumb, unlock -- with a deliberate pause INSIDE the locked section so
  # the second attempt is guaranteed to still be waiting on lock_take when the
  # first finishes, rather than hoping OS scheduling happens to interleave
  # them. bash 3.2 has no $BASHPID and does not reseed $$ inside a subshell,
  # so each attempt's "process" is a real, separately-spawned placeholder --
  # slot_alive needs a genuinely live pid to check.
  #
  # Initialised here, not left to the read below: both branches inside the
  # subshell write race_summary, but if the subshell dies before either does
  # (an interrupted wait, a killed sleep), the file never exists, the read's
  # redirection fails, and under `set -u` an unbound $raceN on the next line
  # would abort THIS WHOLE SCRIPT, not just this one assertion -- a flaky
  # harness has no business taking the other ~90 down with it.
  local raceN="" raceRA="" raceRB=""
  (
    LOCK_DIR="$tmp/locks"; WORKTREES_DIR="$tmp/wtroot"
    mkdir -p "$LOCK_DIR/jRace"
    rd="$tmp/wtroot/jRace/stampRace"; mkdir -p "$rd"
    rlock="$LOCK_DIR/.resume"; rm -rf "$rlock"

    sleep 5 & pidA=$!
    sleep 5 & pidB=$!
    slotA="$LOCK_DIR/jRace/$pidA"; slotB="$LOCK_DIR/jRace/$pidB"
    mkdir -p "$slotA" "$slotB"
    echo "$pidA" > "$slotA/pid"; boot_id > "$slotA/boot"
    echo "$pidB" > "$slotB/pid"; boot_id > "$slotB/boot"

    race_attempt() {
      local slot="$1" resultfile="$2" hold="$3"
      lock_take "$rlock"
      if wt_is_claimed jRace "$rd"; then
        echo REFUSED > "$resultfile"
      else
        [ "$hold" = "1" ] && sleep 0.1
        echo "$rd" > "$slot/worktree"
        echo CLAIMED > "$resultfile"
      fi
      lock_drop "$rlock"
    }

    race_attempt "$slotA" "$tmp/raceA" 1 & raceA=$!
    i=0
    while [ ! -d "$rlock" ] && [ "$i" -lt 200 ]; do sleep 0.01; i=$(( i + 1 )); done
    if [ ! -d "$rlock" ]; then
      echo "TIMEOUT" > "$tmp/race_summary"
    else
      race_attempt "$slotB" "$tmp/raceB" 0 & raceB=$!
      wait "$raceA" "$raceB"
      raceRA="$(cat "$tmp/raceA" 2>/dev/null)"; raceRB="$(cat "$tmp/raceB" 2>/dev/null)"
      raceClaimed=0
      [ "$raceRA" = "CLAIMED" ] && raceClaimed=$(( raceClaimed + 1 ))
      [ "$raceRB" = "CLAIMED" ] && raceClaimed=$(( raceClaimed + 1 ))
      printf '%s %s %s\n' "$raceClaimed" "$raceRA" "$raceRB" > "$tmp/race_summary"
    fi
    kill "$pidA" "$pidB" 2>/dev/null; wait "$pidA" "$pidB" 2>/dev/null
  )
  # Same redirection trap as alloc_port_base's portbase write: a missing file
  # is raised by the shell setting up the `<` before read ever runs, so a
  # 2>/dev/null on read itself does not silence it -- the group is what has
  # to swallow it.
  { read -r raceN raceRA raceRB < "$tmp/race_summary"; } 2>/dev/null || true
  if [ "$raceN" = "1" ]; then
    ok "exactly one of two concurrent reattach attempts claims the tree ($raceRA/$raceRB)"
  else
    bad "expected exactly one claim, got '$raceN' ($raceRA/$raceRB) -- the lock did not serialise them"
  fi
  rm -rf "$tmp/locks/jRace" "$tmp/wtroot/jRace" "$tmp/raceA" "$tmp/raceB" "$tmp/race_summary"

  echo "wt_undelivered_work() — what provisioning left behind is not the agent's work"
  printf '%s\n' '#!/usr/bin/env bash' 'echo residue > provisioned.txt' \
    > "$tmp/cfg/provision/two.up.sh"
  local rd3="$tmp/wtroot/j4/stampE"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j4 two "$tmp/g/repo" stampE ) >/dev/null 2>&1
  [ -f "$rd3/one/provisioned.txt" ] && ok "the hook's untracked file is there" || bad "hook wrote nothing"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_undelivered_work "$rd3" ) >/dev/null 2>&1
  want "provisioning residue alone is NOT undelivered work" 1 $?
  echo "the agent was here" > "$rd3/two/agent.txt"
  got="$( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
          wt_undelivered_work "$rd3" )"
  want "a file the agent added after provisioning IS undelivered work" 0 $?
  case "$got" in *"uncommitted changes in two"*)
      ok "and it names the repo it is in" ;;
    *) bad "the description was '$got'" ;;
  esac
  rm -f "$tmp/cfg/provision/two.up.sh"

  echo "boot_id() — an opaque per-boot identity, stable within one boot"
  got="$(boot_id)"
  case "$got" in
    *-*-*-*-*) ok "it is a boot session uuid, not a timestamp that a clock step moves" ;;
    *) bad "boot_id printed '$got', which is not a uuid" ;;
  esac
  [ "$got" = "$(CC_BOOT_ID=""; boot_id)" ] \
    && ok "and two reads inside one boot agree" || bad "boot_id is not stable"

  echo "slot_alive() — a lease is pinned to the boot it was taken in"
  mkdir -p "$tmp/locks/j8/$$"
  echo $$ > "$tmp/locks/j8/$$/pid"
  boot_id > "$tmp/locks/j8/$$/boot"
  ( LOCK_DIR="$tmp/locks"; slot_alive "$tmp/locks/j8/$$" )
  want "this process's own slot, stamped with this boot, is alive" 0 $?
  echo "0" > "$tmp/locks/j8/$$/boot"
  ( LOCK_DIR="$tmp/locks"; slot_alive "$tmp/locks/j8/$$" )
  want "the same live pid from an earlier boot is dead" 1 $?
  rm -f "$tmp/locks/j8/$$/boot"
  ( LOCK_DIR="$tmp/locks"; slot_alive "$tmp/locks/j8/$$" )
  want "a slot with no boot file predates this and falls back to the pid" 0 $?
  rm -rf "$tmp/locks/j8"

  echo "wt_is_claimed() — a claim from an earlier boot holds nothing"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j8 two "$tmp/g/repo" stampBoot ) >/dev/null 2>&1
  mkdir -p "$tmp/locks/j8/$$"
  echo $$ > "$tmp/locks/j8/$$/pid"
  echo "0" > "$tmp/locks/j8/$$/boot"
  echo "$tmp/wtroot/j8/stampBoot" > "$tmp/locks/j8/$$/worktree"
  # `done`, not left unmarked: an unmarked dir is now kept regardless of
  # whether its claim is live or stale (see wt_teardown), so leaving this one
  # unmarked could not tell THIS function's job -- disregarding a pre-reboot
  # claim -- apart from the boot-pinning being broken and the sweep never
  # reaching wt_teardown at all. Both would leave the dir standing and read as
  # `ok`. A done dir is reaped ONLY if the stale claim is correctly
  # disregarded, which is the exact recycled-pid risk Task 1 exists for.
  echo done > "$tmp/wtroot/j8/stampBoot/.ended"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"
    WORKTREES_DIR="$tmp/wtroot"; LOCK_DIR="$tmp/locks"
    wt_prune_orphans ) >/dev/null 2>&1
  [ ! -d "$tmp/wtroot/j8/stampBoot" ] \
    && ok "a run dir claimed only by a pre-reboot slot is reaped" \
    || bad "a stale pre-reboot claim kept an orphan alive"
  rm -rf "$tmp/locks/j8" "$tmp/wtroot/j8"

  # No backticks in this string: inside double quotes the shell would run it.
  echo "wt_provision() — a down hook from the orphan sweep still knows its ports"
  printf '%s\n' '#!/usr/bin/env bash' 'echo "down saw ${CC_PORT_BASE:-none}" >> "$CC_RUN_DIR/../down.log"' \
    > "$tmp/cfg/provision/two.down.sh"
  chmod +x "$tmp/cfg/provision/two.down.sh"
  rm -f "$tmp/wtroot/j6/down.log"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j6 two "$tmp/g/repo" stampP 27100 ) >/dev/null 2>&1
  got="$("$JQ" -r '.port_base' "$tmp/wtroot/j6/stampP/.run.json" 2>/dev/null)"
  [ "$got" = "27100" ] && ok "the manifest records the run's port block" \
    || bad "port_base was '$got'"
  # `done`, not left unmarked: the orphan sweep now KEEPS an unmarked dir (see
  # above), so proving `down` still finds its ports needs a dir the sweep will
  # actually tear down -- a crash that landed AFTER the run's own classifier
  # wrote `done`, not one caught before any classifier ran.
  echo done > "$tmp/wtroot/j6/stampP/.ended"
  # No slot, no ambient CC_PORT_BASE: exactly the orphan sweep's situation.
  # wt_prune_orphans resolves the project via job_get (JOBS_FILE), not by
  # reading the manifest's own .project — so the sweep needs a job "j6" ->
  # project "two" of its own, same as the real jobs.json a live job would
  # have, or the down hook this test is proving out is never found.
  printf '%s' '{"jobs":[{"id":"j6","project":"two"}]}' > "$tmp/proj/j6.jobs.json"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"
    WORKTREES_DIR="$tmp/wtroot"; LOCK_DIR="$tmp/locks"; JOBS_FILE="$tmp/proj/j6.jobs.json"
    unset CC_PORT_BASE
    wt_prune_orphans ) >/dev/null 2>&1
  grep -q "down saw 27100" "$tmp/wtroot/j6/down.log" 2>/dev/null \
    && ok "a crashed run's down hook reads its ports from the manifest" \
    || bad "down ran without the run's port block"
  rm -f "$tmp/cfg/provision/two.down.sh" "$tmp/wtroot/j6/down.log"

  echo "wt_prune_orphans() — an unclaimed run dir is kept until it is marked done"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j3 two "$tmp/g/repo" stampD ) >/dev/null 2>&1
  mkdir -p "$tmp/locks/j3/999"
  echo $$ > "$tmp/locks/j3/999/pid"
  echo "$tmp/wtroot/j3/stampD" > "$tmp/locks/j3/999/worktree"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"
    WORKTREES_DIR="$tmp/wtroot"; LOCK_DIR="$tmp/locks"
    wt_prune_orphans ) >/dev/null 2>&1
  [ -d "$tmp/wtroot/j3/stampD" ] && ok "a run dir a live slot claims is left alone" \
    || bad "the sweep deleted a claimed run dir"
  rm -rf "$tmp/locks/j3"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"
    WORKTREES_DIR="$tmp/wtroot"; LOCK_DIR="$tmp/locks"
    wt_prune_orphans ) >/dev/null 2>&1
  [ -d "$tmp/wtroot/j3/stampD" ] \
    && ok "unclaimed but still unmarked, it is kept rather than reaped" \
    || bad "the orphan was reaped though nothing ever said its run was done"
  # The control: this is not "the sweep never reaps anything now" -- only that
  # it needs telling. Once the run IS marked done, the very next sweep lets it
  # go, same as any other done run the sweep finds.
  echo done > "$tmp/wtroot/j3/stampD/.ended"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"
    WORKTREES_DIR="$tmp/wtroot"; LOCK_DIR="$tmp/locks"
    wt_prune_orphans ) >/dev/null 2>&1
  [ ! -d "$tmp/wtroot/j3/stampD" ] && ok "and a done, unclaimed run IS reaped by the sweep" \
    || bad "a done run survived a sweep — the sweep no longer reaps anything"

  echo "wt_prune_canonicals() — a run dir removed by hand leaves no registration behind"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j5 two "$tmp/g/repo" stampR ) >/dev/null 2>&1
  rm -rf "$tmp/wtroot/j5/stampR"          # behind git's back, the way a human does it
  git -C "$tmp/g/repo" worktree list --porcelain 2>/dev/null | grep -q 'stampR' \
    && ok "git still lists the registration before the prune" \
    || bad "the fixture did not leave a stale registration to clear"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_prune_canonicals ) >/dev/null 2>&1
  git -C "$tmp/g/repo" worktree list --porcelain 2>/dev/null | grep -q 'stampR' \
    && bad "the stale registration survived the prune" \
    || ok "the canonical checkout is clean again"

  echo "wt_prune_canonicals() — the path list survives spaces and a malformed entry"
  # The enumeration is the fragile half, so test it directly rather than through
  # a git side effect: a path silently dropped here is a repo that is never
  # pruned again, and nothing anywhere would say so.
  mkdir -p "$tmp/proj"
  cat > "$tmp/proj/nasty.json" <<'NASTY'
{"projects":[
 {"cwd":"/Users/Jane Doe/repo-a"},
 {"cwd":"/Users/Jane"},
 {"cwd":"/Users/Jane Doe/repo-a"},
 {"repos":["not-an-object"],"cwd":"/tmp/malformed"},
 {"repos":[{"path":"/tmp/api"},{"name":"no-path"}],"cwd":"/tmp/web"},
 {"name":"no-cwd-at-all"},
 {"cwd":null}
]}
NASTY
  got="$("$JQ" -r '
    .projects[]? | ((.repos // [])[]? | objects | .path), .cwd
    | strings | select(. != "")' "$tmp/proj/nasty.json" 2>/dev/null | sort -u | tr '\n' '|')"
  [ "$got" = "/Users/Jane|/Users/Jane Doe/repo-a|/tmp/api|/tmp/malformed|/tmp/web|" ] \
    && ok "a home dir with a space is its own path, and one bad entry drops only itself" \
    || bad "the path list came out as '$got'"
  rm -f "$tmp/proj/nasty.json"

  echo "wt_prune_canonicals() — end to end, a canonical whose path is a space-truncated prefix of another is pruned too"
  # The two blocks above prove the dedup logic in isolation (the jq expression)
  # and the git side effect for a single canonical (the stampR case). Neither
  # can regress on the one thing the finding was actually about: a SECOND real
  # canonical checkout whose path is what "/Users/Jane" is to
  # "/Users/Jane Doe/repo-a" — a literal prefix ending right where the longer
  # path has a space. This drives the real wt_prune_canonicals against two real
  # git repos shaped exactly that way, so a regression back to the
  # space-delimited seen/glob would fail this assertion even though it cannot
  # touch the fixture above (whose paths do not exist on disk).
  mkdir -p "$tmp/g/spacer/Jane Doe/repo-a" "$tmp/g/spacer/Jane"
  for r in "$tmp/g/spacer/Jane Doe/repo-a" "$tmp/g/spacer/Jane"; do
    git -c init.defaultBranch=develop init -q "$r"
    ( cd "$r" && echo hi > f && git add f && $gitc commit -qm init ) >/dev/null 2>&1
  done
  printf '%s' '{"projects":[
      {"name":"spacer-a","cwd":"'"$tmp"'/g/spacer/Jane Doe/repo-a"},
      {"name":"spacer-b","cwd":"'"$tmp"'/g/spacer/Jane"}]}' > "$tmp/proj/spacer.json"
  ( PROJECTS_FILE="$tmp/proj/spacer.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup jsp1 spacer-a "$tmp/g/spacer/Jane Doe/repo-a" stampSA
    wt_setup jsp2 spacer-b "$tmp/g/spacer/Jane" stampSB ) >/dev/null 2>&1
  rm -rf "$tmp/wtroot/jsp1/stampSA" "$tmp/wtroot/jsp2/stampSB"
  ( git -C "$tmp/g/spacer/Jane Doe/repo-a" worktree list --porcelain 2>/dev/null | grep -q 'stampSA' \
    && git -C "$tmp/g/spacer/Jane" worktree list --porcelain 2>/dev/null | grep -q 'stampSB' ) \
    && ok "both stale registrations exist before the prune" \
    || bad "the fixture did not leave both stale registrations to clear"
  ( PROJECTS_FILE="$tmp/proj/spacer.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_prune_canonicals ) >/dev/null 2>&1
  git -C "$tmp/g/spacer/Jane" worktree list --porcelain 2>/dev/null | grep -q 'stampSB' \
    && bad "the shorter canonical (.../Jane) was never pruned -- the old seen-glob bug is back" \
    || ok "the shorter canonical (.../Jane) was pruned despite matching a longer path up to a space"
  git -C "$tmp/g/spacer/Jane Doe/repo-a" worktree list --porcelain 2>/dev/null | grep -q 'stampSA' \
    && bad "the longer canonical (.../Jane Doe/repo-a) survived the prune" \
    || ok "the longer canonical (.../Jane Doe/repo-a) was pruned"

  echo "toggle-many flips only the jobs it was handed"
  printf '%s' '{"jobs":[{"id":"a"},{"id":"b","enabled":false},{"id":"c"}]}' > "$tmp/tm.json"
  got="$("$JQ" -c --argjson want '["a","b"]' --argjson v false "$TOGGLE_MANY_FILTER" "$tmp/tm.json")"
  [ "$got" = '{"jobs":[{"id":"a","enabled":false},{"id":"b","enabled":false},{"id":"c"}]}' ] \
    && ok "disabling a set leaves every job outside it byte-identical" \
    || bad "toggle-many disable produced: $got"
  got="$("$JQ" -c --argjson want '["b"]' --argjson v true "$TOGGLE_MANY_FILTER" "$tmp/tm.json")"
  [ "$got" = '{"jobs":[{"id":"a"},{"id":"b","enabled":true},{"id":"c"}]}' ] \
    && ok "enabling one job adds no key to the others" \
    || bad "toggle-many enable produced: $got"

  echo "the suite itself touches nothing outside its scratch dir"
  [ "$(size_of "$_real_tick")" = "$_tick0" ] \
    && ok "the real tick.log is byte-identical after the suite" \
    || bad "the suite appended to the real tick.log ($_tick0 -> $(size_of "$_real_tick") bytes)"
  [ "$(size_of "$_real_exec")" = "$_exec0" ] \
    && ok "the real exec.log is byte-identical after the suite" \
    || bad "the suite appended to the real exec.log ($_exec0 -> $(size_of "$_real_exec") bytes)"

  echo "log_rotate() — a log that grows without bound is capped, never lost"
  printf 'old line\n' > "$tmp/r.log"
  log_rotate "$tmp/r.log" 1000000
  [ ! -e "$tmp/r.log.1" ] && ok "a small log is left alone" || bad "a small log was rotated"
  local i=0; : > "$tmp/r.log"
  while [ "$i" -lt 200 ]; do printf 'a line that takes up some space %s\n' "$i" >> "$tmp/r.log"; i=$((i+1)); done
  log_rotate "$tmp/r.log" 1000
  [ "$(size_of "$tmp/r.log")" = "0" ] && ok "an oversized log is truncated" \
    || bad "log still $(size_of "$tmp/r.log") bytes"
  grep -q 'a line that takes up some space 199' "$tmp/r.log.1" 2>/dev/null \
    && ok "the previous generation is kept in .1" || bad "rotated content was lost"
  # A second rotation must not stack generations for ever.
  : > "$tmp/r.log"; i=0
  while [ "$i" -lt 200 ]; do printf 'second generation %s\n' "$i" >> "$tmp/r.log"; i=$((i+1)); done
  log_rotate "$tmp/r.log" 1000
  grep -q 'second generation 199' "$tmp/r.log.1" 2>/dev/null \
    && ok "rotating again replaces .1 rather than growing a chain" || bad ".1 was not replaced"
  [ ! -e "$tmp/r.log.2" ] && ok "no .2 is ever created" || bad "a .2 generation appeared"

  echo "precheck_verdict() — a broken probe is not an idle one"
  [ "$(precheck_verdict 0)" = "work" ]  && ok "exit 0 means work was found"    || bad "exit 0 -> $(precheck_verdict 0)"
  [ "$(precheck_verdict 1)" = "idle" ]  && ok "exit 1 means nothing to do"     || bad "exit 1 -> $(precheck_verdict 1)"
  # The whole point: a probe that could not run at all used to be indistinguishable
  # from one that ran and found nothing, so a job whose credentials had gone
  # missing sat "idle" for ever with nothing showing red anywhere.
  [ "$(precheck_verdict 2)" = "error" ] && ok "exit 2 is a broken probe"       || bad "exit 2 -> $(precheck_verdict 2)"
  [ "$(precheck_verdict 127)" = "error" ] && ok "exit 127 (missing command) is broken" || bad "exit 127 -> $(precheck_verdict 127)"
  [ "$(precheck_verdict '')" = "error" ]  && ok "a missing exit code is broken" || bad "empty -> $(precheck_verdict '')"

  echo "lock_take() — a lock is stolen from the dead, never from the living"
  local t0 elapsed dead=99999
  if kill -0 "$dead" 2>/dev/null; then dead=99998; fi
  lock_take "$tmp/free" && ok "a free lock is taken" || bad "could not take a free lock"
  [ "$(cat "$tmp/free/pid" 2>/dev/null)" = "$$" ] && ok "the holder records its pid" || bad "no pid recorded"
  lock_drop "$tmp/free"
  [ ! -d "$tmp/free" ] && ok "dropping removes the lock" || bad "lock survived the drop"

  mkdir -p "$tmp/stale"; echo "$dead" > "$tmp/stale/pid"
  t0="$(now_epoch)"; lock_take "$tmp/stale"; elapsed=$(( $(now_epoch) - t0 ))
  [ "$elapsed" -lt 2 ] && ok "a lock whose owner is gone is taken at once (${elapsed}s)" \
    || bad "waited ${elapsed}s for a dead owner"
  lock_drop "$tmp/stale"

  # The regression that matters. Every one of these locks used to be broken
  # purely on elapsed time (~4s), so a journal rewrite over a large history —
  # exactly the slow case — would have its lock stolen mid-rewrite by a run
  # ending, and lose the record the lock exists to protect.
  mkdir -p "$tmp/live"; echo $$ > "$tmp/live/pid"
  ( lock_take "$tmp/live" && : > "$tmp/live-was-stolen" ) >/dev/null 2>&1 & local waiter=$!
  sleep 5
  [ ! -f "$tmp/live-was-stolen" ] \
    && ok "a lock held by a LIVE process is still held after 5s" \
    || bad "the lock was stolen from a live holder"
  kill "$waiter" 2>/dev/null; wait "$waiter" 2>/dev/null
  rm -rf "$tmp/live"

  echo "backoff_multiplier() — a job that only ever fails must stop costing full price"
  # Nothing slowed a failing job down: it relaunched every interval, at full
  # budget, for as long as it kept failing. 14 dev/review jobs on a 5-minute
  # interval is a lot of money to spend discovering the same breakage.
  [ "$(backoff_multiplier 0)" = "1" ] && ok "a healthy job is never slowed"        || bad "streak 0 -> $(backoff_multiplier 0)"
  [ "$(backoff_multiplier 2)" = "1" ] && ok "two failures are still just noise"    || bad "streak 2 -> $(backoff_multiplier 2)"
  [ "$(backoff_multiplier 3)" = "2" ] && ok "the third failure doubles the wait"   || bad "streak 3 -> $(backoff_multiplier 3)"
  [ "$(backoff_multiplier 4)" = "4" ] && ok "it keeps doubling"                    || bad "streak 4 -> $(backoff_multiplier 4)"
  [ "$(backoff_multiplier 7)" = "16" ] && ok "the multiplier is capped at 16x"     || bad "streak 7 -> $(backoff_multiplier 7)"
  [ "$(backoff_multiplier 99)" = "16" ] && ok "and stays capped"                   || bad "streak 99 -> $(backoff_multiplier 99)"
  [ "$(backoff_multiplier '')" = "1" ] && ok "an absent streak is not a failure"   || bad "empty -> $(backoff_multiplier '')"
  [ "$(effective_interval 300 0)" = "300" ] && ok "a healthy job keeps its interval" || bad "300/0 -> $(effective_interval 300 0)"
  [ "$(effective_interval 300 4)" = "1200" ] && ok "a failing job waits 4x longer" || bad "300/4 -> $(effective_interval 300 4)"

  echo "state_set_many() — the end of a run is one write, not seven"
  ( STATE_FILE="$tmp/state.json"; echo '{"x":{"keep":"me"}}' > "$STATE_FILE"
    state_set_many x '{"last_status":"success","last_cost":1.25,"fail_streak":0}'
    printf '%s|%s|%s|%s\n' "$(state_get x last_status)" "$(state_get x last_cost)" \
           "$(state_get x fail_streak)" "$(state_get x keep)" ) > "$tmp/sm.out" 2>/dev/null
  got="$(cat "$tmp/sm.out")"
  [ "$got" = "success|1.25|0|me" ] \
    && ok "every field lands and the fields already there survive" || bad "got '$got'"
  ( STATE_FILE="$tmp/state2.json"; echo '{}' > "$STATE_FILE"
    state_set_many newjob '{"a":1}'; state_get newjob a ) > "$tmp/sm2.out" 2>/dev/null
  [ "$(cat "$tmp/sm2.out")" = "1" ] && ok "a job with no state yet is created" || bad "new job: $(cat "$tmp/sm2.out")"

  echo "in_window_vals() — the schedule window, including the one that wraps midnight"
  in_window_vals "" "" 3 600            ; want "no restriction is always open"        0 $?
  in_window_vals "1,2,3,4,5" "" 3 600   ; want "a listed weekday is open"             0 $?
  in_window_vals "1,2,3,4,5" "" 6 600   ; want "an unlisted weekday is closed"        1 $?
  in_window_vals "" "08:00-20:00" 3 600 ; want "inside the hours is open (10:00)"     0 $?
  in_window_vals "" "08:00-20:00" 3 479 ; want "a minute before opening is closed"    1 $?
  in_window_vals "" "08:00-20:00" 3 480 ; want "the opening minute is open"           0 $?
  in_window_vals "" "08:00-20:00" 3 1200; want "the closing minute is closed"         1 $?
  # A window that wraps midnight is the one people get wrong: 22:00-06:00 must
  # be open at 23:00 AND at 02:00, and shut at midday.
  in_window_vals "" "22:00-06:00" 3 1380; want "a wrapping window is open at 23:00"   0 $?
  in_window_vals "" "22:00-06:00" 3 120 ; want "a wrapping window is open at 02:00"   0 $?
  in_window_vals "" "22:00-06:00" 3 720 ; want "a wrapping window is shut at midday"  1 $?
  in_window_vals "6,7" "22:00-06:00" 7 120; want "day and hour must BOTH match"       0 $?
  in_window_vals "6,7" "22:00-06:00" 1 120; want "the wrong day closes it"            1 $?
  # 08:00 written as 08 must not be read as octal — the classic bash trap.
  in_window_vals "" "08:00-09:00" 3 510 ; want "a leading zero is decimal, not octal" 0 $?

  echo "is_due_vals() — due-ness accounts for the failure backoff"
  is_due_vals 300 "$(( $(now_epoch) - 400 ))" 0 ; want "past its interval is due"     0 $?
  is_due_vals 300 "$(( $(now_epoch) - 100 ))" 0 ; want "inside its interval is not"   1 $?
  is_due_vals 300 "$(( $(now_epoch) - 400 ))" 4 ; want "a backed-off job waits longer" 1 $?
  is_due_vals 300 "$(( $(now_epoch) - 1300 ))" 4; want "and runs once the longer wait passes" 0 $?
  is_due_vals 300 0 0                           ; want "a job that never ran is due"  0 $?

  echo "daily caps — a ceiling can be set per job, per project, and for everything"
  mkdir -p "$tmp/caps"
  printf '%s' '{"jobs":[{"id":"own","project":"P","daily_budget_usd":5},
                        {"id":"inherits","project":"P"},
                        {"id":"loner"}]}' > "$tmp/caps/jobs.json"
  printf '%s' '{"global_daily_budget_usd":100,
                "projects":[{"name":"P","daily_budget_usd":20}]}' > "$tmp/caps/projects.json"
  got="$( JOBS_FILE="$tmp/caps/jobs.json"; PROJECTS_FILE="$tmp/caps/projects.json"; daily_cap_for own )"
  [ "$got" = "5" ] && ok "a job's own cap wins" || bad "own -> '$got'"
  got="$( JOBS_FILE="$tmp/caps/jobs.json"; PROJECTS_FILE="$tmp/caps/projects.json"; daily_cap_for inherits )"
  # This is the gap: daily_budget_usd was read from the job ALONE, so setting it
  # on a project quietly did nothing at all.
  [ "$got" = "20" ] && ok "a job with no cap inherits its project's" || bad "inherits -> '$got'"
  got="$( JOBS_FILE="$tmp/caps/jobs.json"; PROJECTS_FILE="$tmp/caps/projects.json"; daily_cap_for loner )"
  [ -z "$got" ] && ok "no cap anywhere means no cap" || bad "loner -> '$got'"
  got="$( PROJECTS_FILE="$tmp/caps/projects.json"; global_daily_cap )"
  [ "$got" = "100" ] && ok "a global ceiling can be declared" || bad "global -> '$got'"
  got="$( PROJECTS_FILE="$tmp/proj/projects.json"; global_daily_cap )"
  [ -z "$got" ] && ok "and is absent unless declared" || bad "undeclared global -> '$got'"

  echo "the Claude account comes from the setting, never from the environment"
  # cmd_install refuses an ambient CLAUDE_CONFIG_DIR, and for a while the runtime
  # did not: `claude-cron run <job>` typed inside a Claude Code session inherited
  # THAT session's account, so the run billed elsewhere and loaded another
  # account's plugins with nothing in the record saying so. Probe the real script
  # rather than a copy of the rule — the rule was never wrong, the wiring was.
  # Sourcing it with `--help` runs every top-level assignment and then returns.
  # An empty value and an unset one are the same to `${VAR:-}`, so both can be
  # passed unconditionally — and stay quoted, which a conditional would not.
  cc_account_probe() { # <ambient CLAUDE_CONFIG_DIR> <CLAUDE_CRON_CLAUDE_CONFIG_DIR>
    env CLAUDE_CONFIG_DIR="$1" CLAUDE_CRON_CLAUDE_CONFIG_DIR="$2" \
        CLAUDE_CRON_CONFIG="$tmp/acct/config" CLAUDE_CRON_DATA="$tmp/acct/data" \
        bash -c '. "$1" --help >/dev/null 2>&1; printf "%s" "${CLAUDE_CONFIG_DIR-<unset>}"' _ "$SELF"
  }
  got="$(cc_account_probe /tmp/cc-someones-session "")"
  [ "$got" = "<unset>" ] \
    && ok "an ambient CLAUDE_CONFIG_DIR is not inherited" \
    || bad "an ambient CLAUDE_CONFIG_DIR leaked in as '$got'"
  got="$(cc_account_probe /tmp/cc-someones-session /tmp/cc-declared)"
  [ "$got" = "/tmp/cc-declared" ] \
    && ok "the declared account wins over the environment" \
    || bad "declared account -> '$got'"
  got="$(cc_account_probe "" /tmp/cc-declared)"
  [ "$got" = "/tmp/cc-declared" ] \
    && ok "and is honoured when nothing is ambient" \
    || bad "declared account alone -> '$got'"
  got="$(cc_account_probe "" "")"
  [ "$got" = "<unset>" ] \
    && ok "no setting anywhere leaves the CLI's own default" \
    || bad "no setting -> '$got'"

  echo "spent_today() — today's spend is summed without reading all of history"
  local midnight; midnight="$(date -v0H -v0M -v0S +%s)"
  : > "$tmp/runs.ndjson"
  printf '{"id":"a","start":%s,"cost":1.5}\n' "$(( midnight + 10 ))" >> "$tmp/runs.ndjson"
  printf '{"id":"a","start":%s,"cost":2.25}\n' "$(( midnight + 20 ))" >> "$tmp/runs.ndjson"
  printf '{"id":"b","start":%s,"cost":4}\n'    "$(( midnight + 30 ))" >> "$tmp/runs.ndjson"
  printf '{"id":"a","start":%s,"cost":99}\n'   "$(( midnight - 8000 ))" >> "$tmp/runs.ndjson"
  got="$( RUNS_FILE="$tmp/runs.ndjson"; spent_today a )"
  [ "$got" = "3.750000" ] && ok "one job's spend today is summed" || bad "spent_today a -> '$got'"
  got="$( RUNS_FILE="$tmp/runs.ndjson"; spent_today_all )"
  [ "$got" = "7.750000" ] && ok "every job's spend today is summed" || bad "spent_today_all -> '$got'"
  # A truncated leading line (the scan starts at a byte offset, not a line
  # boundary) must be skipped, never parsed into a bogus cost.
  printf '%s\n' '{"id":"a","start":1,"co' > "$tmp/cut.ndjson"
  cat "$tmp/runs.ndjson" >> "$tmp/cut.ndjson"
  got="$( RUNS_FILE="$tmp/cut.ndjson"; spent_today a )"
  [ "$got" = "3.750000" ] && ok "a truncated first line is ignored" || bad "with a cut line -> '$got'"

  echo "cmd_worktree_drop() — a retained run dir can be discarded on purpose"
  # wt_teardown deliberately KEEPS an open session (a run cut short, waiting on
  # a resume), and the sweep then re-examines it every tick for ever until one
  # comes. Nothing could ever let go of it on its own, so the only exit is
  # rm -rf by hand.
  local rd4="$tmp/wtroot/j7/stampF"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j7 two "$tmp/g/repo" stampF ) >/dev/null 2>&1
  echo open > "$rd4/.ended"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_teardown j7 two "$rd4" ) >/dev/null 2>&1
  [ -d "$rd4" ] && ok "an open session is still preserved by the normal path" || bad "teardown removed it"

  mkdir -p "$tmp/locks/j7/888"; echo $$ > "$tmp/locks/j7/888/pid"
  echo "$rd4" > "$tmp/locks/j7/888/worktree"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"
    WORKTREES_DIR="$tmp/wtroot"; LOCK_DIR="$tmp/locks"
    cmd_worktree_drop j7 stampF ) >/dev/null 2>&1
  [ -d "$rd4" ] && ok "a dir a LIVE run is using is never dropped" || bad "dropped a live run's dir"
  rm -rf "$tmp/locks/j7"

  # The one remedy for round-1's Important #3 (a leaked compose stack and
  # ports) had no assertion of its own: nothing here ever proved `down`
  # actually fires on a drop, only that the directory goes. An open session
  # never reaches wt_teardown's own down block, so this explicit drop is the
  # ONLY place left that can still release it -- prove it does.
  printf '%s\n' '#!/usr/bin/env bash' 'echo down >> "$CC_RUN_DIR/../down.count"' \
    > "$tmp/cfg/provision/two.down.sh"
  chmod +x "$tmp/cfg/provision/two.down.sh"
  rm -f "$tmp/wtroot/j7/down.count"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"
    WORKTREES_DIR="$tmp/wtroot"; LOCK_DIR="$tmp/locks"
    cmd_worktree_drop j7 stampF ) >/dev/null 2>&1
  want "dropping an unclaimed dir succeeds" 0 $?
  [ ! -d "$rd4" ] && ok "the retained dir is gone once dropped explicitly" || bad "dir survived the drop"
  got="$(wc -l < "$tmp/wtroot/j7/down.count" 2>/dev/null | tr -d ' ')"
  [ "${got:-0}" -eq 2 ] && ok "the drop released what teardown left up, once per repo" \
    || bad "down ran $got times for 2 repos on an explicit drop"
  # And git must not be left believing the worktrees are still checked out.
  got="$(git -C "$tmp/g/repo" worktree list --porcelain 2>/dev/null | grep -c "stampF" || true)"
  [ "$(num "$got")" = "0" ] && ok "git no longer lists the removed worktree" || bad "git still lists $got"
  rm -f "$tmp/cfg/provision/two.down.sh" "$tmp/wtroot/j7/down.count"

  echo "a run the operator stops is recorded as stopped, never lost"
  # Stopping in the seconds between claiming a slot and spawning the agent used
  # to just delete the slot: the row vanished from the table with no run, no log
  # and no record that it had ever been asked for. And a TERM'd agent exits
  # non-zero, so a deliberate stop was filed as `error` — counted in the error
  # tile and feeding the failure backoff, slowing the job down as punishment for
  # a decision its owner made on purpose.
  local sl="$tmp/locks/j9/777"
  mkdir -p "$sl" "$tmp/stoplogs"
  echo 777 > "$sl/pid"; echo 1700000000 > "$sl/start"
  echo "$tmp/stoplogs/r.json" > "$sl/logfile"
  : > "$sl/stopped"
  ( CONFIG_DIR="$tmp/cfg"; DATA_DIR="$tmp"; RUNS_FILE="$tmp/stop.ndjson"
    STATE_FILE="$tmp/stopstate.json"; LOG_DIR="$tmp/stoplogs"; TICK_LOG="$tmp/stop.tick"
    run_record_stopped_early j9 "$sl" ) >/dev/null 2>&1
  got="$("$JQ" -r '.status' "$tmp/stop.ndjson" 2>/dev/null | head -1)"
  [ "$got" = "stopped" ] && ok "a stop before the agent starts still journals a run" \
    || bad "journalled status '$got'"
  got="$("$JQ" -r '.note // ""' "$tmp/stop.ndjson" 2>/dev/null | head -1)"
  case "$got" in STOPPED:*) ok "and the record says why it ended" ;;
                 *) bad "note was '$got'" ;; esac
  got="$("$JQ" -r '.subtype // ""' "$tmp/stoplogs/r.json" 2>/dev/null)"
  [ "$got" = "stopped_by_user" ] && ok "and it leaves a log body explaining itself" \
    || bad "log subtype '$got'"
  # The record used to carry no model at all, which in the run modal reads as
  # missing data rather than as a run that never got far enough to have one.
  got="$("$JQ" -r '.model // ""' "$tmp/stop.ndjson" 2>/dev/null | head -1)"
  [ -n "$got" ] && ok "and says which model it would have run" || bad "model was empty"
  # And a stop landing before the slot has a logfile breadcrumb still gets a log.
  local sl2="$tmp/locks/j9/778"
  mkdir -p "$sl2"; echo 778 > "$sl2/pid"; echo 1700000000 > "$sl2/start"; : > "$sl2/stopped"
  ( CONFIG_DIR="$tmp/cfg"; DATA_DIR="$tmp"; RUNS_FILE="$tmp/stop2.ndjson"
    STATE_FILE="$tmp/stopstate.json"; LOG_DIR="$tmp/stoplogs"; TICK_LOG="$tmp/stop.tick"
    run_record_stopped_early j9 "$sl2" ) >/dev/null 2>&1
  got="$("$JQ" -r '.log // ""' "$tmp/stop2.ndjson" 2>/dev/null | head -1)"
  [ -n "$got" ] && [ -f "$got" ] && ok "a stop with no logfile breadcrumb still writes one" \
    || bad "log path '$got'"
  rm -rf "$tmp/locks/j9/778"
  # Twice must not produce two rows: the normal path drops `journaled` the moment
  # it files its own record, and this must respect that.
  : > "$sl/journaled"
  ( CONFIG_DIR="$tmp/cfg"; DATA_DIR="$tmp"; RUNS_FILE="$tmp/stop.ndjson"
    STATE_FILE="$tmp/stopstate.json"; LOG_DIR="$tmp/stoplogs"; TICK_LOG="$tmp/stop.tick"
    run_record_stopped_early j9 "$sl" ) >/dev/null 2>&1
  got="$(wc -l < "$tmp/stop.ndjson" | tr -d ' ')"
  [ "$got" = "1" ] && ok "a run that already journalled is not recorded twice" \
    || bad "$got rows in the journal"
  # And a slot with no stop marker is none of this function's business.
  rm -f "$sl/stopped" "$sl/journaled"
  ( CONFIG_DIR="$tmp/cfg"; DATA_DIR="$tmp"; RUNS_FILE="$tmp/stop.ndjson"
    STATE_FILE="$tmp/stopstate.json"; LOG_DIR="$tmp/stoplogs"; TICK_LOG="$tmp/stop.tick"
    run_record_stopped_early j9 "$sl" ) >/dev/null 2>&1
  got="$(wc -l < "$tmp/stop.ndjson" | tr -d ' ')"
  [ "$got" = "1" ] && ok "a run nobody stopped is left alone" || bad "$got rows after a no-op"
  rm -rf "$tmp/locks/j9"

  echo "run_record_stopped_early() — a stop after the agent ran does not claim nothing happened"
  # Review: the tree now survives a mid-classifier stop (see run_cleanup
  # below), but this function still filed "no work was done and nothing was
  # spent" regardless of $slot/child -- a record that actively denies the very
  # thing the kept directory proves, and the only exit before the TTL is
  # Discard. $slot/child (written the instant an agent is spawned, never
  # removed) was already in hand to tell the two cases apart; no cost or turns
  # accounting needed, just a different note.
  local sl3="$tmp/locks/j9/779"
  mkdir -p "$sl3"
  echo 779 > "$sl3/pid"; echo 1700000000 > "$sl3/start"
  echo "$tmp/stoplogs/r3.json" > "$sl3/logfile"
  echo 55555 > "$sl3/child"          # an agent WAS spawned before the stop landed
  : > "$sl3/stopped"
  ( CONFIG_DIR="$tmp/cfg"; DATA_DIR="$tmp"; RUNS_FILE="$tmp/stop3.ndjson"
    STATE_FILE="$tmp/stopstate.json"; LOG_DIR="$tmp/stoplogs"; TICK_LOG="$tmp/stop3.tick"
    run_record_stopped_early j9 "$sl3" ) >/dev/null 2>&1
  got="$("$JQ" -r '.note // ""' "$tmp/stop3.ndjson" 2>/dev/null | head -1)"
  case "$got" in
    *"no work was done"*) bad "with an agent spawned, the note still claims '$got'" ;;
    STOPPED:*)            ok "and it no longer denies the agent ever ran" ;;
    *)                    bad "note was '$got'" ;;
  esac
  grep -q "already run" "$tmp/stop3.tick" 2>/dev/null \
    && ok "the tick log tells the two cases apart too" || bad "tick log did not distinguish the case"
  rm -rf "$tmp/locks/j9"

  echo "run_cleanup() — a stop landing after the agent finished must not delete its work"
  # The Critical this closes. _stop_slot TERMs the run WRAPPER whenever the
  # agent's own pid is not ALIVE -- true both when no agent has been spawned
  # yet and when one already finished and exited. A Stop clicked while the
  # wrapper is still inside its post-agent classifier (git status / git branch
  # -r --contains per repo -- real wall-clock time on a real checkout, with the
  # dashboard still showing the run as active) lands here with $slot/stopped
  # set, no `.ended` written yet (the classifier never reached that line), and
  # the agent's actual commits sitting in the tree. $slot/child is the one fact
  # that tells the two cases apart: it is written the moment an agent is
  # spawned and is never removed, so its VALUE does not matter here, only its
  # presence.
  local rd7="$tmp/wtroot/j2/stampS"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j2 two "$tmp/g/repo" stampS ) >/dev/null 2>&1
  echo "the agent's own commit, never pushed" > "$rd7/one/agent.txt"
  local scl="$tmp/locks/j2/999"
  mkdir -p "$scl" "$tmp/rclogs"
  echo 999 > "$scl/pid"; echo 1700000000 > "$scl/start"
  echo "$rd7" > "$scl/worktree"
  echo "$tmp/rclogs/rc.json" > "$scl/logfile"
  echo 12345 > "$scl/child"          # an agent WAS spawned -- dead or alive, it existed
  : > "$scl/stopped"                 # the operator clicked Stop
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    DATA_DIR="$tmp"; RUNS_FILE="$tmp/rc.ndjson"; STATE_FILE="$tmp/rcstate.json"
    LOG_DIR="$tmp/rclogs"; TICK_LOG="$tmp/rc.tick"
    run_cleanup j2 "$scl" ) >/dev/null 2>&1
  [ -d "$rd7" ] \
    && ok "an agent that was spawned keeps its run open, never marked done" \
    || bad "CRITICAL: a stop after the agent ran deleted its work"
  got="$(cat "$rd7/.ended" 2>/dev/null)"
  [ "$got" = "open" ] && ok "and .ended says so, not done" || bad ".ended was '$got'"

  echo "run_cleanup() — a stop with no agent ever spawned is still closed as done"
  # The control, not just the refusal: the ORIGINAL case this branch exists
  # for -- stopped in the seconds between claiming the slot and spawning --
  # must still resolve to done, or the fix above just traded one wrong default
  # for another. Same fixture, minus the one fact ($slot/child) that changes
  # the verdict.
  local rd8="$tmp/wtroot/j2/stampS2"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j2 two "$tmp/g/repo" stampS2 ) >/dev/null 2>&1
  local scl2="$tmp/locks/j2/998"
  mkdir -p "$scl2"
  echo 998 > "$scl2/pid"; echo 1700000000 > "$scl2/start"
  echo "$rd8" > "$scl2/worktree"
  echo "$tmp/rclogs/rc2.json" > "$scl2/logfile"
  : > "$scl2/stopped"                # stopped, and $scl2/child never existed
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    DATA_DIR="$tmp"; RUNS_FILE="$tmp/rc2.ndjson"; STATE_FILE="$tmp/rc2state.json"
    LOG_DIR="$tmp/rclogs"; TICK_LOG="$tmp/rc.tick"
    run_cleanup j2 "$scl2" ) >/dev/null 2>&1
  [ ! -d "$rd8" ] && ok "no agent ever spawned still closes the run as done" \
    || bad "a genuinely pre-agent stop was left open, unable to ever close"
  rm -rf "$tmp/locks/j2" "$tmp/wtroot/j2/stampS" "$tmp/wtroot/j2/stampS2"

  echo "_stop_slot() — a live pid from an earlier boot is cleared, never signalled"
  # Same reboot-recycled-pid risk slot_alive exists for, but with teeth: the old
  # bare kill -0 here did not just miscount a slot, it aimed a real TERM at
  # whatever unrelated process the kernel had since handed that pid to.
  sleep 60 & local bgpid=$!
  mkdir -p "$tmp/locks/j9/$bgpid"
  echo "$bgpid" > "$tmp/locks/j9/$bgpid/pid"
  echo "0" > "$tmp/locks/j9/$bgpid/boot"
  _stop_slot j9 "$tmp/locks/j9/$bgpid" >/dev/null 2>&1
  # A TERM just sent is not necessarily a TERM already delivered: give the
  # kernel a moment before asking whether the process is still there, so a
  # signal in flight cannot read as "never sent".
  sleep 0.3
  kill -0 "$bgpid" 2>/dev/null
  want "a live pid from an earlier boot is left running, not TERM'd" 0 $?
  [ ! -d "$tmp/locks/j9/$bgpid" ] && ok "its stale slot is cleared instead" \
    || bad "the stale slot survived the stop"
  kill "$bgpid" 2>/dev/null; wait "$bgpid" 2>/dev/null
  rm -rf "$tmp/locks/j9"

  echo "_stop_slot() — signals the pid the FILE names, not the directory"
  # locks/j3/999 above (wt_prune_orphans, dir named 999 holding pid=$$) is not a
  # one-off fixture shape: a stale slot's directory name and its own pid file
  # can genuinely disagree. Signalling the name instead of the file is worse
  # than the leak that fixture guards against -- it is a live TERM aimed at
  # whichever unrelated process the kernel now happens to call by that number.
  # _stop_slot's TERM reaches realpid from inside this same shell -- no
  # subshell sits between here and there -- so when the process dies, bash
  # defers the news to the next command boundary instead of dropping it. Left
  # tracked, that surfaces as `Terminated: 15   sleep 60` printed straight into
  # a PASSING run's output, and that exact line is what this suite's own RED
  # transcripts use as proof the bug is alive -- so a green run left tracked
  # would read as a crashed one. Disowning drops only the job-table entry;
  # kill -0 and the explicit wait below still see the real process.
  sleep 60 & local realpid=$!; disown "$realpid"
  sleep 60 & local decoypid=$!; disown "$decoypid"
  mkdir -p "$tmp/locks/j9/$decoypid"
  echo "$realpid" > "$tmp/locks/j9/$decoypid/pid"
  boot_id > "$tmp/locks/j9/$decoypid/boot"
  _stop_slot j9 "$tmp/locks/j9/$decoypid" >/dev/null 2>&1
  sleep 0.3
  kill -0 "$realpid" 2>/dev/null
  want "the process the pid FILE names is the one TERM'd" 1 $?
  kill -0 "$decoypid" 2>/dev/null
  want "the process the directory merely happens to be named after is untouched" 0 $?
  kill "$realpid" "$decoypid" 2>/dev/null; wait "$realpid" "$decoypid" 2>/dev/null
  rm -rf "$tmp/locks/j9"

  echo "_stop_slot() — a slot claimed but not yet given a pid file is still signalled"
  # The window inside acquire_slot between mkdir and its own pid write: nothing
  # was read wrong here, there is simply nothing written yet to read. slot_alive
  # cannot call this alive without a pid file, and treating "cannot tell" as
  # "dead" would silently clear a run mid-claim -- the exact bug the comment
  # inside _stop_slot exists to keep fixed.
  # Same job-control noise as the section above, same fix: disown right away.
  sleep 60 & local midpid=$!; disown "$midpid"
  mkdir -p "$tmp/locks/j9/$midpid"        # mkdir happened; pid/boot files did not
  _stop_slot j9 "$tmp/locks/j9/$midpid" >/dev/null 2>&1
  sleep 0.3
  kill -0 "$midpid" 2>/dev/null
  want "a claim with no pid file yet is signalled, not silently ignored" 1 $?
  [ -d "$tmp/locks/j9/$midpid" ] && ok "its slot is left for the run's own EXIT path to clear" \
    || bad "the slot was cleared instead of signalled"
  kill "$midpid" 2>/dev/null; wait "$midpid" 2>/dev/null
  rm -rf "$tmp/locks/j9"

  echo "_stop_slot() — a pid file of literal 0 clears the slot, never signals the process group"
  # kill -TERM 0 does not name a process, it names the CALLER's own process
  # group -- so an unguarded rpid=0 would TERM this very selftest run, and
  # whatever invoked it, instead of the one dead slot it was meant to clear.
  # Proving that live would mean actually sending that signal from inside the
  # process running this suite: the one outcome this guard exists to rule
  # out, not something to reproduce for real just to watch it fail. Shadow
  # `kill` instead -- real calls (slot_alive's own kill -0 check, reached only
  # if the guard fails to refuse first) still pass through via `command
  # kill`, only the exact dangerous shape is trapped -- so the guard runs for
  # real, end to end, without ever risking the shell running it.
  local pid0_term=0
  kill() {
    if [ "$1" = "-TERM" ] && [ "$2" = "0" ]; then pid0_term=1; return 0; fi
    command kill "$@"
  }
  mkdir -p "$tmp/locks/j9/997"
  echo "0" > "$tmp/locks/j9/997/pid"
  # A plain `_stop_slot ... > file` runs in THIS shell, so the shadow above can
  # mutate pid0_term. `got="$(_stop_slot ...)"` would not: command
  # substitution forks a subshell, and a subshell's writes to an existing
  # variable die with it -- pid0_term would read 0 whether the guard held or
  # not, turning the very assertion this section exists for into one that
  # always passes. Capture to a file instead and read it back after.
  _stop_slot j9 "$tmp/locks/j9/997" > "$tmp/pid0.out" 2>&1
  unset -f kill
  got="$(cat "$tmp/pid0.out")"
  [ "$pid0_term" -eq 0 ] && ok "kill -TERM 0 is never attempted" \
    || bad "the guard let a pid of 0 reach a real kill"
  case "$got" in
    *"no usable pid"*) ok "and it is the refuse-early branch, not the kill branch, that ran" ;;
    *) bad "unexpected output: '$got'" ;;
  esac
  [ ! -d "$tmp/locks/j9/997" ] && ok "and its slot is cleared" || bad "the slot survived"
  rm -rf "$tmp/locks/j9"

  echo "_stop_slot() — a child file of literal 0 is refused, not signalled as the agent"
  # The rpid guard above closes one route to kill -TERM 0; this is the other
  # one, in the branch that runs BEFORE rpid is ever read. child comes from
  # its own file and had no digit check at all before this section existed --
  # kill -0 "0" succeeds the same way it does for rpid, so a child file that
  # ever read "0" would reach a real kill -TERM 0 first, never mind what rpid
  # would have said. Same shadow technique as above, for the same reason: not
  # something to prove by actually sending it.
  local child0_term=0
  kill() {
    if [ "$1" = "-TERM" ] && [ "$2" = "0" ]; then child0_term=1; return 0; fi
    command kill "$@"
  }
  sleep 60 & local claimpid=$!; disown "$claimpid"
  mkdir -p "$tmp/locks/j9/$claimpid"
  echo "0" > "$tmp/locks/j9/$claimpid/child"
  _stop_slot j9 "$tmp/locks/j9/$claimpid" > "$tmp/child0.out" 2>&1
  unset -f kill
  sleep 0.3
  [ "$child0_term" -eq 0 ] && ok "kill -TERM 0 is never attempted" \
    || bad "the guard let a child of 0 reach a real kill"
  kill -0 "$claimpid" 2>/dev/null
  want "and the run's own claim pid is TERM'd instead of the phantom agent" 1 $?
  kill "$claimpid" 2>/dev/null; wait "$claimpid" 2>/dev/null
  rm -rf "$tmp/locks/j9"

  echo "slots_active() — a stale-boot slot is not counted, and is pruned"
  # The other two leaks this task closes (a phantom counted against
  # max_parallel, a retained port block) were, before this task, exercised only
  # through the shared slot_alive() unit assertions above, never end to end
  # through the functions that actually leak. This is that end-to-end path for
  # max_parallel: a slot with a genuinely live pid but the wrong boot must
  # neither be counted nor be left behind for the next call to recount.
  mkdir -p "$tmp/locks/sa/$$" "$tmp/locks/sa/201"
  echo $$ > "$tmp/locks/sa/$$/pid"; boot_id > "$tmp/locks/sa/$$/boot"
  echo $$ > "$tmp/locks/sa/201/pid"; echo "0" > "$tmp/locks/sa/201/boot"
  got="$( LOCK_DIR="$tmp/locks"; slots_active sa )"
  [ "$got" = "1" ] && ok "a slot from an earlier boot is not counted against max_parallel" \
    || bad "slots_active counted $got, wanted 1"
  [ ! -d "$tmp/locks/sa/201" ] && ok "and its directory is pruned, not left behind" \
    || bad "the stale-boot slot's directory survived the count"
  [ -d "$tmp/locks/sa/$$" ] && ok "the genuinely live slot is left alone" \
    || bad "slots_active pruned a live slot"
  rm -rf "$tmp/locks/sa"

  echo "alloc_port_base() — two live runs never get the same ports"
  # Isolation settles the filesystem and says nothing about ports: two runs of
  # one repo each publish 5432 and the second dies on "address already in use",
  # which reads as a broken test suite and is nothing of the kind.
  mkdir -p "$tmp/locks/pj/101" "$tmp/locks/pj/102" "$tmp/locks/pk/103"
  echo $$ > "$tmp/locks/pj/101/pid"; echo $$ > "$tmp/locks/pj/102/pid"
  local b1 b2 b3 b4
  b1="$( LOCK_DIR="$tmp/locks"; alloc_port_base "$tmp/locks/pj/101" )"
  b2="$( LOCK_DIR="$tmp/locks"; alloc_port_base "$tmp/locks/pj/102" )"
  [ -n "$b1" ] && [ "$b1" != "$b2" ] && ok "two live runs get different blocks ($b1 vs $b2)" \
    || bad "both got '$b1'"
  [ "$(( b2 - b1 ))" = "$CC_PORT_SPAN" ] && ok "the blocks do not overlap" \
    || bad "blocks are $(( b2 - b1 )) apart, span is $CC_PORT_SPAN"
  # A slot whose process is gone holds nothing — otherwise the pool shrinks by
  # one for every run that ever ended and never came back.
  echo 999999 > "$tmp/locks/pk/103/pid"
  echo "$b1" > "$tmp/locks/pk/103/portbase"
  rm -rf "$tmp/locks/pj/101" "$tmp/locks/pj/102"
  mkdir -p "$tmp/locks/pj/104"
  b3="$( LOCK_DIR="$tmp/locks"; alloc_port_base "$tmp/locks/pj/104" )"
  [ "$b3" = "$b1" ] && ok "a dead slot's block is handed back out" || bad "got '$b3', wanted '$b1'"
  # Same again with a stale BOOT instead of a dead pid: pk/105 keeps b1
  # genuinely taken (a live, current-boot pid) so the only way alloc_port_base
  # can hand back b2 is by refusing pk/106's claim on it, and pk/106's pid is
  # $$ -- very much alive -- so the only thing making it refusable is the boot
  # it carries.
  mkdir -p "$tmp/locks/pk/105" "$tmp/locks/pk/106"
  echo $$ > "$tmp/locks/pk/105/pid"; echo "$b1" > "$tmp/locks/pk/105/portbase"
  echo $$ > "$tmp/locks/pk/106/pid"; echo "0" > "$tmp/locks/pk/106/boot"
  echo "$b2" > "$tmp/locks/pk/106/portbase"
  mkdir -p "$tmp/locks/pj/107"
  b4="$( LOCK_DIR="$tmp/locks"; alloc_port_base "$tmp/locks/pj/107" )"
  [ "$b4" = "$b2" ] && ok "a live pid from an earlier boot holds no block either" \
    || bad "got '$b4', wanted '$b2' ($b1 should still read taken, held by pk/105)"
  rm -rf "$tmp/locks/pj" "$tmp/locks/pk"

  echo "port_base_free() — a resume takes its block back only if nothing live holds it"
  # The gate that decides between reusing a resume's own block and refusing the
  # resume outright, so it earns the same scrutiny alloc_port_base's own tests
  # give allocation: get this backwards and a resume either steals ports out
  # from under a live run, or refuses one it should have been free to take.
  mkdir -p "$tmp/locks/pf1/201" "$tmp/locks/pf2/301"
  echo $$ > "$tmp/locks/pf1/201/pid"; echo "21000" > "$tmp/locks/pf1/201/portbase"
  ( LOCK_DIR="$tmp/locks"; port_base_free "$tmp/locks/pf2/301" 21000 )
  want "a block a live run holds is refused" 1 $?
  ( LOCK_DIR="$tmp/locks"; port_base_free "$tmp/locks/pf2/301" 21100 )
  want "an unheld block is free" 0 $?
  # The asking slot is excluded from its own search -- otherwise a slot that
  # already recorded this exact block (a resume re-checking the block it is
  # about to keep) would read it as held by somebody else and refuse itself.
  ( LOCK_DIR="$tmp/locks"; port_base_free "$tmp/locks/pf1/201" 21000 )
  want "a slot never finds its own block taken" 0 $?
  # Same as alloc_port_base: a slot whose process is gone holds nothing.
  mkdir -p "$tmp/locks/pf1/202"
  echo 999999 > "$tmp/locks/pf1/202/pid"; echo "21200" > "$tmp/locks/pf1/202/portbase"
  ( LOCK_DIR="$tmp/locks"; port_base_free "$tmp/locks/pf2/301" 21200 )
  want "a dead slot holds no block either" 0 $?
  rm -rf "$tmp/locks/pf1" "$tmp/locks/pf2"

  echo "provision-lib.sh — a run's ports come from its own block"
  local plib="$BIN_DIR/provision-lib.sh"
  got="$( CC_PORT_BASE=21000 CC_PORT_SPAN=100 TMPDIR="$tmp" bash -c \
    'source "$1"; echo "$(cc_port POSTGRES_PORT) $(cc_port REDIS_PORT) $(cc_port POSTGRES_PORT)"' _ "$plib" )"
  [ "$got" = "21000 21001 21000" ] && ok "each name gets its own port, and keeps it" \
    || bad "got '$got'"
  # The whole point: rewrite the ports a checked-in .env carries, and touch
  # nothing else in it.
  printf '%s\n' 'POSTGRES_PORT=5432' 'REDIS_PORT=6379' 'SECRET=keepme' > "$tmp/dotenv"
  ( CC_PORT_BASE=21200 CC_PORT_SPAN=100 TMPDIR="$tmp" bash -c \
    'source "$1"; cc_env_ports "$2"' _ "$plib" "$tmp/dotenv" ) >/dev/null 2>&1
  got="$(grep -c -E '^(POSTGRES|REDIS)_PORT=212[0-9][0-9]$' "$tmp/dotenv")"
  [ "$got" = "2" ] && ok "every *_PORT in the file moves into the block" || bad "$got of 2 rewritten"
  grep -q '^SECRET=keepme$' "$tmp/dotenv" && ok "and nothing else in the file is touched" \
    || bad "the rest of the file did not survive"
  # A key the file does not have must not be invented: publishing a service the
  # project never asked for is worse than leaving it alone.
  grep -q "QDRANT" "$tmp/dotenv" && bad "invented a key that was not there" \
    || ok "keys the file never had are not added"

  echo "run_end_hook() — an unattended pipeline can tell someone it broke"
  mkdir -p "$tmp/hookcfg/hooks"
  ( CONFIG_DIR="$tmp/hookcfg"; run_end_hook j1 error 1.5 "boom" P sess /tmp/l.json 1 2 ) >/dev/null 2>&1
  want "no hook installed is a no-op" 0 $?
  printf '%s\n' '#!/usr/bin/env bash' \
    'printf "%s|%s|%s|%s|%s\n" "$CC_JOB_ID" "$CC_STATUS" "$CC_COST" "$CC_NOTE" "$CC_PROJECT" > "$CC_HOOK_OUT"' \
    > "$tmp/hookcfg/hooks/on-run-end.sh"
  export CC_HOOK_OUT="$tmp/hook.seen"; rm -f "$CC_HOOK_OUT"
  ( CONFIG_DIR="$tmp/hookcfg"; run_end_hook j1 error 1.5 "boom" P sess /tmp/l.json 1 2 ) >/dev/null 2>&1
  local waited=0
  while [ ! -f "$CC_HOOK_OUT" ] && [ "$waited" -lt 50 ]; do sleep 0.1; waited=$((waited+1)); done
  got="$(cat "$CC_HOOK_OUT" 2>/dev/null)"
  [ "$got" = "j1|error|1.5|boom|P" ] && ok "the hook is told which run ended and how" \
    || bad "the hook saw '$got'"
  # It must never delay the run's cleanup, however slow or wedged it is.
  printf '%s\n' '#!/usr/bin/env bash' 'sleep 30' > "$tmp/hookcfg/hooks/on-run-end.sh"
  t0="$(now_epoch)"
  ( CONFIG_DIR="$tmp/hookcfg"; run_end_hook j1 error 0 "" P s /tmp/l.json 1 2 ) >/dev/null 2>&1
  elapsed=$(( $(now_epoch) - t0 ))
  [ "$elapsed" -lt 3 ] && ok "a slow hook does not hold the run open (${elapsed}s)" \
    || bad "run_end_hook blocked for ${elapsed}s"
  unset CC_HOOK_OUT
  rm -f "$tmp/hookcfg/hooks/on-run-end.sh"

  echo "the round cap itself — counting, parking, failing open"
  # The cap is the only hard stop on the dev/review loop, so its own behaviour is
  # tested against a fake Jira rather than asserted by reading the source.
  if [ -x "$BASE_DIR/test/round-cap.test.sh" ]; then
    local rcout
    if rcout="$("$BASE_DIR/test/round-cap.test.sh" 2>&1)"; then
      ok "round-cap suite ($(printf '%s' "$rcout" | grep -c '  PASS') cases)"
    else
      bad "round-cap suite failed:"
      printf '%s\n' "$rcout" | grep '  FAIL' | sed 's/^/      /'
    fi
  else
    ok "round-cap suite not installed — skipped"
  fi

  echo "the dev/review loop has an exit condition"
  # The loop between the dev and review agents once ran without a terminating
  # condition: both prompts said "repeat until nothing blocks", and the reviewer's
  # bar ("any behavioural finding of any severity") is not a state a real pull
  # request reaches. Rounds only ended when the budget did. Three properties keep
  # that closed, and each has been silently undone before by an edit elsewhere —
  # so they are asserted here rather than trusted to prose.
  local jf="${CC_JOBS_FILE:-$CONFIG_DIR/jobs.json}"
  if [ ! -f "$jf" ]; then
    ok "no jobs.json — loop invariants not applicable"
  else
    # All three invariants below find their subjects by an id convention
    # (`<project>-dev-agent`, `<project>-reviewer-agent`). An install that names
    # its jobs otherwise matches nothing — and "nothing matched" was reported as
    # total non-compliance ("missing from 0 of 0"), so the suite was red on every
    # install not using the suffix, for a rule none of its jobs were breaking.
    # An invariant over an empty set holds. Say so, and say the convention out
    # loud in the same breath: a check that silently examined nothing is the
    # failure mode this whole block exists to prevent.
    #
    # 1. The cap is enforced in shell, before a session exists, on BOTH boards.
    local capped=0 devjobs=0
    for pc in "$CONFIG_DIR"/prechecks/*-dev-agent.sh; do
      [ -f "$pc" ] || continue
      devjobs=$(( devjobs + 1 ))
      grep -q 'rc_gate_rework' "$pc" && capped=$(( capped + 1 ))
    done
    if [ "$devjobs" -eq 0 ]; then
      ok "round cap: no prechecks/*-dev-agent.sh here — nothing to check"
    elif [ "$capped" -eq "$devjobs" ]; then
      ok "every dev precheck enforces the round cap ($capped/$devjobs)"
    else
      bad "round cap missing from $(( devjobs - capped )) of $devjobs dev prechecks"
    fi

    # 2. No prompt still promises an unbounded loop, or a bar that cannot be met.
    local residual
    residual="$("$JQ" -r '.jobs[] | .id as $i | .prompt // "" | split("\n")[]
                          | select(test("any finding of any severity|repeating until nothing blocks|repeating until the review is genuinely clean|found nothing at all"))
                          | $i' "$jf" 2>/dev/null | sort -u | tr '\n' ' ')"
    [ -z "$residual" ] \
      && ok "no prompt promises an unbounded loop" \
      || bad "unbounded-loop wording is back in: $residual"

    # 3. The reviewer can actually approve over a non-blocking finding, and the
    #    dev is told to prove a widening did not go too far. Losing either one
    #    restarts the pendulum that produced the expensive rounds.
    local rev_ok=0 rev_n=0 dev_ok=0 dev_n=0
    while IFS=$'\t' read -r id prompt; do
      case "$id" in
        *-reviewer-agent)
          rev_n=$(( rev_n + 1 ))
          printf '%s' "$prompt" | grep -q 'Follow-up findings (not blocking)' \
            && rev_ok=$(( rev_ok + 1 )) ;;
        *-dev-agent)
          dev_n=$(( dev_n + 1 ))
          printf '%s' "$prompt" | grep -q 'containment test' \
            && dev_ok=$(( dev_ok + 1 )) ;;
      esac
    done < <("$JQ" -r '.jobs[] | [.id, (.prompt // "")] | @tsv' "$jf" 2>/dev/null)
    if [ "$rev_n" -eq 0 ]; then
      ok "non-blocking route: no *-reviewer-agent job here — nothing to check"
    elif [ "$rev_ok" -eq "$rev_n" ]; then
      ok "every reviewer may record a finding without spending a round ($rev_ok/$rev_n)"
    else
      bad "the non-blocking route is missing from $(( rev_n - rev_ok )) of $rev_n reviewers"
    fi
    if [ "$dev_n" -eq 0 ]; then
      ok "containment rule: no *-dev-agent job here — nothing to check"
    elif [ "$dev_ok" -eq "$dev_n" ]; then
      ok "every dev prompt requires a containment test when a rule widens ($dev_ok/$dev_n)"
    else
      bad "the containment rule is missing from $(( dev_n - dev_ok )) of $dev_n dev prompts"
    fi
  fi

  rm -rf "$tmp"
  echo
  echo "$pass passed, $fail failed"
  [ "$fail" -eq 0 ]
}

cmd_running() { # prints "running (N)" + exit 0 if any slot is live, else "idle"
  local n; n="$(slots_active "$1")"
  if [ "$n" -ge 1 ]; then echo "running ($n)"; return 0; fi
  echo "idle"; return 1
}

cmd_runs() { # <id> — one active run per line: <run-pid>\t<agent-pid>\t<logfile>
  local base="$LOCK_DIR/$1" d pid child logf
  [ -d "$base" ] || return 0
  for d in "$base"/*/; do
    [ -d "$d" ] || continue
    slot_alive "${d%/}" || { rm -rf "$d"; continue; }
    pid="$(cat "$d/pid" 2>/dev/null || true)"
    child="$(cat "$d/child" 2>/dev/null || true)"
    logf="$(cat "$d/logfile" 2>/dev/null || true)"
    printf '%s\t%s\t%s\n' "$pid" "$child" "$logf"
  done
}

# Stop ONE run by its slot. Leaves the watchdog breadcrumb so the run explains
# itself, then TERMs the agent (or clears a dead slot).
_stop_slot() { # <id> <slot-dir>
  local id="$1" slot="$2" child logf rpid midclaim
  [ -d "$slot" ] || { echo "no such run for $id"; return 1; }
  logf="$(cat "$slot/logfile" 2>/dev/null || true)"
  # The marker the classifier reads. A run the OPERATOR ended is not a failure,
  # and the difference has to survive into the record: `stopped` is a decision,
  # `error` is a fault, and filing one as the other is how a deliberate stop ends
  # up in the error count and drives the failure backoff.
  : > "$slot/stopped" 2>/dev/null || true
  [ -n "$logf" ] && printf 'STOPPED: ended on purpose from the dashboard, not by a failure.\n' \
    > "$logf.watchdog" 2>/dev/null
  child="$(cat "$slot/child" 2>/dev/null || true)"
  # Same danger as the rpid guard below, reached through a different file:
  # kill -0 "0" succeeds (it asks whether the CALLER's own process group
  # exists, which it always does), so a child file that ever read "0" would
  # clear the `-n` check, pass the liveness check, and reach a real
  # kill -TERM 0 -- every process in the group that ran this stop, not the
  # one agent it named.
  if [ -n "$child" ] && [ "$child" != "0" ] && kill -0 "$child" 2>/dev/null; then
    kill -TERM "$child" 2>/dev/null
    echo "stopping $id run $(basename "$slot") (agent pid $child)"
    return 0
  fi
  # No agent yet — stopped in the seconds between claiming the slot and spawning.
  # This used to just delete the slot, so the run vanished from the table with
  # nothing written anywhere: no row, no log, no record that it had ever been
  # asked for. Signal the run wrapper instead and let its EXIT path file the
  # record, exactly as it does for every other ending.
  #
  # rpid has to be the SAME pid slot_alive is about to check below, not a second
  # guess at it -- a slot's directory name and its pid file are two different
  # sources and can disagree (this suite builds exactly that shape elsewhere: a
  # dir named for one pid holding a file that names another). Signalling the
  # name instead of the file aims the TERM at whatever unrelated process the
  # kernel now happens to call by that number. The pid file is missing only in
  # the instant inside acquire_slot between its mkdir and its own pid write --
  # fall back to the directory name only then.
  rpid="$(cat "$slot/pid" 2>/dev/null || true)"
  midclaim=0
  if [ -z "$rpid" ]; then
    rpid="$(basename "$slot")"
    midclaim=1
  fi
  # `0` has to be refused here too, not just empty and non-digit shapes:
  # kill -TERM 0 does not target a process, it targets the CALLER's whole
  # process group -- the operator's own shell session along with it. A slot
  # directory can never be named "0" (it is always stamped from a real $$),
  # but rpid can now come from the pid FILE above, and a pid file that ever
  # held a bare "0" would otherwise sail through unrefused.
  case "$rpid" in
    ''|0|*[!0-9]*) echo "run of $id has no usable pid; clearing its slot"; release_slot "$slot"; return 0 ;;
  esac
  # slot_alive, not a bare kill -0: rpid is only ever the pid this slot was
  # taken by, and the same reboot-recycling that makes a dead slot answer
  # kill -0 would otherwise point this TERM at whatever unrelated process the
  # kernel handed that number to next. But slot_alive has no pid file to read in
  # the mkdir-then-write instant above, so it always calls that slot dead --
  # which would silently clear a run still being claimed instead of signalling
  # it, the exact bug the comment above says this function no longer has. A
  # bare kill -0 on the name is safe there and ONLY there: everywhere else the
  # name already had to survive a pid file to be trusted.
  if slot_alive "$slot" || { [ "$midclaim" -eq 1 ] && kill -0 "$rpid" 2>/dev/null; }; then
    kill -TERM "$rpid" 2>/dev/null
    echo "stopping $id run $rpid (before its agent started)"
  else
    echo "run $rpid of $id is already gone; clearing its slot"
    release_slot "$slot"
  fi
}

cmd_stop() { # <id> [run-pid] — stop ONE run (by its run-pid) or, with no pid, ALL
  local id="$1" rpid="${2:-}" any=0 d
  if [ -n "$rpid" ]; then
    _stop_slot "$id" "$LOCK_DIR/$id/$rpid"
  else
    for d in "$LOCK_DIR/$id"/*/; do [ -d "$d" ] || continue; _stop_slot "$id" "$d"; any=1; done
    [ "$any" -eq 1 ] || echo "no runs in progress for $id"
  fi
}

cmd_precheck() { # <id> — run the job's precheck once and RECORD it, without the agent
  local id="$1" precheck cwd pc_out pc_rc
  precheck="$(jobs_json | "$JQ" -r --arg id "$id" '.jobs[] | select(.id==$id) | .precheck // ""')"
  [ -n "$precheck" ] || { echo "no precheck configured for $id"; return 0; }
  cwd="$(resolve "$id" cwd "$HOME")"
  # A probe reports; it must not claim. See CC_PRECHECK_DRY_RUN in the
  # prechecks: a claim is a write, and spending it here leaves a ticket
  # claimed with no session behind it.
  pc_out="$( cd "$cwd" && export CC_PRECHECK_DRY_RUN=1 && eval "$precheck" 2>&1 )"; pc_rc=$?
  state_set "$id" last_precheck "$("$JQ" -nc --arg o "${pc_out:-(no output)}" --argjson rc "$pc_rc" '{output:$o, exit:$rc}')"
  printf '%s\n(exit %s)\n' "$pc_out" "$pc_rc"
}

cmd_resolve_models() { # refresh the family→id cache (all four families)
  local fam id
  for fam in opus sonnet haiku fable; do
    id="$(resolve_family "$fam")"
    [ -n "$id" ] || id="$fam"
    models_cache_set "$fam" "$id"
    echo "$fam -> $id"
  done
}

# What a run that delivered nothing tells the operator. Split out of the
# classifier so the selftest can assert its shape rather than a whole run's:
# a marker the dashboard can match on, the finding, and the one action that
# continues the work.
undelivered_note() { # undelivered_note <description>
  printf 'UNDELIVERED: %s. The run made changes that exist on no remote, so nothing was handed over — push the branch, or resume this run to finish it, before treating the ticket as done.' "$1"
}

run_job() { # run_job <id> [--force] [resume-session-id]
  # A RESUME picks the failed run's own session back up (`claude --resume <sid>`)
  # instead of starting the job afresh: same task, same conversation, continuing
  # where it stopped. It is always forced (the precheck describes the board now,
  # not the work this session was already doing) and it produces a normal run —
  # its own log, stream, timeline and journal record, nothing lost.
  local id="$1" force="${2:-}" resume_sid="${3:-}"
  [ -n "$resume_sid" ] && force="--force"
  local cwd prompt model effort budget timeout stall permission allowed precheck project proj_desc interactive fifo
  local run_cwd worktree run_dir run_env run_cfgdir _envln slot max_par
  # Loop variables for replaying a reattached run's manifest through `up` again
  # (see the isolation branch below). Declared here, not just inside the loop,
  # because `read` happily creates GLOBALS for anything not already local, and
  # a global `rname` etc. would then bleed into whatever run_job looks at next
  # -- this function runs once per job per tick, in the same shell, in a loop.
  local rname rrepo rwt rbase
  project="$(job_get "$id" '.project' '')"
  # Which account this run signs in as. A project pins one when its work belongs
  # to a different Claude login than the scheduler's default — a company account
  # for client work, a personal one for your own repos. It carries far more than
  # billing: the config dir holds that account's settings, plugins, MCP servers
  # AND its past sessions, so it must stay stable for a job or `--resume` below
  # would go looking for the session in the other account's directory.
  run_cfgdir="$(project_get "$project" '.claude_config_dir' '')"
  case "$run_cfgdir" in null) run_cfgdir="" ;; esac
  run_cfgdir="$(expand_home "$run_cfgdir")"
  # cwd, model, permission, budget and timeout inherit from the project when the
  # job doesn't set them (see resolve()).
  cwd="$(resolve "$id" cwd "$HOME")"
  prompt="$(jobs_json | "$JQ" -r --arg id "$id" '.jobs[] | select(.id==$id) | .prompt')"
  model="$(resolve "$id" model 'opus')"
  # A family (opus/sonnet/…) becomes the newest concrete id of that family.
  local model_family=""
  case "$model" in opus|sonnet|haiku|fable) model_family="$model" ;; esac
  model="$(effective_model "$model")"
  # How hard the model thinks: low|medium|high|xhigh|max (empty = the CLI default)
  effort="$(resolve "$id" effort '')"
  case "$effort" in null) effort="" ;; esac
  # Interactive runs keep stdin open so a human can talk to the agent while it
  # works (see the launch block). Opt-in per job: a normal run must keep ending
  # by itself, and holding stdin open changes exactly that.
  interactive="$(resolve "$id" interactive 'false')"
  case "$interactive" in true) ;; *) interactive="false" ;; esac
  # An absent per-run budget means "no cap", the same way an absent daily cap,
  # time limit and stall guard already do -- clearing the field in the editor
  # deletes the key. `resolve` cannot express it (it collapses a missing value
  # onto its default, so a cleared field would silently read as $2), so read the
  # job directly and let empty stay empty. A project may still set a floor.
  budget="$(job_get "$id" '.max_budget_usd' '')"
  if [ -z "$budget" ] || [ "$budget" = "null" ]; then
    budget="$(project_get "$(job_get "$id" '.project' '')" '.max_budget_usd' '')"
    case "$budget" in null) budget="" ;; esac
  fi
  # A long run is NOT a hung run. `stall_timeout_seconds` is the real guard: kill
  # only after the agent has produced NO output for that long. `timeout_seconds`
  # is now an OPTIONAL absolute cap — empty or 0 means "no wall-clock limit", so
  # a legitimately long task (hours) is never killed just for taking its time.
  timeout="$(resolve "$id" timeout_seconds '')"
  stall="$(resolve "$id" stall_timeout_seconds '1200')"
  case "$timeout" in ''|null) timeout=0 ;; esac
  case "$stall" in ''|null) stall=0 ;; esac
  permission="$(resolve "$id" permission_mode 'dontAsk')"
  allowed="$(job_get "$id" '.allowed_tools' '')"
  precheck="$(jobs_json | "$JQ" -r --arg id "$id" '.jobs[] | select(.id==$id) | .precheck // ""')"

  [ -n "$prompt" ] && [ "$prompt" != "null" ] || { log_tick "$id: no prompt, skipped"; return 1; }
  [ -d "$cwd" ] || { log_tick "$id: cwd missing ($cwd), skipped"; return 1; }
  # Refuse rather than let the CLI create the directory and find no credentials
  # in it: that spends a launch to fail at the login prompt, and every later run
  # would fail the same way with nothing saying why.
  [ -z "$run_cfgdir" ] || [ -d "$run_cfgdir" ] || {
    log_tick "$id: claude_config_dir missing ($run_cfgdir), skipped"; return 1; }

  # Prepend the project's description as context, so a run carries the project's
  # purpose without repeating it in every job prompt.
  if [ -n "$project" ] && [ "$project" != "null" ]; then
    proj_desc="$(project_get "$project" '.description' '')"
    if [ -n "$proj_desc" ] && [ "$proj_desc" != "null" ]; then
      prompt="Project: ${project}
${proj_desc}

---

${prompt}"
    fi
  fi

  # Append the run-ending contract, unless this prompt already states it. The
  # classifier downgrades an undeclared ending to a warning, so the rule has to
  # reach EVERY job -- including one written by someone who never saw this
  # scheduler's release notes -- and a job's own jobs.json is the one place that
  # cannot carry it, being personal and unversioned.
  case "$prompt" in
    *"$RUN_ENDING_MARKER"*) ;;
    *) prompt="${prompt}

$(run_ending_contract)" ;;
  esac

  # How many runs of THIS job may work at once — a job-level setting only, never
  # inherited. Blank or missing means 3; zero means no ceiling at all.
  max_par="$(job_get "$id" '.max_parallel' '3')"
  case "$max_par" in ''|null|*[!0-9]*) max_par=3 ;; esac
  if ! slot="$(acquire_slot "$id" "$max_par")"; then
    log_tick "$id: already at max_parallel=$max_par run(s), not launching another"
    return 0
  fi
  trap 'run_cleanup "'"$id"'" "'"$slot"'"' EXIT

  local forced="false"
  [ "$force" = "--force" ] && forced="true"

  # Daily budget gate: a per-job ceiling on today's spend. Empty = no cap.
  # Scheduled runs only — Run now is a deliberate override, like the precheck.
  if [ "$forced" != "true" ]; then
    local cap spent gcap gspent
    cap="$(daily_cap_for "$id")"
    if [ -n "$cap" ]; then
      spent="$(spent_today "$id")"
      if awk -v s="$spent" -v c="$cap" 'BEGIN{exit !((s+0)>=(c+0))}'; then
        state_set "$id" last_status '"capped"'
        state_set "$id" last_capped "$("$JQ" -nc --arg s "$spent" --arg c "$cap" '{spent:($s|tonumber),cap:($c|tonumber)}')"
        log_tick "$id: daily cap reached (\$$spent / \$$cap) — skipping"
        release_slot "$slot"; trap - EXIT
        return 0
      fi
    fi
    # The fleet-wide ceiling. Every job can sit correctly under its own cap and
    # the day still cost far more than intended — with a job per repo per role,
    # the sum is the number that actually matters.
    gcap="$(global_daily_cap)"
    if [ -n "$gcap" ]; then
      gspent="$(spent_today_all)"
      if awk -v s="$gspent" -v c="$gcap" 'BEGIN{exit !((s+0)>=(c+0))}'; then
        state_set "$id" last_status '"capped"'
        state_set "$id" last_capped "$("$JQ" -nc --arg s "$gspent" --arg c "$gcap" '{spent:($s|tonumber),cap:($c|tonumber),scope:"global"}')"
        log_tick "$id: GLOBAL daily cap reached (\$$gspent / \$$gcap across all jobs) — skipping"
        release_slot "$slot"; trap - EXIT
        return 0
      fi
    fi
  fi

  # Cheap gate: run the precheck, capture what it saw, and only spend a Claude
  # session when it passes (exit 0) — unless this run was forced (Run now).
  local pc_out="" pc_rc=0
  if [ -n "$precheck" ]; then
    # The precheck sees the same account as the run it gates: a probe that asks
    # Claude itself must not answer for one account the session then spends on
    # another, and MCP credentials live per config dir too.
    # A RESUME must never let the precheck claim. The session already has its
    # work, and the continuation prompt below REPLACES this output entirely --
    # so a precheck that takes a ticket would move one out of the queue for a
    # run that is never going to look at it. Same contract as the standalone
    # probes: report, touch nothing.
    pc_out="$( cd "$cwd" && { [ -n "$run_cfgdir" ] && export CLAUDE_CONFIG_DIR="$run_cfgdir"
                              [ -n "$resume_sid" ] && export CC_PRECHECK_DRY_RUN=1
                              eval "$precheck" 2>&1; } )"; pc_rc=$?
    state_set "$id" last_precheck "$("$JQ" -nc --arg o "${pc_out:-(no output)}" --argjson rc "$pc_rc" '{output:$o, exit:$rc}')"
    local pc_verdict; pc_verdict="$(precheck_verdict "$pc_rc")"
    if [ "$forced" != "true" ] && [ "$pc_verdict" != "work" ]; then
      state_set "$id" last_start "$(now_epoch)"
      if [ "$pc_verdict" = "error" ]; then
        # NOT idle: the probe itself failed, so nothing is known about the
        # board. Surfaced as its own status so the card can go red instead of
        # claiming, reassuringly and wrongly, that there was nothing to do.
        state_set "$id" last_status '"precheck_error"'
        # A broken probe repeats every interval just as a failing run does, and
        # costs a shell each time, so it feeds the same backoff.
        state_set "$id" fail_streak "$(( $(num "$(state_get "$id" fail_streak 0)") + 1 ))"
        log_tick "$id: PRECHECK FAILED (exit $pc_rc) — the probe could not run, so no work was looked for"
      else
        state_set "$id" last_status '"idle"'
        log_tick "$id: precheck found nothing to do (exit $pc_rc)"
      fi
      release_slot "$slot"; trap - EXIT
      return 0
    fi
    # Hand the precheck's own words to the agent. The precheck runs per-run, in
    # shell, before the session exists — so it is the only place that can hold a
    # LOCK. A precheck that atomically claims a ticket has to be able to say WHICH
    # one it claimed, and until now its output went only to a sidecar file the
    # agent never reads: two runs then each picked from the same board query and
    # reviewed the same pull request. Passing it here makes the claim reach the
    # only party that can honour it.
    if [ -n "$pc_out" ]; then
      prompt="Your precheck ran before this session started and reported:

${pc_out}

Treat that as fact about right now — it is the harness speaking, not a suggestion.
Where it names the specific work claimed for this run, that is your work: take it
and nothing else.

---

${prompt}"
    fi
  fi

  local start end stamp logfile streamfile precheckfile rc out cost turns session status port_base
  start="$(now_epoch)"
  # PID suffix keeps two same-second runs from clobbering each other's logs.
  stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mkdir -p "$LOG_DIR/$id"
  logfile="$LOG_DIR/$id/$stamp.json"
  streamfile="$LOG_DIR/$id/$stamp.stream.ndjson"
  precheckfile="$LOG_DIR/$id/$stamp.precheck.txt"

  # Isolate this run in its own git worktree, so a peer run (a review while a dev
  # works, say) can never clobber this one's branch in the shared checkout. The
  # agent's cwd becomes the worktree; its env carries the project's declared
  # venv/vars. Generic and gated by projects.json — a non-isolated project just
  # runs in $cwd as before. If isolation is on but setup fails, ABORT rather than
  # silently run in the shared tree (falling back would reintroduce the race).
  run_cwd="$cwd"
  worktree=""
  # The env the agent starts with. It exists whether or not this project is
  # isolated — the account is a property of the project, not of the worktree —
  # and the worktree's own venv/vars are appended to it below when there is one.
  run_env=()
  [ -n "$run_cfgdir" ] && run_env+=("CLAUDE_CONFIG_DIR=$run_cfgdir")
  if wt_isolation_enabled "$project" "$cwd"; then
    local reattached=""
    [ -n "$resume_sid" ] && reattached="$(wt_find_by_session "$id" "$resume_sid")"
    if [ -n "$reattached" ]; then
      # THE RESUME CONTINUES IN THE TREE THE SESSION WAS WORKING IN. Cutting a
      # fresh worktree here — which is what used to happen, with no special case
      # for a resume at all — handed the agent a conversation that remembered
      # editing files and a checkout of the base that had none of them.
      #
      # Everything below is read from the manifest, never re-derived from
      # projects.json. That is deliberate and it is the freeze: the repo set is
      # fixed for the session's life, so editing a project's `repos` while a
      # session is open cannot change what that session is working on. Changing
      # the mount set means a new session, exactly as it does upstream.
      run_dir="$reattached"
      # CLAIM IT UNDER A LOCK, BEFORE ANYTHING ELSE. Two `claude-cron resume`
      # calls for the same session — a double click, a retried automation —
      # otherwise both reach here and both launch an agent into the same tree,
      # which is the exact race the whole worktree design exists to prevent.
      # `max_parallel` does not stop it: it defaults to 3, so both get a slot.
      #
      # Two details are load-bearing. `wt_is_claimed` does NOT exclude the
      # calling slot, so this has to run BEFORE our own breadcrumb is written —
      # after it, every resume would refuse itself. And check-then-act without
      # the mutex only narrows the window instead of closing it, so the check
      # and the claim happen together.
      #
      # Refusing here also leaves the cleanest wreckage: `$slot/worktree` is
      # still unwritten, so run_cleanup reads an empty run dir, skips teardown
      # entirely, and never touches the directory the other run is using.
      local rlock="$LOCK_DIR/.resume"
      lock_take "$rlock"
      if wt_is_claimed "$id" "$run_dir"; then
        lock_drop "$rlock"
        log_tick "$id: cannot resume $resume_sid — another run is already working in $run_dir"
        state_set "$id" last_start "$start"
        state_set "$id" last_status '"error"'
        run_cleanup "$id" "$slot"; trap - EXIT
        return 1
      fi
      echo "$run_dir" > "$slot/worktree"
      lock_drop "$rlock"
      port_base="$("$JQ" -r '.port_base // ""' "$run_dir/.run.json" 2>/dev/null)"
      case "$port_base" in null) port_base="" ;; esac
      if [ -z "$port_base" ]; then
        port_base="$(alloc_port_base "$slot")"
        # Record it. The manifest is what teardown reads — wt_provision says so
        # explicitly, because the orphan sweep runs `down` with no ambient
        # CC_PORT_BASE. A block bound here and left out of the manifest means
        # the eventual `down` releases ports this run never took.
        if "$JQ" --arg pb "$port_base" '.port_base = $pb' "$run_dir/.run.json" \
             > "$run_dir/.run.json.new" 2>/dev/null; then
          mv -f "$run_dir/.run.json.new" "$run_dir/.run.json"
        else
          rm -f "$run_dir/.run.json.new"
        fi
      elif ! port_base_free "$slot" "$port_base"; then
        # Its services are still bound to that block and somebody else holds it.
        # Refusing is the honest answer: a fresh block would silently point the
        # resumed agent's config at ports nothing is listening on.
        log_tick "$id: cannot resume $resume_sid — its port block $port_base is held by a live run"
        state_set "$id" last_start "$start"
        state_set "$id" last_status '"error"'
        run_cleanup "$id" "$slot"; trap - EXIT
        return 1
      else
        { echo "$port_base" > "$slot/portbase"; } 2>/dev/null || true
      fi
      export CC_PORT_BASE="$port_base" CC_PORT_SPAN CC_PROVISION_LIB="$BIN_DIR/provision-lib.sh"
      local primary_name
      primary_name="$("$JQ" -r '.primary // ""' "$run_dir/.run.json" 2>/dev/null)"
      case "$primary_name" in null) primary_name="" ;; esac
      worktree="$run_dir/$primary_name"
      # AN EMPTY primary IS THE DANGEROUS CASE, not a missing directory. Empty
      # makes this "$run_dir/" — and the run dir exists, so a bare `-d` test
      # passes and the agent is launched with its cwd set to the folder holding
      # the worktrees instead of to a checkout. The port block four lines up is
      # read defensively for exactly this reason; so is this.
      if [ -z "$primary_name" ] || [ ! -d "$worktree" ]; then
        log_tick "$id: cannot resume $resume_sid — its primary worktree is gone or unnamed"
        state_set "$id" last_start "$start"
        state_set "$id" last_status '"error"'
        run_cleanup "$id" "$slot"; trap - EXIT
        return 1
      fi
      # `up` runs again, with the SAME port block. The hooks are written to be
      # re-runnable (cc_copy_ignored, cc_env_ports, `herd link`, `compose up -d`
      # all are), and this is what puts a stack back that a reboot took down
      # while the session sat open.
      while IFS="$(printf '\t')" read -r rname rrepo rwt rbase; do
        [ -n "$rname" ] || continue
        # `|| true` here, unlike the fresh path which aborts. A reattach finds a
        # stack that is usually already up, so the common failure is a hook
        # declining work it has done rather than a tree left half-built — and
        # refusing the resume would strand a session that is otherwise fine.
        # It is not silent: wt_provision logs the rc and the repo to the tick
        # log itself.
        wt_provision up "$project" "$id" "$run_dir" "$rname" "$rrepo" "$rwt" "$rbase" || true
      done < <("$JQ" -r '.repos[] | [.name,.canonical,.worktree,.base] | @tsv' \
                  "$run_dir/.run.json" 2>/dev/null)
      log_tick "$id: resumed $resume_sid in its own tree $run_dir (cwd $worktree)"
    else
      # Claim the path BEFORE anything exists there. The sweep removes any run dir
      # no live slot claims, so creating first and claiming after leaves a window
      # in which it can delete the very directory this agent is about to work in.
      # The path is ours to predict, so stake it first.
      run_dir="$WORKTREES_DIR/$id/$stamp"
      echo "$run_dir" > "$slot/worktree"
      # Before wt_setup, because the provisioning hooks it calls are what need the
      # block: they are what write the run's ports into its config.
      port_base="$(alloc_port_base "$slot")"
      export CC_PORT_BASE="$port_base" CC_PORT_SPAN CC_PROVISION_LIB="$BIN_DIR/provision-lib.sh"
      if ! worktree="$(wt_setup "$id" "$project" "$cwd" "$stamp" "$port_base")"; then
        state_set "$id" last_start "$start"
        state_set "$id" last_status '"error"'
        log_tick "$id: worktree isolation failed — run aborted (no shared-checkout fallback)"
        run_cleanup "$id" "$slot"; trap - EXIT
        return 1
      fi
      log_tick "$id: isolated in $run_dir (cwd $worktree)"
    fi
    run_cwd="$worktree"
    # What the agent needs to find the OTHER repos of this run, and the canonical
    # checkout of each: the manifest. Everything else it could only guess at.
    run_env+=("CC_RUN_DIR=$run_dir" "CC_RUN_MANIFEST=$run_dir/.run.json" \
              "CC_PROJECT=$project" "CC_JOB_ID=$id" \
              "CC_PRIMARY_REPO=$(basename "$run_cwd")" \
              "CC_PORT_BASE=$port_base" "CC_PORT_SPAN=$CC_PORT_SPAN" \
              "CC_PROVISION_LIB=$BIN_DIR/provision-lib.sh")
    while IFS= read -r _envln; do
      [ -n "$_envln" ] && run_env+=("$_envln")
    done < <(wt_env_line "$project" "$cwd" "$run_cwd")
  fi

  # Persist what the precheck saw, next to the run log.
  {
    if [ "$forced" = "true" ]; then echo "RUN FORCED (Run now) — precheck not gating this run."; fi
    if [ -n "$precheck" ]; then
      printf 'precheck: %s\nexit: %s%s\n\n--- output ---\n%s\n' \
        "$precheck" "$pc_rc" "$([ "$pc_rc" -eq 0 ] && echo '  (pass → work found)' || echo '  (fail → would be idle)')" "$pc_out"
    else
      echo "(no precheck configured — every due tick runs the agent)"
    fi
  } > "$precheckfile"

  state_set "$id" last_start "$start"
  state_set "$id" last_status '"running"'
  # Publish the log path up front so the dashboard can tail a run while it is
  # still going (the journal record only lands when the run finishes).
  state_set "$id" last_log "$("$JQ" -nc --arg p "$logfile" '$p')"
  echo "$logfile" > "$slot/logfile" 2>/dev/null || true   # per-run breadcrumb for stop
  # This run's own start. The shared state holds only one per job, so when
  # several run at once it is the slot that says when each began — without it
  # the dashboard can only ever show the most recent one.
  echo "$start" > "$slot/start" 2>/dev/null || true
  # A resume is in flight for that session: recorded here so nothing offers to
  # resume it a second time while this one is still working.
  [ -n "$resume_sid" ] && echo "$resume_sid" > "$slot/resume_of" 2>/dev/null || true
  log_tick "$id: starting run ($stamp)"

  # stream-json gives one NDJSON event per message — the per-turn trace the
  # dashboard renders. The final "result" event carries the same summary object
  # the plain json format used to emit; it is extracted into $logfile below so
  # every existing reader keeps working.
  local args
  args="-p --output-format stream-json --verbose --model $model --permission-mode $permission"
  # No flag at all when the budget is cleared: the CLI has no value meaning
  # "unlimited", so the absence of the flag is what expresses it.
  [ -n "$budget" ] && args="$args --max-budget-usd $budget"
  # Resume: continue the failed run's own session rather than starting over.
  [ -n "$resume_sid" ] && args="$args --resume $resume_sid"
  [ -n "$effort" ] && args="$args --effort $effort"
  [ -n "$allowed" ] && [ "$allowed" != "null" ] && args="$args --allowedTools $allowed"

  # On a resume the session already carries the job's instructions and everything
  # it did; re-sending the whole prompt would restart the task instead of
  # continuing it. Send a short continuation instruction instead — and tell it to
  # say so plainly when the work is already done or no longer possible (the card
  # moved, the ticket is gone), so the run ends cleanly rather than inventing work.
  if [ -n "$resume_sid" ]; then
    prompt="Continue exactly where you stopped. This is the same task, resumed after the previous run ended early — re-read your own last messages and carry on from there; do NOT start over.
If the work turns out to be already finished, or it can no longer be done at all (the ticket is gone, the card moved on, another run took it), then do NOT invent new work: stop and answer with one line starting exactly with 'NOTHING TO DO: ' followed by the reason."
  fi

  fifo=""
  if [ "$interactive" = "true" ]; then
    # `--input-format stream-json` accepts further user messages on stdin while
    # the run is going, which is what makes the dashboard's terminal two-way.
    # The prompt is sent as the first message instead of as an argument.
    fifo="$logfile.stdin"
    rm -f "$fifo"; mkfifo "$fifo" 2>/dev/null
    args="$args --input-format stream-json --replay-user-messages"
    (
      cd "$run_cwd" || exit 1
      env ${run_env[@]+"${run_env[@]}"} "$CLAUDE_BIN" $args < "$fifo" > "$streamfile" 2> "$logfile.err"
    ) &
  else
    (
      cd "$run_cwd" || exit 1
      env ${run_env[@]+"${run_env[@]}"} "$CLAUDE_BIN" $args "$prompt" > "$streamfile" 2> "$logfile.err"
    ) &
  fi
  local child=$!

  if [ "$interactive" = "true" ]; then
    exec 9> "$fifo"                       # hold it open: EOF would end the turn loop
    "$JQ" -nc --arg t "$prompt" \
      '{type:"user",message:{role:"user",content:[{type:"text",text:$t}]}}' >&9
    state_set "$id" last_fifo "$("$JQ" -nc --arg p "$fifo" '$p')"
  fi
  # Publish the agent's PID so `claude-cron stop` can end this run cleanly.
  echo "$child" > "$slot/child" 2>/dev/null || true

  # An interactive run does not end on its own: stdin is held open, so after each
  # answer the agent simply waits for more. This ends it once the conversation is
  # over — after a `result` event, give the human a short window to type; any new
  # output (their replayed message, or the agent working again) cancels it.
  if [ "$interactive" = "true" ]; then
    (
      # The decision is a POSITIVE ASSERTION about the transcript's current
      # state — "the conversation is finished and quiet" — never an inference
      # from a counter. turn_is_over() has to say yes twice, INTERACTIVE_GRACE
      # apart, with the file unchanged in between, before anything is killed.
      while kill -0 "$child" 2>/dev/null; do
        sleep 2
        turn_is_over "$streamfile" || continue
        size="$(num "$(wc -c < "$streamfile" 2>/dev/null)")"
        waited=0
        while [ "$waited" -lt "$INTERACTIVE_GRACE" ]; do
          sleep 2
          waited="$(num "$(( waited + 2 ))")"
          kill -0 "$child" 2>/dev/null || exit 0
          [ "$(num "$(wc -c < "$streamfile" 2>/dev/null)")" != "$size" ] && break
        done
        # Re-assert after the wait: anything new, or a transcript that no longer
        # ends on a result, means the agent is working again — leave it alone.
        [ "$(num "$(wc -c < "$streamfile" 2>/dev/null)")" != "$size" ] && continue
        turn_is_over "$streamfile" || continue
        [ "$waited" -ge "$INTERACTIVE_GRACE" ] || continue
        printf 'interactive: conversation idle for %ss after the last answer\n' \
          "$INTERACTIVE_GRACE" > "$logfile.turnend"
        kill -TERM "$child" 2>/dev/null
        exit 0
      done
    ) & local turnloop=$!
  fi

  # Liveness watchdog. It asks "is this run still doing anything?", not "has it
  # taken too long" — the stream file grows with every agent event, so while it
  # grows the agent is alive and we leave it alone however many hours it needs.
  # We kill only when it has been silent for $stall seconds (a genuine hang), or
  # when an explicit absolute cap $timeout is set and exceeded. The reason is
  # written to the watchdog file so the run can explain itself afterwards.
  #
  # "Silent" means BOTH signals are quiet. The stream alone is not enough: it
  # stops for the entire duration of a single tool call, so a long test suite
  # reads as a hang and gets killed at $stall for doing exactly what it was
  # asked to do. CPU burnt by the run's process tree covers that gap — while a
  # child is computing, the run is working, and only a run that is neither
  # emitting events nor burning CPU is genuinely hung.
  local wdfile="$logfile.watchdog"
  : > "$wdfile"
  (
    local last_size=-1 last_cpu=-1 last_change now size cpu began poll=30
    began="$(now_epoch)"; last_change="$began"
    while kill -0 "$child" 2>/dev/null; do
      # Bind this run dir to its session the moment the transcript names one,
      # so a machine that goes down mid-run still leaves the directory findable.
      bind_session "$run_dir" "$streamfile"
      sleep "$poll"
      kill -0 "$child" 2>/dev/null || break
      now="$(now_epoch)"
      size="$(wc -c < "$streamfile" 2>/dev/null | tr -d ' ')"; size="${size:-0}"
      cpu="$(num "$(tree_cpu_seconds "$child")")"
      if [ "$size" != "$last_size" ] || [ "$cpu" != "$last_cpu" ]; then
        last_size="$size"; last_cpu="$cpu"; last_change="$now"
      fi
      if [ "$stall" -gt 0 ] && [ "$((now - last_change))" -ge "$stall" ]; then
        printf 'stalled: no output and no CPU for %ss (killed by watchdog)\n' "$stall" > "$wdfile"
        kill -TERM "$child" 2>/dev/null; break
      fi
      if [ "$timeout" -gt 0 ] && [ "$((now - began))" -ge "$timeout" ]; then
        printf 'absolute timeout: reached the %ss cap (killed by watchdog)\n' "$timeout" > "$wdfile"
        kill -TERM "$child" 2>/dev/null; break
      fi
    done
  ) & local watchdog=$!
  wait "$child"; rc=$?
  # Again, now that the transcript is final. The watchdog polls every 30s and
  # its first pass runs before the child has even exec'd, so a run that dies
  # inside that first window would otherwise never be bound — and a run that
  # dies early is exactly the one a resume is for. Here the file is static and
  # complete, so this pass cannot miss what the polling one raced.
  bind_session "$run_dir" "$streamfile"
  kill "$watchdog" 2>/dev/null; wait "$watchdog" 2>/dev/null
  if [ "$interactive" = "true" ]; then
    kill "${turnloop:-0}" 2>/dev/null; wait "${turnloop:-0}" 2>/dev/null
    exec 9>&- 2>/dev/null || true
    rm -f "$fifo"
    state_set "$id" last_fifo '""'
  fi
  local wdreason=""
  [ -s "$wdfile" ] && wdreason="$(cat "$wdfile")"
  rm -f "$wdfile"

  # Extract the final result event; synthesize an error object if the stream
  # ended without one (crash, timeout kill) so classification still works.
  # Tolerant of a truncated/garbled line anywhere in the stream (see below).
  "$JQ" -n -R '[inputs | fromjson? | select(.type == "result")] | last // empty' "$streamfile" > "$logfile" 2>/dev/null
  if ! "$JQ" -e 'type == "object"' "$logfile" >/dev/null 2>&1; then
    # No result event: the run was killed or crashed. Never leave a blank record —
    # rebuild what we can from the stream (session, turn count, and the agent's
    # last words) so the log always says what happened and how far it got.
    # `-n -R` + `fromjson?` parses line by line and SKIPS malformed ones. This
    # matters: a killed run is usually cut off mid-write, and a plain `jq -s`
    # rejects the whole file over that one truncated last line — which is how a
    # run with 349 turns of real work ended up reported as "no information".
    "$JQ" -n -R --arg reason "${wdreason:-the run ended without a final result event (killed or crashed)}" '
      [inputs | fromjson?] as $ev
      | [$ev[] | .message?.usage? // empty] as $u
      | { is_error: true,
          subtype: "no_result_event",
          session_id: ([$ev[] | select(.type=="system" and .subtype=="init") | .session_id] | first // ""),
          num_turns: ([$ev[] | select(.type=="assistant")] | length),
          stop_reason: $reason,
          # A killed run consumed real tokens even though no cost was reported.
          # Record them, so waste can never masquerade as a free $0.00 run.
          usage: { input_tokens:        ([$u[].input_tokens // 0] | add // 0),
                   cache_read_tokens:   ([$u[].cache_read_input_tokens // 0] | add // 0),
                   cache_write_tokens:  ([$u[].cache_creation_input_tokens // 0] | add // 0),
                   output_tokens:       ([$u[].output_tokens // 0] | add // 0) },
          result: (
            [ $ev[] | select(.type=="assistant") | .message.content[]? | select(.type=="text") | .text ]
            | map(select(length > 0)) | last // ""
            | if . == "" then "" else "**Run did not finish — " + $reason + ".**\n\nThe agent'"'"'s last message before it stopped:\n\n" + . end
          ) }' "$streamfile" > "$logfile" 2>/dev/null
    "$JQ" -e 'type == "object"' "$logfile" >/dev/null 2>&1 \
      || printf '{"is_error":true,"subtype":"no_result_event","result":"","stop_reason":"%s"}\n' "${wdreason:-killed or crashed}" > "$logfile"
  fi

  end="$(now_epoch)"
  cost="$("$JQ" -r '.total_cost_usd // 0' "$logfile" 2>/dev/null || echo 0)"
  turns="$("$JQ" -r '.num_turns // 0' "$logfile" 2>/dev/null || echo 0)"
  session="$("$JQ" -r '.session_id // ""' "$logfile" 2>/dev/null || echo "")"

  # Which model actually ran. `$model` is what the job asked for and is usually an
  # ALIAS ("opus") that resolves to whatever is newest, so record the resolved id
  # too — the stream's system/init event reports it (e.g. claude-opus-4-8).
  # Without this the history cannot answer "which Opus was this run?" later.
  local model_id
  model_id="$("$JQ" -r 'select(.type=="system" and .subtype=="init") | .model' "$streamfile" 2>/dev/null | head -1)"
  [ -n "$model_id" ] && [ "$model_id" != "null" ] || model_id=""

  # Classify the run: error / warning / success.
  #   error   — the process failed, the CLI reported an error, or the agent had
  #             tools denied (a blocked agent silently doing nothing is a failure,
  #             not a success — it must surface loudly);
  #   warning — the run completed but something smells: stderr output, or an
  #             empty agent result;
  #   success — clean run, agent produced a result, nothing denied.
  # An interactive run is ENDED BY US once the conversation goes quiet, so its
  # exit status is a signal, not a failure. Treat that as a clean exit.
  if [ -f "$logfile.turnend" ]; then rc=0; rm -f "$logfile.turnend"; fi
  local denials subtype result_len errbytes
  denials="$("$JQ" -r '.permission_denials // [] | length' "$logfile" 2>/dev/null || echo 0)"
  subtype="$("$JQ" -r '.subtype // "success"' "$logfile" 2>/dev/null || echo success)"
  result_len="$("$JQ" -r '.result // "" | length' "$logfile" 2>/dev/null || echo 0)"
  errbytes="$(wc -c < "$logfile.err" 2>/dev/null | tr -d ' ')"
  if [ "$rc" -ne 0 ] || [ "$subtype" != "success" ] \
     || ! "$JQ" -e '.is_error != true' "$logfile" >/dev/null 2>&1; then
    status="error"
  elif [ "${denials:-0}" -gt 0 ]; then
    status="error"
  elif [ "${errbytes:-0}" -gt 0 ] || [ "${result_len:-0}" -eq 0 ]; then
    status="warning"
  else
    status="success"
  fi

  # A run the OPERATOR ended is not a failure, whatever the exit code says. A
  # TERM'd agent exits non-zero and lands in the branch above as `error`, so a
  # deliberate stop was counted in the error tile and drove the failure backoff,
  # slowing the job down as punishment for a decision its owner made on purpose.
  # This overrides every branch above precisely because those all read the exit
  # code, and the exit code is the one thing a kill guarantees.
  # The work itself is untouched: the stream, the log and the turns already
  # written stay exactly where they are — only the verdict changes.
  if [ -f "$slot/stopped" ]; then
    status="stopped"
    wdreason="STOPPED: you ended this run from the dashboard. Anything it had already done is in the log below and on disk; it was interrupted, not undone."
  fi

  # "Ran fine, but there was nothing to do" — a resumed task already finished, or
  # its ticket is gone. The agent answers `NOTHING TO DO: <reason>` (see the
  # resume prompt). The run did not FAIL, but calling it a plain success hides
  # that a session was spent doing nothing, so it is a WARNING: worth a look,
  # never a blocker. The reason rides in the run's note, which the dashboard
  # shows behind the "?" beside the status.
  local nothing_line
  nothing_line="$("$JQ" -r '.result // ""' "$logfile" 2>/dev/null | grep -m1 -oE 'NOTHING TO DO:.*' || true)"
  if [ -n "$nothing_line" ] && [ "$status" = "success" ]; then
    wdreason="${nothing_line}"
    status="warning"
  fi

  # "The agent stopped talking" is NOT "the agent finished the job".
  #
  # A headless run ends the instant the model returns text without a tool call.
  # An agent that says "I'll wait for the background suite and then commit" gets
  # exactly what it asked for in an interactive session and nothing at all here:
  # the process exits, its children die with it, and the work is abandoned
  # mid-task. That produces a textbook-clean record — rc 0, subtype success, a
  # non-empty result — so it was filed as SUCCESS, which is how a ticket with no
  # commit, no push and no PR came to be reported as done. The one fact the
  # operator needed was the one fact the status did not carry.
  #
  # So a clean exit now has to be CLAIMED, not inferred. The agent declares how
  # its run ended (see the job prompt's "Declare how your run ended"); an
  # undeclared ending is the signature of a run that stopped mid-task, and it is
  # a warning — never a silent success. A warning that is occasionally
  # unnecessary costs a glance; a success that is occasionally false costs a day.
  if [ "$status" = "success" ] \
     && ! "$JQ" -r '.result // ""' "$logfile" 2>/dev/null \
          | grep -qE '(RUN COMPLETE|NOTHING TO DO|BLOCKED):'; then
    wdreason="UNDECLARED ENDING: the agent stopped without saying its run was finished (no 'RUN COMPLETE:', 'NOTHING TO DO:' or 'BLOCKED:' line), which is what a run cut off mid-task looks like. Do NOT assume the ticket is done — check the branch, the PR and the ticket, and resume this run to continue with its context."
    status="warning"
  fi

  # "Ran out of money mid-task" looks EXACTLY like "finished the job": the agent
  # sees the budget running down, wraps up cleanly and returns a result, so the
  # subtype is `success` and nothing in the record says the work was cut short.
  # A 75-minute run that stopped at 97% of its cap read as a clean success while
  # its ticket sat unfinished — the one thing the operator needed to know was the
  # one thing not shown. Spending the whole cap is not proof of truncation, but it
  # is the only signal available here, and a warning that is occasionally
  # unnecessary is far cheaper than silence that is occasionally very expensive.
  local cap
  cap="$(job_get "$id" '.max_budget_usd' '')"
  case "$cap" in ''|null|0) cap="" ;; esac
  if [ -n "$cap" ] && [ "$status" = "success" ] \
     && awk "BEGIN{exit !(${cost:-0} >= $cap * 0.9)}" 2>/dev/null; then
    wdreason="BUDGET LIMITED: spent \$${cost:-0} of a \$$cap cap — the agent wrapped up early, so the task may be unfinished. Check the ticket and the branch before assuming it is done; resume this run to continue with its context."
    status="warning"
  fi

  # A run that produced commits or changes no remote knows about handed nothing
  # over. It used to be answered by keeping the run directory on disk for ever,
  # which preserved the work for nobody: a resume cuts a fresh worktree, so the
  # only thing that folder ever did was fill the disk and wait for a human. Push
  # is the delivery channel; failing to use it is a failed run, and it belongs on
  # the card. A warning, not an error: the agent may have been cut off mid-task,
  # and a resume is the right next move rather than a backoff.
  #
  # LAST, and appending rather than replacing. Last because every rule above
  # fires only while the status is still `success` — setting `warning` here
  # first would silence UNDECLARED ENDING and BUDGET LIMITED entirely. And
  # appending because "spent the whole cap" and "pushed nothing" are two
  # different things the operator needs in one glance, not a choice between
  # them.
  #
  # `stopped` is excluded deliberately: an operator who ended the run already
  # knows it did not finish, and replacing their STOPPED record with a generic
  # "you did not push" is less information, not more. `error` is excluded
  # because a run that failed has a cause worth more than its symptom.
  case "$status" in
    success|warning)
      if [ -n "$run_dir" ]; then
        local undelivered
        if undelivered="$(wt_undelivered_work "$run_dir")"; then
          wdreason="${wdreason:-}${wdreason:+ · }$(undelivered_note "$undelivered")"
          status="warning"
        fi
      fi
      ;;
  esac

  # The session's fate, written where teardown can read it. A run that reached a
  # declared ending is over and its tree can go; anything else may be picked up
  # by a resume, and the resume needs this exact directory.
  if [ -n "$run_dir" ] && [ -d "$run_dir" ]; then
    case "$status" in
      success) printf 'done\n' > "$run_dir/.ended" 2>/dev/null || true ;;
      *)       printf 'open\n' > "$run_dir/.ended" 2>/dev/null || true ;;
    esac
  fi

  # Consecutive failures drive the backoff (see backoff_multiplier). A warning
  # is NOT a failure: the run worked, it just wants a look — slowing those down
  # would throttle the very jobs that are doing their job.
  local streak_next=0
  [ "$status" = "error" ] && streak_next="$(( $(num "$(state_get "$id" fail_streak 0)") + 1 ))"

  # One write for the whole outcome. Seven separate ones meant seven turns of
  # the state lock, which every concurrent run had to queue behind.
  state_set_many "$id" "$("$JQ" -nc \
    --argjson end "$end" --arg status "$status" --argjson start "$start" \
    --arg cost "${cost:-0}" --arg session "$session" \
    --argjson streak "$streak_next" \
    '{last_end:$end, last_status:$status, last_run_start:$start,
      last_run_status:$status,
      # the CLI reports cost as a decimal string; tonumber? keeps a malformed
      # one from making the whole state write fail
      last_cost:($cost|tonumber? // 0),
      last_session:$session, fail_streak:$streak}')"
  # Record what was CHOSEN (the family, when one was) plus what actually ran.
  record_run "$id" "$status" "$start" "$end" "${cost:-0}" "${turns:-0}" "$session" "$logfile" "$wdreason" "$forced" "$pc_out" "$project" "${model_family:-$model}" "$model_id" "$resume_sid"
  # Tells the EXIT path this run has already filed its record, so a stop that
  # lands while we are finishing here cannot produce a second one.
  : > "$slot/journaled" 2>/dev/null || true
  log_tick "$id: finished status=$status rc=$rc denials=${denials:-0} cost=\$$cost turns=$turns model=$model${model_id:+ ($model_id)} forced=$forced${wdreason:+ — $wdreason}"
  # Fired after the record exists, so a hook that opens the dashboard or reads
  # the journal sees this run already in it.
  run_end_hook "$id" "$status" "${cost:-0}" "$wdreason" "$project" "$session" "$logfile" "$start" "$end"

  run_cleanup "$id" "$slot"; trap - EXIT
  [ "$status" != "error" ]
}

# --- telling someone a run ended --------------------------------------------
# An unattended pipeline that can only be checked by opening a web page is not
# really unattended: a job can fail every five minutes all night and the first
# anyone knows is the next morning. This is the same shape as the provisioning
# hooks — a script on disk, run with the facts in its environment — so the
# engine stays ignorant of notifiers, and terminal-notifier, ntfy, a Slack
# webhook or a Linear comment are all just things the user writes here.
#
# Detached AND time-limited: a notifier that hangs must not hold the run's slot,
# and a run must never be kept alive by something that only reports on it.
RUN_HOOK_TIMEOUT="${CLAUDE_CRON_HOOK_TIMEOUT:-60}"
run_end_hook() { # <id> <status> <cost> <note> <project> <session> <log> <start> <end>
  local script="$CONFIG_DIR/hooks/on-run-end.sh"
  [ -f "$script" ] || return 0
  (
    _hook() {
      CC_JOB_ID="$1" CC_STATUS="$2" CC_COST="$3" CC_NOTE="$4" CC_PROJECT="$5" \
      CC_SESSION="$6" CC_LOG="$7" CC_START="$8" CC_END="$9" \
      CC_DURATION="$(( ${9:-0} - ${8:-0} ))" CC_DASHBOARD="http://127.0.0.1:$PORT/" \
        bash "$script" >>"$DATA_DIR/exec.log" 2>&1
    }
    wt_run_limited "$RUN_HOOK_TIMEOUT" _hook "$@" \
      || log_tick "$1: on-run-end hook failed or timed out — see exec.log"
  ) >/dev/null 2>&1 &
  return 0
}

# ---------------------------------------------------------------------- tick

# Everything the tick needs to decide about every enabled job, in ONE jq pass
# over both files: id, window, interval, last start, failure streak, ceiling.
#
# The loop used to ask job_get/state_get per field per job, and each of those
# cats and re-parses the whole jobs file — about seven jq processes per job, so
# roughly 150 forks a minute at 21 jobs, for ever, almost always to conclude
# that nothing is due. Disabled jobs are filtered here rather than in the loop:
# `// true` would be wrong (it treats false as absent), hence the explicit test.
tick_plan() { # id \t days \t hours \t interval \t last_start \t fail_streak \t max_parallel
  [ -f "$JOBS_FILE" ] || return 0
  "$JQ" -e . "$JOBS_FILE" >/dev/null 2>&1 || { log_tick "tick: malformed $JOBS_FILE — no job examined"; return 0; }
  "$JQ" -r --slurpfile st "$STATE_FILE" '
    (($st[0]) // {}) as $S
    | .jobs[]
    | select(.enabled != false)
    | . as $j | ($S[$j.id] // {}) as $s
    | [ $j.id,
        (($j.active_days // []) | map(tostring) | join(",")),
        ($j.active_hours // ""),
        (($j.interval_seconds // 300) | tostring),
        (($s.last_start // 0) | tostring),
        (($s.fail_streak // 0) | tostring),
        (($j.max_parallel // 3) | tostring) ] | @tsv' "$JOBS_FILE" 2>/dev/null
}

# The tick only DECIDES and LAUNCHES — it never waits for a run. Each due job is
# handed to a detached `_exec` process that carries out the precheck + Claude run
# on its own, so a 90-minute run never blocks the other jobs' ticks. A run still
# holding its lock is not relaunched.
cmd_tick() {
  local id
  # Cap the two append-only logs before anything else writes to them. Once a
  # minute is the right cadence: the tick is the only thing guaranteed to run,
  # and doing it per log line would cost a wc(1) per line instead of two a tick.
  log_rotate "$TICK_LOG"
  log_rotate "$DATA_DIR/exec.log"
  # Reap worktrees left by runs that died without cleaning up (safe teardown:
  # anything with unpushed/uncommitted work is kept, not deleted).
  wt_prune_orphans
  wt_prune_canonicals
  # Keep the family→model resolutions fresh (about once a day). It rides on the
  # tick this package already installs — deliberately NOT a second launchd job or
  # a crontab entry, so nothing lives outside the project folder and the whole
  # thing still works when the package is handed to someone else. Detached, so a
  # ~1min probing pass never delays the jobs.
  if models_stale && ! lock_active "_models"; then
    nohup /bin/bash "$SELF" _resolve_models </dev/null >> "$DATA_DIR/exec.log" 2>&1 &
    log_tick "models: refreshing family→id resolutions (cache older than ${MODELS_TTL}s)"
  fi
  local days hours interval last streak max_par
  while IFS="$(printf '\t')" read -r id days hours interval last streak max_par; do
    [ -n "$id" ] || continue
    in_window_vals "$days" "$hours" >/dev/null || continue
    is_due_vals "$interval" "$last" "$streak" || continue
    case "$max_par" in ''|null|*[!0-9]*) max_par=3 ;; esac
    if [ "$max_par" -gt 0 ] && [ "$(slots_active "$id")" -ge "$max_par" ]; then
      log_tick "$id: at max_parallel=$max_par run(s), not launching another"
      continue
    fi
    nohup /bin/bash "$SELF" _exec "$id" </dev/null >> "$DATA_DIR/exec.log" 2>&1 &
    log_tick "$id: launched detached run"
  done < <(tick_plan)
}

# ------------------------------------------------------------------ commands

PLIST_PATH_ENV="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

cmd_install() {
  # A global default account, carried into launchd — which inherits nothing from
  # the shell, so without this every run signs in as ~/.claude however the
  # scheduler was installed. Taken ONLY from the explicit variable, never from an
  # ambient CLAUDE_CONFIG_DIR: installing from inside a Claude session would
  # otherwise silently pin that session's account for every job, forever.
  local plist_cfgdir=""
  if [ -n "${CLAUDE_CRON_CLAUDE_CONFIG_DIR:-}" ]; then
    plist_cfgdir="
    <key>CLAUDE_CONFIG_DIR</key><string>$(expand_home "$CLAUDE_CRON_CLAUDE_CONFIG_DIR")</string>"
  elif [ -f "$PLIST_PATH" ]; then
    # Re-running the installer must not quietly drop an account pinned earlier.
    plist_cfgdir="$("$PYTHON" - "$PLIST_PATH" <<'PY'
import plistlib, sys
try:
    v = plistlib.load(open(sys.argv[1], "rb")).get("EnvironmentVariables", {}).get("CLAUDE_CONFIG_DIR")
except Exception:
    v = None
if v:
    print("\n    <key>CLAUDE_CONFIG_DIR</key><string>%s</string>" % v, end="")
PY
)"
  fi

  # 1) the tick agent — fires the scheduler once a minute
  cat > "$PLIST_PATH" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$PLIST_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$SELF</string>
    <string>tick</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <!-- The tick detaches per-job runners and exits; without this, launchd would
       reap the whole process group and kill the runs when the tick returns. -->
  <key>AbandonProcessGroup</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$PLIST_PATH_ENV</string>
    <key>HOME</key><string>$HOME</string>$plist_cfgdir
  </dict>
  <key>StandardOutPath</key><string>$DATA_DIR/launchd.out.log</string>
  <key>StandardErrorPath</key><string>$DATA_DIR/launchd.err.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
PLIST
  # 2) the control server — keeps the interactive dashboard alive on 127.0.0.1
  cat > "$SERVER_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$SERVER_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$PYTHON</string>
    <string>$SERVER_BIN</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$PLIST_PATH_ENV</string>
    <key>HOME</key><string>$HOME</string>
    <key>CLAUDE_CRON_PORT</key><string>$PORT</string>$plist_cfgdir
  </dict>
  <key>StandardOutPath</key><string>$DATA_DIR/server.log</string>
  <key>StandardErrorPath</key><string>$DATA_DIR/server.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
PLIST
  launchctl unload "$PLIST_PATH" 2>/dev/null
  launchctl load "$PLIST_PATH" 2>/dev/null || die "launchctl load failed for $PLIST_PATH"
  launchctl unload "$SERVER_PLIST" 2>/dev/null
  launchctl load "$SERVER_PLIST" 2>/dev/null || die "launchctl load failed for $SERVER_PLIST"
  echo "Installed and loaded:"
  echo "  $PLIST_LABEL   — ticks every 60s (survives logout and reboot)"
  echo "  $SERVER_LABEL  — control dashboard on http://127.0.0.1:$PORT/"
  if [ -n "$plist_cfgdir" ]; then
    echo "Claude account : ${plist_cfgdir##*<string>}" | sed 's|</string>||'
  else
    echo "Claude account : the CLI default (~/.claude) — set CLAUDE_CRON_CLAUDE_CONFIG_DIR and re-run to change it"
  fi
  # The agent prompts make these skills mandatory by name. A fresh clone whose
  # ~/.claude/skills lacks them runs agents that cite standards they cannot read,
  # and nothing anywhere says so -- the run just quietly holds a lower bar. So a
  # clone that installs the scheduler installs the skills it depends on, in the
  # same step, rather than leaving it as a documented step somebody skips.
  echo "Skills (linked into ~/.claude/skills):"
  cmd_skills install
  echo "Open the dashboard with: claude-cron dashboard"
}

cmd_uninstall() {
  launchctl unload "$PLIST_PATH" 2>/dev/null
  launchctl unload "$SERVER_PLIST" 2>/dev/null
  rm -f "$PLIST_PATH" "$SERVER_PLIST"
  echo "Unloaded and removed both agents. Jobs, state and logs were kept."
}

cmd_status() {
  local loaded="not loaded"
  launchctl list 2>/dev/null | grep -q "$PLIST_LABEL" && loaded="loaded"
  echo "launchd   : $PLIST_LABEL — $loaded"
  echo "plist     : $PLIST_PATH"
  echo "jobs file : $JOBS_FILE"
  echo "data      : $DATA_DIR"
  echo
  printf '%-20s %-8s %-9s %-11s %-9s %s\n' JOB ENABLED EVERY LAST STATUS COST
  # One jq over both files, for the same reason the tick does it (see
  # tick_plan): five per job meant a hundred processes just to print a table.
  local id en iv ls st lc ago now
  now="$(now_epoch)"
  while IFS="$(printf '\t')" read -r id en iv ls st lc; do
    [ -n "$id" ] || continue
    if [ "$(num "$ls")" -gt 0 ]; then ago="$(( ( now - ls ) / 60 ))m ago"; else ago="never"; fi
    printf '%-20s %-8s %-9s %-11s %-9s $%s\n' "$id" "$en" "$(( $(num "$iv" 300) / 60 ))m" "$ago" "$st" "$lc"
  done < <("$JQ" -r --slurpfile st "$STATE_FILE" '
      (($st[0]) // {}) as $S
      | .jobs[] | . as $j | ($S[$j.id] // {}) as $s
      | [ $j.id,
          (if $j.enabled == false then "false" else "true" end),
          (($j.interval_seconds // 300) | tostring),
          (($s.last_start // 0) | tostring),
          (($s.last_status // "—") | tostring),
          (($s.last_cost // 0) | tostring) ] | @tsv' "$JOBS_FILE" 2>/dev/null)
  echo
  echo "Dashboard : http://127.0.0.1:$PORT/   (claude-cron dashboard)"
}

cmd_dashboard() {
  ensure_server || die "Control server did not answer on port $PORT — check $DATA_DIR/server.log"
  echo "http://127.0.0.1:$PORT/"
  open "http://127.0.0.1:$PORT/" 2>/dev/null
}

cmd_logs() {
  local id="${1:-}" n="${2:-1}"
  [ -n "$id" ] || die "usage: claude-cron logs <job-id> [n]"
  local f
  f="$(ls -t "$LOG_DIR/$id"/*.json 2>/dev/null | head -"$n" | tail -1)"
  if [ -z "$f" ]; then
    die "no log files on disk for $id — finished runs are absorbed into data/index.db; open the dashboard (claude-cron dashboard) and use the log button on the run row"
  fi
  echo "── $f"
  "$JQ" -r '.result // .' "$f" 2>/dev/null || cat "$f"
}

job_exists() { jobs_json | "$JQ" -e --arg id "$1" 'any(.jobs[]; .id == $id)' >/dev/null 2>&1; }

# Tell the dashboard its index is stale after we REWRITE history (a rename
# rewrites lines anywhere in the journal). Its own change detection hashes only
# the head of the file, so an edit further down would otherwise go unnoticed and
# the index would keep serving the old values. The server clears this flag when
# it re-ingests.
journal_rewritten() { : > "$DATA_DIR/.reingest" 2>/dev/null || true; }

write_jobs() { # write_jobs <jq-filter> [jq-args...]
  # Never replace the jobs file with a broken document: a filter that errors, or
  # that yields anything other than an object carrying .jobs, is discarded. One
  # bad write here would take every job down with it.
  local tmp; tmp="$(mktemp "$CONFIG_DIR/.jobs.XXXXXX")"
  if "$JQ" "$@" "$JOBS_FILE" > "$tmp" 2>/dev/null \
     && "$JQ" -e 'type == "object" and (.jobs | type) == "array"' "$tmp" >/dev/null 2>&1; then
    mv "$tmp" "$JOBS_FILE"
  else
    rm -f "$tmp"; die "refusing to write a malformed jobs file (change discarded)"
  fi
}

cmd_toggle() {
  local id="$1" val="$2"
  job_exists "$id" || die "no such job: $id"
  write_jobs --arg id "$id" --argjson v "$val" \
    '.jobs = [.jobs[] | if .id == $id then .enabled = $v else . end]'
  echo "$id enabled=$val"
}

# The one filter that flips `enabled` on a named set of jobs. It lives in a
# constant so selftest exercises the exact string the command runs: a second copy
# in the test would drift, and the property being proved is precisely that jobs
# outside the set come out untouched.
TOGGLE_MANY_FILTER='.jobs = [.jobs[] | if (.id | IN($want[])) then .enabled = $v else . end]'

cmd_toggle_many() { # cmd_toggle_many <true|false> — ids on stdin (JSON array or one per line)
  # Flips a WHOLE SET in one write. A loop of cmd_toggle calls would rewrite
  # jobs.json once per job, so a failure halfway leaves the set half applied,
  # and a reader could catch the file between two of those writes. One atomic
  # write (one mv) rules both out: no half-applied batch, no torn read of the
  # file. It does NOT make a concurrent tick see one consistent snapshot for
  # the whole run — cmd_tick re-reads jobs.json per job, so a batch landing
  # mid-loop is still old for jobs already visited and new for the rest.
  local val="$1" raw ids missing n
  raw="$(cat)"
  [ -n "$raw" ] || die "toggle-many: no ids given"
  # Same input contract as reorder. NOTE: `try … catch` hands the ERROR to the
  # catch branch, not the input, so use `fromjson?` + `//` instead — with catch,
  # a plain list would be parsed out of jq's own error message.
  ids="$(printf '%s' "$raw" | "$JQ" -c -R -s '. as $t | ($t | fromjson?) // ($t | split("\n") | map(select(length > 0)))')"
  printf '%s' "$ids" | "$JQ" -e 'type == "array" and length > 0 and all(.[]; type == "string")' >/dev/null 2>&1 \
    || die "toggle-many: expected a non-empty list of job ids"
  # Resolve every id BEFORE writing: one unknown id refuses the whole batch,
  # rather than applying the part that happened to match.
  missing="$(jobs_json | "$JQ" -r --argjson want "$ids" '. as $doc | ($doc.jobs | map(.id)) as $have | [$want[] | . as $w | select(($have | index($w)) == null)] | join(", ")')"
  [ -n "$missing" ] && die "toggle-many: unknown job(s): $missing"
  write_jobs --argjson want "$ids" --argjson v "$val" "$TOGGLE_MANY_FILTER"
  n="$(printf '%s' "$ids" | "$JQ" -r 'length')"
  if [ "$n" = 1 ]; then echo "1 job enabled=$val"; else echo "$n jobs enabled=$val"; fi
}

cmd_rename() { # cmd_rename <old-id> <new-id> — id + everything keyed by it
  local old="$1" new="$2" tmp path newpath
  job_exists "$old" || die "no such job: $old"
  # Validate the NEW id exactly as creation does, so a rename can never produce
  # an id that `create` would have refused.
  case "$new" in *[!a-zA-Z0-9_-]*|'') die "rename: id must contain only letters, digits, - and _" ;; esac
  [ "$old" = "$new" ] && { echo "unchanged: $old"; return 0; }
  job_exists "$new" && die "rename: a job named '$new' already exists"
  # A live run holds a slot dir, a worktree and a logfile under the OLD id; let
  # it finish rather than renaming the ground out from under it.
  [ "$(slots_active "$old")" -gt 0 ] && die "rename: $old has a run in progress — stop it or wait for it to finish"

  # The job itself, and its precheck command if it points at the per-job script.
  path="$(precheck_path "$old")"; newpath="$(precheck_path "$new")"
  if [ -f "$path" ] && [ ! -e "$newpath" ]; then
    mv "$path" "$newpath"
    write_jobs --arg o "$old" --arg n "$new" --arg np "bash $newpath" \
      '.jobs = [.jobs[] | if .id == $o then (.id = $n | .precheck = $np) else . end]'
  else
    write_jobs --arg o "$old" --arg n "$new" '.jobs = [.jobs[] | if .id == $o then (.id = $n) else . end]'
  fi

  # Everything else keyed by the id: state, logs, journal. The dashboard's DB
  # re-ingests on its own — it resyncs whenever runs.ndjson's signature changes.
  tmp="$(mktemp "$DATA_DIR/.state.XXXXXX")"
  "$JQ" --arg o "$old" --arg n "$new" \
    'if has($o) then (.[$n] = .[$o] | del(.[$o])) else . end' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
  [ -d "$LOG_DIR/$old" ] && [ ! -e "$LOG_DIR/$new" ] && mv "$LOG_DIR/$old" "$LOG_DIR/$new"
  if [ -s "$RUNS_FILE" ]; then
    tmp="$(mktemp "$DATA_DIR/.runs.XXXXXX")"
    # Under the journal lock: a run ending mid-rewrite would otherwise append to
    # the file this replaces, and its record would be lost.
    journal_lock
    "$JQ" -c --arg o "$old" --arg n "$new" \
      'if .id == $o then (.id = $n | .log = ((.log // "") | sub("/logs/" + $o + "/"; "/logs/" + $n + "/"))) else . end' \
      "$RUNS_FILE" > "$tmp" && mv "$tmp" "$RUNS_FILE"
    journal_unlock
    journal_rewritten
  fi
  rm -rf "$LOCK_DIR/$old"
  [ -d "$WORKTREES_DIR/$old" ] && rmdir "$WORKTREES_DIR/$old" 2>/dev/null
  echo "renamed $old -> $new"
}

cmd_reorder() { # new order of ids on stdin (one per line, or a JSON array)
  # Reorders ONLY the jobs named, into the positions those jobs already occupy —
  # so reordering inside one project group never disturbs the others.
  local ids raw
  raw="$(cat)"
  [ -n "$raw" ] || die "reorder: no ids given"
  # Accept a JSON array or one id per line. NOTE: `try … catch` hands the ERROR
  # to the catch branch, not the input, so use `fromjson?` + `//` instead — with
  # catch, a plain list would be parsed out of jq's own error message.
  ids="$(printf '%s' "$raw" | "$JQ" -c -R -s '. as $t | ($t | fromjson?) // ($t | split("\n") | map(select(length > 0)))')"
  printf '%s' "$ids" | "$JQ" -e 'type == "array" and length > 0 and all(.[]; type == "string")' >/dev/null 2>&1 \
    || die "reorder: expected a non-empty list of job ids"
  local missing
  # `. as $doc` first: inside `$want[]` the dot is the id, not the document.
  missing="$(jobs_json | "$JQ" -r --argjson want "$ids" '. as $doc | ($doc.jobs | map(.id)) as $have | [$want[] | . as $w | select(($have | index($w)) == null)] | join(", ")')"
  [ -n "$missing" ] && die "reorder: unknown job(s): $missing"
  write_jobs --argjson want "$ids" '
    . as $doc
    # The positions the named jobs already occupy, in file order. Rewriting only
    # those slots keeps every other job exactly where it was.
    | [range(0; ($doc.jobs | length)) as $i | select(($want | index($doc.jobs[$i].id)) != null) | $i] as $slots
    | reduce range(0; ($slots | length)) as $k ($doc;
        .jobs[$slots[$k]] = ($doc.jobs[] | select(.id == $want[$k])))'
  echo "reordered: $(printf '%s' "$ids" | "$JQ" -r 'join(" -> ")')"
}

cmd_delete() {
  local id="$1" tmp
  job_exists "$id" || die "no such job: $id"
  write_jobs --arg id "$id" '.jobs = [.jobs[] | select(.id != $id)]'
  tmp="$(mktemp "$DATA_DIR/.state.XXXXXX")"
  "$JQ" --arg id "$id" 'del(.[$id])' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
  rm -rf "$LOCK_DIR/$id"
  echo "deleted $id"
}

cmd_set_prompt() { # reads the new prompt from stdin
  local id="$1" prompt
  job_exists "$id" || die "no such job: $id"
  prompt="$(cat)"
  [ -n "$prompt" ] || die "empty prompt"
  write_jobs --arg id "$id" --arg p "$prompt" \
    '.jobs = [.jobs[] | if .id == $id then .prompt = $p else . end]'
  echo "prompt updated for $id"
}

cmd_set_field() { # cmd_set_field <id> <field> ; value on stdin
  local id="$1" field="$2" value
  job_exists "$id" || die "no such job: $id"
  value="$(cat)"
  case "$field" in
    interval_seconds)
      case "$value" in ''|*[!0-9]*) die "$field must be a positive integer" ;; esac
      [ "$value" -lt 60 ] && value=60
      write_jobs --arg id "$id" --argjson v "$value" \
        '.jobs = [.jobs[] | if .id == $id then .interval_seconds = $v else . end]' ;;
    interactive)
      case "$value" in
        true|false) write_jobs --arg id "$id" --argjson v "$value" \
            '.jobs = [.jobs[] | if .id == $id then .interactive = $v else . end]' ;;
        "") write_jobs --arg id "$id" '.jobs = [.jobs[] | if .id == $id then del(.interactive) else . end]' ;;
        *) die "interactive must be true or false" ;;
      esac ;;
    max_parallel)
      # How many runs of this job may work at once. Empty clears it (the engine
      # then uses its default of 3); 0 is a value in its own right — no ceiling.
      if [ -z "$value" ]; then
        write_jobs --arg id "$id" '.jobs = [.jobs[] | if .id == $id then del(.max_parallel) else . end]'
      else
        case "$value" in *[!0-9]*) die "max_parallel must be a whole number (0 = no limit)" ;; esac
        write_jobs --arg id "$id" --argjson v "$value" \
          '.jobs = [.jobs[] | if .id == $id then .max_parallel = $v else . end]'
      fi ;;
    effort)
      # empty clears it (the CLI then uses its own default)
      case "$value" in
        "") write_jobs --arg id "$id" '.jobs = [.jobs[] | if .id == $id then del(.effort) else . end]' ;;
        low|medium|high|xhigh|max)
          write_jobs --arg id "$id" --arg v "$value" \
            '.jobs = [.jobs[] | if .id == $id then .effort = $v else . end]' ;;
        *) die "effort must be one of: low, medium, high, xhigh, max (or empty)" ;;
      esac ;;
    timeout_seconds|stall_timeout_seconds)
      # Both are optional: empty clears them (no absolute cap / no stall guard).
      if [ -z "$value" ]; then
        write_jobs --arg id "$id" --arg f "$field" \
          '.jobs = [.jobs[] | if .id == $id then del(.[$f]) else . end]'
      else
        case "$value" in *[!0-9]*) die "$field must be a positive integer or empty" ;; esac
        write_jobs --arg id "$id" --arg f "$field" --argjson v "$value" \
          '.jobs = [.jobs[] | if .id == $id then .[$f] = $v else . end]'
      fi ;;
    max_budget_usd)
      if [ -z "$value" ]; then   # empty clears the cap: the run may spend what the task needs
        write_jobs --arg id "$id" \
          '.jobs = [.jobs[] | if .id == $id then del(.max_budget_usd) else . end]'
      else
        "$JQ" -n --arg v "$value" '$v|tonumber' >/dev/null 2>&1 || die "$field must be a number or empty"
        write_jobs --arg id "$id" --argjson v "$value" \
          '.jobs = [.jobs[] | if .id == $id then .max_budget_usd = $v else . end]'
      fi ;;
    daily_budget_usd)
      if [ -z "$value" ]; then   # empty clears the cap (no daily ceiling)
        write_jobs --arg id "$id" \
          '.jobs = [.jobs[] | if .id == $id then del(.daily_budget_usd) else . end]'
      else
        "$JQ" -n --arg v "$value" '$v|tonumber' >/dev/null 2>&1 || die "$field must be a number or empty"
        write_jobs --arg id "$id" --argjson v "$value" \
          '.jobs = [.jobs[] | if .id == $id then .daily_budget_usd = $v else . end]'
      fi ;;
    model|active_hours|description|cwd)
      write_jobs --arg id "$id" --arg f "$field" --arg v "$value" \
        '.jobs = [.jobs[] | if .id == $id then .[$f] = $v else . end]' ;;
    project)
      if [ -z "$value" ]; then   # empty clears the project (job becomes ungrouped)
        write_jobs --arg id "$id" '.jobs = [.jobs[] | if .id == $id then del(.project) else . end]'
      else
        write_jobs --arg id "$id" --arg v "$value" \
          '.jobs = [.jobs[] | if .id == $id then .project = $v else . end]'
      fi ;;
    permission_mode)
      case "$value" in
        acceptEdits|auto|bypassPermissions|manual|dontAsk|plan) : ;;
        *) die "invalid permission_mode: $value" ;;
      esac
      write_jobs --arg id "$id" --arg v "$value" \
        '.jobs = [.jobs[] | if .id == $id then .permission_mode = $v else . end]' ;;
    active_days)
      local arr
      arr="$("$JQ" -cn --arg v "$value" '$v|split(",")|map(select(length>0)|tonumber)' 2>/dev/null)" \
        || die "active_days must be comma-separated numbers 1..7"
      write_jobs --arg id "$id" --argjson v "$arr" \
        '.jobs = [.jobs[] | if .id == $id then .active_days = $v else . end]' ;;
    *) die "unknown field: $field" ;;
  esac
  echo "$field updated for $id"
}

# A run dir that wt_teardown decided to keep (marked `open` — the session was
# cut short and a resume has not claimed it) is preserved for as long as that
# stands: the sweep re-examines it every tick and always reaches the same
# conclusion. Nothing releases it on its own, so the only way out meanwhile is
# rm -rf by hand — and because nothing listed them either, they were invisible
# until the disk filled. This is the deliberate way to let one go.
cmd_worktree_drop() { # cmd_worktree_drop <job-id> <stamp>
  local id="$1" stamp="$2" run_dir="$WORKTREES_DIR/$1/$2"
  case "$stamp" in *[!a-zA-Z0-9_.-]*|''|*..*) die "worktree-drop: bad stamp '$stamp'" ;; esac
  [ -d "$run_dir" ] || die "worktree-drop: no such run dir: $run_dir"
  # Never pull the ground out from under a running agent.
  if wt_is_claimed "$id" "$run_dir"; then
    die "worktree-drop: $id/$stamp belongs to a run that is still going — stop it first"
  fi
  # `down` first, and by hand: an open session deliberately never reached the
  # down block in wt_teardown, so this is the only chance its compose stack and
  # its ports get to be released — the manifest that names them goes out with
  # the directory on the next line.
  #
  # The project comes from .run.json first, job_get only as a fallback: a job
  # can be deleted (or renamed) while its run dir still sits on disk, and
  # these are exactly the directories most likely to be dropped by hand long
  # after the job that made them is gone. job_get alone would resolve such a
  # job to no project at all, wt_provision would look for `provision/.down.sh`
  # and find nothing, and the drop would silently take nothing down.
  local dproject
  dproject="$("$JQ" -r '.project // ""' "$run_dir/.run.json" 2>/dev/null)"
  case "$dproject" in null) dproject="" ;; esac
  [ -n "$dproject" ] || dproject="$(job_get "$id" '.project' '')"
  wt_down_all "$id" "$dproject" "$run_dir"
  wt_remove_all "$run_dir"
  [ -d "$WORKTREES_DIR/$id" ] && rmdir "$WORKTREES_DIR/$id" 2>/dev/null
  log_tick "$id: run dir $stamp dropped by the user (discarding whatever it held)"
  echo "dropped $id/$stamp"
}

precheck_path() { echo "$CONFIG_DIR/prechecks/$1.sh"; }

PRECHECK_SKELETON='#!/bin/bash
# Precheck for job "%s".
# Exit 0 to wake a Claude run; exit 1 to stay idle (a skipped tick costs nothing).
# Put a cheap check here — curl an API, grep a log, test a file — and end with a
# test whose exit status is the decision. Example:
#
#   count=$(curl -sf https://api.example.com/queue | /usr/bin/jq -r ".pending")
#   [ "${count:-0}" -gt 0 ]
exit 0
'

cmd_set_precheck() { # reads the precheck script from stdin
  local id="$1" script path
  job_exists "$id" || die "no such job: $id"
  script="$(cat)"
  [ -n "$script" ] || die "empty precheck script"
  mkdir -p "$CONFIG_DIR/prechecks"
  path="$(precheck_path "$id")"
  printf '%s\n' "$script" > "$path"
  chmod +x "$path"
  write_jobs --arg id "$id" --arg cmd "bash $path" \
    '.jobs = [.jobs[] | if .id == $id then .precheck = $cmd else . end]'
  echo "precheck updated for $id ($path)"
}

cmd_get_precheck() {
  local path; path="$(precheck_path "$1")"
  [ -f "$path" ] && cat "$path" || true
}

# The worktree provisioning hooks, kept the same way prechecks are: a script on
# disk, named after what owns it, with the CLI as the only writer.
provision_path() { printf '%s/provision/%s.%s.sh\n' "$CONFIG_DIR" "$1" "$2"; }

cmd_provision_set() { # <project> <up|down> — the script arrives on stdin
  local project="$1" phase="$2" script path
  projects_json | "$JQ" -e --arg n "$project" 'any(.projects[]; .name==$n)' >/dev/null 2>&1 \
    || die "no such project: $project"
  case "$phase" in up|down) ;; *) die "phase must be up or down" ;; esac
  script="$(cat)"
  path="$(provision_path "$project" "$phase")"
  # An empty script means "no hook": remove the file rather than leave one that
  # runs nothing, so the engine's `[ -f ]` check stays the whole truth.
  if [ -z "$script" ]; then
    rm -f "$path"
    echo "provision $phase cleared for $project"
    return 0
  fi
  mkdir -p "$CONFIG_DIR/provision"
  printf '%s\n' "$script" > "$path"
  chmod +x "$path"
  echo "provision $phase updated for $project ($path)"
}

cmd_provision_get() { # <project> <up|down>
  local path; path="$(provision_path "$1" "$2")"
  [ -f "$path" ] && cat "$path" || true
}

cmd_create() { # reads a partial job object (JSON) from stdin
  local partial id path defaults merged
  partial="$(cat)"
  echo "$partial" | "$JQ" -e 'type == "object"' >/dev/null 2>&1 || die "create: stdin must be a JSON object"
  id="$(echo "$partial" | "$JQ" -r '.id // ""')"
  [ -n "$id" ] || die "create: missing .id"
  case "$id" in *[!a-zA-Z0-9_-]*|'') die "create: id must contain only letters, digits, - and _" ;; esac
  job_exists "$id" && die "create: a job named '$id' already exists"
  path="$(precheck_path "$id")"
  # cwd is intentionally NOT defaulted here: an unset cwd inherits from the
  # job's project (resolve()); it only falls back to $HOME at run time when the
  # job has no project either.
  defaults="$("$JQ" -n --arg id "$id" --arg pc "bash $path" '{
    id: $id, description: "", enabled: true,
    interval_seconds: 300, active_days: [1,2,3,4,5], active_hours: "08:00-20:00",
    precheck: $pc, model: "opus", max_budget_usd: 2, stall_timeout_seconds: 1200,
    permission_mode: "dontAsk", prompt: ""
  }')"
  merged="$(printf '%s\n%s\n' "$defaults" "$partial" | "$JQ" -s '.[0] * .[1]')"
  write_jobs --argjson j "$merged" '.jobs += [$j]'
  if [ ! -f "$path" ]; then
    mkdir -p "$CONFIG_DIR/prechecks"
    # shellcheck disable=SC2059
    printf "$PRECHECK_SKELETON" "$id" > "$path"
    chmod +x "$path"
  fi
  echo "created $id (precheck: $path)"
}

cmd_project_set() { # reads a partial project object (JSON) from stdin; merges by name
  local partial name
  partial="$(cat)"
  echo "$partial" | "$JQ" -e 'type == "object"' >/dev/null 2>&1 || die "project-set: stdin must be a JSON object"
  name="$(echo "$partial" | "$JQ" -r '.name // ""')"
  [ -n "$name" ] || die "project-set: missing .name"
  if projects_json | "$JQ" -e --arg n "$name" 'any(.projects[]; .name==$n)' >/dev/null 2>&1; then
    write_projects --arg n "$name" --argjson p "$partial" \
      '.projects = [.projects[] | if .name==$n then (. * $p) else . end]'
  else
    write_projects --argjson p "$partial" '.projects += [$p]'
  fi
  echo "project '$name' saved"
}

cmd_project_rename() { # <old-name> <new-name> — the project and every job pointing at it
  local old="$1" new="$2"
  projects_json | "$JQ" -e --arg n "$old" 'any(.projects[]; .name==$n)' >/dev/null 2>&1 \
    || die "project-rename: no such project: $old"
  [ -n "$new" ] || die "project-rename: the new name cannot be empty"
  [ "$old" = "$new" ] && { echo "unchanged: $old"; return 0; }
  # A project name is its identity — two projects sharing one would make every
  # lookup (cwd, description, worktree config) ambiguous.
  projects_json | "$JQ" -e --arg n "$new" 'any(.projects[]; .name==$n)' >/dev/null 2>&1 \
    && die "project-rename: a project named '$new' already exists"
  write_projects --arg o "$old" --arg n "$new" \
    '.projects = [.projects[] | if .name==$o then (.name = $n) else . end]'
  # Jobs reference the project BY NAME, so they must follow it or they would
  # silently stop inheriting cwd/model/worktree settings.
  write_jobs --arg o "$old" --arg n "$new" \
    '.jobs = [.jobs[] | if .project==$o then (.project = $n) else . end]'
  # Every past run recorded the project name it ran under, so the history must
  # follow too — otherwise the runs table keeps showing the old name forever.
  # The dashboard's DB re-ingests on its own once the journal's signature changes.
  if [ -s "$RUNS_FILE" ]; then
    local tmp; tmp="$(mktemp "$DATA_DIR/.runs.XXXXXX")"
    journal_lock
    if "$JQ" -c --arg o "$old" --arg n "$new" \
         'if .project == $o then (.project = $n) else . end' "$RUNS_FILE" > "$tmp" 2>/dev/null; then
      mv "$tmp" "$RUNS_FILE"
      journal_unlock
      journal_rewritten
    else
      rm -f "$tmp"
      journal_unlock
    fi
  fi
  echo "project '$old' renamed to '$new'"
}

cmd_project_delete() { # <name> — the project is removed; jobs keep .project (just stop inheriting)
  local name="$1"
  write_projects --arg n "$name" '.projects = [.projects[] | select(.name != $n)]'
  echo "project '$name' deleted"
}

cmd_project_list() {
  projects_json | "$JQ" -r '.projects[] | "  \(.name)  ·  cwd=\(.cwd // "—")  ·  \(.description // "" | .[0:60])"'
}

# Ensure the control server is up; start it detached if nothing answers /health.
ensure_server() {
  curl -s -o /dev/null "http://127.0.0.1:$PORT/health" 2>/dev/null && return 0
  CLAUDE_CRON_PORT="$PORT" nohup "$PYTHON" "$SERVER_BIN" >> "$DATA_DIR/server.log" 2>&1 &
  local i=0
  while [ "$i" -lt 20 ]; do
    curl -s -o /dev/null "http://127.0.0.1:$PORT/health" 2>/dev/null && return 0
    i=$(( i + 1 )); sleep 0.25
  done
  return 1
}

cmd_serve() { CLAUDE_CRON_PORT="$PORT" exec "$PYTHON" "$SERVER_BIN"; }

usage() {
  cat <<USAGE
claude-cron — durable local scheduler for headless Claude Code runs

  claude-cron install         install + load both agents (tick + control server)
  claude-cron uninstall       unload + remove both agents (keeps jobs and logs)
  claude-cron status          launchd state, every job, last run and cost
  claude-cron list            same as status
  claude-cron dashboard       open the interactive control dashboard in a browser
  claude-cron serve           run the control server in the foreground (launchd uses this)
  claude-cron run <id>        run one job now, ignoring schedule and precheck
  claude-cron check <id>      run only the precheck and report what it found
  claude-cron logs <id> [n]   print the result of the n-th most recent run
  claude-cron enable <id>     re-enable a job
  claude-cron disable <id>    stop a job without deleting it
  claude-cron toggle-many <true|false>   enable or disable a whole set of jobs;
                              ids on stdin, as a JSON array or one per line
  claude-cron delete <id>     remove a job from jobs.json (keeps its logs)
  claude-cron create <id>     create a job from a partial JSON object on stdin
  claude-cron set-prompt <id> replace a job's prompt, read from stdin
  claude-cron set-field <id> <field>   set interval_seconds|active_hours|active_days|
                              model|max_budget_usd|timeout_seconds|
                              stall_timeout_seconds, value from stdin
  claude-cron set-precheck <id>   replace a job's precheck script, read from stdin
  claude-cron provision-set <project> <up|down>   replace a worktree provisioning hook (stdin)
  claude-cron provision-get <project> <up|down>   print one
  claude-cron get-precheck <id>   print a job's precheck script
  claude-cron tick            internal — what launchd calls every minute

Jobs are defined in $JOBS_FILE
USAGE
}

cmd_check() {
  local id="$1" precheck cwd
  precheck="$(jobs_json | "$JQ" -r --arg id "$id" '.jobs[] | select(.id==$id) | .precheck // ""')"
  cwd="$(resolve "$id" cwd "$HOME")"   # inherit the project's cwd, like run_job
  [ -n "$precheck" ] || { echo "$id has no precheck — every due tick spends a session."; return 0; }
  # Read-only, like every standalone probe (see CC_PRECHECK_DRY_RUN).
  ( cd "$cwd" && export CC_PRECHECK_DRY_RUN=1 && eval "$precheck" ); local rc=$?
  case "$(precheck_verdict "$rc")" in
    work)  echo "precheck: WORK FOUND — a due tick would start a Claude run" ;;
    idle)  echo "precheck: nothing to do — a due tick would cost nothing" ;;
    *)     echo "precheck: BROKEN (exit $rc) — the probe could not run, so this job is stuck: it will never find work until this is fixed" ; return 1 ;;
  esac
}

case "${1:-}" in
  install)   cmd_install ;;
  uninstall) cmd_uninstall ;;
  status|list) cmd_status ;;
  dashboard) cmd_dashboard ;;
  tick)      cmd_tick ;;
  _exec)     [ $# -ge 2 ] || die "usage: claude-cron _exec <job-id>"; run_job "$2" ;;  # internal: detached runner
  _resolve_models)   # internal: detached daily refresh, guarded by its own lock
    acquire_lock "_models" || exit 0
    trap 'release_lock "_models"' EXIT
    cmd_resolve_models
    ;;
  run)       [ $# -ge 2 ] || die "usage: claude-cron run <job-id>"; run_job "$2" --force ;;
  resume)    [ $# -ge 3 ] || die "usage: claude-cron resume <job-id> <session-id>"; run_job "$2" --force "$3" ;;
  check)     [ $# -ge 2 ] || die "usage: claude-cron check <job-id>"; cmd_check "$2" ;;
  logs)      shift; cmd_logs "$@" ;;
  enable)    [ $# -ge 2 ] || die "usage: claude-cron enable <job-id>"; cmd_toggle "$2" true ;;
  disable)   [ $# -ge 2 ] || die "usage: claude-cron disable <job-id>"; cmd_toggle "$2" false ;;
  delete)    [ $# -ge 2 ] || die "usage: claude-cron delete <job-id>"; cmd_delete "$2" ;;
  rename)    [ $# -ge 3 ] || die "usage: claude-cron rename <job-id> <new-id>"; cmd_rename "$2" "$3" ;;
  reorder)   cmd_reorder ;;   # new order of job ids on stdin
  toggle-many) [ $# -ge 2 ] || die "usage: claude-cron toggle-many <true|false>  (job ids on stdin)"
               case "$2" in true|false) ;; *) die "toggle-many: expected true or false, got '$2'" ;; esac
               cmd_toggle_many "$2" ;;
  create)    cmd_create ;;
  project-set)    cmd_project_set ;;
  project-delete) [ $# -ge 2 ] || die "usage: claude-cron project-delete <name>"; cmd_project_delete "$2" ;;
  project-rename) [ $# -ge 3 ] || die "usage: claude-cron project-rename <name> <new-name>"; cmd_project_rename "$2" "$3" ;;
  project-list)   cmd_project_list ;;
  resolve-models) cmd_resolve_models ;;
  skills)    shift; cmd_skills "${1:-status}" ;;
  selftest)  cmd_selftest ;;
  running)   [ $# -ge 2 ] || die "usage: claude-cron running <job-id>"; cmd_running "$2" ;;
  runs)      [ $# -ge 2 ] || die "usage: claude-cron runs <job-id>"; cmd_runs "$2" ;;
  precheck)  [ $# -ge 2 ] || die "usage: claude-cron precheck <job-id>"; cmd_precheck "$2" ;;
  say)       [ $# -ge 2 ] || die "usage: claude-cron say <job-id> (message on stdin)"; cmd_say "$2" ;;
  stop)      [ $# -ge 2 ] || die "usage: claude-cron stop <job-id> [run-pid]"; cmd_stop "$2" "${3:-}" ;;
  set-prompt) [ $# -ge 2 ] || die "usage: claude-cron set-prompt <job-id> (prompt on stdin)"; cmd_set_prompt "$2" ;;
  set-field) [ $# -ge 3 ] || die "usage: claude-cron set-field <job-id> <field> (value on stdin)"; cmd_set_field "$2" "$3" ;;
  set-precheck) [ $# -ge 2 ] || die "usage: claude-cron set-precheck <job-id> (script on stdin)"; cmd_set_precheck "$2" ;;
  get-precheck) [ $# -ge 2 ] || die "usage: claude-cron get-precheck <job-id>"; cmd_get_precheck "$2" ;;
  provision-set) [ $# -ge 3 ] || die "usage: claude-cron provision-set <project> <up|down> (script on stdin)"; cmd_provision_set "$2" "$3" ;;
  provision-get) [ $# -ge 3 ] || die "usage: claude-cron provision-get <project> <up|down>"; cmd_provision_get "$2" "$3" ;;
  worktree-drop) [ $# -ge 3 ] || die "usage: claude-cron worktree-drop <job-id> <stamp>"; cmd_worktree_drop "$2" "$3" ;;
  serve)     cmd_serve ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try: claude-cron help)" ;;
esac
