#!/bin/bash
# claude-cron — durable local scheduler for headless Claude Code runs.
#
# Self-contained: config/ and data/ sit next to this script's bin/ directory.
# A single launchd agent calls `claude-cron tick` once a minute; the tick
# decides which jobs are due, runs an optional cheap precheck, and only then
# spends a Claude session.
#
# Targets bash 3.2 (macOS system bash): no associative arrays, no mapfile.

set -uo pipefail

# Resolve this script's real path (following symlinks) so the install is
# self-contained: config/ and data/ and the sibling server live next to bin/,
# wherever the folder lives. A symlink in ~/.local/bin keeps it on PATH.
_src="$0"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
SELF="$(cd -P "$(dirname "$_src")" && pwd)/$(basename "$_src")"
BIN_DIR="$(dirname "$SELF")"
BASE_DIR="$(cd "$BIN_DIR/.." && pwd)"

CONFIG_DIR="${CLAUDE_CRON_CONFIG:-$BASE_DIR/config}"
DATA_DIR="${CLAUDE_CRON_DATA:-$BASE_DIR/data}"
JOBS_FILE="$CONFIG_DIR/jobs.json"
PROJECTS_FILE="$CONFIG_DIR/projects.json"
MODELS_FILE="$CONFIG_DIR/models.json"
INTERACTIVE_GRACE=20        # seconds to wait for a human reply before ending
                            # an interactive run that has finished its turn
MODELS_TTL=86400            # 24h — how long a family→id resolution is trusted,
                            # and how often the tick refreshes it on its own
STATE_FILE="$DATA_DIR/state.json"
RUNS_FILE="$DATA_DIR/runs.ndjson"
LOG_DIR="$DATA_DIR/logs"
LOCK_DIR="$DATA_DIR/locks"
WORKTREES_DIR="$DATA_DIR/worktrees"   # one isolated git worktree per run lives here
TICK_LOG="$DATA_DIR/tick.log"

PLIST_LABEL="com.claude-cron.tick"
PLIST_PATH="$HOME/Library/LaunchAgents/$PLIST_LABEL.plist"
SERVER_LABEL="com.claude-cron.server"
SERVER_PLIST="$HOME/Library/LaunchAgents/$SERVER_LABEL.plist"
SERVER_BIN="$BIN_DIR/claude-cron-server"
PORT="${CLAUDE_CRON_PORT:-8787}"

CLAUDE_BIN="${CLAUDE_CRON_CLAUDE_BIN:-$HOME/.local/bin/claude}"
# Which Claude account every run signs in as. Claude Code keeps credentials,
# settings, plugins, MCP servers and past sessions per config directory — one
# signed-in account each — so this variable is the only thing that chooses
# between two accounts on the same Mac. Set here it is the default for
# everything, model probes included; a project may pin its own (see
# `claude_config_dir` in projects.json). Empty leaves the CLI's own default
# (~/.claude), which is what this tool used before the setting existed.
CLAUDE_CONFIG_DIR="${CLAUDE_CRON_CLAUDE_CONFIG_DIR:-${CLAUDE_CONFIG_DIR:-}}"
if [ -n "$CLAUDE_CONFIG_DIR" ]; then export CLAUDE_CONFIG_DIR; else unset CLAUDE_CONFIG_DIR; fi
PYTHON="${CLAUDE_CRON_PYTHON:-$(command -v python3 2>/dev/null || echo /usr/bin/python3)}"
JQ=/usr/bin/jq

mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$LOG_DIR" "$LOCK_DIR" "$WORKTREES_DIR"
[ -f "$STATE_FILE" ] || echo '{}' > "$STATE_FILE"
[ -f "$RUNS_FILE" ] || : > "$RUNS_FILE"
[ -f "$PROJECTS_FILE" ] || echo '{"projects":[]}' > "$PROJECTS_FILE"

# Per-run git-worktree isolation. Generic and language-agnostic: every
# project-specific detail (whether to isolate, which venv/env) is declared in
# projects.json under `.worktree`, never hard-coded here. See the library header.
. "$BIN_DIR/worktree-lib.sh"

die() { printf '%s\n' "$*" >&2; exit 1; }
# Every number that comes from a command goes through this. The interactive
# supervisor once killed healthy agents because `grep -c` prints "0" AND exits 1,
# so `$(grep -c … || echo 0)` produced "0\n0" and the arithmetic test below it
# blew up instead of returning false. A validated integer makes that whole class
# of failure impossible, so use num() rather than trusting command output.
num() { # num <text> [fallback] -> a plain non-negative integer, always
  local v="${1:-}" d="${2:-0}"
  v="$(printf '%s' "$v" | tr -d '[:space:]')"
  case "$v" in ''|*[!0-9]*) printf '%s' "$d" ;; *) printf '%s' "$v" ;; esac
}


# A leading ~ is the shell's, not the filesystem's: a path that arrives from
# JSON has never been through word expansion, so "~/.claude-work" would be taken
# literally and land a directory called "~" next to the config file.
expand_home() { # expand_home <path>
  case "${1:-}" in
    '~')   printf '%s' "$HOME" ;;
    '~/'*) printf '%s/%s' "$HOME" "${1#\~/}" ;;
    *)     printf '%s' "${1:-}" ;;
  esac
}

now_epoch() { date +%s; }
iso_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
log_tick() { printf '%s %s\n' "$(iso_now)" "$*" >> "$TICK_LOG"; }

# Nothing ever trimmed tick.log or exec.log, so both grew for the life of the
# install — and the dashboard re-reads tick.log WHOLE every 5s to count the
# day's activity, so an old install pays for that growth on every poll. Keep one
# previous generation and start fresh: history far enough back to be useless for
# the 24h counters is not worth carrying for ever.
LOG_MAX_BYTES="${CLAUDE_CRON_LOG_MAX:-4194304}"   # 4 MiB per file
log_rotate() { # log_rotate <file> [max-bytes]
  local f="${1:-}" max; max="$(num "${2:-$LOG_MAX_BYTES}" "$LOG_MAX_BYTES")"
  [ -f "$f" ] || return 0
  [ "$(num "$(wc -c < "$f" 2>/dev/null)")" -ge "$max" ] || return 0
  # Exactly one generation: mv replaces any existing .1, so the chain never
  # grows. A run holding exec.log open keeps writing into the renamed file —
  # harmless, and it stops at the end of that run.
  mv -f "$f" "$f.1" 2>/dev/null || return 0
  : > "$f" 2>/dev/null || true
}

# ---------------------------------------------------------------- job helpers

jobs_json() {
  [ -f "$JOBS_FILE" ] || die "No jobs file at $JOBS_FILE — run ./install.sh (it seeds one from config/jobs.example.json)"
  "$JQ" -e . "$JOBS_FILE" >/dev/null 2>&1 || die "Malformed JSON in $JOBS_FILE"
  cat "$JOBS_FILE"
}

# NOTE: deliberately NOT jq's `//` operator. `//` treats **false** as absent, so
# `(.enabled) // "true"` returned "true" for a job with `enabled: false` — which
# meant Disable never disabled anything and the tick kept launching runs. Fall
# back only on null/missing.
job_get() { # job_get <id> <jq-path> [default]
  local id="$1" path="$2" def="${3:-}"
  jobs_json | "$JQ" -r --arg id "$id" --arg def "$def" \
    '[.jobs[] | select(.id == $id) | '"$path"'] | .[0] as $v
     | (if $v == null then $def else $v end)
     | if type == "array" then join(",") else tostring end'
}

# ---------------------------------------------------------------- projects

projects_json() {
  [ -f "$PROJECTS_FILE" ] && "$JQ" -e . "$PROJECTS_FILE" >/dev/null 2>&1 || echo '{"projects":[]}' > "$PROJECTS_FILE"
  cat "$PROJECTS_FILE"
}

project_get() { # project_get <name> <jq-path> [default]
  local name="$1" path="$2" def="${3:-}"
  projects_json | "$JQ" -r --arg n "$name" --arg def "$def" \
    '[.projects[] | select(.name == $n) | '"$path"'] | .[0] as $v
     | (if $v == null then $def else $v end)
     | if type == "array" then join(",") else tostring end'
}

write_projects() { # write_projects <jq-filter> [jq-args...]
  local tmp; tmp="$(mktemp "$CONFIG_DIR/.projects.XXXXXX")"
  "$JQ" "$@" "$PROJECTS_FILE" > "$tmp" && mv "$tmp" "$PROJECTS_FILE"
}

# Resolve a possibly-inherited field: the job's own value wins; else the job's
# project's value; else the default. Empty/absent counts as "not set".
resolve() { # resolve <id> <field> <default>
  local id="$1" field="$2" def="$3" v proj pv
  v="$(job_get "$id" ".$field" '')"
  if [ -n "$v" ] && [ "$v" != "null" ]; then echo "$v"; return; fi
  proj="$(job_get "$id" '.project' '')"
  if [ -n "$proj" ] && [ "$proj" != "null" ]; then
    pv="$(project_get "$proj" ".$field" '')"
    if [ -n "$pv" ] && [ "$pv" != "null" ]; then echo "$pv"; return; fi
  fi
  echo "$def"
}

state_get() { # state_get <id> <field> [default]
  "$JQ" -r --arg id "$1" --arg f "$2" --arg def "${3:-}" \
    '.[$id][$f] as $v | (if $v == null then $def else $v end) | tostring' "$STATE_FILE" 2>/dev/null
}

# ---- the one mkdir lock every serialized write uses ------------------------
# Every lock here used to break purely on ELAPSED TIME (~4s) without ever asking
# whether the holder was still alive. That inverts the point of a lock: the
# slowest legitimate holder is precisely the one most likely to be robbed, and
# the slowest holder here is a journal rewrite over a long history — so the
# record a run had just appended could be lost to the very mechanism meant to
# protect it. `acquire_lock` already knew the right answer (write your pid, and
# only break the lock when that pid is gone); this generalises it to the rest.
LOCK_GRACE_SECONDS="${CLAUDE_CRON_LOCK_GRACE:-30}"

lock_take() { # lock_take <lockdir> — blocks until held; always succeeds
  local d="${1:-}" hold i=0
  while ! mkdir "$d" 2>/dev/null; do
    hold="$(cat "$d/pid" 2>/dev/null || true)"
    if [ -n "$hold" ] && ! kill -0 "$hold" 2>/dev/null; then
      rm -rf "$d"; continue          # the owner is gone: genuinely stale
    fi
    # A live owner is WAITED for, however long it takes. An unreadable owner is
    # the narrow race between mkdir and writing the pid — give that, and only
    # that, a time-based escape.
    i=$(( i + 1 ))
    if [ -z "$hold" ] && [ "$i" -ge $(( LOCK_GRACE_SECONDS * 100 )) ]; then
      rm -rf "$d"; i=0; continue
    fi
    sleep 0.01
  done
  echo $$ > "$d/pid" 2>/dev/null || true
  return 0
}
lock_drop() { rm -rf "${1:-}"; }   # rm -rf, not rmdir: the dir holds a pid file

# Serialize state writes: detached runs execute in parallel, and state_set is a
# read-modify-write on one shared file, so two of them racing would drop a field.
_state_lock()   { lock_take "$LOCK_DIR/.state.lock"; }
_state_unlock() { lock_drop "$LOCK_DIR/.state.lock"; }

state_set() { # state_set <id> <field> <value-as-json>
  local id="$1" field="$2" value="$3" tmp
  _state_lock
  tmp="$(mktemp "$DATA_DIR/.state.XXXXXX")"
  "$JQ" --arg id "$id" --arg f "$field" --argjson v "$value" \
    '.[$id] = ((.[$id] // {}) | .[$f] = $v)' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
  _state_unlock
}

# Several fields in ONE locked read-modify-write. The end of a run set seven
# fields one at a time, so it took the state lock seven times and forked jq
# seven times to record a single event — and every other run on the machine
# queued behind each of them. Merges into whatever the job already has, so no
# field written elsewhere is lost.
state_set_many() { # state_set_many <id> <json-object>
  local id="$1" obj="$2" tmp
  _state_lock
  tmp="$(mktemp "$DATA_DIR/.state.XXXXXX")"
  "$JQ" --arg id "$id" --argjson o "$obj" \
    '.[$id] = ((.[$id] // {}) + $o)' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
  _state_unlock
}

# What a precheck's exit status MEANS. The engine used to read every non-zero
# status as "nothing to do", which made the two failures that matter look
# identical to the one healthy outcome: a probe that ran and found no work
# (exit 1) and a probe that could not run AT ALL (a missing credentials file,
# an unsourceable helper, a typo -> 2, 126, 127) both left the job sitting
# quietly "idle". A job could therefore stop working for good and the dashboard
# would keep reporting it as healthy and up to date. The contract is now
# explicit and narrow: 0 = work, 1 = idle, anything else = the probe is broken.
precheck_verdict() { # precheck_verdict <exit-code> -> work|idle|error
  case "$(num "${1:-}" 99)" in
    0) printf 'work'  ;;
    1) printf 'idle'  ;;
    *) printf 'error' ;;
  esac
}

# ------------------------------------------------------------- schedule gates

# Is a moment inside a job's active window? 0 = yes, 1 = no (reason on stdout).
# Takes VALUES rather than a job id: the tick reads every job's fields in one jq
# pass (see tick_plan), and passing the day/minute in makes the rule testable
# without waiting for a Tuesday.
in_window_vals() { # in_window_vals <days-csv> <hours> [dow] [minute-of-day]
  local days="${1:-}" hours="${2:-}" dow="${3:-}" nowmin="${4:-}" start end s e
  case "$days" in null) days="" ;; esac
  case "$hours" in null) hours="" ;; esac
  [ -n "$dow" ] || dow="$(date +%u)"                         # 1=Mon .. 7=Sun
  [ -n "$nowmin" ] || nowmin=$(( 10#$(date +%H) * 60 + 10#$(date +%M) ))

  if [ -n "$days" ]; then
    case ",$days," in
      *",$dow,"*) : ;;
      *) echo "outside active_days ($days)"; return 1 ;;
    esac
  fi

  if [ -n "$hours" ]; then
    start="${hours%%-*}"; end="${hours##*-}"
    # 10# throughout: "08" is octal to bash arithmetic otherwise, and 08/09 are
    # not even valid octal — the window would abort rather than merely misread.
    s=$(( 10#${start%%:*} * 60 + 10#${start##*:} ))
    e=$(( 10#${end%%:*} * 60 + 10#${end##*:} ))
    if [ "$s" -le "$e" ]; then
      [ "$nowmin" -ge "$s" ] && [ "$nowmin" -lt "$e" ] || { echo "outside active_hours ($hours)"; return 1; }
    else  # window crosses midnight
      [ "$nowmin" -ge "$s" ] || [ "$nowmin" -lt "$e" ] || { echo "outside active_hours ($hours)"; return 1; }
    fi
  fi
  return 0
}

# --- backoff on repeated failure -------------------------------------------
# A job that fails relaunched every interval at full budget, for as long as it
# kept failing — the loop had no notion of "this is not working". Two failures
# are noise (a flaky network, a busy remote); from the third the wait doubles
# each time, capped so a job that is fixed recovers within one capped interval
# rather than hours later. The streak resets on ANY run that is not an error,
# so one good run puts the job straight back on its normal cadence.
BACKOFF_AFTER=3        # failures before the wait starts growing
BACKOFF_MAX=16         # never wait more than 16x the configured interval

backoff_multiplier() { # backoff_multiplier <consecutive-failures> -> 1|2|4|8|16
  local s m=1; s="$(num "${1:-}" 0)"
  [ "$s" -lt "$BACKOFF_AFTER" ] && { printf '1'; return; }
  local steps=$(( s - BACKOFF_AFTER + 1 )) i=0
  while [ "$i" -lt "$steps" ] && [ "$m" -lt "$BACKOFF_MAX" ]; do
    m=$(( m * 2 )); i=$(( i + 1 ))
  done
  [ "$m" -gt "$BACKOFF_MAX" ] && m="$BACKOFF_MAX"
  printf '%s' "$m"
}

effective_interval() { # effective_interval <interval> <streak>
  local iv; iv="$(num "${1:-}" 300)"
  printf '%s' "$(( iv * $(backoff_multiplier "${2:-0}") ))"
}

is_due_vals() { # is_due_vals <interval> <last-start> <fail-streak> ; 0 = due
  local interval last
  interval="$(effective_interval "${1:-300}" "${3:-0}")"
  last="$(num "${2:-0}")"
  [ "$(( $(now_epoch) - last ))" -ge "$interval" ]
}

# Is the agent's turn finished? True only when the LAST decodable event in the
# transcript is a `result` — i.e. the agent has answered and is now waiting for
# input. Deliberately a positive assertion on the file's current state: the
# earlier counter-based version mis-fired and killed working agents. Isolated
# and side-effect free so `claude-cron selftest` can exercise it directly.
turn_is_over() { # turn_is_over <stream-file> ; 0 = the agent answered and is idle
  local f="${1:-}" last
  [ -s "$f" ] || return 1
  last="$("$JQ" -rn -R '[inputs | fromjson? | select(.type != null) | .type] | last // ""' "$f" 2>/dev/null)"
  [ "$last" = "result" ]
}

# ------------------------------------------------------------------- locking

acquire_lock() { # 0 = acquired
  # Two statements on purpose: `local a="$1" b="…$a"` expands every word BEFORE
  # assigning any of them, so under `set -u` the second one sees $a unset. It
  # only ever worked because callers happened to have their own `id` in scope.
  local id="$1" pid
  local lock="$LOCK_DIR/$id"
  if mkdir "$lock" 2>/dev/null; then
    echo $$ > "$lock/pid"; return 0
  fi
  pid="$(cat "$lock/pid" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    return 1                      # a previous run is still going
  fi
  rm -rf "$lock"                  # stale lock from a killed run
  mkdir "$lock" 2>/dev/null && { echo $$ > "$lock/pid"; return 0; }
  return 1
}

release_lock() { rm -rf "$LOCK_DIR/$1"; }

# ---- concurrent run slots (per job) ---------------------------------------
# A job may now run several times in parallel — worktrees remove the working-tree
# contention that used to force one-at-a-time. Each run holds its OWN slot dir
# $LOCK_DIR/<id>/<pid>/ carrying its pid, child pid and worktree breadcrumb.
# `max_parallel` caps how many run at once. The default is 3 (see run_job and
# the tick), NOT the 1 this comment used to claim -- and the difference matters
# to anyone reading it before setting the field: a job whose agent only records
# its progress at the END of a run (moving a card, applying a label) will have a
# second run launched against the same work by the next tick. Such a job wants
# an explicit 1. This is separate from acquire_lock above, which remains a
# single mutex for internal locks (_models).

slots_dir() { echo "$LOCK_DIR/$1"; }     # base dir holding a job's run slots

slots_active() { # <id> -> prints count of live slots; prunes dead ones
  local id="$1"                           # separate stmt: $id must exist before...
  local base="$LOCK_DIR/$id" d pid n=0    # ...it is expanded here (set -u)
  [ -d "$base" ] || { echo 0; return 0; }
  for d in "$base"/*/; do                # glob skips the dotfile mutex (.acq)
    [ -d "$d" ] || continue
    pid="$(cat "$d/pid" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then n=$((n + 1)); else rm -rf "$d"; fi
  done
  echo "$n"
}

acquire_slot() { # <id> <max> -> prints the slot dir; non-zero when at capacity
  # max 0 means no ceiling: run as many at once as are asked for.
  local id="$1" max="$2"
  local base="$LOCK_DIR/$id" slot n L="" i=0
  mkdir -p "$base"
  L="$base/.acq"                         # short mutex so the ceiling holds under a race
  lock_take "$L"
  n="$(slots_active "$id")"              # also prunes dead slots
  if [ "$max" -gt 0 ] && [ "$n" -ge "$max" ]; then lock_drop "$L"; return 1; fi
  slot="$base/$$"                        # unique per _exec process
  mkdir -p "$slot"; echo $$ > "$slot/pid"
  lock_drop "$L"
  printf '%s\n' "$slot"
}

release_slot() { rm -rf "$1"; }          # <slot-dir>

# End-of-run cleanup, shared by the normal exit path and the EXIT trap (so a
# crashed or killed run cleans up too). Tears down the run's worktrees if that is
# safe (see wt_teardown), THEN releases its slot. Reads the run dir from the
# slot breadcrumb; the trap bakes in the slot path. Idempotent.
run_cleanup() { # <id> <slot-dir>
  local id="$1" slot="${2:-}" wt project
  [ -n "$slot" ] || return 0
  wt="$(cat "$slot/worktree" 2>/dev/null || true)"
  if [ -n "$wt" ]; then
    project="$(job_get "$id" '.project' '')"
    # The job's cwd is not needed: teardown finds each repo's canonical checkout
    # through wt_main_of, which works even for a run dir built from repos the
    # job itself never names.
    wt_teardown "$id" "$project" "$wt"
  fi
  release_slot "$slot"
}

lock_active() { # 0 = a run is currently holding the lock for <id> (single mutex)
  local lock="$LOCK_DIR/$1" pid
  [ -d "$lock" ] || return 1
  pid="$(cat "$lock/pid" 2>/dev/null)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# ------------------------------------------------------------------ run a job

# The journal is appended to by runs ending and REWRITTEN whole by deletes and
# renames. Without a shared lock a rewrite can be built from a snapshot taken
# before an append and then overwrite it — losing a finished run's record for
# good. Both sides take this lock; the dashboard takes the same one by name.
journal_lock()   { lock_take "$LOCK_DIR/.journal.lock"; }
journal_unlock() { lock_drop "$LOCK_DIR/.journal.lock"; }

record_run() { # <id> <status> <start> <end> <cost> <turns> <session> <logfile> <note> <forced> <precheck> <project> <model> <model_id> <resumed_from>
  "$JQ" -nc \
    --arg id "$1" --arg status "$2" --argjson start "$3" --argjson end "$4" \
    --arg cost "$5" --arg turns "$6" --arg session "$7" --arg logfile "$8" --arg note "$9" \
    --arg forced "${10:-false}" --arg precheck "${11:-}" --arg project "${12:-}" \
    --arg model "${13:-}" --arg model_id "${14:-}" --arg resumed_from "${15:-}" \
    '{id:$id, status:$status, start:$start, end:$end, duration:($end-$start),
      cost:($cost|tonumber? // 0), turns:($turns|tonumber? // 0),
      session:$session, log:$logfile, note:$note,
      forced:($forced=="true"), precheck:$precheck, project:$project,
      model:$model, model_id:$model_id,
      # The session this run continued, when it was a resume — this is what
      # makes a resumed task identifiable as already picked up.
      resumed_from:$resumed_from}' > "$LOCK_DIR/.rec.$$"
  # Append under the journal lock, so a concurrent rewrite cannot drop this
  # record on the floor (build the line first — the lock is held for the append
  # alone, never across the jq run).
  journal_lock
  cat "$LOCK_DIR/.rec.$$" >> "$RUNS_FILE"
  journal_unlock
  rm -f "$LOCK_DIR/.rec.$$"
}

# How much of the journal the daily-spend scan reads. Records are appended in
# time order, so today's are always at the END — reading the whole file to find
# them made every single run launch O(all history ever). 4 MiB is thousands of
# records: far more than any day, and bounded for ever. A partial first line is
# dropped by `fromjson?`, which is why the offset can be a plain byte count.
SPEND_SCAN_BYTES="${CLAUDE_CRON_SPEND_SCAN:-4194304}"

_spend_since_midnight() { # _spend_since_midnight [id] -> dollars (float)
  local id="${1:-}" midnight
  midnight="$(date -v0H -v0M -v0S +%s 2>/dev/null || echo 0)"
  [ -f "$RUNS_FILE" ] || { printf '0'; return; }
  tail -c "$SPEND_SCAN_BYTES" "$RUNS_FILE" 2>/dev/null \
    | "$JQ" -rR --arg id "$id" --argjson mid "$midnight" \
        'fromjson? | select(((.start//0)>=$mid) and ($id=="" or .id==$id)) | (.cost//0)' 2>/dev/null \
    | awk '{s+=$1} END{printf "%.6f", s+0}'
}

# Total cost of a job's runs since local midnight — powers the per-job daily cap.
spent_today() { _spend_since_midnight "$1"; }

# Total cost of EVERY job's runs since local midnight — powers the global cap.
spent_today_all() { _spend_since_midnight ""; }

# The daily ceiling that applies to a job: its own, else its project's, else
# none. It used to be read from the job ALONE, so a `daily_budget_usd` set on a
# project silently did nothing — which is the one place you would naturally put
# it when a project owns several jobs.
daily_cap_for() { # daily_cap_for <id> -> dollars, or empty for "no cap"
  local v; v="$(resolve "$1" daily_budget_usd '')"
  case "$v" in null) v="" ;; esac
  printf '%s' "$v"
}

# A ceiling on what EVERYTHING spends in a day, declared once at the top of
# projects.json. Per-job caps cannot express "the whole fleet has a budget":
# 21 jobs each correctly under their own limit still add up.
global_daily_cap() { # -> dollars, or empty for "no cap"
  local v
  v="$(projects_json | "$JQ" -r '.global_daily_budget_usd // "" | tostring' 2>/dev/null)"
  case "$v" in null) v="" ;; esac
  printf '%s' "$v"
}

# --- family → newest concrete model id -------------------------------------
# Picking a family must always mean "the newest one". The CLI alias does NOT do
# that: it resolves to the newest model the INSTALLED CLI knows, which lags the
# API after a release (2026-07-24: `opus` still meant claude-opus-4-8 while
# claude-opus-5 was live and absent from the CLI binary). So we discover it:
# the alias gives a free baseline (the init event needs no API call), then we
# probe the next versions up. An unknown id is rejected by the API with
# "issue with the selected model", which is how a probe fails. Results are
# cached in config/models.json for MODELS_TTL so this costs almost nothing.

model_probe_ok() { # model_probe_ok <id> -> 0 when the API accepts it
  local out
  out="$("$CLAUDE_BIN" -p --output-format json --model "$1" "ok" 2>&1)" || return 1
  printf '%s' "$out" | "$JQ" -e '
    (.is_error != true) and (((.result // "") | test("issue with the selected model"; "i")) | not)
  ' >/dev/null 2>&1
}

model_alias_baseline() { # what the CLI's own alias points at (no API call)
  "$CLAUDE_BIN" -p --output-format stream-json --verbose --model "$1" "hi" 2>/dev/null \
    | head -1 | "$JQ" -r '.model // empty' 2>/dev/null
}

resolve_family() { # resolve_family <family> -> newest id (prints, and caches)
  local fam="$1" base major minor cand best=""
  base="$(model_alias_baseline "$fam")"
  [ -n "$base" ] || { echo "$fam"; return; }
  major="$(printf '%s' "$base" | sed -E "s/^claude-${fam}-([0-9]+).*/\1/")"
  case "$major" in ''|*[!0-9]*) echo "$base"; return ;; esac

  # newer bare majors first (e.g. claude-opus-6, claude-opus-5)
  local m
  for m in $(( major + 2 )) $(( major + 1 )); do
    cand="claude-${fam}-${m}"
    if model_probe_ok "$cand"; then best="$cand"; major="$m"; break; fi
  done
  [ -n "$best" ] || best="$base"

  # then the newest minor of that major (claude-opus-5-2, -1 …)
  for minor in 3 2 1; do
    cand="claude-${fam}-${major}-${minor}"
    if model_probe_ok "$cand"; then best="$cand"; break; fi
  done
  echo "$best"
}

models_cache_get() { # models_cache_get <family> -> cached id if still fresh
  [ -f "$MODELS_FILE" ] || return 1
  "$JQ" -er --arg f "$1" --argjson now "$(now_epoch)" --argjson ttl "$MODELS_TTL" \
    '.resolved[$f] | select(.id != null and (($now - (.at // 0)) < $ttl)) | .id' \
    "$MODELS_FILE" 2>/dev/null
}

models_cache_set() { # models_cache_set <family> <id>
  local tmp; tmp="$(mktemp "$CONFIG_DIR/.models.XXXXXX")"
  [ -f "$MODELS_FILE" ] || echo '{"resolved":{}}' > "$MODELS_FILE"
  "$JQ" --arg f "$1" --arg id "$2" --argjson at "$(now_epoch)" \
    '.resolved[$f] = {id:$id, at:$at}' "$MODELS_FILE" > "$tmp" && mv "$tmp" "$MODELS_FILE"
}

effective_model() { # effective_model <model> -> concrete id (families resolved)
  local m="$1" hit
  case "$m" in
    opus|sonnet|haiku|fable) ;;
    *) echo "$m"; return ;;          # already an explicit id — use it verbatim
  esac
  if hit="$(models_cache_get "$m")"; then echo "$hit"; return; fi
  hit="$(resolve_family "$m")"
  [ -n "$hit" ] || hit="$m"
  models_cache_set "$m" "$hit"
  echo "$hit"
}

models_stale() { # 0 = the cache is missing or older than MODELS_TTL
  local oldest
  [ -f "$MODELS_FILE" ] || return 0
  oldest="$("$JQ" -r '[.resolved[]?.at // 0] | min // 0' "$MODELS_FILE" 2>/dev/null)"
  case "$oldest" in ''|null|*[!0-9]*) oldest=0 ;; esac
  [ "$(( $(now_epoch) - oldest ))" -ge "$MODELS_TTL" ]
}

cmd_say() { # cmd_say <id> — message on stdin, delivered to the live run
  local id="$1" fifo text w
  lock_active "$id" || die "no run in progress for $id"
  fifo="$(state_get "$id" last_fifo '')"
  [ -n "$fifo" ] && [ "$fifo" != "null" ] && [ -p "$fifo" ] \
    || die "this run is not interactive (enable 'interactive' on the job)"
  text="$(cat)"
  [ -n "$text" ] || die "empty message"
  # Non-blocking: if the agent died between the checks above, writing to the
  # FIFO would block forever, so give up after a few seconds.
  "$JQ" -nc --arg t "$text" \
    '{type:"user",message:{role:"user",content:[{type:"text",text:$t}]}}' > "$fifo" &
  w=$!
  ( sleep 5; kill "$w" 2>/dev/null ) >/dev/null 2>&1 &
  wait "$w" 2>/dev/null || die "could not deliver — the run may have just ended"
  echo "delivered to $id"
}

cmd_selftest() { # offline checks of the logic that can kill a run or lose money
  local pass=0 fail=0 tmp
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/ccselftest.XXXXXX")"
  ok()   { pass=$(( pass + 1 )); printf '  ok    %s\n' "$1"; }
  bad()  { fail=$(( fail + 1 )); printf '  FAIL  %s\n' "$1"; }
  want() { # want <label> <expected 0|1> <actual-rc>
    [ "$2" -eq "$3" ] && ok "$1" || bad "$1"
  }
  size_of() { num "$(wc -c < "${1:-/nonexistent}" 2>/dev/null)"; }

  # The suite exercises wt_setup/wt_teardown/wt_provision for real, and those
  # write through log_tick and the provisioning hooks. Pointed at the live data
  # dir they append fake jobs (j1..j9, "provision up failed for repoA") to the
  # very tick.log the dashboard parses for its 24h activity counts — the test
  # suite inventing jobs in production history. Shadow the whole data dir, at
  # FUNCTION scope so every helper these tests call sees it too (bash is
  # dynamically scoped), and prove at the end that nothing leaked.
  local _real_tick="$TICK_LOG" _real_exec="$DATA_DIR/exec.log"
  local _tick0 _exec0
  _tick0="$(size_of "$_real_tick")"; _exec0="$(size_of "$_real_exec")"
  local DATA_DIR="$tmp/data"
  local TICK_LOG="$DATA_DIR/tick.log"
  local LOG_DIR="$DATA_DIR/logs" LOCK_DIR="$DATA_DIR/locks"
  local WORKTREES_DIR="$DATA_DIR/worktrees" RUNS_FILE="$DATA_DIR/runs.ndjson"
  mkdir -p "$DATA_DIR" "$LOG_DIR" "$LOCK_DIR" "$WORKTREES_DIR"

  echo "num() — a number from a command is always an integer"
  # This is the exact shape that once produced "0\n0" and killed live agents.
  local n; n="$(num "$(grep -c 'nothing' /dev/null 2>/dev/null)")"
  [ "$n" = "0" ] && ok "grep -c with no match yields 0" || bad "grep -c with no match yielded '$n'"
  [ "$(num '')" = "0" ]        && ok "empty  -> 0"        || bad "empty"
  [ "$(num '  7 ')" = "7" ]    && ok "spaces trimmed"     || bad "spaces"
  [ "$(num 'x9')" = "0" ]      && ok "garbage -> 0"       || bad "garbage"
  [ "$(num '' 5)" = "5" ]      && ok "fallback honoured"  || bad "fallback"
  # and it must be usable in arithmetic without aborting
  ( [ "$(num 'x')" -lt 1 ] ) >/dev/null 2>&1 && ok "usable in [ -lt ]" || bad "not usable in [ -lt ]"

  echo "turn_is_over() — only a finished, quiet turn may end a run"
  printf '%s\n' '{"type":"system"}' '{"type":"assistant","message":{}}' > "$tmp/working.ndjson"
  printf '%s\n' '{"type":"system"}' '{"type":"result","subtype":"success"}' > "$tmp/done.ndjson"
  printf '%s\n' '{"type":"result"}' '{"type":"assistant","message":{}}' > "$tmp/resumed.ndjson"
  : > "$tmp/empty.ndjson"
  printf '%s\n' '{"type":"result"}' '{"trunca' > "$tmp/cut.ndjson"
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"the word result appears here"}]}}' > "$tmp/decoy.ndjson"
  turn_is_over "$tmp/working.ndjson"; want "mid-work run is NOT killable"        1 $?
  turn_is_over "$tmp/done.ndjson";    want "answered run is killable"            0 $?
  turn_is_over "$tmp/resumed.ndjson"; want "work after a result is NOT killable" 1 $?
  turn_is_over "$tmp/empty.ndjson";   want "empty transcript is NOT killable"    1 $?
  turn_is_over "$tmp/cut.ndjson";     want "truncated tail ignored"              0 $?
  turn_is_over "$tmp/decoy.ndjson";   want "the word 'result' in text is not an event" 1 $?
  turn_is_over "$tmp/missing.ndjson"; want "missing file is NOT killable"        1 $?

  echo "killed runs report what they consumed"
  printf '%s\n' \
    '{"type":"system","subtype":"init","session_id":"s"}' \
    '{"type":"assistant","message":{"usage":{"input_tokens":10,"cache_read_input_tokens":100,"cache_creation_input_tokens":5,"output_tokens":2}}}' \
    > "$tmp/usage.ndjson"
  local got
  got="$("$JQ" -rn -R '[inputs | fromjson?] as $ev | [$ev[] | .message?.usage? // empty] as $u
    | "\([$u[].input_tokens // 0] | add // 0)/\([$u[].cache_read_input_tokens // 0] | add // 0)/\([$u[].output_tokens // 0] | add // 0)"' \
    "$tmp/usage.ndjson" 2>/dev/null)"
  [ "$got" = "10/100/2" ] && ok "token usage recovered from a stream ($got)" \
                          || bad "token usage wrong: got '$got', want 10/100/2"

  echo "a disabled job is never launched"
  [ "$(job_get __no_such_job__ '.enabled' 'true')" = "true" ] && ok "absent job defaults to enabled" || bad "default broke"
  printf '%s' '{"jobs":[{"id":"x","enabled":false}]}' > "$tmp/jobs.json"
  got="$("$JQ" -r '[.jobs[] | select(.id=="x") | .enabled] | .[0] as $v | (if $v == null then "true" else $v end) | tostring' "$tmp/jobs.json")"
  [ "$got" = "false" ] && ok "enabled:false reads as false (jq // would say true)" || bad "enabled:false read as '$got'"

  echo "wt_repos() — declared repos win, a bare cwd is the single-repo case"
  mkdir -p "$tmp/proj"
  printf '%s' '{"projects":[{"name":"multi","cwd":"/x/front","repos":[
      {"name":"front","path":"/x/front","base":"develop"},
      {"name":"back","path":"/x/back","base":"release"}]},
    {"name":"solo","cwd":"/x/solo"}]}' > "$tmp/proj/projects.json"
  got="$( PROJECTS_FILE="$tmp/proj/projects.json"; wt_repos multi /x/front | wc -l | tr -d ' ' )"
  [ "$got" = "2" ] && ok "a declared multi-repo project yields 2 rows" || bad "multi yielded '$got' rows"
  got="$( PROJECTS_FILE="$tmp/proj/projects.json"; wt_repos multi /x/front | sed -n '2p' )"
  [ "$got" = "$(printf 'back\t/x/back\trelease')" ] && ok "name/path/base survive the round trip" \
    || bad "second row was '$got'"
  got="$( PROJECTS_FILE="$tmp/proj/projects.json"; wt_repos solo /x/solo )"
  [ "$got" = "$(printf 'solo\t/x/solo\t')" ] && ok "no .repos[] synthesises one row from cwd" \
    || bad "solo row was '$got'"

  echo "wt_base_ref() — declared base wins, then local, then HEAD"
  local gitc="git -c user.name=cc -c user.email=cc@local -c commit.gpgsign=false"
  mkdir -p "$tmp/g"
  git init -q --bare "$tmp/g/origin.git"
  git -c init.defaultBranch=develop init -q "$tmp/g/repo"
  ( cd "$tmp/g/repo" && echo hi > f && git add f && $gitc commit -qm init \
      && git remote add origin "$tmp/g/origin.git" && git push -q -u origin develop ) >/dev/null 2>&1
  got="$(wt_base_ref "$tmp/g/repo" develop)"
  [ "$got" = "origin/develop" ] && ok "a pushed base resolves to origin/<base>" || bad "got '$got'"
  ( cd "$tmp/g/repo" && git branch local-only ) >/dev/null 2>&1
  got="$(wt_base_ref "$tmp/g/repo" local-only)"
  [ "$got" = "local-only" ] && ok "a local-only base resolves to the local branch" || bad "got '$got'"
  got="$(wt_base_ref "$tmp/g/repo" no-such-branch)"
  [ "$got" = "HEAD" ] && ok "an unresolvable base falls back to HEAD" || bad "got '$got'"
  got="$(wt_base_ref "$tmp/g/repo" "")"
  [ "$got" = "origin/develop" ] && ok "an empty base is inferred from the current branch" || bad "got '$got'"

  echo "wt_base_ref() — a hung fetch cannot hold a run for ever"
  # The fetch runs inside wt_setup, i.e. AFTER the run has taken its slot and
  # BEFORE the watchdog exists — so a remote that accepts the connection and
  # then says nothing used to pin the slot indefinitely. With max_parallel=1
  # that is the job dead until a human notices.
  mkdir -p "$tmp/fakebin"
  printf '%s\n' '#!/bin/bash' \
    'for a in "$@"; do [ "$a" = fetch ] && { sleep 8; exit 0; }; done' \
    'exec /usr/bin/git "$@"' > "$tmp/fakebin/git"
  chmod +x "$tmp/fakebin/git"
  local t0 elapsed ref_got
  t0="$(now_epoch)"
  ref_got="$( PATH="$tmp/fakebin:$PATH"; wt_base_ref "$tmp/g/repo" develop 2 2>/dev/null )"
  elapsed=$(( $(now_epoch) - t0 ))
  [ "$elapsed" -lt 6 ] && ok "a stalled fetch is abandoned after the timeout (${elapsed}s)" \
    || bad "wt_base_ref waited ${elapsed}s for a hung fetch"
  [ "$ref_got" = "origin/develop" ] \
    && ok "the base still resolves from the refs already on disk" \
    || bad "after a timed-out fetch the base resolved to '$ref_got'"

  echo "wt_provision() — a missing hook is a no-op, a failing one is a failure"
  mkdir -p "$tmp/cfg/provision" "$tmp/run/repoA"
  ( CONFIG_DIR="$tmp/cfg"; PROJECTS_FILE="$tmp/proj/projects.json"
    wt_provision up nohooks j1 "$tmp/run" repoA /x/a "$tmp/run/repoA" develop ) >/dev/null 2>&1
  want "no script at all is a no-op" 0 $?
  printf '%s\n' '#!/usr/bin/env bash' 'printf "%s %s\n" "$CC_REPO_NAME" "$CC_BASE" > "$CC_WORKTREE/seen"' \
    > "$tmp/cfg/provision/hooked.up.sh"
  ( CONFIG_DIR="$tmp/cfg"; PROJECTS_FILE="$tmp/proj/projects.json"
    wt_provision up hooked j1 "$tmp/run" repoA /x/a "$tmp/run/repoA" develop ) >/dev/null 2>&1
  want "a passing hook returns 0" 0 $?
  got="$(cat "$tmp/run/repoA/seen" 2>/dev/null)"
  [ "$got" = "repoA develop" ] && ok "the hook sees CC_REPO_NAME and CC_BASE" || bad "hook saw '$got'"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 3' > "$tmp/cfg/provision/broken.up.sh"
  ( CONFIG_DIR="$tmp/cfg"; PROJECTS_FILE="$tmp/proj/projects.json"
    wt_provision up broken j1 "$tmp/run" repoA /x/a "$tmp/run/repoA" develop ) >/dev/null 2>&1
  [ $? -ne 0 ] && ok "a failing hook reports failure" || bad "a failing hook reported success"

  echo "wt_setup() — one worktree per repo, a manifest, and an untouched canonical"
  git -c init.defaultBranch=develop init -q "$tmp/g/repo2"
  ( cd "$tmp/g/repo2" && echo hi > f && git add f && $gitc commit -qm init ) >/dev/null 2>&1
  printf '%s' '{"projects":[{"name":"two","cwd":"'"$tmp"'/g/repo","repos":[
      {"name":"one","path":"'"$tmp"'/g/repo","base":"develop"},
      {"name":"two","path":"'"$tmp"'/g/repo2","base":"develop"}]}]}' > "$tmp/proj/two.json"
  local rd="$tmp/wtroot/j2/stampA" prim
  prim="$( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
           wt_setup j2 two "$tmp/g/repo" stampA )"
  [ "$prim" = "$rd/one" ] && ok "the primary worktree is the repo matching .cwd" || bad "primary was '$prim'"
  [ -d "$rd/one" ] && [ -d "$rd/two" ] && ok "one worktree per declared repo" || bad "missing worktrees"
  got="$("$JQ" -r '.repos | length' "$rd/.run.json" 2>/dev/null)"
  [ "$got" = "2" ] && ok "the manifest lists both repos" || bad "manifest listed '$got'"
  got="$("$JQ" -r '.repos[0].fork_sha' "$rd/.run.json" 2>/dev/null)"
  [ "$got" = "$(git -C "$rd/one" rev-parse HEAD)" ] && ok "fork_sha matches the worktree's HEAD" \
    || bad "fork_sha was '$got'"
  got="$(git -C "$tmp/g/repo" symbolic-ref --short --quiet HEAD 2>/dev/null)"
  [ "$got" = "develop" ] && ok "the canonical checkout keeps its branch" || bad "canonical is on '$got'"

  echo "wt_setup() — a project that declares no repos still gets its one worktree"
  printf '%s' '{"projects":[{"name":"solo1","cwd":"'"$tmp"'/g/repo2"}]}' > "$tmp/proj/solo.json"
  prim="$( PROJECTS_FILE="$tmp/proj/solo.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
           wt_setup j9 solo1 "$tmp/g/repo2" stampS )"
  [ "$prim" = "$tmp/wtroot/j9/stampS/repo2" ] && ok "the single-repo path needs no .repos[]" \
    || bad "single-repo primary was '$prim'"
  got="$(wt_run_worktrees "$tmp/wtroot/j9/stampS" | wc -l | tr -d ' ')"
  [ "$got" = "1" ] && ok "exactly one worktree, named after the cwd" || bad "got $got worktrees"

  echo "wt_setup() — a failing hook aborts, takes down what it built, leaves nothing"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 1' > "$tmp/cfg/provision/two.up.sh"
  printf '%s\n' '#!/usr/bin/env bash' 'echo "$CC_REPO_NAME" >> "$tmp_down_log"' \
    > "$tmp/cfg/provision/two.down.sh"
  export tmp_down_log="$tmp/abort-down.log"; : > "$tmp_down_log"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j2 two "$tmp/g/repo" stampB ) >/dev/null 2>&1
  want "a failing up aborts the setup" 1 $?
  [ ! -d "$tmp/wtroot/j2/stampB" ] && ok "the run dir is gone after a rollback" || bad "run dir survived"
  got="$(sort -u "$tmp_down_log" 2>/dev/null | tr '\n' ' ')"
  [ "$got" = "one two " ] && ok "down ran for what had been built before the abort" \
    || bad "abort ran down for '$got'"
  unset tmp_down_log
  rm -f "$tmp/cfg/provision/two.up.sh" "$tmp/cfg/provision/two.down.sh"

  echo "wt_teardown() — down runs, and unpushed work in ANY repo preserves the run"
  printf '%s\n' '#!/usr/bin/env bash' 'echo "$CC_REPO_NAME" >> "$CC_RUN_DIR/down.log"' \
    > "$tmp/cfg/provision/two.down.sh"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_teardown j2 two "$rd" ) >/dev/null 2>&1
  [ ! -d "$rd" ] && ok "a clean run dir is removed" || bad "clean run dir survived"

  local rd2="$tmp/wtroot/j2/stampC"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j2 two "$tmp/g/repo" stampC ) >/dev/null 2>&1
  ( cd "$rd2/two" && echo work > new.txt && git add new.txt && $gitc commit -qm work ) >/dev/null 2>&1
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_unsafe_to_remove "$rd2" ) >/dev/null 2>&1
  want "an unpushed commit in one repo preserves the whole run" 0 $?
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_teardown j2 two "$rd2" ) >/dev/null 2>&1
  [ -d "$rd2/one" ] && ok "the clean sibling is kept too (all or nothing)" || bad "sibling was removed"
  got="$(sort -u "$rd2/down.log" 2>/dev/null | tr '\n' ' ')"
  [ "$got" = "one two " ] && ok "down ran for every repo even though the run was kept" \
    || bad "down.log held '$got'"
  # A preserved run dir is swept again on every tick. Without a marker, `down`
  # re-runs for ever -- a `docker compose down -v` a minute, for as long as the
  # unpushed work sits there.
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_teardown j2 two "$rd2" ) >/dev/null 2>&1
  got="$(wc -l < "$rd2/down.log" 2>/dev/null | tr -d ' ')"
  [ "$got" = "2" ] && ok "down runs ONCE per run dir, however often teardown is called" \
    || bad "down ran $got times for 2 repos"
  rm -f "$tmp/cfg/provision/two.down.sh"

  echo "wt_unsafe_to_remove() — what provisioning left behind is not the agent's work"
  printf '%s\n' '#!/usr/bin/env bash' 'echo residue > provisioned.txt' \
    > "$tmp/cfg/provision/two.up.sh"
  local rd3="$tmp/wtroot/j4/stampE"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j4 two "$tmp/g/repo" stampE ) >/dev/null 2>&1
  [ -f "$rd3/one/provisioned.txt" ] && ok "the hook's untracked file is there" || bad "hook wrote nothing"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_unsafe_to_remove "$rd3" ) >/dev/null 2>&1
  want "provisioning residue alone does NOT preserve a run" 1 $?
  echo "the agent was here" > "$rd3/two/agent.txt"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_unsafe_to_remove "$rd3" ) >/dev/null 2>&1
  want "a file the agent added after provisioning DOES preserve it" 0 $?
  rm -f "$tmp/cfg/provision/two.up.sh"

  echo "wt_prune_orphans() — an unclaimed run dir is reaped, a claimed one is not"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"; WORKTREES_DIR="$tmp/wtroot"
    wt_setup j3 two "$tmp/g/repo" stampD ) >/dev/null 2>&1
  mkdir -p "$tmp/locks/j3/999"
  echo $$ > "$tmp/locks/j3/999/pid"
  echo "$tmp/wtroot/j3/stampD" > "$tmp/locks/j3/999/worktree"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"
    WORKTREES_DIR="$tmp/wtroot"; LOCK_DIR="$tmp/locks"
    wt_prune_orphans ) >/dev/null 2>&1
  [ -d "$tmp/wtroot/j3/stampD" ] && ok "a run dir a live slot claims is left alone" \
    || bad "the sweep deleted a claimed run dir"
  rm -rf "$tmp/locks/j3"
  ( PROJECTS_FILE="$tmp/proj/two.json"; CONFIG_DIR="$tmp/cfg"
    WORKTREES_DIR="$tmp/wtroot"; LOCK_DIR="$tmp/locks"
    wt_prune_orphans ) >/dev/null 2>&1
  [ ! -d "$tmp/wtroot/j3/stampD" ] && ok "an unclaimed run dir is reaped" || bad "orphan survived"

  echo "toggle-many flips only the jobs it was handed"
  printf '%s' '{"jobs":[{"id":"a"},{"id":"b","enabled":false},{"id":"c"}]}' > "$tmp/tm.json"
  got="$("$JQ" -c --argjson want '["a","b"]' --argjson v false "$TOGGLE_MANY_FILTER" "$tmp/tm.json")"
  [ "$got" = '{"jobs":[{"id":"a","enabled":false},{"id":"b","enabled":false},{"id":"c"}]}' ] \
    && ok "disabling a set leaves every job outside it byte-identical" \
    || bad "toggle-many disable produced: $got"
  got="$("$JQ" -c --argjson want '["b"]' --argjson v true "$TOGGLE_MANY_FILTER" "$tmp/tm.json")"
  [ "$got" = '{"jobs":[{"id":"a"},{"id":"b","enabled":true},{"id":"c"}]}' ] \
    && ok "enabling one job adds no key to the others" \
    || bad "toggle-many enable produced: $got"

  echo "the suite itself touches nothing outside its scratch dir"
  [ "$(size_of "$_real_tick")" = "$_tick0" ] \
    && ok "the real tick.log is byte-identical after the suite" \
    || bad "the suite appended to the real tick.log ($_tick0 -> $(size_of "$_real_tick") bytes)"
  [ "$(size_of "$_real_exec")" = "$_exec0" ] \
    && ok "the real exec.log is byte-identical after the suite" \
    || bad "the suite appended to the real exec.log ($_exec0 -> $(size_of "$_real_exec") bytes)"

  echo "log_rotate() — a log that grows without bound is capped, never lost"
  printf 'old line\n' > "$tmp/r.log"
  log_rotate "$tmp/r.log" 1000000
  [ ! -e "$tmp/r.log.1" ] && ok "a small log is left alone" || bad "a small log was rotated"
  local i=0; : > "$tmp/r.log"
  while [ "$i" -lt 200 ]; do printf 'a line that takes up some space %s\n' "$i" >> "$tmp/r.log"; i=$((i+1)); done
  log_rotate "$tmp/r.log" 1000
  [ "$(size_of "$tmp/r.log")" = "0" ] && ok "an oversized log is truncated" \
    || bad "log still $(size_of "$tmp/r.log") bytes"
  grep -q 'a line that takes up some space 199' "$tmp/r.log.1" 2>/dev/null \
    && ok "the previous generation is kept in .1" || bad "rotated content was lost"
  # A second rotation must not stack generations for ever.
  : > "$tmp/r.log"; i=0
  while [ "$i" -lt 200 ]; do printf 'second generation %s\n' "$i" >> "$tmp/r.log"; i=$((i+1)); done
  log_rotate "$tmp/r.log" 1000
  grep -q 'second generation 199' "$tmp/r.log.1" 2>/dev/null \
    && ok "rotating again replaces .1 rather than growing a chain" || bad ".1 was not replaced"
  [ ! -e "$tmp/r.log.2" ] && ok "no .2 is ever created" || bad "a .2 generation appeared"

  echo "precheck_verdict() — a broken probe is not an idle one"
  [ "$(precheck_verdict 0)" = "work" ]  && ok "exit 0 means work was found"    || bad "exit 0 -> $(precheck_verdict 0)"
  [ "$(precheck_verdict 1)" = "idle" ]  && ok "exit 1 means nothing to do"     || bad "exit 1 -> $(precheck_verdict 1)"
  # The whole point: a probe that could not run at all used to be indistinguishable
  # from one that ran and found nothing, so a job whose credentials had gone
  # missing sat "idle" for ever with nothing showing red anywhere.
  [ "$(precheck_verdict 2)" = "error" ] && ok "exit 2 is a broken probe"       || bad "exit 2 -> $(precheck_verdict 2)"
  [ "$(precheck_verdict 127)" = "error" ] && ok "exit 127 (missing command) is broken" || bad "exit 127 -> $(precheck_verdict 127)"
  [ "$(precheck_verdict '')" = "error" ]  && ok "a missing exit code is broken" || bad "empty -> $(precheck_verdict '')"

  echo "lock_take() — a lock is stolen from the dead, never from the living"
  local t0 elapsed dead=99999
  if kill -0 "$dead" 2>/dev/null; then dead=99998; fi
  lock_take "$tmp/free" && ok "a free lock is taken" || bad "could not take a free lock"
  [ "$(cat "$tmp/free/pid" 2>/dev/null)" = "$$" ] && ok "the holder records its pid" || bad "no pid recorded"
  lock_drop "$tmp/free"
  [ ! -d "$tmp/free" ] && ok "dropping removes the lock" || bad "lock survived the drop"

  mkdir -p "$tmp/stale"; echo "$dead" > "$tmp/stale/pid"
  t0="$(now_epoch)"; lock_take "$tmp/stale"; elapsed=$(( $(now_epoch) - t0 ))
  [ "$elapsed" -lt 2 ] && ok "a lock whose owner is gone is taken at once (${elapsed}s)" \
    || bad "waited ${elapsed}s for a dead owner"
  lock_drop "$tmp/stale"

  # The regression that matters. Every one of these locks used to be broken
  # purely on elapsed time (~4s), so a journal rewrite over a large history —
  # exactly the slow case — would have its lock stolen mid-rewrite by a run
  # ending, and lose the record the lock exists to protect.
  mkdir -p "$tmp/live"; echo $$ > "$tmp/live/pid"
  ( lock_take "$tmp/live" && : > "$tmp/live-was-stolen" ) >/dev/null 2>&1 & local waiter=$!
  sleep 5
  [ ! -f "$tmp/live-was-stolen" ] \
    && ok "a lock held by a LIVE process is still held after 5s" \
    || bad "the lock was stolen from a live holder"
  kill "$waiter" 2>/dev/null; wait "$waiter" 2>/dev/null
  rm -rf "$tmp/live"

  echo "backoff_multiplier() — a job that only ever fails must stop costing full price"
  # Nothing slowed a failing job down: it relaunched every interval, at full
  # budget, for as long as it kept failing. 14 dev/review jobs on a 5-minute
  # interval is a lot of money to spend discovering the same breakage.
  [ "$(backoff_multiplier 0)" = "1" ] && ok "a healthy job is never slowed"        || bad "streak 0 -> $(backoff_multiplier 0)"
  [ "$(backoff_multiplier 2)" = "1" ] && ok "two failures are still just noise"    || bad "streak 2 -> $(backoff_multiplier 2)"
  [ "$(backoff_multiplier 3)" = "2" ] && ok "the third failure doubles the wait"   || bad "streak 3 -> $(backoff_multiplier 3)"
  [ "$(backoff_multiplier 4)" = "4" ] && ok "it keeps doubling"                    || bad "streak 4 -> $(backoff_multiplier 4)"
  [ "$(backoff_multiplier 7)" = "16" ] && ok "the multiplier is capped at 16x"     || bad "streak 7 -> $(backoff_multiplier 7)"
  [ "$(backoff_multiplier 99)" = "16" ] && ok "and stays capped"                   || bad "streak 99 -> $(backoff_multiplier 99)"
  [ "$(backoff_multiplier '')" = "1" ] && ok "an absent streak is not a failure"   || bad "empty -> $(backoff_multiplier '')"
  [ "$(effective_interval 300 0)" = "300" ] && ok "a healthy job keeps its interval" || bad "300/0 -> $(effective_interval 300 0)"
  [ "$(effective_interval 300 4)" = "1200" ] && ok "a failing job waits 4x longer" || bad "300/4 -> $(effective_interval 300 4)"

  echo "state_set_many() — the end of a run is one write, not seven"
  ( STATE_FILE="$tmp/state.json"; echo '{"x":{"keep":"me"}}' > "$STATE_FILE"
    state_set_many x '{"last_status":"success","last_cost":1.25,"fail_streak":0}'
    printf '%s|%s|%s|%s\n' "$(state_get x last_status)" "$(state_get x last_cost)" \
           "$(state_get x fail_streak)" "$(state_get x keep)" ) > "$tmp/sm.out" 2>/dev/null
  got="$(cat "$tmp/sm.out")"
  [ "$got" = "success|1.25|0|me" ] \
    && ok "every field lands and the fields already there survive" || bad "got '$got'"
  ( STATE_FILE="$tmp/state2.json"; echo '{}' > "$STATE_FILE"
    state_set_many newjob '{"a":1}'; state_get newjob a ) > "$tmp/sm2.out" 2>/dev/null
  [ "$(cat "$tmp/sm2.out")" = "1" ] && ok "a job with no state yet is created" || bad "new job: $(cat "$tmp/sm2.out")"

  echo "in_window_vals() — the schedule window, including the one that wraps midnight"
  in_window_vals "" "" 3 600            ; want "no restriction is always open"        0 $?
  in_window_vals "1,2,3,4,5" "" 3 600   ; want "a listed weekday is open"             0 $?
  in_window_vals "1,2,3,4,5" "" 6 600   ; want "an unlisted weekday is closed"        1 $?
  in_window_vals "" "08:00-20:00" 3 600 ; want "inside the hours is open (10:00)"     0 $?
  in_window_vals "" "08:00-20:00" 3 479 ; want "a minute before opening is closed"    1 $?
  in_window_vals "" "08:00-20:00" 3 480 ; want "the opening minute is open"           0 $?
  in_window_vals "" "08:00-20:00" 3 1200; want "the closing minute is closed"         1 $?
  # A window that wraps midnight is the one people get wrong: 22:00-06:00 must
  # be open at 23:00 AND at 02:00, and shut at midday.
  in_window_vals "" "22:00-06:00" 3 1380; want "a wrapping window is open at 23:00"   0 $?
  in_window_vals "" "22:00-06:00" 3 120 ; want "a wrapping window is open at 02:00"   0 $?
  in_window_vals "" "22:00-06:00" 3 720 ; want "a wrapping window is shut at midday"  1 $?
  in_window_vals "6,7" "22:00-06:00" 7 120; want "day and hour must BOTH match"       0 $?
  in_window_vals "6,7" "22:00-06:00" 1 120; want "the wrong day closes it"            1 $?
  # 08:00 written as 08 must not be read as octal — the classic bash trap.
  in_window_vals "" "08:00-09:00" 3 510 ; want "a leading zero is decimal, not octal" 0 $?

  echo "is_due_vals() — due-ness accounts for the failure backoff"
  is_due_vals 300 "$(( $(now_epoch) - 400 ))" 0 ; want "past its interval is due"     0 $?
  is_due_vals 300 "$(( $(now_epoch) - 100 ))" 0 ; want "inside its interval is not"   1 $?
  is_due_vals 300 "$(( $(now_epoch) - 400 ))" 4 ; want "a backed-off job waits longer" 1 $?
  is_due_vals 300 "$(( $(now_epoch) - 1300 ))" 4; want "and runs once the longer wait passes" 0 $?
  is_due_vals 300 0 0                           ; want "a job that never ran is due"  0 $?

  echo "daily caps — a ceiling can be set per job, per project, and for everything"
  mkdir -p "$tmp/caps"
  printf '%s' '{"jobs":[{"id":"own","project":"P","daily_budget_usd":5},
                        {"id":"inherits","project":"P"},
                        {"id":"loner"}]}' > "$tmp/caps/jobs.json"
  printf '%s' '{"global_daily_budget_usd":100,
                "projects":[{"name":"P","daily_budget_usd":20}]}' > "$tmp/caps/projects.json"
  got="$( JOBS_FILE="$tmp/caps/jobs.json"; PROJECTS_FILE="$tmp/caps/projects.json"; daily_cap_for own )"
  [ "$got" = "5" ] && ok "a job's own cap wins" || bad "own -> '$got'"
  got="$( JOBS_FILE="$tmp/caps/jobs.json"; PROJECTS_FILE="$tmp/caps/projects.json"; daily_cap_for inherits )"
  # This is the gap: daily_budget_usd was read from the job ALONE, so setting it
  # on a project quietly did nothing at all.
  [ "$got" = "20" ] && ok "a job with no cap inherits its project's" || bad "inherits -> '$got'"
  got="$( JOBS_FILE="$tmp/caps/jobs.json"; PROJECTS_FILE="$tmp/caps/projects.json"; daily_cap_for loner )"
  [ -z "$got" ] && ok "no cap anywhere means no cap" || bad "loner -> '$got'"
  got="$( PROJECTS_FILE="$tmp/caps/projects.json"; global_daily_cap )"
  [ "$got" = "100" ] && ok "a global ceiling can be declared" || bad "global -> '$got'"
  got="$( PROJECTS_FILE="$tmp/proj/projects.json"; global_daily_cap )"
  [ -z "$got" ] && ok "and is absent unless declared" || bad "undeclared global -> '$got'"

  echo "spent_today() — today's spend is summed without reading all of history"
  local midnight; midnight="$(date -v0H -v0M -v0S +%s)"
  : > "$tmp/runs.ndjson"
  printf '{"id":"a","start":%s,"cost":1.5}\n' "$(( midnight + 10 ))" >> "$tmp/runs.ndjson"
  printf '{"id":"a","start":%s,"cost":2.25}\n' "$(( midnight + 20 ))" >> "$tmp/runs.ndjson"
  printf '{"id":"b","start":%s,"cost":4}\n'    "$(( midnight + 30 ))" >> "$tmp/runs.ndjson"
  printf '{"id":"a","start":%s,"cost":99}\n'   "$(( midnight - 8000 ))" >> "$tmp/runs.ndjson"
  got="$( RUNS_FILE="$tmp/runs.ndjson"; spent_today a )"
  [ "$got" = "3.750000" ] && ok "one job's spend today is summed" || bad "spent_today a -> '$got'"
  got="$( RUNS_FILE="$tmp/runs.ndjson"; spent_today_all )"
  [ "$got" = "7.750000" ] && ok "every job's spend today is summed" || bad "spent_today_all -> '$got'"
  # A truncated leading line (the scan starts at a byte offset, not a line
  # boundary) must be skipped, never parsed into a bogus cost.
  printf '%s\n' '{"id":"a","start":1,"co' > "$tmp/cut.ndjson"
  cat "$tmp/runs.ndjson" >> "$tmp/cut.ndjson"
  got="$( RUNS_FILE="$tmp/cut.ndjson"; spent_today a )"
  [ "$got" = "3.750000" ] && ok "a truncated first line is ignored" || bad "with a cut line -> '$got'"

  rm -rf "$tmp"
  echo
  echo "$pass passed, $fail failed"
  [ "$fail" -eq 0 ]
}

cmd_running() { # prints "running (N)" + exit 0 if any slot is live, else "idle"
  local n; n="$(slots_active "$1")"
  if [ "$n" -ge 1 ]; then echo "running ($n)"; return 0; fi
  echo "idle"; return 1
}

cmd_runs() { # <id> — one active run per line: <run-pid>\t<agent-pid>\t<logfile>
  local base="$LOCK_DIR/$1" d pid child logf
  [ -d "$base" ] || return 0
  for d in "$base"/*/; do
    [ -d "$d" ] || continue
    pid="$(cat "$d/pid" 2>/dev/null || true)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || { rm -rf "$d"; continue; }
    child="$(cat "$d/child" 2>/dev/null || true)"
    logf="$(cat "$d/logfile" 2>/dev/null || true)"
    printf '%s\t%s\t%s\n' "$pid" "$child" "$logf"
  done
}

# Stop ONE run by its slot. Leaves the watchdog breadcrumb so the run explains
# itself, then TERMs the agent (or clears a dead slot).
_stop_slot() { # <id> <slot-dir>
  local id="$1" slot="$2" child logf
  [ -d "$slot" ] || { echo "no such run for $id"; return 1; }
  logf="$(cat "$slot/logfile" 2>/dev/null || true)"
  [ -n "$logf" ] && printf 'stopped by the user\n' > "$logf.watchdog" 2>/dev/null
  child="$(cat "$slot/child" 2>/dev/null || true)"
  if [ -n "$child" ] && kill -0 "$child" 2>/dev/null; then
    kill -TERM "$child" 2>/dev/null
    echo "stopping $id run $(basename "$slot") (agent pid $child)"
  else
    echo "run $(basename "$slot") of $id not stoppable (no live agent); clearing its slot"
    release_slot "$slot"
  fi
}

cmd_stop() { # <id> [run-pid] — stop ONE run (by its run-pid) or, with no pid, ALL
  local id="$1" rpid="${2:-}" any=0 d
  if [ -n "$rpid" ]; then
    _stop_slot "$id" "$LOCK_DIR/$id/$rpid"
  else
    for d in "$LOCK_DIR/$id"/*/; do [ -d "$d" ] || continue; _stop_slot "$id" "$d"; any=1; done
    [ "$any" -eq 1 ] || echo "no runs in progress for $id"
  fi
}

cmd_precheck() { # <id> — run the job's precheck once and RECORD it, without the agent
  local id="$1" precheck cwd pc_out pc_rc
  precheck="$(jobs_json | "$JQ" -r --arg id "$id" '.jobs[] | select(.id==$id) | .precheck // ""')"
  [ -n "$precheck" ] || { echo "no precheck configured for $id"; return 0; }
  cwd="$(resolve "$id" cwd "$HOME")"
  # A probe reports; it must not claim. See CC_PRECHECK_DRY_RUN in the
  # prechecks: a claim is a write, and spending it here leaves a ticket
  # claimed with no session behind it.
  pc_out="$( cd "$cwd" && export CC_PRECHECK_DRY_RUN=1 && eval "$precheck" 2>&1 )"; pc_rc=$?
  state_set "$id" last_precheck "$("$JQ" -nc --arg o "${pc_out:-(no output)}" --argjson rc "$pc_rc" '{output:$o, exit:$rc}')"
  printf '%s\n(exit %s)\n' "$pc_out" "$pc_rc"
}

cmd_resolve_models() { # refresh the family→id cache (all four families)
  local fam id
  for fam in opus sonnet haiku fable; do
    id="$(resolve_family "$fam")"
    [ -n "$id" ] || id="$fam"
    models_cache_set "$fam" "$id"
    echo "$fam -> $id"
  done
}

run_job() { # run_job <id> [--force] [resume-session-id]
  # A RESUME picks the failed run's own session back up (`claude --resume <sid>`)
  # instead of starting the job afresh: same task, same conversation, continuing
  # where it stopped. It is always forced (the precheck describes the board now,
  # not the work this session was already doing) and it produces a normal run —
  # its own log, stream, timeline and journal record, nothing lost.
  local id="$1" force="${2:-}" resume_sid="${3:-}"
  [ -n "$resume_sid" ] && force="--force"
  local cwd prompt model effort budget timeout stall permission allowed precheck project proj_desc interactive fifo
  local run_cwd worktree run_dir run_env run_cfgdir _envln slot max_par
  project="$(job_get "$id" '.project' '')"
  # Which account this run signs in as. A project pins one when its work belongs
  # to a different Claude login than the scheduler's default — a company account
  # for client work, a personal one for your own repos. It carries far more than
  # billing: the config dir holds that account's settings, plugins, MCP servers
  # AND its past sessions, so it must stay stable for a job or `--resume` below
  # would go looking for the session in the other account's directory.
  run_cfgdir="$(project_get "$project" '.claude_config_dir' '')"
  case "$run_cfgdir" in null) run_cfgdir="" ;; esac
  run_cfgdir="$(expand_home "$run_cfgdir")"
  # cwd, model, permission, budget and timeout inherit from the project when the
  # job doesn't set them (see resolve()).
  cwd="$(resolve "$id" cwd "$HOME")"
  prompt="$(jobs_json | "$JQ" -r --arg id "$id" '.jobs[] | select(.id==$id) | .prompt')"
  model="$(resolve "$id" model 'opus')"
  # A family (opus/sonnet/…) becomes the newest concrete id of that family.
  local model_family=""
  case "$model" in opus|sonnet|haiku|fable) model_family="$model" ;; esac
  model="$(effective_model "$model")"
  # How hard the model thinks: low|medium|high|xhigh|max (empty = the CLI default)
  effort="$(resolve "$id" effort '')"
  case "$effort" in null) effort="" ;; esac
  # Interactive runs keep stdin open so a human can talk to the agent while it
  # works (see the launch block). Opt-in per job: a normal run must keep ending
  # by itself, and holding stdin open changes exactly that.
  interactive="$(resolve "$id" interactive 'false')"
  case "$interactive" in true) ;; *) interactive="false" ;; esac
  # An absent per-run budget means "no cap", the same way an absent daily cap,
  # time limit and stall guard already do -- clearing the field in the editor
  # deletes the key. `resolve` cannot express it (it collapses a missing value
  # onto its default, so a cleared field would silently read as $2), so read the
  # job directly and let empty stay empty. A project may still set a floor.
  budget="$(job_get "$id" '.max_budget_usd' '')"
  if [ -z "$budget" ] || [ "$budget" = "null" ]; then
    budget="$(project_get "$(job_get "$id" '.project' '')" '.max_budget_usd' '')"
    case "$budget" in null) budget="" ;; esac
  fi
  # A long run is NOT a hung run. `stall_timeout_seconds` is the real guard: kill
  # only after the agent has produced NO output for that long. `timeout_seconds`
  # is now an OPTIONAL absolute cap — empty or 0 means "no wall-clock limit", so
  # a legitimately long task (hours) is never killed just for taking its time.
  timeout="$(resolve "$id" timeout_seconds '')"
  stall="$(resolve "$id" stall_timeout_seconds '1200')"
  case "$timeout" in ''|null) timeout=0 ;; esac
  case "$stall" in ''|null) stall=0 ;; esac
  permission="$(resolve "$id" permission_mode 'dontAsk')"
  allowed="$(job_get "$id" '.allowed_tools' '')"
  precheck="$(jobs_json | "$JQ" -r --arg id "$id" '.jobs[] | select(.id==$id) | .precheck // ""')"

  [ -n "$prompt" ] && [ "$prompt" != "null" ] || { log_tick "$id: no prompt, skipped"; return 1; }
  [ -d "$cwd" ] || { log_tick "$id: cwd missing ($cwd), skipped"; return 1; }
  # Refuse rather than let the CLI create the directory and find no credentials
  # in it: that spends a launch to fail at the login prompt, and every later run
  # would fail the same way with nothing saying why.
  [ -z "$run_cfgdir" ] || [ -d "$run_cfgdir" ] || {
    log_tick "$id: claude_config_dir missing ($run_cfgdir), skipped"; return 1; }

  # Prepend the project's description as context, so a run carries the project's
  # purpose without repeating it in every job prompt.
  if [ -n "$project" ] && [ "$project" != "null" ]; then
    proj_desc="$(project_get "$project" '.description' '')"
    if [ -n "$proj_desc" ] && [ "$proj_desc" != "null" ]; then
      prompt="Project: ${project}
${proj_desc}

---

${prompt}"
    fi
  fi

  # How many runs of THIS job may work at once — a job-level setting only, never
  # inherited. Blank or missing means 3; zero means no ceiling at all.
  max_par="$(job_get "$id" '.max_parallel' '3')"
  case "$max_par" in ''|null|*[!0-9]*) max_par=3 ;; esac
  if ! slot="$(acquire_slot "$id" "$max_par")"; then
    log_tick "$id: already at max_parallel=$max_par run(s), not launching another"
    return 0
  fi
  trap 'run_cleanup "'"$id"'" "'"$slot"'"' EXIT

  local forced="false"
  [ "$force" = "--force" ] && forced="true"

  # Daily budget gate: a per-job ceiling on today's spend. Empty = no cap.
  # Scheduled runs only — Run now is a deliberate override, like the precheck.
  if [ "$forced" != "true" ]; then
    local cap spent gcap gspent
    cap="$(daily_cap_for "$id")"
    if [ -n "$cap" ]; then
      spent="$(spent_today "$id")"
      if awk -v s="$spent" -v c="$cap" 'BEGIN{exit !((s+0)>=(c+0))}'; then
        state_set "$id" last_status '"capped"'
        state_set "$id" last_capped "$("$JQ" -nc --arg s "$spent" --arg c "$cap" '{spent:($s|tonumber),cap:($c|tonumber)}')"
        log_tick "$id: daily cap reached (\$$spent / \$$cap) — skipping"
        release_slot "$slot"; trap - EXIT
        return 0
      fi
    fi
    # The fleet-wide ceiling. Every job can sit correctly under its own cap and
    # the day still cost far more than intended — with a job per repo per role,
    # the sum is the number that actually matters.
    gcap="$(global_daily_cap)"
    if [ -n "$gcap" ]; then
      gspent="$(spent_today_all)"
      if awk -v s="$gspent" -v c="$gcap" 'BEGIN{exit !((s+0)>=(c+0))}'; then
        state_set "$id" last_status '"capped"'
        state_set "$id" last_capped "$("$JQ" -nc --arg s "$gspent" --arg c "$gcap" '{spent:($s|tonumber),cap:($c|tonumber),scope:"global"}')"
        log_tick "$id: GLOBAL daily cap reached (\$$gspent / \$$gcap across all jobs) — skipping"
        release_slot "$slot"; trap - EXIT
        return 0
      fi
    fi
  fi

  # Cheap gate: run the precheck, capture what it saw, and only spend a Claude
  # session when it passes (exit 0) — unless this run was forced (Run now).
  local pc_out="" pc_rc=0
  if [ -n "$precheck" ]; then
    # The precheck sees the same account as the run it gates: a probe that asks
    # Claude itself must not answer for one account the session then spends on
    # another, and MCP credentials live per config dir too.
    # A RESUME must never let the precheck claim. The session already has its
    # work, and the continuation prompt below REPLACES this output entirely --
    # so a precheck that takes a ticket would move one out of the queue for a
    # run that is never going to look at it. Same contract as the standalone
    # probes: report, touch nothing.
    pc_out="$( cd "$cwd" && { [ -n "$run_cfgdir" ] && export CLAUDE_CONFIG_DIR="$run_cfgdir"
                              [ -n "$resume_sid" ] && export CC_PRECHECK_DRY_RUN=1
                              eval "$precheck" 2>&1; } )"; pc_rc=$?
    state_set "$id" last_precheck "$("$JQ" -nc --arg o "${pc_out:-(no output)}" --argjson rc "$pc_rc" '{output:$o, exit:$rc}')"
    local pc_verdict; pc_verdict="$(precheck_verdict "$pc_rc")"
    if [ "$forced" != "true" ] && [ "$pc_verdict" != "work" ]; then
      state_set "$id" last_start "$(now_epoch)"
      if [ "$pc_verdict" = "error" ]; then
        # NOT idle: the probe itself failed, so nothing is known about the
        # board. Surfaced as its own status so the card can go red instead of
        # claiming, reassuringly and wrongly, that there was nothing to do.
        state_set "$id" last_status '"precheck_error"'
        # A broken probe repeats every interval just as a failing run does, and
        # costs a shell each time, so it feeds the same backoff.
        state_set "$id" fail_streak "$(( $(num "$(state_get "$id" fail_streak 0)") + 1 ))"
        log_tick "$id: PRECHECK FAILED (exit $pc_rc) — the probe could not run, so no work was looked for"
      else
        state_set "$id" last_status '"idle"'
        log_tick "$id: precheck found nothing to do (exit $pc_rc)"
      fi
      release_slot "$slot"; trap - EXIT
      return 0
    fi
    # Hand the precheck's own words to the agent. The precheck runs per-run, in
    # shell, before the session exists — so it is the only place that can hold a
    # LOCK. A precheck that atomically claims a ticket has to be able to say WHICH
    # one it claimed, and until now its output went only to a sidecar file the
    # agent never reads: two runs then each picked from the same board query and
    # reviewed the same pull request. Passing it here makes the claim reach the
    # only party that can honour it.
    if [ -n "$pc_out" ]; then
      prompt="Your precheck ran before this session started and reported:

${pc_out}

Treat that as fact about right now — it is the harness speaking, not a suggestion.
Where it names the specific work claimed for this run, that is your work: take it
and nothing else.

---

${prompt}"
    fi
  fi

  local start end stamp logfile streamfile precheckfile rc out cost turns session status
  start="$(now_epoch)"
  # PID suffix keeps two same-second runs from clobbering each other's logs.
  stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mkdir -p "$LOG_DIR/$id"
  logfile="$LOG_DIR/$id/$stamp.json"
  streamfile="$LOG_DIR/$id/$stamp.stream.ndjson"
  precheckfile="$LOG_DIR/$id/$stamp.precheck.txt"

  # Isolate this run in its own git worktree, so a peer run (a review while a dev
  # works, say) can never clobber this one's branch in the shared checkout. The
  # agent's cwd becomes the worktree; its env carries the project's declared
  # venv/vars. Generic and gated by projects.json — a non-isolated project just
  # runs in $cwd as before. If isolation is on but setup fails, ABORT rather than
  # silently run in the shared tree (falling back would reintroduce the race).
  run_cwd="$cwd"
  worktree=""
  # The env the agent starts with. It exists whether or not this project is
  # isolated — the account is a property of the project, not of the worktree —
  # and the worktree's own venv/vars are appended to it below when there is one.
  run_env=()
  [ -n "$run_cfgdir" ] && run_env+=("CLAUDE_CONFIG_DIR=$run_cfgdir")
  if wt_isolation_enabled "$project" "$cwd"; then
    # Claim the path BEFORE anything exists there. The sweep removes any run dir
    # no live slot claims, so creating first and claiming after leaves a window
    # in which it can delete the very directory this agent is about to work in.
    # The path is ours to predict, so stake it first.
    run_dir="$WORKTREES_DIR/$id/$stamp"
    echo "$run_dir" > "$slot/worktree"
    if ! worktree="$(wt_setup "$id" "$project" "$cwd" "$stamp")"; then
      state_set "$id" last_start "$start"
      state_set "$id" last_status '"error"'
      log_tick "$id: worktree isolation failed — run aborted (no shared-checkout fallback)"
      run_cleanup "$id" "$slot"; trap - EXIT
      return 1
    fi
    run_cwd="$worktree"
    # What the agent needs to find the OTHER repos of this run, and the canonical
    # checkout of each: the manifest. Everything else it could only guess at.
    run_env+=("CC_RUN_DIR=$run_dir" "CC_RUN_MANIFEST=$run_dir/.run.json" \
              "CC_PROJECT=$project" "CC_JOB_ID=$id" \
              "CC_PRIMARY_REPO=$(basename "$run_cwd")")
    while IFS= read -r _envln; do
      [ -n "$_envln" ] && run_env+=("$_envln")
    done < <(wt_env_line "$project" "$cwd" "$run_cwd")
    log_tick "$id: isolated in $run_dir (cwd $run_cwd)"
  fi

  # Persist what the precheck saw, next to the run log.
  {
    if [ "$forced" = "true" ]; then echo "RUN FORCED (Run now) — precheck not gating this run."; fi
    if [ -n "$precheck" ]; then
      printf 'precheck: %s\nexit: %s%s\n\n--- output ---\n%s\n' \
        "$precheck" "$pc_rc" "$([ "$pc_rc" -eq 0 ] && echo '  (pass → work found)' || echo '  (fail → would be idle)')" "$pc_out"
    else
      echo "(no precheck configured — every due tick runs the agent)"
    fi
  } > "$precheckfile"

  state_set "$id" last_start "$start"
  state_set "$id" last_status '"running"'
  # Publish the log path up front so the dashboard can tail a run while it is
  # still going (the journal record only lands when the run finishes).
  state_set "$id" last_log "$("$JQ" -nc --arg p "$logfile" '$p')"
  echo "$logfile" > "$slot/logfile" 2>/dev/null || true   # per-run breadcrumb for stop
  # This run's own start. The shared state holds only one per job, so when
  # several run at once it is the slot that says when each began — without it
  # the dashboard can only ever show the most recent one.
  echo "$start" > "$slot/start" 2>/dev/null || true
  # A resume is in flight for that session: recorded here so nothing offers to
  # resume it a second time while this one is still working.
  [ -n "$resume_sid" ] && echo "$resume_sid" > "$slot/resume_of" 2>/dev/null || true
  log_tick "$id: starting run ($stamp)"

  # stream-json gives one NDJSON event per message — the per-turn trace the
  # dashboard renders. The final "result" event carries the same summary object
  # the plain json format used to emit; it is extracted into $logfile below so
  # every existing reader keeps working.
  local args
  args="-p --output-format stream-json --verbose --model $model --permission-mode $permission"
  # No flag at all when the budget is cleared: the CLI has no value meaning
  # "unlimited", so the absence of the flag is what expresses it.
  [ -n "$budget" ] && args="$args --max-budget-usd $budget"
  # Resume: continue the failed run's own session rather than starting over.
  [ -n "$resume_sid" ] && args="$args --resume $resume_sid"
  [ -n "$effort" ] && args="$args --effort $effort"
  [ -n "$allowed" ] && [ "$allowed" != "null" ] && args="$args --allowedTools $allowed"

  # On a resume the session already carries the job's instructions and everything
  # it did; re-sending the whole prompt would restart the task instead of
  # continuing it. Send a short continuation instruction instead — and tell it to
  # say so plainly when the work is already done or no longer possible (the card
  # moved, the ticket is gone), so the run ends cleanly rather than inventing work.
  if [ -n "$resume_sid" ]; then
    prompt="Continue exactly where you stopped. This is the same task, resumed after the previous run ended early — re-read your own last messages and carry on from there; do NOT start over.
If the work turns out to be already finished, or it can no longer be done at all (the ticket is gone, the card moved on, another run took it), then do NOT invent new work: stop and answer with one line starting exactly with 'NOTHING TO DO: ' followed by the reason."
  fi

  fifo=""
  if [ "$interactive" = "true" ]; then
    # `--input-format stream-json` accepts further user messages on stdin while
    # the run is going, which is what makes the dashboard's terminal two-way.
    # The prompt is sent as the first message instead of as an argument.
    fifo="$logfile.stdin"
    rm -f "$fifo"; mkfifo "$fifo" 2>/dev/null
    args="$args --input-format stream-json --replay-user-messages"
    (
      cd "$run_cwd" || exit 1
      env ${run_env[@]+"${run_env[@]}"} "$CLAUDE_BIN" $args < "$fifo" > "$streamfile" 2> "$logfile.err"
    ) &
  else
    (
      cd "$run_cwd" || exit 1
      env ${run_env[@]+"${run_env[@]}"} "$CLAUDE_BIN" $args "$prompt" > "$streamfile" 2> "$logfile.err"
    ) &
  fi
  local child=$!

  if [ "$interactive" = "true" ]; then
    exec 9> "$fifo"                       # hold it open: EOF would end the turn loop
    "$JQ" -nc --arg t "$prompt" \
      '{type:"user",message:{role:"user",content:[{type:"text",text:$t}]}}' >&9
    state_set "$id" last_fifo "$("$JQ" -nc --arg p "$fifo" '$p')"
  fi
  # Publish the agent's PID so `claude-cron stop` can end this run cleanly.
  echo "$child" > "$slot/child" 2>/dev/null || true

  # An interactive run does not end on its own: stdin is held open, so after each
  # answer the agent simply waits for more. This ends it once the conversation is
  # over — after a `result` event, give the human a short window to type; any new
  # output (their replayed message, or the agent working again) cancels it.
  if [ "$interactive" = "true" ]; then
    (
      # The decision is a POSITIVE ASSERTION about the transcript's current
      # state — "the conversation is finished and quiet" — never an inference
      # from a counter. turn_is_over() has to say yes twice, INTERACTIVE_GRACE
      # apart, with the file unchanged in between, before anything is killed.
      while kill -0 "$child" 2>/dev/null; do
        sleep 2
        turn_is_over "$streamfile" || continue
        size="$(num "$(wc -c < "$streamfile" 2>/dev/null)")"
        waited=0
        while [ "$waited" -lt "$INTERACTIVE_GRACE" ]; do
          sleep 2
          waited="$(num "$(( waited + 2 ))")"
          kill -0 "$child" 2>/dev/null || exit 0
          [ "$(num "$(wc -c < "$streamfile" 2>/dev/null)")" != "$size" ] && break
        done
        # Re-assert after the wait: anything new, or a transcript that no longer
        # ends on a result, means the agent is working again — leave it alone.
        [ "$(num "$(wc -c < "$streamfile" 2>/dev/null)")" != "$size" ] && continue
        turn_is_over "$streamfile" || continue
        [ "$waited" -ge "$INTERACTIVE_GRACE" ] || continue
        printf 'interactive: conversation idle for %ss after the last answer\n' \
          "$INTERACTIVE_GRACE" > "$logfile.turnend"
        kill -TERM "$child" 2>/dev/null
        exit 0
      done
    ) & local turnloop=$!
  fi

  # Liveness watchdog. It asks "is this run still doing anything?", not "has it
  # taken too long" — the stream file grows with every agent event, so while it
  # grows the agent is alive and we leave it alone however many hours it needs.
  # We kill only when it has been silent for $stall seconds (a genuine hang), or
  # when an explicit absolute cap $timeout is set and exceeded. The reason is
  # written to the watchdog file so the run can explain itself afterwards.
  local wdfile="$logfile.watchdog"
  : > "$wdfile"
  (
    local last_size=-1 last_change now size began poll=30
    began="$(now_epoch)"; last_change="$began"
    while kill -0 "$child" 2>/dev/null; do
      sleep "$poll"
      kill -0 "$child" 2>/dev/null || break
      now="$(now_epoch)"
      size="$(wc -c < "$streamfile" 2>/dev/null | tr -d ' ')"; size="${size:-0}"
      if [ "$size" != "$last_size" ]; then last_size="$size"; last_change="$now"; fi
      if [ "$stall" -gt 0 ] && [ "$((now - last_change))" -ge "$stall" ]; then
        printf 'stalled: no output for %ss (killed by watchdog)\n' "$stall" > "$wdfile"
        kill -TERM "$child" 2>/dev/null; break
      fi
      if [ "$timeout" -gt 0 ] && [ "$((now - began))" -ge "$timeout" ]; then
        printf 'absolute timeout: reached the %ss cap (killed by watchdog)\n' "$timeout" > "$wdfile"
        kill -TERM "$child" 2>/dev/null; break
      fi
    done
  ) & local watchdog=$!
  wait "$child"; rc=$?
  kill "$watchdog" 2>/dev/null; wait "$watchdog" 2>/dev/null
  if [ "$interactive" = "true" ]; then
    kill "${turnloop:-0}" 2>/dev/null; wait "${turnloop:-0}" 2>/dev/null
    exec 9>&- 2>/dev/null || true
    rm -f "$fifo"
    state_set "$id" last_fifo '""'
  fi
  local wdreason=""
  [ -s "$wdfile" ] && wdreason="$(cat "$wdfile")"
  rm -f "$wdfile"

  # Extract the final result event; synthesize an error object if the stream
  # ended without one (crash, timeout kill) so classification still works.
  # Tolerant of a truncated/garbled line anywhere in the stream (see below).
  "$JQ" -n -R '[inputs | fromjson? | select(.type == "result")] | last // empty' "$streamfile" > "$logfile" 2>/dev/null
  if ! "$JQ" -e 'type == "object"' "$logfile" >/dev/null 2>&1; then
    # No result event: the run was killed or crashed. Never leave a blank record —
    # rebuild what we can from the stream (session, turn count, and the agent's
    # last words) so the log always says what happened and how far it got.
    # `-n -R` + `fromjson?` parses line by line and SKIPS malformed ones. This
    # matters: a killed run is usually cut off mid-write, and a plain `jq -s`
    # rejects the whole file over that one truncated last line — which is how a
    # run with 349 turns of real work ended up reported as "no information".
    "$JQ" -n -R --arg reason "${wdreason:-the run ended without a final result event (killed or crashed)}" '
      [inputs | fromjson?] as $ev
      | [$ev[] | .message?.usage? // empty] as $u
      | { is_error: true,
          subtype: "no_result_event",
          session_id: ([$ev[] | select(.type=="system" and .subtype=="init") | .session_id] | first // ""),
          num_turns: ([$ev[] | select(.type=="assistant")] | length),
          stop_reason: $reason,
          # A killed run consumed real tokens even though no cost was reported.
          # Record them, so waste can never masquerade as a free $0.00 run.
          usage: { input_tokens:        ([$u[].input_tokens // 0] | add // 0),
                   cache_read_tokens:   ([$u[].cache_read_input_tokens // 0] | add // 0),
                   cache_write_tokens:  ([$u[].cache_creation_input_tokens // 0] | add // 0),
                   output_tokens:       ([$u[].output_tokens // 0] | add // 0) },
          result: (
            [ $ev[] | select(.type=="assistant") | .message.content[]? | select(.type=="text") | .text ]
            | map(select(length > 0)) | last // ""
            | if . == "" then "" else "**Run did not finish — " + $reason + ".**\n\nThe agent'"'"'s last message before it stopped:\n\n" + . end
          ) }' "$streamfile" > "$logfile" 2>/dev/null
    "$JQ" -e 'type == "object"' "$logfile" >/dev/null 2>&1 \
      || printf '{"is_error":true,"subtype":"no_result_event","result":"","stop_reason":"%s"}\n' "${wdreason:-killed or crashed}" > "$logfile"
  fi

  end="$(now_epoch)"
  cost="$("$JQ" -r '.total_cost_usd // 0' "$logfile" 2>/dev/null || echo 0)"
  turns="$("$JQ" -r '.num_turns // 0' "$logfile" 2>/dev/null || echo 0)"
  session="$("$JQ" -r '.session_id // ""' "$logfile" 2>/dev/null || echo "")"

  # Which model actually ran. `$model` is what the job asked for and is usually an
  # ALIAS ("opus") that resolves to whatever is newest, so record the resolved id
  # too — the stream's system/init event reports it (e.g. claude-opus-4-8).
  # Without this the history cannot answer "which Opus was this run?" later.
  local model_id
  model_id="$("$JQ" -r 'select(.type=="system" and .subtype=="init") | .model' "$streamfile" 2>/dev/null | head -1)"
  [ -n "$model_id" ] && [ "$model_id" != "null" ] || model_id=""

  # Classify the run: error / warning / success.
  #   error   — the process failed, the CLI reported an error, or the agent had
  #             tools denied (a blocked agent silently doing nothing is a failure,
  #             not a success — it must surface loudly);
  #   warning — the run completed but something smells: stderr output, or an
  #             empty agent result;
  #   success — clean run, agent produced a result, nothing denied.
  # An interactive run is ENDED BY US once the conversation goes quiet, so its
  # exit status is a signal, not a failure. Treat that as a clean exit.
  if [ -f "$logfile.turnend" ]; then rc=0; rm -f "$logfile.turnend"; fi
  local denials subtype result_len errbytes
  denials="$("$JQ" -r '.permission_denials // [] | length' "$logfile" 2>/dev/null || echo 0)"
  subtype="$("$JQ" -r '.subtype // "success"' "$logfile" 2>/dev/null || echo success)"
  result_len="$("$JQ" -r '.result // "" | length' "$logfile" 2>/dev/null || echo 0)"
  errbytes="$(wc -c < "$logfile.err" 2>/dev/null | tr -d ' ')"
  if [ "$rc" -ne 0 ] || [ "$subtype" != "success" ] \
     || ! "$JQ" -e '.is_error != true' "$logfile" >/dev/null 2>&1; then
    status="error"
  elif [ "${denials:-0}" -gt 0 ]; then
    status="error"
  elif [ "${errbytes:-0}" -gt 0 ] || [ "${result_len:-0}" -eq 0 ]; then
    status="warning"
  else
    status="success"
  fi

  # "Ran fine, but there was nothing to do" — a resumed task already finished, or
  # its ticket is gone. The agent answers `NOTHING TO DO: <reason>` (see the
  # resume prompt). The run did not FAIL, but calling it a plain success hides
  # that a session was spent doing nothing, so it is a WARNING: worth a look,
  # never a blocker. The reason rides in the run's note, which the dashboard
  # shows behind the "?" beside the status.
  local nothing_line
  nothing_line="$("$JQ" -r '.result // ""' "$logfile" 2>/dev/null | grep -m1 -oE 'NOTHING TO DO:.*' || true)"
  if [ -n "$nothing_line" ] && [ "$status" = "success" ]; then
    wdreason="${nothing_line}"
    status="warning"
  fi

  # "Ran out of money mid-task" looks EXACTLY like "finished the job": the agent
  # sees the budget running down, wraps up cleanly and returns a result, so the
  # subtype is `success` and nothing in the record says the work was cut short.
  # A 75-minute run that stopped at 97% of its cap read as a clean success while
  # its ticket sat unfinished — the one thing the operator needed to know was the
  # one thing not shown. Spending the whole cap is not proof of truncation, but it
  # is the only signal available here, and a warning that is occasionally
  # unnecessary is far cheaper than silence that is occasionally very expensive.
  local cap
  cap="$(job_get "$id" '.max_budget_usd' '')"
  case "$cap" in ''|null|0) cap="" ;; esac
  if [ -n "$cap" ] && [ "$status" = "success" ] \
     && awk "BEGIN{exit !(${cost:-0} >= $cap * 0.9)}" 2>/dev/null; then
    wdreason="BUDGET LIMITED: spent \$${cost:-0} of a \$$cap cap — the agent wrapped up early, so the task may be unfinished. Check the ticket and the branch before assuming it is done; resume this run to continue with its context."
    status="warning"
  fi

  # Consecutive failures drive the backoff (see backoff_multiplier). A warning
  # is NOT a failure: the run worked, it just wants a look — slowing those down
  # would throttle the very jobs that are doing their job.
  local streak_next=0
  [ "$status" = "error" ] && streak_next="$(( $(num "$(state_get "$id" fail_streak 0)") + 1 ))"

  # One write for the whole outcome. Seven separate ones meant seven turns of
  # the state lock, which every concurrent run had to queue behind.
  state_set_many "$id" "$("$JQ" -nc \
    --argjson end "$end" --arg status "$status" --argjson start "$start" \
    --arg cost "${cost:-0}" --arg session "$session" \
    --argjson streak "$streak_next" \
    '{last_end:$end, last_status:$status, last_run_start:$start,
      last_run_status:$status,
      # the CLI reports cost as a decimal string; tonumber? keeps a malformed
      # one from making the whole state write fail
      last_cost:($cost|tonumber? // 0),
      last_session:$session, fail_streak:$streak}')"
  # Record what was CHOSEN (the family, when one was) plus what actually ran.
  record_run "$id" "$status" "$start" "$end" "${cost:-0}" "${turns:-0}" "$session" "$logfile" "$wdreason" "$forced" "$pc_out" "$project" "${model_family:-$model}" "$model_id" "$resume_sid"
  log_tick "$id: finished status=$status rc=$rc denials=${denials:-0} cost=\$$cost turns=$turns model=$model${model_id:+ ($model_id)} forced=$forced${wdreason:+ — $wdreason}"

  run_cleanup "$id" "$slot"; trap - EXIT
  [ "$status" != "error" ]
}

# ---------------------------------------------------------------------- tick

# Everything the tick needs to decide about every enabled job, in ONE jq pass
# over both files: id, window, interval, last start, failure streak, ceiling.
#
# The loop used to ask job_get/state_get per field per job, and each of those
# cats and re-parses the whole jobs file — about seven jq processes per job, so
# roughly 150 forks a minute at 21 jobs, for ever, almost always to conclude
# that nothing is due. Disabled jobs are filtered here rather than in the loop:
# `// true` would be wrong (it treats false as absent), hence the explicit test.
tick_plan() { # id \t days \t hours \t interval \t last_start \t fail_streak \t max_parallel
  [ -f "$JOBS_FILE" ] || return 0
  "$JQ" -e . "$JOBS_FILE" >/dev/null 2>&1 || { log_tick "tick: malformed $JOBS_FILE — no job examined"; return 0; }
  "$JQ" -r --slurpfile st "$STATE_FILE" '
    (($st[0]) // {}) as $S
    | .jobs[]
    | select(.enabled != false)
    | . as $j | ($S[$j.id] // {}) as $s
    | [ $j.id,
        (($j.active_days // []) | map(tostring) | join(",")),
        ($j.active_hours // ""),
        (($j.interval_seconds // 300) | tostring),
        (($s.last_start // 0) | tostring),
        (($s.fail_streak // 0) | tostring),
        (($j.max_parallel // 3) | tostring) ] | @tsv' "$JOBS_FILE" 2>/dev/null
}

# The tick only DECIDES and LAUNCHES — it never waits for a run. Each due job is
# handed to a detached `_exec` process that carries out the precheck + Claude run
# on its own, so a 90-minute run never blocks the other jobs' ticks. A run still
# holding its lock is not relaunched.
cmd_tick() {
  local id
  # Cap the two append-only logs before anything else writes to them. Once a
  # minute is the right cadence: the tick is the only thing guaranteed to run,
  # and doing it per log line would cost a wc(1) per line instead of two a tick.
  log_rotate "$TICK_LOG"
  log_rotate "$DATA_DIR/exec.log"
  # Reap worktrees left by runs that died without cleaning up (safe teardown:
  # anything with unpushed/uncommitted work is kept, not deleted).
  wt_prune_orphans
  # Keep the family→model resolutions fresh (about once a day). It rides on the
  # tick this package already installs — deliberately NOT a second launchd job or
  # a crontab entry, so nothing lives outside the project folder and the whole
  # thing still works when the package is handed to someone else. Detached, so a
  # ~1min probing pass never delays the jobs.
  if models_stale && ! lock_active "_models"; then
    nohup /bin/bash "$SELF" _resolve_models </dev/null >> "$DATA_DIR/exec.log" 2>&1 &
    log_tick "models: refreshing family→id resolutions (cache older than ${MODELS_TTL}s)"
  fi
  local days hours interval last streak max_par
  while IFS="$(printf '\t')" read -r id days hours interval last streak max_par; do
    [ -n "$id" ] || continue
    in_window_vals "$days" "$hours" >/dev/null || continue
    is_due_vals "$interval" "$last" "$streak" || continue
    case "$max_par" in ''|null|*[!0-9]*) max_par=3 ;; esac
    if [ "$max_par" -gt 0 ] && [ "$(slots_active "$id")" -ge "$max_par" ]; then
      log_tick "$id: at max_parallel=$max_par run(s), not launching another"
      continue
    fi
    nohup /bin/bash "$SELF" _exec "$id" </dev/null >> "$DATA_DIR/exec.log" 2>&1 &
    log_tick "$id: launched detached run"
  done < <(tick_plan)
}

# ------------------------------------------------------------------ commands

PLIST_PATH_ENV="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

cmd_install() {
  # A global default account, carried into launchd — which inherits nothing from
  # the shell, so without this every run signs in as ~/.claude however the
  # scheduler was installed. Taken ONLY from the explicit variable, never from an
  # ambient CLAUDE_CONFIG_DIR: installing from inside a Claude session would
  # otherwise silently pin that session's account for every job, forever.
  local plist_cfgdir=""
  if [ -n "${CLAUDE_CRON_CLAUDE_CONFIG_DIR:-}" ]; then
    plist_cfgdir="
    <key>CLAUDE_CONFIG_DIR</key><string>$(expand_home "$CLAUDE_CRON_CLAUDE_CONFIG_DIR")</string>"
  elif [ -f "$PLIST_PATH" ]; then
    # Re-running the installer must not quietly drop an account pinned earlier.
    plist_cfgdir="$("$PYTHON" - "$PLIST_PATH" <<'PY'
import plistlib, sys
try:
    v = plistlib.load(open(sys.argv[1], "rb")).get("EnvironmentVariables", {}).get("CLAUDE_CONFIG_DIR")
except Exception:
    v = None
if v:
    print("\n    <key>CLAUDE_CONFIG_DIR</key><string>%s</string>" % v, end="")
PY
)"
  fi

  # 1) the tick agent — fires the scheduler once a minute
  cat > "$PLIST_PATH" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$PLIST_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$SELF</string>
    <string>tick</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <!-- The tick detaches per-job runners and exits; without this, launchd would
       reap the whole process group and kill the runs when the tick returns. -->
  <key>AbandonProcessGroup</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$PLIST_PATH_ENV</string>
    <key>HOME</key><string>$HOME</string>$plist_cfgdir
  </dict>
  <key>StandardOutPath</key><string>$DATA_DIR/launchd.out.log</string>
  <key>StandardErrorPath</key><string>$DATA_DIR/launchd.err.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
PLIST
  # 2) the control server — keeps the interactive dashboard alive on 127.0.0.1
  cat > "$SERVER_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$SERVER_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$PYTHON</string>
    <string>$SERVER_BIN</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$PLIST_PATH_ENV</string>
    <key>HOME</key><string>$HOME</string>
    <key>CLAUDE_CRON_PORT</key><string>$PORT</string>$plist_cfgdir
  </dict>
  <key>StandardOutPath</key><string>$DATA_DIR/server.log</string>
  <key>StandardErrorPath</key><string>$DATA_DIR/server.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
PLIST
  launchctl unload "$PLIST_PATH" 2>/dev/null
  launchctl load "$PLIST_PATH" 2>/dev/null || die "launchctl load failed for $PLIST_PATH"
  launchctl unload "$SERVER_PLIST" 2>/dev/null
  launchctl load "$SERVER_PLIST" 2>/dev/null || die "launchctl load failed for $SERVER_PLIST"
  echo "Installed and loaded:"
  echo "  $PLIST_LABEL   — ticks every 60s (survives logout and reboot)"
  echo "  $SERVER_LABEL  — control dashboard on http://127.0.0.1:$PORT/"
  if [ -n "$plist_cfgdir" ]; then
    echo "Claude account : ${plist_cfgdir##*<string>}" | sed 's|</string>||'
  else
    echo "Claude account : the CLI default (~/.claude) — set CLAUDE_CRON_CLAUDE_CONFIG_DIR and re-run to change it"
  fi
  echo "Open it with: claude-cron dashboard"
}

cmd_uninstall() {
  launchctl unload "$PLIST_PATH" 2>/dev/null
  launchctl unload "$SERVER_PLIST" 2>/dev/null
  rm -f "$PLIST_PATH" "$SERVER_PLIST"
  echo "Unloaded and removed both agents. Jobs, state and logs were kept."
}

cmd_status() {
  local loaded="not loaded"
  launchctl list 2>/dev/null | grep -q "$PLIST_LABEL" && loaded="loaded"
  echo "launchd   : $PLIST_LABEL — $loaded"
  echo "plist     : $PLIST_PATH"
  echo "jobs file : $JOBS_FILE"
  echo "data      : $DATA_DIR"
  echo
  printf '%-20s %-8s %-9s %-11s %-9s %s\n' JOB ENABLED EVERY LAST STATUS COST
  # One jq over both files, for the same reason the tick does it (see
  # tick_plan): five per job meant a hundred processes just to print a table.
  local id en iv ls st lc ago now
  now="$(now_epoch)"
  while IFS="$(printf '\t')" read -r id en iv ls st lc; do
    [ -n "$id" ] || continue
    if [ "$(num "$ls")" -gt 0 ]; then ago="$(( ( now - ls ) / 60 ))m ago"; else ago="never"; fi
    printf '%-20s %-8s %-9s %-11s %-9s $%s\n' "$id" "$en" "$(( $(num "$iv" 300) / 60 ))m" "$ago" "$st" "$lc"
  done < <("$JQ" -r --slurpfile st "$STATE_FILE" '
      (($st[0]) // {}) as $S
      | .jobs[] | . as $j | ($S[$j.id] // {}) as $s
      | [ $j.id,
          (if $j.enabled == false then "false" else "true" end),
          (($j.interval_seconds // 300) | tostring),
          (($s.last_start // 0) | tostring),
          (($s.last_status // "—") | tostring),
          (($s.last_cost // 0) | tostring) ] | @tsv' "$JOBS_FILE" 2>/dev/null)
  echo
  echo "Dashboard : http://127.0.0.1:$PORT/   (claude-cron dashboard)"
}

cmd_dashboard() {
  ensure_server || die "Control server did not answer on port $PORT — check $DATA_DIR/server.log"
  echo "http://127.0.0.1:$PORT/"
  open "http://127.0.0.1:$PORT/" 2>/dev/null
}

cmd_logs() {
  local id="${1:-}" n="${2:-1}"
  [ -n "$id" ] || die "usage: claude-cron logs <job-id> [n]"
  local f
  f="$(ls -t "$LOG_DIR/$id"/*.json 2>/dev/null | head -"$n" | tail -1)"
  if [ -z "$f" ]; then
    die "no log files on disk for $id — finished runs are absorbed into data/index.db; open the dashboard (claude-cron dashboard) and use the log button on the run row"
  fi
  echo "── $f"
  "$JQ" -r '.result // .' "$f" 2>/dev/null || cat "$f"
}

job_exists() { jobs_json | "$JQ" -e --arg id "$1" 'any(.jobs[]; .id == $id)' >/dev/null 2>&1; }

# Tell the dashboard its index is stale after we REWRITE history (a rename
# rewrites lines anywhere in the journal). Its own change detection hashes only
# the head of the file, so an edit further down would otherwise go unnoticed and
# the index would keep serving the old values. The server clears this flag when
# it re-ingests.
journal_rewritten() { : > "$DATA_DIR/.reingest" 2>/dev/null || true; }

write_jobs() { # write_jobs <jq-filter> [jq-args...]
  # Never replace the jobs file with a broken document: a filter that errors, or
  # that yields anything other than an object carrying .jobs, is discarded. One
  # bad write here would take every job down with it.
  local tmp; tmp="$(mktemp "$CONFIG_DIR/.jobs.XXXXXX")"
  if "$JQ" "$@" "$JOBS_FILE" > "$tmp" 2>/dev/null \
     && "$JQ" -e 'type == "object" and (.jobs | type) == "array"' "$tmp" >/dev/null 2>&1; then
    mv "$tmp" "$JOBS_FILE"
  else
    rm -f "$tmp"; die "refusing to write a malformed jobs file (change discarded)"
  fi
}

cmd_toggle() {
  local id="$1" val="$2"
  job_exists "$id" || die "no such job: $id"
  write_jobs --arg id "$id" --argjson v "$val" \
    '.jobs = [.jobs[] | if .id == $id then .enabled = $v else . end]'
  echo "$id enabled=$val"
}

# The one filter that flips `enabled` on a named set of jobs. It lives in a
# constant so selftest exercises the exact string the command runs: a second copy
# in the test would drift, and the property being proved is precisely that jobs
# outside the set come out untouched.
TOGGLE_MANY_FILTER='.jobs = [.jobs[] | if (.id | IN($want[])) then .enabled = $v else . end]'

cmd_toggle_many() { # cmd_toggle_many <true|false> — ids on stdin (JSON array or one per line)
  # Flips a WHOLE SET in one write. A loop of cmd_toggle calls would rewrite
  # jobs.json once per job, so a failure halfway leaves the set half applied,
  # and a reader could catch the file between two of those writes. One atomic
  # write (one mv) rules both out: no half-applied batch, no torn read of the
  # file. It does NOT make a concurrent tick see one consistent snapshot for
  # the whole run — cmd_tick re-reads jobs.json per job, so a batch landing
  # mid-loop is still old for jobs already visited and new for the rest.
  local val="$1" raw ids missing n
  raw="$(cat)"
  [ -n "$raw" ] || die "toggle-many: no ids given"
  # Same input contract as reorder. NOTE: `try … catch` hands the ERROR to the
  # catch branch, not the input, so use `fromjson?` + `//` instead — with catch,
  # a plain list would be parsed out of jq's own error message.
  ids="$(printf '%s' "$raw" | "$JQ" -c -R -s '. as $t | ($t | fromjson?) // ($t | split("\n") | map(select(length > 0)))')"
  printf '%s' "$ids" | "$JQ" -e 'type == "array" and length > 0 and all(.[]; type == "string")' >/dev/null 2>&1 \
    || die "toggle-many: expected a non-empty list of job ids"
  # Resolve every id BEFORE writing: one unknown id refuses the whole batch,
  # rather than applying the part that happened to match.
  missing="$(jobs_json | "$JQ" -r --argjson want "$ids" '. as $doc | ($doc.jobs | map(.id)) as $have | [$want[] | . as $w | select(($have | index($w)) == null)] | join(", ")')"
  [ -n "$missing" ] && die "toggle-many: unknown job(s): $missing"
  write_jobs --argjson want "$ids" --argjson v "$val" "$TOGGLE_MANY_FILTER"
  n="$(printf '%s' "$ids" | "$JQ" -r 'length')"
  if [ "$n" = 1 ]; then echo "1 job enabled=$val"; else echo "$n jobs enabled=$val"; fi
}

cmd_rename() { # cmd_rename <old-id> <new-id> — id + everything keyed by it
  local old="$1" new="$2" tmp path newpath
  job_exists "$old" || die "no such job: $old"
  # Validate the NEW id exactly as creation does, so a rename can never produce
  # an id that `create` would have refused.
  case "$new" in *[!a-zA-Z0-9_-]*|'') die "rename: id must contain only letters, digits, - and _" ;; esac
  [ "$old" = "$new" ] && { echo "unchanged: $old"; return 0; }
  job_exists "$new" && die "rename: a job named '$new' already exists"
  # A live run holds a slot dir, a worktree and a logfile under the OLD id; let
  # it finish rather than renaming the ground out from under it.
  [ "$(slots_active "$old")" -gt 0 ] && die "rename: $old has a run in progress — stop it or wait for it to finish"

  # The job itself, and its precheck command if it points at the per-job script.
  path="$(precheck_path "$old")"; newpath="$(precheck_path "$new")"
  if [ -f "$path" ] && [ ! -e "$newpath" ]; then
    mv "$path" "$newpath"
    write_jobs --arg o "$old" --arg n "$new" --arg np "bash $newpath" \
      '.jobs = [.jobs[] | if .id == $o then (.id = $n | .precheck = $np) else . end]'
  else
    write_jobs --arg o "$old" --arg n "$new" '.jobs = [.jobs[] | if .id == $o then (.id = $n) else . end]'
  fi

  # Everything else keyed by the id: state, logs, journal. The dashboard's DB
  # re-ingests on its own — it resyncs whenever runs.ndjson's signature changes.
  tmp="$(mktemp "$DATA_DIR/.state.XXXXXX")"
  "$JQ" --arg o "$old" --arg n "$new" \
    'if has($o) then (.[$n] = .[$o] | del(.[$o])) else . end' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
  [ -d "$LOG_DIR/$old" ] && [ ! -e "$LOG_DIR/$new" ] && mv "$LOG_DIR/$old" "$LOG_DIR/$new"
  if [ -s "$RUNS_FILE" ]; then
    tmp="$(mktemp "$DATA_DIR/.runs.XXXXXX")"
    # Under the journal lock: a run ending mid-rewrite would otherwise append to
    # the file this replaces, and its record would be lost.
    journal_lock
    "$JQ" -c --arg o "$old" --arg n "$new" \
      'if .id == $o then (.id = $n | .log = ((.log // "") | sub("/logs/" + $o + "/"; "/logs/" + $n + "/"))) else . end' \
      "$RUNS_FILE" > "$tmp" && mv "$tmp" "$RUNS_FILE"
    journal_unlock
    journal_rewritten
  fi
  rm -rf "$LOCK_DIR/$old"
  [ -d "$WORKTREES_DIR/$old" ] && rmdir "$WORKTREES_DIR/$old" 2>/dev/null
  echo "renamed $old -> $new"
}

cmd_reorder() { # new order of ids on stdin (one per line, or a JSON array)
  # Reorders ONLY the jobs named, into the positions those jobs already occupy —
  # so reordering inside one project group never disturbs the others.
  local ids raw
  raw="$(cat)"
  [ -n "$raw" ] || die "reorder: no ids given"
  # Accept a JSON array or one id per line. NOTE: `try … catch` hands the ERROR
  # to the catch branch, not the input, so use `fromjson?` + `//` instead — with
  # catch, a plain list would be parsed out of jq's own error message.
  ids="$(printf '%s' "$raw" | "$JQ" -c -R -s '. as $t | ($t | fromjson?) // ($t | split("\n") | map(select(length > 0)))')"
  printf '%s' "$ids" | "$JQ" -e 'type == "array" and length > 0 and all(.[]; type == "string")' >/dev/null 2>&1 \
    || die "reorder: expected a non-empty list of job ids"
  local missing
  # `. as $doc` first: inside `$want[]` the dot is the id, not the document.
  missing="$(jobs_json | "$JQ" -r --argjson want "$ids" '. as $doc | ($doc.jobs | map(.id)) as $have | [$want[] | . as $w | select(($have | index($w)) == null)] | join(", ")')"
  [ -n "$missing" ] && die "reorder: unknown job(s): $missing"
  write_jobs --argjson want "$ids" '
    . as $doc
    # The positions the named jobs already occupy, in file order. Rewriting only
    # those slots keeps every other job exactly where it was.
    | [range(0; ($doc.jobs | length)) as $i | select(($want | index($doc.jobs[$i].id)) != null) | $i] as $slots
    | reduce range(0; ($slots | length)) as $k ($doc;
        .jobs[$slots[$k]] = ($doc.jobs[] | select(.id == $want[$k])))'
  echo "reordered: $(printf '%s' "$ids" | "$JQ" -r 'join(" -> ")')"
}

cmd_delete() {
  local id="$1" tmp
  job_exists "$id" || die "no such job: $id"
  write_jobs --arg id "$id" '.jobs = [.jobs[] | select(.id != $id)]'
  tmp="$(mktemp "$DATA_DIR/.state.XXXXXX")"
  "$JQ" --arg id "$id" 'del(.[$id])' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
  rm -rf "$LOCK_DIR/$id"
  echo "deleted $id"
}

cmd_set_prompt() { # reads the new prompt from stdin
  local id="$1" prompt
  job_exists "$id" || die "no such job: $id"
  prompt="$(cat)"
  [ -n "$prompt" ] || die "empty prompt"
  write_jobs --arg id "$id" --arg p "$prompt" \
    '.jobs = [.jobs[] | if .id == $id then .prompt = $p else . end]'
  echo "prompt updated for $id"
}

cmd_set_field() { # cmd_set_field <id> <field> ; value on stdin
  local id="$1" field="$2" value
  job_exists "$id" || die "no such job: $id"
  value="$(cat)"
  case "$field" in
    interval_seconds)
      case "$value" in ''|*[!0-9]*) die "$field must be a positive integer" ;; esac
      [ "$value" -lt 60 ] && value=60
      write_jobs --arg id "$id" --argjson v "$value" \
        '.jobs = [.jobs[] | if .id == $id then .interval_seconds = $v else . end]' ;;
    interactive)
      case "$value" in
        true|false) write_jobs --arg id "$id" --argjson v "$value" \
            '.jobs = [.jobs[] | if .id == $id then .interactive = $v else . end]' ;;
        "") write_jobs --arg id "$id" '.jobs = [.jobs[] | if .id == $id then del(.interactive) else . end]' ;;
        *) die "interactive must be true or false" ;;
      esac ;;
    max_parallel)
      # How many runs of this job may work at once. Empty clears it (the engine
      # then uses its default of 3); 0 is a value in its own right — no ceiling.
      if [ -z "$value" ]; then
        write_jobs --arg id "$id" '.jobs = [.jobs[] | if .id == $id then del(.max_parallel) else . end]'
      else
        case "$value" in *[!0-9]*) die "max_parallel must be a whole number (0 = no limit)" ;; esac
        write_jobs --arg id "$id" --argjson v "$value" \
          '.jobs = [.jobs[] | if .id == $id then .max_parallel = $v else . end]'
      fi ;;
    effort)
      # empty clears it (the CLI then uses its own default)
      case "$value" in
        "") write_jobs --arg id "$id" '.jobs = [.jobs[] | if .id == $id then del(.effort) else . end]' ;;
        low|medium|high|xhigh|max)
          write_jobs --arg id "$id" --arg v "$value" \
            '.jobs = [.jobs[] | if .id == $id then .effort = $v else . end]' ;;
        *) die "effort must be one of: low, medium, high, xhigh, max (or empty)" ;;
      esac ;;
    timeout_seconds|stall_timeout_seconds)
      # Both are optional: empty clears them (no absolute cap / no stall guard).
      if [ -z "$value" ]; then
        write_jobs --arg id "$id" --arg f "$field" \
          '.jobs = [.jobs[] | if .id == $id then del(.[$f]) else . end]'
      else
        case "$value" in *[!0-9]*) die "$field must be a positive integer or empty" ;; esac
        write_jobs --arg id "$id" --arg f "$field" --argjson v "$value" \
          '.jobs = [.jobs[] | if .id == $id then .[$f] = $v else . end]'
      fi ;;
    max_budget_usd)
      if [ -z "$value" ]; then   # empty clears the cap: the run may spend what the task needs
        write_jobs --arg id "$id" \
          '.jobs = [.jobs[] | if .id == $id then del(.max_budget_usd) else . end]'
      else
        "$JQ" -n --arg v "$value" '$v|tonumber' >/dev/null 2>&1 || die "$field must be a number or empty"
        write_jobs --arg id "$id" --argjson v "$value" \
          '.jobs = [.jobs[] | if .id == $id then .max_budget_usd = $v else . end]'
      fi ;;
    daily_budget_usd)
      if [ -z "$value" ]; then   # empty clears the cap (no daily ceiling)
        write_jobs --arg id "$id" \
          '.jobs = [.jobs[] | if .id == $id then del(.daily_budget_usd) else . end]'
      else
        "$JQ" -n --arg v "$value" '$v|tonumber' >/dev/null 2>&1 || die "$field must be a number or empty"
        write_jobs --arg id "$id" --argjson v "$value" \
          '.jobs = [.jobs[] | if .id == $id then .daily_budget_usd = $v else . end]'
      fi ;;
    model|active_hours|description|cwd)
      write_jobs --arg id "$id" --arg f "$field" --arg v "$value" \
        '.jobs = [.jobs[] | if .id == $id then .[$f] = $v else . end]' ;;
    project)
      if [ -z "$value" ]; then   # empty clears the project (job becomes ungrouped)
        write_jobs --arg id "$id" '.jobs = [.jobs[] | if .id == $id then del(.project) else . end]'
      else
        write_jobs --arg id "$id" --arg v "$value" \
          '.jobs = [.jobs[] | if .id == $id then .project = $v else . end]'
      fi ;;
    permission_mode)
      case "$value" in
        acceptEdits|auto|bypassPermissions|manual|dontAsk|plan) : ;;
        *) die "invalid permission_mode: $value" ;;
      esac
      write_jobs --arg id "$id" --arg v "$value" \
        '.jobs = [.jobs[] | if .id == $id then .permission_mode = $v else . end]' ;;
    active_days)
      local arr
      arr="$("$JQ" -cn --arg v "$value" '$v|split(",")|map(select(length>0)|tonumber)' 2>/dev/null)" \
        || die "active_days must be comma-separated numbers 1..7"
      write_jobs --arg id "$id" --argjson v "$arr" \
        '.jobs = [.jobs[] | if .id == $id then .active_days = $v else . end]' ;;
    *) die "unknown field: $field" ;;
  esac
  echo "$field updated for $id"
}

precheck_path() { echo "$CONFIG_DIR/prechecks/$1.sh"; }

PRECHECK_SKELETON='#!/bin/bash
# Precheck for job "%s".
# Exit 0 to wake a Claude run; exit 1 to stay idle (a skipped tick costs nothing).
# Put a cheap check here — curl an API, grep a log, test a file — and end with a
# test whose exit status is the decision. Example:
#
#   count=$(curl -sf https://api.example.com/queue | /usr/bin/jq -r ".pending")
#   [ "${count:-0}" -gt 0 ]
exit 0
'

cmd_set_precheck() { # reads the precheck script from stdin
  local id="$1" script path
  job_exists "$id" || die "no such job: $id"
  script="$(cat)"
  [ -n "$script" ] || die "empty precheck script"
  mkdir -p "$CONFIG_DIR/prechecks"
  path="$(precheck_path "$id")"
  printf '%s\n' "$script" > "$path"
  chmod +x "$path"
  write_jobs --arg id "$id" --arg cmd "bash $path" \
    '.jobs = [.jobs[] | if .id == $id then .precheck = $cmd else . end]'
  echo "precheck updated for $id ($path)"
}

cmd_get_precheck() {
  local path; path="$(precheck_path "$1")"
  [ -f "$path" ] && cat "$path" || true
}

# The worktree provisioning hooks, kept the same way prechecks are: a script on
# disk, named after what owns it, with the CLI as the only writer.
provision_path() { printf '%s/provision/%s.%s.sh\n' "$CONFIG_DIR" "$1" "$2"; }

cmd_provision_set() { # <project> <up|down> — the script arrives on stdin
  local project="$1" phase="$2" script path
  projects_json | "$JQ" -e --arg n "$project" 'any(.projects[]; .name==$n)' >/dev/null 2>&1 \
    || die "no such project: $project"
  case "$phase" in up|down) ;; *) die "phase must be up or down" ;; esac
  script="$(cat)"
  path="$(provision_path "$project" "$phase")"
  # An empty script means "no hook": remove the file rather than leave one that
  # runs nothing, so the engine's `[ -f ]` check stays the whole truth.
  if [ -z "$script" ]; then
    rm -f "$path"
    echo "provision $phase cleared for $project"
    return 0
  fi
  mkdir -p "$CONFIG_DIR/provision"
  printf '%s\n' "$script" > "$path"
  chmod +x "$path"
  echo "provision $phase updated for $project ($path)"
}

cmd_provision_get() { # <project> <up|down>
  local path; path="$(provision_path "$1" "$2")"
  [ -f "$path" ] && cat "$path" || true
}

cmd_create() { # reads a partial job object (JSON) from stdin
  local partial id path defaults merged
  partial="$(cat)"
  echo "$partial" | "$JQ" -e 'type == "object"' >/dev/null 2>&1 || die "create: stdin must be a JSON object"
  id="$(echo "$partial" | "$JQ" -r '.id // ""')"
  [ -n "$id" ] || die "create: missing .id"
  case "$id" in *[!a-zA-Z0-9_-]*|'') die "create: id must contain only letters, digits, - and _" ;; esac
  job_exists "$id" && die "create: a job named '$id' already exists"
  path="$(precheck_path "$id")"
  # cwd is intentionally NOT defaulted here: an unset cwd inherits from the
  # job's project (resolve()); it only falls back to $HOME at run time when the
  # job has no project either.
  defaults="$("$JQ" -n --arg id "$id" --arg pc "bash $path" '{
    id: $id, description: "", enabled: true,
    interval_seconds: 300, active_days: [1,2,3,4,5], active_hours: "08:00-20:00",
    precheck: $pc, model: "opus", max_budget_usd: 2, stall_timeout_seconds: 1200,
    permission_mode: "dontAsk", prompt: ""
  }')"
  merged="$(printf '%s\n%s\n' "$defaults" "$partial" | "$JQ" -s '.[0] * .[1]')"
  write_jobs --argjson j "$merged" '.jobs += [$j]'
  if [ ! -f "$path" ]; then
    mkdir -p "$CONFIG_DIR/prechecks"
    # shellcheck disable=SC2059
    printf "$PRECHECK_SKELETON" "$id" > "$path"
    chmod +x "$path"
  fi
  echo "created $id (precheck: $path)"
}

cmd_project_set() { # reads a partial project object (JSON) from stdin; merges by name
  local partial name
  partial="$(cat)"
  echo "$partial" | "$JQ" -e 'type == "object"' >/dev/null 2>&1 || die "project-set: stdin must be a JSON object"
  name="$(echo "$partial" | "$JQ" -r '.name // ""')"
  [ -n "$name" ] || die "project-set: missing .name"
  if projects_json | "$JQ" -e --arg n "$name" 'any(.projects[]; .name==$n)' >/dev/null 2>&1; then
    write_projects --arg n "$name" --argjson p "$partial" \
      '.projects = [.projects[] | if .name==$n then (. * $p) else . end]'
  else
    write_projects --argjson p "$partial" '.projects += [$p]'
  fi
  echo "project '$name' saved"
}

cmd_project_rename() { # <old-name> <new-name> — the project and every job pointing at it
  local old="$1" new="$2"
  projects_json | "$JQ" -e --arg n "$old" 'any(.projects[]; .name==$n)' >/dev/null 2>&1 \
    || die "project-rename: no such project: $old"
  [ -n "$new" ] || die "project-rename: the new name cannot be empty"
  [ "$old" = "$new" ] && { echo "unchanged: $old"; return 0; }
  # A project name is its identity — two projects sharing one would make every
  # lookup (cwd, description, worktree config) ambiguous.
  projects_json | "$JQ" -e --arg n "$new" 'any(.projects[]; .name==$n)' >/dev/null 2>&1 \
    && die "project-rename: a project named '$new' already exists"
  write_projects --arg o "$old" --arg n "$new" \
    '.projects = [.projects[] | if .name==$o then (.name = $n) else . end]'
  # Jobs reference the project BY NAME, so they must follow it or they would
  # silently stop inheriting cwd/model/worktree settings.
  write_jobs --arg o "$old" --arg n "$new" \
    '.jobs = [.jobs[] | if .project==$o then (.project = $n) else . end]'
  # Every past run recorded the project name it ran under, so the history must
  # follow too — otherwise the runs table keeps showing the old name forever.
  # The dashboard's DB re-ingests on its own once the journal's signature changes.
  if [ -s "$RUNS_FILE" ]; then
    local tmp; tmp="$(mktemp "$DATA_DIR/.runs.XXXXXX")"
    journal_lock
    if "$JQ" -c --arg o "$old" --arg n "$new" \
         'if .project == $o then (.project = $n) else . end' "$RUNS_FILE" > "$tmp" 2>/dev/null; then
      mv "$tmp" "$RUNS_FILE"
      journal_unlock
      journal_rewritten
    else
      rm -f "$tmp"
      journal_unlock
    fi
  fi
  echo "project '$old' renamed to '$new'"
}

cmd_project_delete() { # <name> — the project is removed; jobs keep .project (just stop inheriting)
  local name="$1"
  write_projects --arg n "$name" '.projects = [.projects[] | select(.name != $n)]'
  echo "project '$name' deleted"
}

cmd_project_list() {
  projects_json | "$JQ" -r '.projects[] | "  \(.name)  ·  cwd=\(.cwd // "—")  ·  \(.description // "" | .[0:60])"'
}

# Ensure the control server is up; start it detached if nothing answers /health.
ensure_server() {
  curl -s -o /dev/null "http://127.0.0.1:$PORT/health" 2>/dev/null && return 0
  CLAUDE_CRON_PORT="$PORT" nohup "$PYTHON" "$SERVER_BIN" >> "$DATA_DIR/server.log" 2>&1 &
  local i=0
  while [ "$i" -lt 20 ]; do
    curl -s -o /dev/null "http://127.0.0.1:$PORT/health" 2>/dev/null && return 0
    i=$(( i + 1 )); sleep 0.25
  done
  return 1
}

cmd_serve() { CLAUDE_CRON_PORT="$PORT" exec "$PYTHON" "$SERVER_BIN"; }

usage() {
  cat <<USAGE
claude-cron — durable local scheduler for headless Claude Code runs

  claude-cron install         install + load both agents (tick + control server)
  claude-cron uninstall       unload + remove both agents (keeps jobs and logs)
  claude-cron status          launchd state, every job, last run and cost
  claude-cron list            same as status
  claude-cron dashboard       open the interactive control dashboard in a browser
  claude-cron serve           run the control server in the foreground (launchd uses this)
  claude-cron run <id>        run one job now, ignoring schedule and precheck
  claude-cron check <id>      run only the precheck and report what it found
  claude-cron logs <id> [n]   print the result of the n-th most recent run
  claude-cron enable <id>     re-enable a job
  claude-cron disable <id>    stop a job without deleting it
  claude-cron toggle-many <true|false>   enable or disable a whole set of jobs;
                              ids on stdin, as a JSON array or one per line
  claude-cron delete <id>     remove a job from jobs.json (keeps its logs)
  claude-cron create <id>     create a job from a partial JSON object on stdin
  claude-cron set-prompt <id> replace a job's prompt, read from stdin
  claude-cron set-field <id> <field>   set interval_seconds|active_hours|active_days|
                              model|max_budget_usd|timeout_seconds|
                              stall_timeout_seconds, value from stdin
  claude-cron set-precheck <id>   replace a job's precheck script, read from stdin
  claude-cron provision-set <project> <up|down>   replace a worktree provisioning hook (stdin)
  claude-cron provision-get <project> <up|down>   print one
  claude-cron get-precheck <id>   print a job's precheck script
  claude-cron tick            internal — what launchd calls every minute

Jobs are defined in $JOBS_FILE
USAGE
}

cmd_check() {
  local id="$1" precheck cwd
  precheck="$(jobs_json | "$JQ" -r --arg id "$id" '.jobs[] | select(.id==$id) | .precheck // ""')"
  cwd="$(resolve "$id" cwd "$HOME")"   # inherit the project's cwd, like run_job
  [ -n "$precheck" ] || { echo "$id has no precheck — every due tick spends a session."; return 0; }
  # Read-only, like every standalone probe (see CC_PRECHECK_DRY_RUN).
  ( cd "$cwd" && export CC_PRECHECK_DRY_RUN=1 && eval "$precheck" ); local rc=$?
  case "$(precheck_verdict "$rc")" in
    work)  echo "precheck: WORK FOUND — a due tick would start a Claude run" ;;
    idle)  echo "precheck: nothing to do — a due tick would cost nothing" ;;
    *)     echo "precheck: BROKEN (exit $rc) — the probe could not run, so this job is stuck: it will never find work until this is fixed" ; return 1 ;;
  esac
}

case "${1:-}" in
  install)   cmd_install ;;
  uninstall) cmd_uninstall ;;
  status|list) cmd_status ;;
  dashboard) cmd_dashboard ;;
  tick)      cmd_tick ;;
  _exec)     [ $# -ge 2 ] || die "usage: claude-cron _exec <job-id>"; run_job "$2" ;;  # internal: detached runner
  _resolve_models)   # internal: detached daily refresh, guarded by its own lock
    acquire_lock "_models" || exit 0
    trap 'release_lock "_models"' EXIT
    cmd_resolve_models
    ;;
  run)       [ $# -ge 2 ] || die "usage: claude-cron run <job-id>"; run_job "$2" --force ;;
  resume)    [ $# -ge 3 ] || die "usage: claude-cron resume <job-id> <session-id>"; run_job "$2" --force "$3" ;;
  check)     [ $# -ge 2 ] || die "usage: claude-cron check <job-id>"; cmd_check "$2" ;;
  logs)      shift; cmd_logs "$@" ;;
  enable)    [ $# -ge 2 ] || die "usage: claude-cron enable <job-id>"; cmd_toggle "$2" true ;;
  disable)   [ $# -ge 2 ] || die "usage: claude-cron disable <job-id>"; cmd_toggle "$2" false ;;
  delete)    [ $# -ge 2 ] || die "usage: claude-cron delete <job-id>"; cmd_delete "$2" ;;
  rename)    [ $# -ge 3 ] || die "usage: claude-cron rename <job-id> <new-id>"; cmd_rename "$2" "$3" ;;
  reorder)   cmd_reorder ;;   # new order of job ids on stdin
  toggle-many) [ $# -ge 2 ] || die "usage: claude-cron toggle-many <true|false>  (job ids on stdin)"
               case "$2" in true|false) ;; *) die "toggle-many: expected true or false, got '$2'" ;; esac
               cmd_toggle_many "$2" ;;
  create)    cmd_create ;;
  project-set)    cmd_project_set ;;
  project-delete) [ $# -ge 2 ] || die "usage: claude-cron project-delete <name>"; cmd_project_delete "$2" ;;
  project-rename) [ $# -ge 3 ] || die "usage: claude-cron project-rename <name> <new-name>"; cmd_project_rename "$2" "$3" ;;
  project-list)   cmd_project_list ;;
  resolve-models) cmd_resolve_models ;;
  selftest)  cmd_selftest ;;
  running)   [ $# -ge 2 ] || die "usage: claude-cron running <job-id>"; cmd_running "$2" ;;
  runs)      [ $# -ge 2 ] || die "usage: claude-cron runs <job-id>"; cmd_runs "$2" ;;
  precheck)  [ $# -ge 2 ] || die "usage: claude-cron precheck <job-id>"; cmd_precheck "$2" ;;
  say)       [ $# -ge 2 ] || die "usage: claude-cron say <job-id> (message on stdin)"; cmd_say "$2" ;;
  stop)      [ $# -ge 2 ] || die "usage: claude-cron stop <job-id> [run-pid]"; cmd_stop "$2" "${3:-}" ;;
  set-prompt) [ $# -ge 2 ] || die "usage: claude-cron set-prompt <job-id> (prompt on stdin)"; cmd_set_prompt "$2" ;;
  set-field) [ $# -ge 3 ] || die "usage: claude-cron set-field <job-id> <field> (value on stdin)"; cmd_set_field "$2" "$3" ;;
  set-precheck) [ $# -ge 2 ] || die "usage: claude-cron set-precheck <job-id> (script on stdin)"; cmd_set_precheck "$2" ;;
  get-precheck) [ $# -ge 2 ] || die "usage: claude-cron get-precheck <job-id>"; cmd_get_precheck "$2" ;;
  provision-set) [ $# -ge 3 ] || die "usage: claude-cron provision-set <project> <up|down> (script on stdin)"; cmd_provision_set "$2" "$3" ;;
  provision-get) [ $# -ge 3 ] || die "usage: claude-cron provision-get <project> <up|down>"; cmd_provision_get "$2" "$3" ;;
  serve)     cmd_serve ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try: claude-cron help)" ;;
esac
